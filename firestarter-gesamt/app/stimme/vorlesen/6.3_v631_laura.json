{"s":[["Tagesgeld, Festgeld, Geldmarkt-ETF",0.0,2.833,[[0,10,0.0],[11,20,0.952],[21,34,1.73]]],["„Sicher“ heißt nicht automatisch „klug“.",2.949,5.236,[[0,8,2.949],[9,14,3.587],[15,20,3.889],[21,32,4.098],[33,40,4.679]]],["Geld, das ruht, kann trotzdem ein wenig arbeiten, es unterscheidet sich vor allem in einer Frage:",5.619,10.797,[[0,5,5.619],[6,9,5.933],[10,15,6.142],[16,20,6.478],[21,29,6.687],[30,33,7.152],[34,39,7.268],[40,49,7.57],[50,52,8.487],[53,66,8.673],[67,71,9.276],[72,75,9.462],[76,81,9.636],[82,84,9.903],[85,90,9.996],[91,97,10.205]]],["Wie schnell kommst du wieder dran?",11.076,12.597,[[0,3,11.076],[4,11,11.25],[12,18,11.575],[19,21,11.842],[22,28,11.947],[29,34,12.19]]],["Tagesgeld",12.713,13.491,[[0,9,12.713]]],["Verfügbarkeit: jederzeit",14.002,15.732,[[0,14,14.002],[15,24,15.175]]],["Idee: flexibel parken, Zins meist variabel",15.801,18.797,[[0,5,15.801],[6,14,16.347],[15,22,16.928],[23,27,17.717],[28,33,18.065],[34,42,18.344]]],["Festgeld",18.843,19.389,[[0,8,18.843]]],["Verfügbarkeit: erst nach Ablauf",19.714,21.839,[[0,14,19.714],[15,19,20.863],[20,24,21.177],[25,31,21.386]]],["Idee: für mehr Zins bindest du das Geld eine feste Zeit",21.932,25.194,[[0,5,21.932],[6,9,22.489],[10,14,22.709],[15,19,22.976],[20,27,23.36],[28,30,23.685],[31,34,23.801],[35,39,23.998],[40,44,24.3],[45,50,24.509],[51,55,24.915]]],["Geldmarkt-ETF",25.264,26.216,[[0,13,25.264]]],["Verfügbarkeit: börsentäglich",26.285,28.375,[[0,14,26.285],[15,28,27.551]]],["Idee: bildet kurzfristige Geldmarkt-Zinsen ab.",28.456,31.533,[[0,5,28.456],[6,12,29.025],[13,25,29.385],[26,42,30.244],[43,46,31.231]]],["Übergang Richtung Wertpapier",31.812,33.321,[[0,8,31.812],[9,17,32.334],[18,28,32.671]]],["Eine kleine Leiter:",33.6,34.714,[[0,4,33.6],[5,11,33.867],[12,19,34.238]]],["Tagesgeld, Festgeld, Geldmarkt-ETF · der Tausch ist immer derselbe:",34.784,40.101,[[0,10,34.784],[11,20,35.782],[21,34,36.758],[35,36,38.058],[37,40,38.499],[41,47,38.696],[48,51,39.022],[52,57,39.207],[58,67,39.451]]],["Verfügbarkeit gegen Zins.",40.252,41.878,[[0,13,40.252],[14,19,41.088],[20,25,41.355]]],["Der Tausch ist immer derselbe:",42.121,43.689,[[0,3,42.121],[4,10,42.319],[11,14,42.609],[15,20,42.795],[21,30,43.039]]],["Verfügbarkeit gegen Zins.",43.863,45.627,[[0,13,43.863],[14,19,44.722],[20,25,45.035]]],["Beim Festgeld lauert die Lockzins-Falle:",45.952,48.344,[[0,4,45.952],[5,13,46.208],[14,20,46.858],[21,24,47.16],[25,40,47.311]]],["Ein hoher Aktionszins gilt oft nur für Neukunden und nur kurz, danach fällt das Geld still auf den niedrigeren Bestandszins zurück.",48.588,56.192,[[0,3,48.588],[4,9,48.82],[10,21,49.064],[22,26,50.016],[27,30,50.26],[31,34,50.469],[35,38,50.608],[39,48,50.747],[49,52,51.56],[53,56,51.792],[57,62,51.966],[63,69,52.721],[70,75,53.127],[76,79,53.336],[80,84,53.534],[85,90,53.789],[91,94,54.114],[95,98,54.254],[99,110,54.393],[111,123,54.962],[124,131,55.716]]],["„Sicher parken“ ist kein einziger Zustand, sondern eine kleine Leiter, von jederzeit verfügbar bis börsentäglich handelbar.",56.436,64.192,[[0,7,56.436],[8,15,56.924],[16,19,57.47],[20,24,57.771],[25,33,58.038],[34,42,58.514],[43,50,59.188],[51,55,59.838],[56,62,60.128],[63,70,60.546],[71,74,61.092],[75,84,61.417],[85,94,61.962],[95,98,62.543],[99,112,62.752],[113,123,63.53]]],["Der höchste beworbene Zins ist nicht automatisch der beste; entscheidend ist, was nach der Aktion übrig bleibt.",64.517,70.774,[[0,3,64.517],[4,11,64.691],[12,21,65.074],[22,26,65.608],[27,30,66.003],[31,36,66.2],[37,48,66.456],[49,52,67.094],[53,59,67.222],[60,72,67.965],[73,77,68.58],[78,81,68.859],[82,86,69.137],[87,90,69.3],[91,97,69.404],[98,103,69.834],[104,111,70.113]]]]}