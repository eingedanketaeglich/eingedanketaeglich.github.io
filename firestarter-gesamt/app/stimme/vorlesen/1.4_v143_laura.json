{"s":[["Der Abstand ist dein Wachstumsraum",0.0,1.974,[[0,3,0.0],[4,11,0.232],[12,15,0.789],[16,20,0.975],[21,34,1.173]]],["Schau dir die drei Abstände zwischen Heute und Ziel an, genau sie sind dein persönlicher Wachstumsraum.",2.485,8.011,[[0,5,2.485],[6,9,2.786],[10,13,2.902],[14,18,3.03],[19,27,3.286],[28,36,3.843],[37,42,4.203],[43,46,4.54],[47,51,4.69],[52,55,4.992],[56,61,5.399],[62,65,5.817],[66,70,6.049],[71,75,6.235],[76,88,6.455],[89,103,7.082]]],["Der größte Abstand zeigt, wo deine nächsten Schritte am meisten bewirken.",8.22,11.912,[[0,3,8.22],[4,10,8.406],[11,18,8.835],[19,25,9.276],[26,28,9.659],[29,34,9.787],[35,43,10.019],[44,52,10.414],[53,55,10.762],[56,63,10.89],[64,73,11.296]]],["Keine feste Stufenzahl, dein Tempo bestimmst du selbst.",12.19,15.604,[[0,5,12.19],[6,11,12.527],[12,23,12.875],[24,28,13.781],[29,34,14.083],[35,44,14.419],[45,47,14.861],[48,55,14.988]]],["Deine drei Zielwerte sind die Rohform deiner Nordsterne.",15.847,18.947,[[0,5,15.847],[6,10,16.114],[11,20,16.381],[21,25,16.997],[26,29,17.159],[30,37,17.31],[38,44,17.879],[45,56,18.158]]],["Als Nächstes gießt du sie in einen Brief an dein zukünftiges Ich, mit einer konkreten, überprüfbaren Selbstverpflichtung.",19.191,26.122,[[0,3,19.191],[4,12,19.481],[13,18,19.992],[19,21,20.248],[22,25,20.387],[26,28,20.619],[29,34,20.793],[35,40,21.037],[41,43,21.385],[44,48,21.49],[49,60,21.699],[61,65,22.523],[66,69,22.883],[70,75,23.069],[76,86,23.324],[87,100,24.079],[101,121,25.054]]],["Drei Sätze zum Mitnehmen",26.633,27.945,[[0,4,26.633],[5,10,26.912],[11,14,27.283],[15,24,27.469]]],["Die drei Leitbegriffe sind eine Kette:",28.549,30.673,[[0,3,28.549],[4,8,28.734],[9,21,28.978],[22,26,29.71],[27,31,29.919],[32,38,30.116]]],["Wissen trägt Selbstbestimmung, beides trägt Aufbau.",30.917,33.971,[[0,6,30.917],[7,12,31.265],[13,30,31.637],[31,37,32.659],[38,43,33.042],[44,51,33.378]]],["Eine niedrige Zahl heute ist dein Startkapital, kein Urteil.",34.354,37.918,[[0,4,34.354],[5,13,34.586],[14,18,35.073],[19,24,35.41],[25,28,35.782],[29,33,35.921],[34,47,36.095],[48,52,37.059],[53,60,37.361]]],["Der Abstand zwischen Heute und Ziel ist dein Wachstumsraum.",38.359,41.703,[[0,3,38.359],[4,11,38.533],[12,20,38.974],[21,26,39.323],[27,30,39.671],[31,35,39.81],[36,39,40.217],[40,44,40.379],[45,59,40.588]]]]}