{"s":[["Fonds und ETF, der gemeinsame Korb",0.0,2.334,[[0,5,0.0],[6,9,0.522],[10,14,0.72],[15,18,1.324],[19,29,1.451],[30,34,2.078]]],["Fünfhundert Aktien einzeln kaufen?",2.403,4.296,[[0,11,2.403],[12,18,2.972],[19,26,3.355],[27,34,3.738]]],["Ein Albtraum.",4.47,5.399,[[0,3,4.47],[4,13,4.69]]],["Eleganter: alles in einen Korb, mit einer Order gekauft.",5.642,8.986,[[0,10,5.642],[11,16,6.653],[17,19,7.001],[20,25,7.117],[26,31,7.372],[32,35,7.709],[36,41,7.86],[42,47,8.092],[48,56,8.371]]],["Dieser Korb heißt Fonds; seine günstigste Bauform heißt ETF.",9.369,13.293,[[0,6,9.369],[7,11,9.718],[12,17,10.054],[18,24,10.379],[25,30,10.937],[31,41,11.204],[42,49,11.807],[50,55,12.341],[56,60,12.655]]],["Die wichtigste Gabelung, zwei Arten, den Korb zu füllen:",13.41,16.753,[[0,3,13.41],[4,14,13.572],[15,24,14.129],[25,29,14.919],[30,36,15.302],[37,40,15.65],[41,45,15.836],[46,48,16.115],[49,56,16.266]]],["Wer füllt den Korb? ein Manager-Team wählt aus",16.904,19.493,[[0,3,16.904],[4,9,17.171],[10,13,17.403],[14,19,17.589],[20,23,18.274],[24,36,18.448],[37,42,19.133],[43,46,19.389]]],["Laufende Kosten / Jahr: oft rund 1,5 bis 2 %",19.586,23.592,[[0,8,19.586],[9,15,20.027],[16,17,20.689],[18,23,20.886],[24,27,21.606],[28,32,21.838],[33,36,22.094],[37,40,22.825],[41,42,22.999],[43,44,23.348]]],["Wer füllt den Korb? ein Index-Rezept",24.102,26.482,[[0,3,24.102],[4,9,24.335],[10,13,24.567],[14,19,24.753],[20,23,25.345],[24,36,25.588]]],["Laufende Kosten / Jahr: oft nur 0,05 bis 0,50 %",26.575,31.15,[[0,8,26.575],[9,15,27.028],[16,17,27.609],[18,23,27.783],[24,27,28.259],[28,31,28.561],[32,36,28.735],[37,40,29.722],[41,45,29.931],[46,47,30.871]]],["Das Geld im Fonds ist Sondervermögen, rechtlich getrennt vom Anbieter, es gehört weiter dir.",31.846,37.221,[[0,3,31.846],[4,8,32.102],[9,11,32.357],[12,17,32.496],[18,21,32.902],[22,37,33.204],[38,47,34.238],[48,56,34.656],[57,60,35.05],[61,70,35.248],[71,73,35.933],[74,80,36.13],[81,87,36.49],[88,92,36.85]]],["Aber ehrlich:",37.43,38.266,[[0,4,37.43],[5,13,37.721]]],["Sondervermögen schützt vor der Pleite des Anbieters, nicht vor Kursrückgängen.",38.591,42.934,[[0,14,38.591],[15,22,39.543],[23,26,39.903],[27,30,40.054],[31,37,40.182],[38,41,40.553],[42,52,40.751],[53,58,41.587],[59,62,41.877],[63,78,42.051]]],["Ein Insolvenz-Schutz, kein Markt-Schutz.",43.259,45.743,[[0,3,43.259],[4,21,43.456],[22,26,44.512],[27,40,44.791]]]]}