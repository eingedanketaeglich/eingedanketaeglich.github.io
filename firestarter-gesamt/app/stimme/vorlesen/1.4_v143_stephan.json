{"s":[["Der Abstand ist dein Wachstumsraum",0.0,2.485,[[0,3,0.0],[4,11,0.209],[12,15,0.848],[16,20,1.289],[21,34,1.602]]],["Schau dir die drei Abstände zwischen Heute und Ziel an, genau sie sind dein persönlicher Wachstumsraum.",2.926,8.626,[[0,5,2.926],[6,9,3.193],[10,13,3.286],[14,18,3.448],[19,27,3.738],[28,36,4.214],[37,42,4.528],[43,46,4.911],[47,51,5.062],[52,55,5.399],[56,61,5.956],[62,65,6.281],[66,70,6.513],[71,75,6.885],[76,88,7.163],[89,103,7.755]]],["Der größte Abstand zeigt, wo deine nächsten Schritte am meisten bewirken.",8.777,12.469,[[0,3,8.777],[4,10,8.94],[11,18,9.276],[19,25,9.671],[26,28,10.228],[29,34,10.379],[35,43,10.623],[44,52,10.995],[53,55,11.331],[56,63,11.447],[64,73,11.831]]],["Keine feste Stufenzahl, dein Tempo bestimmst du selbst.",12.678,16.44,[[0,5,12.678],[6,11,13.05],[12,23,13.363],[24,28,14.362],[29,34,14.629],[35,44,15.279],[45,47,15.743],[48,55,15.883]]],["Deine drei Zielwerte sind die Rohform deiner Nordsterne.",16.556,20.26,[[0,5,16.556],[6,10,16.811],[11,20,17.055],[21,25,17.659],[26,29,17.822],[30,37,18.054],[38,44,19.203],[45,56,19.528]]],["Als Nächstes gießt du sie in einen Brief an dein zukünftiges Ich, mit einer konkreten, überprüfbaren Selbstverpflichtung.",20.434,26.935,[[0,3,20.434],[4,12,20.62],[13,18,21.003],[19,21,21.212],[22,25,21.316],[26,28,21.455],[29,34,21.56],[35,40,21.781],[41,43,22.222],[44,48,22.338],[49,60,22.524],[61,65,23.267],[66,69,23.928],[70,75,24.079],[76,86,24.288],[87,100,24.88],[101,121,25.786]]],["Drei Sätze zum Mitnehmen",27.109,28.839,[[0,4,27.109],[5,10,27.516],[11,14,28.015],[15,24,28.224]]],["Die drei Leitbegriffe sind eine Kette:",29.222,31.138,[[0,3,29.222],[4,8,29.42],[9,21,29.745],[22,26,30.383],[27,31,30.558],[32,38,30.755]]],["Wissen trägt Selbstbestimmung, beides trägt Aufbau.",31.417,34.702,[[0,6,31.417],[7,12,31.881],[13,30,32.287],[31,37,33.286],[38,43,33.692],[44,51,33.982]]],["Eine niedrige Zahl heute ist dein Startkapital, kein Urteil.",34.911,37.965,[[0,4,34.911],[5,13,35.143],[14,18,35.573],[19,24,35.828],[25,28,36.107],[29,33,36.235],[34,47,36.386],[48,52,37.256],[53,60,37.5]]],["Der Abstand zwischen Heute und Ziel ist dein Wachstumsraum.",38.243,41.935,[[0,3,38.243],[4,11,38.406],[12,20,38.731],[21,26,39.044],[27,30,39.393],[31,35,39.532],[36,39,39.95],[40,44,40.345],[45,59,40.681]]]]}