{"s":[["Die Grenze.",0.0,0.766,[[0,3,0.0],[4,11,0.209]]],["Notgroschen ist Sicherheit, nicht Renditequelle",1.37,4.54,[[0,11,1.37],[12,15,2.067],[16,27,2.264],[28,33,3.239],[34,47,3.657]]],["Verzinste Einlagen haben eine klare Aufgabe:",5.236,8.069,[[0,9,5.236],[10,18,5.863],[19,24,6.42],[25,29,6.687],[30,35,6.931],[36,44,7.372]]],["Sicherheit und Verfügbarkeit, vor allem für den Notgroschen.",8.51,11.9,[[0,10,8.51],[11,14,9.067],[15,29,9.183],[30,33,10.333],[34,39,10.553],[40,43,10.855],[44,47,11.006],[48,60,11.157]]],["Sie sind nicht der Ort, an dem Vermögen wächst.",12.597,14.965,[[0,3,12.597],[4,8,12.817],[9,14,13.038],[15,18,13.247],[19,23,13.433],[24,26,13.688],[27,30,13.793],[31,39,13.99],[40,47,14.478]]],["Wer mit Zins-Hopping (ständig dem nächsten Aktionszins hinterher) Vermögen aufbauen will, verwechselt die Aufgaben.",15.917,23.092,[[0,3,15.917],[4,7,16.138],[8,20,16.289],[21,29,17.02],[30,33,17.636],[34,42,17.81],[43,54,18.146],[55,65,18.901],[66,74,20.585],[75,83,21.049],[84,89,21.513],[90,101,21.827],[102,105,22.361],[106,115,22.477]]],["Die klare Linie:",23.336,24.3,[[0,3,23.336],[4,9,23.487],[10,16,23.824]]],["Der Notgroschen bleibt sicher und verfügbar, niemals in Schwankung.",24.544,28.317,[[0,3,24.544],[4,15,24.729],[16,22,25.356],[23,29,25.705],[30,33,26.053],[34,44,26.192],[45,52,27.202],[53,55,27.655],[56,67,27.748]]],["Was darüber hinaus lange frei ist, gehört in den Vermögensaufbau (Baustein 4 ff.), nicht ins nächste Festgeld.",29.129,36.897,[[0,3,29.129],[4,11,29.35],[12,18,29.698],[19,24,30.151],[25,29,30.441],[30,34,30.732],[35,41,31.219],[42,44,31.556],[45,48,31.649],[49,64,31.858],[65,74,32.961],[75,76,33.692],[77,82,34.389],[83,88,35.306],[89,92,35.608],[93,100,35.828],[101,110,36.177]]],["Verzinste Einlagen und Vermögensaufbau sind zwei verschiedene Werkzeuge.",37.593,41.784,[[0,9,37.593],[10,18,38.255],[19,22,38.801],[23,38,38.951],[39,43,40.078],[44,48,40.298],[49,61,40.589],[62,72,41.088]]],["Das eine hält den Notgroschen sicher, das andere lässt Vermögen über Jahrzehnte wachsen.",42.388,47.02,[[0,3,42.388],[4,8,42.655],[9,13,42.945],[14,17,43.108],[18,29,43.27],[30,37,43.886],[38,41,44.455],[42,48,44.675],[49,54,45.0],[55,63,45.244],[64,68,45.778],[69,79,46.045],[80,88,46.544]]],["Sie zu verwechseln kostet auf beiden Seiten, entweder Sicherheit oder Wachstum.",47.833,52.442,[[0,3,47.833],[4,6,48.054],[7,18,48.204],[19,25,48.75],[26,29,49.098],[30,36,49.261],[37,44,49.633],[45,53,50.387],[54,64,50.852],[65,69,51.537],[70,79,51.838]]],["Drei Sätze zum Mitnehmen",53.139,54.485,[[0,4,53.139],[5,10,53.487],[11,14,53.847],[15,24,54.044]]],["Tagesgeld, Festgeld, Geldmarkt-ETF verzinsen ruhendes Geld; der Tausch ist immer Verfügbarkeit gegen Zins.",55.298,63.681,[[0,10,55.298],[11,20,56.378],[21,34,57.4],[35,44,58.99],[45,53,59.605],[54,59,60.058],[60,63,61.208],[64,70,61.393],[71,74,61.742],[75,80,61.939],[81,94,62.195],[95,100,62.938],[101,106,63.193]]],["Vorsicht vor der Lockzins-Falle.",64.378,66.119,[[0,8,64.378],[9,12,64.912],[13,16,65.051],[17,32,65.19]]],["Realzins = Einlagenzins − Inflation:",66.932,71.274,[[0,8,66.932],[9,10,67.953],[11,23,68.673],[24,25,69.799],[26,36,70.391]]],["Ist er negativ, schrumpft dein Geld still, auch wenn die Zahl gleich bleibt.",72.087,76.603,[[0,3,72.087],[4,6,72.342],[7,15,72.458],[16,25,73.48],[26,30,73.874],[31,35,74.049],[36,42,74.304],[43,47,74.896],[48,52,75.14],[53,56,75.303],[57,61,75.465],[62,68,75.767],[69,76,76.08]]],["Verzinste Einlagen sind Sicherheit, keine Renditequelle.",77.299,80.782,[[0,9,77.299],[10,18,77.926],[19,23,78.426],[24,35,78.646],[36,41,79.587],[42,56,79.923]]],["Zins-Hopping ersetzt den Zinseszins nicht.",81.595,84.382,[[0,12,81.595],[13,20,82.396],[21,24,82.803],[25,35,83.0],[36,42,83.778]]]]}