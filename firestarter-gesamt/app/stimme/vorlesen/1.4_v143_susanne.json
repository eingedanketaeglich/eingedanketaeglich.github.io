{"s":[["Der Abstand ist dein Wachstumsraum",0.0,2.415,[[0,3,0.0],[4,11,0.325],[12,15,0.94],[16,20,1.161],[21,34,1.416]]],["Schau dir die drei Abstände zwischen Heute und Ziel an, genau sie sind dein persönlicher Wachstumsraum.",2.856,9.81,[[0,5,2.856],[6,9,3.17],[10,13,3.32],[14,18,3.448],[19,27,3.82],[28,36,4.447],[37,42,4.911],[43,46,5.48],[47,51,5.805],[52,55,6.281],[56,61,6.815],[62,65,7.245],[66,70,7.593],[71,75,7.814],[76,88,8.034],[89,103,8.766]]],["Der größte Abstand zeigt, wo deine nächsten Schritte am meisten bewirken.",10.194,14.176,[[0,3,10.194],[4,10,10.379],[11,18,10.786],[19,25,11.262],[26,28,11.61],[29,34,11.819],[35,43,12.074],[44,52,12.504],[53,55,12.887],[56,63,13.015],[64,73,13.479]]],["Keine feste Stufenzahl, dein Tempo bestimmst du selbst.",14.501,18.111,[[0,5,14.501],[6,11,14.919],[12,23,15.348],[24,28,16.277],[29,34,16.521],[35,44,16.927],[45,47,17.345],[48,55,17.566]]],["Deine drei Zielwerte sind die Rohform deiner Nordsterne.",18.355,21.919,[[0,5,18.355],[6,10,18.657],[11,20,18.947],[21,25,19.76],[26,29,19.98],[30,37,20.178],[38,44,20.805],[45,56,21.095]]],["Als Nächstes gießt du sie in einen Brief an dein zukünftiges Ich, mit einer konkreten, überprüfbaren Selbstverpflichtung.",22.302,29.396,[[0,3,22.302],[4,12,22.546],[13,18,23.011],[19,21,23.254],[22,25,23.405],[26,28,23.591],[29,34,23.742],[35,40,23.998],[41,43,24.415],[44,48,24.578],[49,60,24.799],[61,65,25.553],[66,69,26.099],[70,75,26.285],[76,86,26.505],[87,100,27.237],[101,121,28.258]]],["Drei Sätze zum Mitnehmen",29.779,31.405,[[0,4,29.779],[5,10,30.163],[11,14,30.604],[15,24,30.778]]],["Die drei Leitbegriffe sind eine Kette:",31.788,33.994,[[0,3,31.788],[4,8,31.974],[9,21,32.241],[22,26,32.914],[27,31,33.135],[32,38,33.379]]],["Wissen trägt Selbstbestimmung, beides trägt Aufbau.",34.238,37.628,[[0,6,34.238],[7,12,34.737],[13,30,35.109],[31,37,36.107],[38,43,36.583],[44,51,36.943]]],["Eine niedrige Zahl heute ist dein Startkapital, kein Urteil.",37.837,41.68,[[0,4,37.837],[5,13,38.081],[14,18,38.557],[19,24,38.847],[25,28,39.288],[29,33,39.474],[34,47,39.718],[48,52,40.728],[53,60,41.03]]],["Der Abstand zwischen Heute und Ziel ist dein Wachstumsraum.",41.889,45.975,[[0,3,41.889],[4,11,42.086],[12,20,42.574],[21,26,43.003],[27,30,43.526],[31,35,43.828],[36,39,44.315],[40,44,44.478],[45,59,44.722]]]]}