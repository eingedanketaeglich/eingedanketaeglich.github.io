{"s":[["Wo warst du bisher abhängig?",0.0,1.753,[[0,2,0.0],[3,8,0.267],[9,11,0.534],[12,18,0.639],[19,28,0.952]]],["Abhängigkeit ist kein Grund für Scham, sie ist normal, solange das Wissen fehlt.",1.962,6.548,[[0,12,1.962],[13,16,2.682],[17,21,2.879],[22,27,3.158],[28,31,3.413],[32,38,3.576],[39,42,4.18],[43,46,4.377],[47,54,4.598],[55,62,5.224],[63,66,5.573],[67,73,5.747],[74,80,6.037]]],["Der erste Akt der Selbstbestimmung ist, sie zu sehen.",6.699,9.543,[[0,3,6.699],[4,9,6.861],[10,13,7.163],[14,17,7.477],[18,34,7.663],[35,39,8.394],[40,43,8.754],[44,46,8.975],[47,53,9.149]]],["Bei welcher Geldentscheidung habe ich zuletzt einfach vertraut, ohne es selbst zu verstehen?",9.787,14.837,[[0,3,9.787],[4,11,9.961],[12,28,10.344],[29,33,11.413],[34,37,11.61],[38,45,11.738],[46,53,12.144],[54,63,12.481],[64,68,13.293],[69,71,13.618],[72,78,13.722],[79,81,14.059],[82,92,14.222]]],["Wem habe ich sie überlassen, und welches Interesse hatte diese Person oder Stelle?",15.162,19.435,[[0,3,15.162],[4,8,15.464],[9,12,15.708],[13,16,15.847],[17,28,15.998],[29,32,16.555],[33,40,16.718],[41,50,17.078],[51,56,17.554],[57,62,17.786],[63,69,18.053],[70,74,18.587],[75,82,18.912]]],["Was müsste ich verstehen, um es beim nächsten Mal selbst zu entscheiden?",19.76,23.208,[[0,3,19.76],[4,10,20.131],[11,14,20.491],[15,25,20.607],[26,28,21.083],[29,31,21.199],[32,36,21.292],[37,45,21.432],[46,49,21.71],[50,56,21.873],[57,59,22.418],[60,72,22.616]]],["Erster praktischer Schritt, der Notgroschen",23.591,26.401,[[0,6,23.591],[7,18,24.195],[19,27,24.81],[28,31,25.518],[32,43,25.704]]],["Eine Reserve aus 3 bis 6 Netto-Monatsgehältern auf einem getrennten Konto fängt Notfälle ab, ohne dass du in Panik etwas verkaufen musst.",26.911,35.189,[[0,4,26.911],[5,12,27.179],[13,16,27.631],[17,18,27.875],[19,22,28.2],[23,24,28.432],[25,46,28.85],[47,50,30.186],[51,56,30.325],[57,67,30.522],[68,73,31.045],[74,79,31.544],[80,88,31.881],[89,92,32.449],[93,97,32.984],[98,102,33.262],[103,105,33.436],[106,108,33.564],[109,114,33.68],[115,120,34.075],[121,130,34.342],[131,137,34.783]]],["Er ist der erste der vier Geldtöpfe, mehr dazu in Baustein 2.",35.364,39.45,[[0,2,35.364],[3,6,35.491],[7,10,35.619],[11,16,35.758],[17,20,36.153],[21,25,36.292],[26,36,36.478],[37,41,37.43],[42,46,37.767],[47,49,38.162],[50,58,38.278],[59,61,38.928]]],["Kreuze an, was auf dich zutrifft.",39.659,41.807,[[0,6,39.659],[7,10,40.066],[11,14,40.588],[15,18,40.82],[19,23,40.948],[24,33,41.134]]],["Ein Spiegel, keine Beratung, nichts wird gespeichert.",41.958,44.942,[[0,3,41.958],[4,12,42.109],[13,18,42.759],[19,28,43.026],[29,35,43.56],[36,40,43.967],[41,53,44.187]]],["Drei Sätze zum Mitnehmen",45.0,46.509,[[0,4,45.0],[5,10,45.348],[11,14,45.813],[15,24,45.998]]],["Anlageberatung lebt von der Wissens-Lücke, das Problem ist das Modell, nicht die Person.",46.579,51.397,[[0,14,46.579],[15,19,47.45],[20,23,47.728],[24,27,47.879],[28,42,48.019],[43,46,48.855],[47,54,49.029],[55,58,49.354],[59,62,49.458],[63,70,49.656],[71,76,50.166],[77,80,50.538],[81,88,50.724]]],["Bildung will sich selbst überflüssig machen; Beratung hält die Abhängigkeit.",51.606,55.716,[[0,7,51.606],[8,12,52.163],[13,17,52.349],[18,24,52.5],[25,36,52.86],[37,44,53.417],[45,53,54.033],[54,58,54.579],[59,62,54.73],[63,76,54.857]]],["Der erste Akt der Selbstbestimmung ist, die eigene Abhängigkeit zu erkennen, der Notgroschen ist der erste praktische Schritt.",55.867,62.648,[[0,3,55.867],[4,9,56.018],[10,13,56.309],[14,17,56.61],[18,34,56.785],[35,39,57.493],[40,43,58.05],[44,50,58.201],[51,63,58.456],[64,66,59.048],[67,76,59.188],[77,80,59.919],[81,92,60.093],[93,96,60.836],[97,100,60.976],[101,106,61.115],[107,117,61.51],[118,126,62.021]]]]}