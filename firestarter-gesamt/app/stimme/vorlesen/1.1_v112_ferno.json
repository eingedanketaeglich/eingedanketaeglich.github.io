{"s":[["Was Firestarter ist, und was nicht",0.0,2.148,[[0,3,0.0],[4,15,0.313],[16,20,1.033],[21,24,1.451],[25,28,1.591],[29,34,1.834]]],["Die ehrlichste Art, Vertrauen aufzubauen: sagen, wo die Grenzen liegen.",2.961,7.57,[[0,3,2.961],[4,14,3.193],[15,19,3.692],[20,29,3.924],[30,41,4.447],[42,48,5.561],[49,51,6.351],[52,55,6.641],[56,63,6.78],[64,71,7.21]]],["Bildung, die dir das Prinzip erklärt, keine auf deinen Einzelfall zugeschnittene Empfehlung.",8.522,13.108,[[0,8,8.522],[9,12,8.975],[13,16,9.067],[17,20,9.195],[21,28,9.358],[29,37,9.776],[38,43,10.484],[44,47,10.855],[48,54,11.006],[55,65,11.296],[66,80,11.9],[81,92,12.504]]],["ehrliche Sprache:",13.711,14.791,[[0,8,13.711],[9,17,14.129]]],["Es fällt nie eine Zahl wie „so viel bekommst du“.",15.07,18.216,[[0,2,15.07],[3,8,15.302],[9,12,15.616],[13,17,15.848],[18,22,16.103],[23,26,16.405],[27,30,16.695],[31,35,17.229],[36,44,17.438],[45,49,17.845]]],["ein Fundament, aktives Handeln gehört nicht zu Firestarter.",18.727,22.558,[[0,3,18.727],[4,14,18.867],[15,22,19.877],[23,30,20.434],[31,37,20.805],[38,43,21.13],[44,46,21.49],[47,59,21.688]]],["die Schicht darunter, das konkrete Depot-Zusammenstellen kommt später.",22.942,26.529,[[0,3,22.942],[4,11,23.093],[12,21,23.348],[22,25,23.975],[26,34,24.184],[35,56,24.671],[57,62,25.763],[63,70,25.983]]],["steuerliches Grundwissen, damit du die richtigen Fragen stellen kannst.",27.133,30.639,[[0,12,27.133],[13,25,27.76],[26,31,28.538],[32,34,28.828],[35,38,28.932],[39,48,29.072],[49,55,29.466],[56,63,29.814],[64,71,30.151]]],["Und was ist es dann zusammengefasst?",31.335,33.251,[[0,3,31.335],[4,7,31.672],[8,11,31.881],[12,14,32.044],[15,19,32.148],[20,36,32.322]]],["Bildung.",33.948,34.516,[[0,8,33.948]]],["Ein Fundament.",35.12,36.014,[[0,3,35.12],[4,14,35.306]]],["Eine Selbstlern-Bibliothek, durch die du dich selbst bewegst, und auf der alles Weitere ruht.",36.827,41.889,[[0,4,36.827],[5,27,37.117],[28,33,38.638],[34,37,38.882],[38,40,38.998],[41,45,39.091],[46,52,39.23],[53,61,39.578],[62,65,40.368],[66,69,40.542],[70,73,40.67],[74,79,40.786],[80,87,41.088],[88,93,41.494]]],["Was ein Programm nicht verspricht, schützt dich, nicht den Anbieter.",42.702,46.115,[[0,3,42.702],[4,7,42.934],[8,16,43.05],[17,22,43.468],[23,34,43.7],[35,42,44.269],[43,48,44.629],[49,54,45.116],[55,58,45.337],[59,68,45.5]]],["Ein Programm ohne Rendite-Werbung hat nur ein Interesse: dass du es verstehst.",46.928,51.502,[[0,3,46.928],[4,12,47.113],[13,17,47.624],[18,33,47.903],[34,37,48.681],[38,41,48.843],[42,45,49.052],[46,56,49.296],[57,61,50.039],[62,64,50.26],[65,67,50.411],[68,78,50.562]]]]}