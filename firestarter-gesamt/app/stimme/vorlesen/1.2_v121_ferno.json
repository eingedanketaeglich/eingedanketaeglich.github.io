{"s":[["Der stille Motor: einfacher Zins vs.",0.0,2.914,[[0,3,0.0],[4,10,0.255],[11,17,0.557],[18,27,1.579],[28,32,2.113],[33,36,2.589]]],["Zinseszins",2.937,3.611,[[0,10,2.937]]],["Zwei Wörter, ein winziger Unterschied, riesige Wirkung über die Zeit.",4.505,9.056,[[0,4,4.505],[5,12,4.923],[13,16,5.735],[17,25,5.979],[26,38,6.49],[39,46,7.407],[47,54,7.883],[55,59,8.278],[60,63,8.452],[64,69,8.58]]],["Einfacher Zins",9.718,10.612,[[0,9,9.718],[10,14,10.263]]],["Du entnimmst den Zins jedes Jahr.",11.366,13.224,[[0,2,11.366],[3,12,11.587],[13,16,11.935],[17,21,12.132],[22,27,12.504],[28,33,12.817]]],["Das Kapital bleibt gleich.",13.444,15.081,[[0,3,13.444],[4,11,13.653],[12,18,14.187],[19,26,14.524]]],["Es wächst in einer geraden Linie.",15.732,17.67,[[0,2,15.732],[3,9,15.975],[10,12,16.3],[13,18,16.451],[19,26,16.718],[27,33,17.171]]],["Zinseszins",18.332,19.04,[[0,10,18.332]]],["Du lässt den Zins liegen.",19.702,20.979,[[0,2,19.702],[3,8,19.888],[9,12,20.085],[13,17,20.259],[18,25,20.584]]],["Zins wird auf Kapital und auf frühere Zinsen gezahlt.",21.211,24.137,[[0,4,21.211],[5,9,21.525],[10,13,21.699],[14,21,21.861],[22,25,22.511],[26,29,22.697],[30,37,22.848],[38,44,23.231],[45,53,23.568]]],["Es wächst gekrümmt (exponentiell).",24.334,26.47,[[0,2,24.334],[3,9,24.52],[10,18,24.787],[19,34,25.333]]],["Das Endkapital nach n Jahren ergibt sich aus Startkapital K₀ und Zinssatz i:",26.958,32.125,[[0,3,26.958],[4,14,27.19],[15,19,27.817],[20,21,28.015],[22,28,28.189],[29,35,28.618],[36,40,28.955],[41,44,29.152],[45,57,29.315],[58,60,30.186],[61,64,30.975],[65,73,31.219],[74,76,31.788]]],["Rechnen wir es mit 10.000 € und 7 % (historische Lehrannahme):",32.542,36.954,[[0,7,32.542],[8,11,32.937],[12,14,33.111],[15,18,33.274],[19,25,33.425],[26,27,34.121],[28,31,34.458],[32,33,34.644],[34,35,34.957],[36,48,35.456],[49,62,36.246]]],["Jahr 1 → 10.700 €.",37.175,39.578,[[0,4,37.175],[5,6,37.465],[7,8,37.778],[9,15,37.883],[16,18,39.171]]],["Jahr 2 → 11.449 €, nicht glatt 11.400 