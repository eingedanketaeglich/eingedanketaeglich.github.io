{"s":[["Die drei Leitbegriffe, dein Dreieck",0.0,2.403,[[0,3,0.0],[4,8,0.255],[9,22,0.511],[23,27,1.509],[28,35,1.846]]],["Das ganze Programm steht auf drei Begriffen, mit R&F in der Mitte.",2.786,6.676,[[0,3,2.786],[4,9,3.03],[10,18,3.367],[19,24,3.82],[25,28,4.098],[29,33,4.249],[34,44,4.505],[45,48,5.236],[49,52,5.457],[53,55,5.991],[56,59,6.095],[60,66,6.246]]],["Du kannst nichts steuern, was du nicht verstehst.",6.803,9.462,[[0,2,6.803],[3,9,6.966],[10,16,7.326],[17,25,7.628],[26,29,8.115],[30,32,8.359],[33,38,8.487],[39,49,8.684]]],["Solange Geld, Zinsen und Börse eine Black Box sind, entscheiden andere.",9.741,13.944,[[0,7,9.741],[8,13,10.194],[14,20,10.693],[21,24,11.157],[25,30,11.296],[31,35,11.749],[36,41,11.981],[42,45,12.225],[46,51,12.504],[52,63,12.852],[64,71,13.41]]],["Wissen allein füllt kein Depot.",14.223,16.022,[[0,6,14.223],[7,13,14.571],[14,19,14.989],[20,24,15.267],[25,31,15.546]]],["Es wird erst wertvoll, wenn es in Handlung übergeht.",16.231,18.716,[[0,2,16.231],[3,7,16.428],[8,12,16.603],[13,22,16.812],[23,27,17.357],[28,30,17.508],[31,33,17.647],[34,42,17.752],[43,52,18.123]]],["Nicht reich werden um des Reichtums willen, sondern frei werden in deinen Entscheidungen.",19.041,23.696,[[0,5,19.041],[6,11,19.319],[12,18,19.621],[19,21,19.935],[22,25,20.051],[26,35,20.213],[36,43,20.724],[44,51,21.258],[52,56,21.606],[57,63,21.897],[64,66,22.257],[67,73,22.454],[74,89,22.895]]],["Drei Leitbegriffe – dein erster Baustein",24.079,26.599,[[0,4,24.079],[5,17,24.381],[18,19,25.229],[20,24,25.368],[25,31,25.624],[32,40,26.041]]],["Finanzwissen führt zu Selbstbestimmung, und beides zusammen führt zu Vermögensaufbau.",27.202,31.893,[[0,12,27.202],[13,18,27.992],[19,21,28.224],[22,39,28.375],[40,43,29.258],[44,50,29.467],[51,59,29.885],[60,65,30.384],[66,68,30.628],[69,85,30.767]]],["Der Funke gehört dir, nicht dem Berater.",32.218,34.714,[[0,3,32.218],[4,9,32.404],[10,16,32.729],[17,21,33.031],[22,27,33.588],[28,31,33.855],[32,40,34.006]]],["Ein Feuer, das du selbst entfacht hast, kann dir niemand mehr ausreden.",35.04,38.871,[[0,3,35.04],[4,10,35.26],[11,14,35.608],[15,17,35.806],[18,24,35.945],[25,33,36.27],[34,39,36.711],[40,44,37.106],[45,48,37.303],[49,56,37.454],[57,61,37.814],[62,71,37.977]]]]}