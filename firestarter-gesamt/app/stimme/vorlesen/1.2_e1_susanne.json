{"s":[["Der stille Saboteur, den niemand zeigt",0.0,2.914,[[0,3,0.0],[4,10,0.383],[11,20,0.766],[21,24,1.567],[25,32,1.834],[33,38,2.426]]],["Er nimmt dir nichts, er verhindert, dass etwas entsteht.",3.239,6.397,[[0,2,3.239],[3,8,3.425],[9,12,3.646],[13,20,3.82],[21,23,4.563],[24,35,4.714],[36,40,5.283],[41,46,5.492],[47,56,5.77]]],["Stell dir vor, jemand bremst dich aus, aber nicht in deiner Tasche, sondern in deiner Zukunft.",6.676,12.167,[[0,5,6.676],[6,9,6.931],[10,14,7.105],[15,21,7.396],[22,28,7.732],[29,33,8.092],[34,38,8.313],[39,43,9.079],[44,49,9.358],[50,52,9.601],[53,59,9.694],[60,67,9.985],[68,75,10.623],[76,78,11.018],[79,85,11.111],[86,94,11.389]]],["Du merkst es nicht, weil das Geld nie auf deinem Konto war.",12.446,15.661,[[0,2,12.446],[3,9,12.655],[10,12,13.061],[13,19,13.224],[20,24,13.56],[25,28,13.735],[29,33,13.92],[34,37,14.211],[38,41,14.454],[42,48,14.605],[49,54,14.895],[55,59,15.244]]],["Es hätte dort sein können.",15.836,17.287,[[0,2,15.836],[3,8,16.045],[9,13,16.3],[14,18,16.521],[19,26,16.811]]],["Es kam nur nie an.",17.496,18.982,[[0,2,17.496],[3,6,17.716],[7,10,17.972],[11,14,18.216],[15,18,18.529]]],["Wir nennen ihn den stillen Saboteur.",19.156,21.641,[[0,3,19.156],[4,10,19.423],[11,14,19.806],[15,18,20.073],[19,26,20.317],[27,36,20.816]]],["Und um ihn zu verstehen, musst du zuerst den stillen Motor kennen, an dem er sabotiert: den Zinseszins.",21.884,28.351,[[0,3,21.884],[4,6,22.175],[7,10,22.326],[11,13,22.453],[14,24,22.604],[25,30,23.115],[31,33,23.359],[34,40,23.545],[41,44,24.009],[45,52,24.23],[53,58,24.648],[59,66,25.1],[67,69,25.495],[70,73,25.634],[74,76,25.843],[77,87,25.948],[88,91,26.923],[92,103,27.225]]],["Stell ihn dir wie einen Marathonläufer vor, seine ganze Kraft steckt nicht in der Geschwindigkeit, sondern darin, dass er nicht aufhört.",28.63,36.536,[[0,5,28.63],[6,9,28.978],[10,13,29.117],[14,17,29.338],[18,23,29.524],[24,38,29.791],[39,43,30.662],[44,49,31.219],[50,55,31.521],[56,61,31.95],[62,68,32.333],[69,74,32.682],[75,77,32.949],[78,81,33.042],[82,98,33.181],[99,106,34.33],[107,113,34.818],[114,118,35.259],[119,121,35.48],[122,127,35.573],[128,136,35.863]]],["Keine Sorge vor der Mathematik:",36.815,38.533,[[0,5,36.815],[6,11,37.175],[12,15,37.477],[16,19,37.628],[20,31,37.744]]],["Wir rechnen alles gemeinsam und Schritt für Schritt.",38.742,41.575,[[0,3,38.742],[4,11,38.94],[12,17,39.381],[18,27,39.694],[28,31,40.402],[32,39,40.6],[40,43,40.913],[44,52,41.087]]],["Du brauchst nur die vier Grundrechenarten.",41.819,44.164,[[0,2,41.819],[3,11,41.981],[12,15,42.353],[16,19,42.608],[20,24,42.759],[25,42,43.026]]],["Wie werden aus 10.000 € rund 58.000 €, allein durch Nichtaufhören?",44.373,50.41,[[0,3,44.373],[4,10,44.57],[11,14,44.919],[15,21,45.209],[22,23,45.964],[24,28,46.358],[29,35,46.683],[36,38,48.03],[39,45,48.657],[46,51,49.087],[52,66,49.354]]],["Warum ist Stillstand oft teurer als ein zwischenzeitlicher Verlust?",50.689,54.311,[[0,5,50.689],[6,9,51.037],[10,20,51.223],[21,24,51.815],[25,31,52.036],[32,35,52.558],[36,39,52.779],[40,58,52.918],[59,67,53.707]]],["Warum steht diese Rechnung in keinem Hochglanz-Prospekt?",54.52,57.922,[[0,5,54.52],[6,11,54.926],[12,17,55.217],[18,26,55.495],[27,29,55.983],[30,36,56.157],[37,56,56.656]]],["Zwei Schritte weiter wartet der Zinseszins-Rechner.",58.201,61.219,[[0,4,58.201],[5,13,58.502],[14,20,58.827],[21,27,59.234],[28,31,59.628],[32,51,59.849]]],["Gib dort eine eigene Zahl ein, zum Beispiel den Betrag, den du im Monat übrig hättest, und schau, was die Kontinuität über die Jahre daraus macht.",61.544,69.566,[[0,3,61.544],[4,8,61.776],[9,13,61.997],[14,20,62.206],[21,25,62.635],[26,30,63.007],[31,34,63.274],[35,43,63.471],[44,47,63.889],[48,55,64.11],[56,59,64.539],[60,62,64.714],[63,65,64.853],[66,71,64.946],[72,77,65.352],[78,86,65.666],[87,90,66.397],[91,97,66.571],[98,101,66.931],[102,105,67.152],[106,117,67.291],[118,122,68.162],[123,126,68.359],[127,132,68.475],[133,139,68.765],[140,146,69.09]]],["Eine Lehrannahme, kein Versprechen.",69.845,72.121,[[0,4,69.845],[5,17,70.112],[18,22,71.041],[23,35,71.343]]],["Das Schlimmste, das passieren kann?",72.364,74.361,[[0,3,72.364],[4,15,72.573],[16,19,73.247],[20,29,73.479],[30,35,73.943]]],["Nichts.",74.686,75.29,[[0,7,74.686]]],["Kein Geld bewegt sich, keine Entscheidung fällt.",75.499,78.204,[[0,4,75.499],[5,9,75.813],[10,16,76.068],[17,22,76.474],[23,28,76.776],[29,41,77.067],[42,48,77.589]]]]}