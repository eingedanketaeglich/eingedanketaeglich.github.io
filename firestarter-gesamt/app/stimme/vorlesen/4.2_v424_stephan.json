61,[[0,4,37.767],[5,12,38.069]]],["Korb − Gebühr",38.812,40.135,[[0,4,38.812],[5,6,39.462],[7,13,39.613]]],["Wer verdient noch?",40.577,41.61,[[0,3,40.577],[4,12,40.774],[13,18,41.145]]],["Anbieter (klein)",41.819,43.247,[[0,8,41.819],[9,16,42.434]]],["Schau auf die letzte Zeile:",43.398,44.791,[[0,5,43.398],[6,9,43.665],[10,13,43.792],[14,20,43.897],[21,27,44.257]]],["Manche verdienen nicht nur, wenn du verdienst, sie verdienen immer, über die laufende Gebühr, Jahr für Jahr.",44.965,51.13,[[0,6,44.965],[7,16,45.313],[17,22,45.755],[23,27,45.964],[28,32,46.207],[33,35,46.347],[36,46,46.451],[47,50,47.206],[51,60,47.368],[61,67,47.891],[68,72,48.355],[73,76,48.564],[77,85,48.703],[86,93,49.214],[94,98,49.992],[99,102,50.375],[103,108,50.584]]],["Die laufende, prozentuale Gebühr ist eine Gestalt des stillen Saboteurs aus Baustein 1: klein im Jahr, groß über die Zeit.",51.281,59.129,[[0,3,51.281],[4,13,51.455],[14,25,51.989],[26,32,52.662],[33,36,53.092],[37,41,53.208],[42,49,53.394],[50,53,53.951],[54,61,54.149],[62,71,54.566],[72,75,55.321],[76,84,55.6],[85,87,56.064],[88,93,56.888],[94,96,57.225],[97,102,57.364],[103,107,57.852],[108,112,58.247],[113,116,58.409],[117,122,58.549]]],["Das ist keine Aussage gegen ETFs (R&F nutzt sie selbst), sondern gegen das Wegschauen.",59.245,65.155,[[0,3,59.245],[4,7,59.431],[8,13,59.559],[14,21,59.803],[22,27,60.29],[28,32,60.604],[33,37,61.498],[38,43,62.09],[44,47,62.392],[48,56,62.519],[57,64,63.309],[65,70,63.692],[71,74,64.017],[75,86,64.307]]],["Drei Sätze zum Mitnehmen",65.329,66.606,[[0,4,65.329],[5,10,65.631],[11,14,65.968],[15,24,66.13]]],["Jede Wertpapierart hat eine Rolle.",66.931,68.673,[[0,4,66.931],[5,18,67.233],[19,22,67.953],[23,27,68.092],[28,34,68.255]]],["Eigentümer (Aktie), Gläubiger (Anleihe), Korb-Anteil (Fonds/ETF), und einen Ertrag.",68.766,75.976,[[0,10,68.766],[11,19,69.567],[20,29,70.496],[30,40,71.262],[41,52,72.284],[53,65,73.178],[66,69,74.907],[70,75,75.105],[76,83,75.395]]],["Aktiv = ein Manager wählt aus (teurer); ETF/passiv = ein Index-Rezept (günstiger).",76.219,83.139,[[0,5,76.219],[6,7,76.939],[8,11,77.229],[12,19,77.38],[20,25,77.775],[26,29,78.031],[30,39,78.565],[40,50,79.308],[51,52,80.666],[53,56,80.91],[57,69,81.177],[70,82,82.326]]],["Sondervermögen schützt vor Anbieter-Pleite, nicht vor fallenden Kursen.",83.313,87.087,[[0,14,83.313],[15,22,84.045],[23,26,84.44],[27,43,84.649],[44,49,85.531],[50,53,85.786],[54,63,86.088],[64,71,86.634]]],["Die entscheidende Frage ist „Wer verdient noch mit?“, die laufende Gebühr ist der stille Saboteur: klein im Jahr, groß über die Zeit.",87.11,95.574,[[0,3,87.11],[4,17,87.272],[18,23,87.76],[24,27,88.108],[28,32,88.503],[33,41,89.072],[42,46,89.409],[47,53,89.583],[54,57,90.303],[58,66,90.465],[67,73,90.813],[74,77,91.324],[78,81,91.487],[82,88,91.673],[89,98,91.998],[99,104,92.845],[105,107,93.275],[108,113,93.414],[114,118,94.087],[119,123,94.552],[124,127,94.738],[128,133,94.889]]]]}