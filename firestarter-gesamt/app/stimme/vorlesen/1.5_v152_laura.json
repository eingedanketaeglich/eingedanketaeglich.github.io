{"s":[["Deine drei Nordsterne als Zielkoordinaten",0.0,2.786,[[0,5,0.0],[6,10,0.372],[11,21,0.65],[22,25,1.416],[26,41,1.765]]],["Je eine Aussage, die in 12 Monaten wahr sein soll.",3.599,6.536,[[0,2,3.599],[3,7,3.831],[8,16,4.04],[17,20,4.574],[21,23,4.714],[24,26,4.83],[27,34,5.201],[35,39,5.654],[40,44,5.863],[45,50,6.095]]],["„Ich verstehe meine Geldentscheidungen und kann gute von schlechten Ratschlägen unterscheiden.“",6.861,11.54,[[0,4,6.861],[5,13,7.117],[14,19,7.523],[20,38,7.755],[39,42,8.707],[43,47,8.858],[48,52,9.091],[53,56,9.427],[57,67,9.625],[68,79,10.043],[80,95,10.6]]],["„Ich baue ununterbrochen auf.",12.144,14.013,[[0,4,12.144],[5,9,12.492],[10,24,12.806],[25,29,13.595]]],["Der Lauf wird nicht unterbrochen - ich handle bewusst, egal was der Markt macht.“",14.129,18.46,[[0,3,14.129],[4,8,14.303],[9,13,14.547],[14,19,14.733],[20,32,14.954],[33,34,15.697],[35,38,15.871],[39,45,16.057],[46,54,16.335],[55,59,16.985],[60,63,17.345],[64,67,17.519],[68,73,17.647],[74,81,17.937]]],["„Ich bin nicht beratungsresistent, kann aber meine Entscheidungen selbst treffen und begründen.“",18.785,24.033,[[0,4,18.785],[5,8,19.133],[9,14,19.331],[15,34,19.609],[35,39,20.968],[40,44,21.246],[45,50,21.502],[51,65,21.734],[66,72,22.314],[73,80,22.628],[81,84,22.999],[85,96,23.115]]],["Die meisten kennen ihren Kontostand, aber nicht ihr Wofür.",24.845,28.282,[[0,3,24.845],[4,11,25.031],[12,18,25.484],[19,24,25.786],[25,36,26.041],[37,41,26.958],[42,47,27.237],[48,51,27.481],[52,58,27.608]]],["Der Brief dreht das um: erst die Richtung, dann die Zahl.",28.723,32.322,[[0,3,28.723],[4,9,28.92],[10,15,29.199],[16,19,29.42],[20,23,29.745],[24,28,30.29],[29,32,30.523],[33,42,30.65],[43,47,31.277],[48,51,31.509],[52,57,31.672]]]]}