{"s":[["Deine drei Nordsterne als Zielkoordinaten",0.0,3.135,[[0,5,0.0],[6,10,0.372],[11,21,0.755],[22,25,1.533],[26,41,1.834]]],["Je eine Aussage, die in 12 Monaten wahr sein soll.",3.646,6.722,[[0,2,3.646],[3,7,3.889],[8,16,4.122],[17,20,4.69],[21,23,4.83],[24,26,4.934],[27,34,5.248],[35,39,5.747],[40,44,6.014],[45,50,6.269]]],["„Ich verstehe meine Geldentscheidungen und kann gute von schlechten Ratschlägen unterscheiden.“",7.047,11.923,[[0,4,7.047],[5,13,7.338],[14,19,7.732],[20,38,7.953],[39,42,8.928],[43,47,9.102],[48,52,9.323],[53,56,9.764],[57,67,9.973],[68,79,10.495],[80,95,11.076]]],["„Ich baue ununterbrochen auf.",12.527,14.42,[[0,4,12.527],[5,9,12.829],[10,24,13.142],[25,29,13.909]]],["Der Lauf wird nicht unterbrochen - ich handle bewusst, egal was der Markt macht.“",14.629,19.249,[[0,3,14.629],[4,8,14.849],[9,13,15.151],[14,19,15.372],[20,32,15.65],[33,34,16.475],[35,38,16.684],[39,45,16.869],[46,54,17.194],[55,59,17.775],[60,63,18.205],[64,67,18.379],[68,73,18.506],[74,81,18.773]]],["„Ich bin nicht beratungsresistent, kann aber meine Entscheidungen selbst treffen und begründen.“",19.493,25.043,[[0,4,19.493],[5,8,19.853],[9,14,20.027],[15,34,20.294],[35,39,21.595],[40,44,21.838],[45,50,22.036],[51,65,22.303],[66,72,22.907],[73,80,23.371],[81,84,23.951],[85,96,24.265]]],["Die meisten kennen ihren Kontostand, aber nicht ihr Wofür.",25.287,29.025,[[0,3,25.287],[4,11,25.461],[12,18,25.902],[19,24,26.285],[25,36,26.587],[37,41,27.609],[42,47,27.887],[48,51,28.178],[52,58,28.328]]],["Der Brief dreht das um: erst die Richtung, dann die Zahl.",29.35,33.948,[[0,3,29.35],[4,9,29.606],[10,15,29.989],[16,19,30.279],[20,23,30.604],[24,28,31.37],[29,32,31.788],[33,42,31.997],[43,47,32.74],[48,51,33.054],[52,57,33.239]]]]}