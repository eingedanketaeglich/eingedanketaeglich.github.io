{"s":[["Deine Frage für unsere Präsenzveranstaltungen",0.0,2.485,[[0,5,0.0],[6,11,0.418],[12,15,0.848],[16,22,1.022],[23,45,1.265]]],["…wir greifen sie in einer kommenden Präsenzveranstaltung (auch für Online-Teilnehmer) auf und verarbeiten sie im Aufbau unserer Q&A-Videothek.",2.601,12.179,[[0,4,2.601],[5,12,3.831],[13,16,4.261],[17,19,4.447],[20,25,4.586],[26,35,4.841],[36,56,5.329],[57,62,6.583],[63,66,7.129],[67,85,7.326],[86,89,8.162],[90,93,8.87],[94,105,9.091],[106,109,9.729],[110,112,9.857],[113,119,10.019],[120,127,10.519],[128,142,10.82]]],["Was du aus dieser Lektion mitnimmst",12.562,14.315,[[0,3,12.562],[4,6,12.806],[7,10,12.922],[11,17,13.073],[18,25,13.34],[26,35,13.793]]],["Dein Werkzeug: die klare Trennung von Bildung und Beratung plus dein Kurz-Check, ob für dich Bildung reicht oder ein Berater sich lohnt.",15.615,24.346,[[0,4,15.615],[5,14,15.952],[15,18,17.078],[19,24,17.252],[25,33,17.67],[34,37,18.065],[38,45,18.274],[46,49,18.657],[50,58,18.773],[59,63,19.655],[64,68,19.992],[69,80,20.201],[81,83,21.246],[84,87,21.455],[88,92,21.571],[93,100,21.745],[101,107,22.082],[108,112,22.779],[113,116,23.092],[117,124,23.22],[125,129,23.649],[130,136,23.847]]],["Nimm es mit, du wendest es in den nächsten Lektionen wieder an.",24.95,28.433,[[0,4,24.95],[5,7,25.182],[8,12,25.333],[13,15,25.902],[16,23,26.076],[24,26,26.471],[27,29,26.621],[30,33,26.714],[34,42,26.854],[43,52,27.248],[53,59,27.771],[60,63,28.026]]],["Für dich gebaut:",29.129,30.162,[[0,3,29.129],[4,8,29.303],[9,16,29.477]]],["Du sammelst hier nicht auf eigene Faust Wissen zusammen, sondern wirst Schritt für Schritt geführt, jede Lektion baut auf der vorigen auf, und der Selbsttest zeigt dir genau, wo du gerade stehst.",30.406,41.204,[[0,2,30.406],[3,11,30.592],[12,16,31.01],[17,22,31.173],[23,26,31.428],[27,33,31.602],[34,39,31.939],[40,46,32.287],[47,56,32.566],[57,64,33.332],[65,70,33.646],[71,78,33.901],[79,82,34.226],[83,90,34.377],[91,99,34.656],[100,104,35.642],[105,112,35.909],[113,117,36.455],[118,121,36.711],[122,125,36.838],[126,133,36.978],[134,138,37.407],[139,142,38.208],[143,146,38.348],[147,157,38.487],[158,163,39.137],[164,167,39.381],[168,174,39.497],[175,177,39.996],[178,180,40.17],[181,187,40.275],[188,195,40.623]]],["Wo es persönlich wird:",41.645,42.91,[[0,2,41.645],[3,5,41.819],[6,16,41.947],[17,22,42.492]]],["Deine konkrete Frage bleibt nicht offen, in den Q&A-Aufzeichnungen zu häufigen Themen hat sie einen festen Platz.",43.293,49.888,[[0,5,43.293],[6,14,43.572],[15,20,44.059],[21,27,44.443],[28,33,44.744],[34,40,44.977],[41,43,45.65],[44,47,45.801],[48,66,45.952],[67,69,47.194],[70,78,47.334],[79,85,47.775],[86,89,48.39],[90,93,48.611],[94,99,48.727],[100,106,48.959],[107,113,49.377]]],["Hier bist du kein Lernender unter vielen, sondern wirst gehört.",50.491,53.87,[[0,4,50.491],[5,9,50.712],[10,12,50.886],[13,17,51.002],[18,27,51.223],[28,33,51.687],[34,41,51.908],[42,49,52.558],[50,55,52.871],[56,63,53.104]]]]}