{"s":[["Der Berater meint es gut, und macht dich trotzdem abhängig",0.0,2.902,[[0,3,0.0],[4,11,0.209],[12,17,0.58],[18,20,0.755],[21,25,0.859],[26,29,1.44],[30,35,1.556],[36,40,1.741],[41,49,1.974],[50,58,2.45]]],["Anlageberatung ist, nüchtern betrachtet, ein Geschäftsmodell.",3.146,7.57,[[0,14,3.146],[15,19,4.261],[20,28,4.807],[29,40,5.364],[41,44,6.316],[45,61,6.536]]],["Und es lebt von einer Lücke.",8.011,9.578,[[0,3,8.011],[4,6,8.185],[7,11,8.29],[12,15,8.522],[16,21,8.696],[22,28,8.963]]],["Die Wissens-Lücke",9.903,11.041,[[0,3,9.903],[4,17,10.124]]],["Du weißt weniger als der Berater, genau dieser Abstand ist sein Wert.",11.424,15.43,[[0,2,11.424],[3,8,11.645],[9,16,12.028],[17,20,12.388],[21,24,12.527],[25,33,12.655],[34,39,13.189],[40,46,13.56],[47,54,13.862],[55,58,14.385],[59,63,14.699],[64,69,14.919]]],["Schließt sich die Lücke, braucht man ihn weniger.",15.581,18.298,[[0,8,15.581],[9,13,15.929],[14,17,16.115],[18,24,16.231],[25,32,16.73],[33,36,17.137],[37,40,17.346],[41,49,17.543]]],["Das fertige Produkt",18.739,19.83,[[0,3,18.739],[4,11,18.948],[12,19,19.331]]],["Oft steht am Ende ein Produkt, das ohnehin verkauft werden soll.",20.271,23.754,[[0,3,20.271],[4,9,20.736],[10,12,21.015],[13,17,21.131],[18,21,21.363],[22,30,21.491],[31,34,22.025],[35,42,22.303],[43,51,22.698],[52,58,23.151],[59,64,23.406]]],["Die Frage ist nicht ob, sondern welches.",23.963,26.715,[[0,3,23.963],[4,9,24.126],[10,13,24.439],[14,19,24.579],[20,23,24.915],[24,31,25.403],[32,40,25.902]]],["Abgegebene Verantwortung",26.866,28.329,[[0,10,26.866],[11,24,27.563]]],["Du delegierst die Entscheidung, und damit das Verstehen.",28.933,31.637,[[0,2,28.933],[3,13,29.292],[14,17,29.884],[18,31,30.012],[32,35,30.523],[36,41,30.639],[42,45,30.894],[46,56,31.068]]],["Bequem heute, teuer auf Dauer.",31.881,34.099,[[0,6,31.881],[7,13,32.427],[14,19,32.914],[20,23,33.344],[24,30,33.599]]],["Das Problem ist nicht der schlechte Berater, es ist das gute Modell.",34.377,37.744,[[0,3,34.377],[4,11,34.563],[12,15,35.016],[16,21,35.132],[22,25,35.341],[26,35,35.48],[36,44,35.863],[45,47,36.432],[48,51,36.56],[52,55,36.688],[56,60,36.862],[61,68,37.14]]],["Selbst ein ehrlicher, kompetenter Berater arbeitet in einem System, das von deiner Unwissenheit lebt.",38.069,44.397,[[0,6,38.069],[7,10,38.394],[11,21,38.592],[22,33,39.219],[34,41,39.904],[42,50,40.542],[51,53,41.053],[54,59,41.158],[60,67,41.39],[68,71,42.226],[72,75,42.435],[76,82,42.574],[83,95,42.934],[96,101,43.735]]]]}