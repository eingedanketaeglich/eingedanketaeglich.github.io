{"s":[["Die Aktie, ein Stück Eigentum",0.0,2.287,[[0,3,0.0],[4,10,0.244],[11,14,1.242],[15,20,1.428],[21,29,1.753]]],["Gibst du dem Bäcker 100 € und dir gehört dafür ein winziges Stück von allem, hast du ihm Geld geliehen?",3.587,9.23,[[0,5,3.587],[6,8,3.889],[9,12,4.005],[13,19,4.156],[20,23,4.493],[24,25,5.016],[26,29,5.433],[30,33,5.596],[34,40,5.735],[41,46,6.037],[47,50,6.397],[51,59,6.525],[60,65,6.978],[66,69,7.233],[70,76,7.419],[77,81,7.953],[82,84,8.162],[85,88,8.266],[89,93,8.417],[94,103,8.673]]],["Nein.",10.182,10.658,[[0,5,10.182]]],["Du bist Mit-Eigentümer.",10.983,12.446,[[0,2,10.983],[3,7,11.18],[8,23,11.447]]],["Genau das ist eine Aktie: ein Eigentumsanteil.",13.142,16.544,[[0,5,13.142],[6,9,13.56],[10,13,13.827],[14,18,13.99],[19,25,14.199],[26,29,15.186],[30,46,15.453]]],["Als Eigentümer profitierst du auf zwei Wegen:",17.357,19.864,[[0,3,17.357],[4,14,17.67],[15,26,18.181],[27,29,18.715],[30,33,18.854],[34,38,19.017],[39,45,19.365]]],["Dividende",20.189,20.851,[[0,9,20.189]]],["dein Anteil am ausgeschütteten Gewinn",21.095,23.231,[[0,4,21.095],[5,11,21.467],[12,14,21.943],[15,30,22.14],[31,37,22.883]]],["Wertsteigerung",24.044,24.868,[[0,14,24.044]]],["wollen mehr Leute ein Stück, steigt der Preis deines Anteils",25.193,28.502,[[0,6,25.193],[7,11,25.565],[12,17,25.785],[18,21,26.099],[22,28,26.215],[29,35,26.912],[36,39,27.248],[40,45,27.376],[46,52,27.701],[53,60,27.991]]],["Beide Wege haben eine Kehrseite:",29.617,31.498,[[0,5,29.617],[6,10,29.965],[11,16,30.255],[17,21,30.522],[22,32,30.731]]],["Läuft das Unternehmen schlecht, fällt die Dividende aus und der Wert kann sinken.",31.939,35.991,[[0,5,31.939],[6,9,32.229],[10,21,32.391],[22,31,32.798],[32,37,33.599],[38,41,33.843],[42,51,33.948],[52,55,34.47],[56,59,34.749],[60,63,34.865],[64,68,35.016],[69,73,35.283],[74,81,35.492]]],["Als Eigentümer trägst du das unternehmerische Risiko mit, du sitzt im selben Boot.",36.502,40.96,[[0,3,36.502],[4,14,36.78],[15,21,37.361],[22,24,37.663],[25,28,37.756],[29,45,37.941],[46,52,38.65],[53,57,39.102],[58,60,39.66],[61,66,39.834],[67,69,40.089],[70,76,40.217],[77,82,40.53]]],["Eine Aktie ist kein Papier mit hüpfenden Zahlen, sondern ein Eigentumstitel mit Stimmrecht.",41.564,46.66,[[0,4,41.564],[5,10,41.9],[11,14,42.307],[15,19,42.516],[20,26,42.736],[27,30,43.119],[31,40,43.27],[41,48,43.793],[49,56,44.501],[57,60,44.849],[61,75,45.023],[76,79,45.836],[80,91,45.964]]],["Du bist nicht Kunde des Marktes, sondern Teilhaber an echter Wirtschaft, einen garantierten Ertrag gibt es dafür nicht.",47.357,54.056,[[0,2,47.357],[3,7,47.52],[8,13,47.717],[14,19,47.891],[20,23,48.193],[24,32,48.367],[33,40,49.168],[41,50,49.551],[51,53,50.085],[54,60,50.224],[61,72,50.526],[73,78,51.571],[79,91,51.861],[92,98,52.477],[99,103,52.883],[104,106,53.127],[107,112,53.231],[113,119,53.498]]]]}