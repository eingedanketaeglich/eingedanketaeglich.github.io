{"s":[["Wo stehst du, und wo willst du hin?",0.0,2.45,[[0,2,0.0],[3,9,0.418],[10,13,0.755],[14,17,1.219],[18,20,1.44],[21,27,1.591],[28,30,1.846],[31,35,2.009]]],["Bevor man eine Route plant, braucht man zwei Punkte: wo man ist und wo man hin will.",2.775,8.197,[[0,5,2.775],[6,9,3.123],[10,14,3.309],[15,20,3.553],[21,27,3.878],[28,35,4.319],[36,39,4.656],[40,44,4.888],[45,52,5.283],[53,55,6.084],[56,59,6.258],[60,63,6.49],[64,67,7.012],[68,70,7.21],[71,74,7.361],[75,78,7.523],[79,84,7.744]]],["Du arbeitest mit den drei Leitbegriffen aus Lektion 1.1.",8.44,12.492,[[0,2,8.44],[3,12,8.673],[13,16,9.311],[17,20,9.451],[21,25,9.625],[26,39,9.915],[40,43,10.693],[44,51,10.948],[52,56,11.471]]],["Finanzwissen, Selbstbestimmung, Vermögensaufbau.",12.736,15.766,[[0,13,12.736],[14,31,13.642],[32,48,14.536]]],["Diesmal ganz persönlich.",16.045,17.716,[[0,7,16.045],[8,12,16.637],[13,24,16.95]]],["Keine Prüfung, keine Note, die Grundlage für deinen Zukunftsbrief in 1.5.",17.891,23.15,[[0,5,17.891],[6,14,18.216],[15,20,18.877],[21,26,19.226],[27,30,19.899],[31,40,20.096],[41,44,20.781],[45,51,20.932],[52,65,21.223],[66,68,22.163],[69,73,22.314]]],["Wie hängen die drei Leitbegriffe zusammen?",23.475,25.774,[[0,3,23.475],[4,10,23.719],[11,14,24.021],[15,19,24.148],[20,32,24.427],[33,42,25.17]]],["Warum ist eine niedrige Zahl heute kein schlechtes Zeugnis?",26.018,29.338,[[0,5,26.018],[6,9,26.494],[10,14,26.679],[15,23,26.9],[24,28,27.399],[29,34,27.689],[35,39,28.014],[40,50,28.247],[51,59,28.676]]],["Was sagt der Abstand zwischen Heute und Ziel über dich aus?",29.582,32.995,[[0,3,29.582],[4,8,29.779],[9,12,30.0],[13,20,30.151],[21,29,30.638],[30,35,31.056],[36,39,31.497],[40,44,31.694],[45,49,32.031],[50,54,32.228],[55,59,32.437]]],["In Lektion 1.1 hast du die drei Leitbegriffe kennengelernt:",33.378,37.917,[[0,2,33.378],[3,10,33.622],[11,14,34.249],[15,19,35.514],[20,22,35.769],[23,26,35.909],[27,31,36.048],[32,44,36.373],[45,59,37.093]]],["Finanzwissen ist die Grundlage, Selbstbestimmung der Sinn und Vermögensaufbau das Ziel, zusammen bilden sie ein Dreieck mit R&F in der Mitte.",38.196,47.345,[[0,12,38.196],[13,16,39.09],[17,20,39.264],[21,31,39.427],[32,48,40.646],[49,52,41.493],[53,57,41.632],[58,61,41.969],[62,77,42.19],[78,81,43.177],[82,87,43.397],[88,96,44.094],[97,103,44.628],[104,107,44.918],[108,111,45.057],[112,119,45.197],[120,123,45.766],[124,127,45.975],[128,130,46.555],[131,134,46.648],[135,141,46.799]]],["Dort ging es allgemein um das Prinzip; hier setzt du dieselben drei Begriffe nun ganz persönlich für deinen eigenen Standort ein.",47.624,55.077,[[0,4,47.624],[5,9,47.937],[10,12,48.134],[13,22,48.274],[23,25,48.796],[26,29,48.912],[30,38,49.098],[39,43,50.062],[44,49,50.352],[50,52,50.642],[53,62,50.793],[63,67,51.234],[68,76,51.524],[77,80,51.977],[81,85,52.186],[86,96,52.511],[97,100,53.161],[101,107,53.324],[108,115,53.684],[116,124,54.172],[125,129,54.706]]],["„Eine niedrige Zahl heute ist dein Startkapital, kein Urteil.“",55.286,59.071,[[0,5,55.286],[6,14,55.716],[15,19,56.192],[20,25,56.505],[26,29,56.877],[30,34,57.028],[35,48,57.225],[49,53,58.049],[54,62,58.328]]]]}