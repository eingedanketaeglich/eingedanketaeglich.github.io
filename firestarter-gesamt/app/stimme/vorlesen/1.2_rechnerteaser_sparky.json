{"s":[["Der Zinseszins-Rechner, dein Werkzeug",0.0,2.566,[[0,3,0.0],[4,23,0.267],[24,28,1.649],[29,37,1.95]]],["Genau diesen Rechner bekommst du in die Hand, aber erst, wenn du selbst geschätzt hast statt einfach abzulesen.",3.68,10.658,[[0,5,3.68],[6,12,4.11],[13,20,4.377],[21,29,4.83],[30,32,5.259],[33,35,5.387],[36,39,5.468],[40,45,5.596],[46,50,6.351],[51,56,6.641],[57,61,7.163],[62,64,7.361],[65,71,7.5],[72,81,7.883],[82,86,8.371],[87,92,8.986],[93,100,9.323],[101,111,9.764]]],["Gleich kommen vier Fragen.",11.355,12.899,[[0,6,11.355],[7,13,11.738],[14,18,12.04],[19,26,12.283]]],["Rate mit, den frei bedienbaren Rechner schaltest du dir als Bonus frei, sobald du Baustein 1 abgeschlossen hast.",13.282,20.55,[[0,4,13.282],[5,9,13.642],[10,13,14.373],[14,18,14.594],[19,30,14.919],[31,38,15.557],[39,48,16.254],[49,51,16.718],[52,55,16.835],[56,59,17.021],[60,65,17.276],[66,71,17.682],[72,78,18.24],[79,81,18.634],[82,90,18.762],[91,92,19.261],[93,106,19.528],[107,112,20.179]]],["Danach liegt er dauerhaft in deinem Rechner-Fenster.",21.061,23.917,[[0,6,21.061],[7,12,21.56],[13,15,21.804],[16,25,21.908],[26,28,22.431],[29,35,22.512],[36,52,22.802]]]]}