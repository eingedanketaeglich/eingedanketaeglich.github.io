{"s":[["Verzinste Einlagen.",0.0,1.753,[[0,9,0.0],[10,19,0.882]]],["Geld, das ruht, soll nicht schlafen",1.962,4.249,[[0,5,1.962],[6,9,2.415],[10,15,2.682],[16,20,3.239],[21,26,3.495],[27,35,3.669]]],["Dein Notgroschen liegt „sicher“, aber verdient er auch etwas, oder verliert er still an Kaufkraft?",4.574,10.194,[[0,4,4.574],[5,16,4.888],[17,22,5.55],[23,32,5.817],[33,37,6.722],[38,46,6.989],[47,49,7.349],[50,54,7.5],[55,61,7.767],[62,66,8.243],[67,75,8.58],[76,78,8.975],[79,84,9.067],[85,87,9.334],[88,98,9.462]]],["Deine Konten haben jetzt Aufgaben.",10.437,12.678,[[0,5,10.437],[6,12,10.739],[13,18,11.227],[19,24,11.529],[25,34,11.889]]],["Eines trägt den Notgroschen.",12.829,14.768,[[0,5,12.829],[6,11,13.328],[12,15,13.665],[16,28,13.851]]],["Drei Etappen: die drei Wege, ruhendes Geld zu verzinsen (Tagesgeld, Festgeld, Geldmarkt-ETF) samt Lockzins-Falle, dann der Realzins-Test (Zins minus Inflation), zuletzt die Grenze zwischen „sicher parken“ und „investieren“.",15.047,32.206,[[0,4,15.047],[5,13,15.406],[14,17,16.254],[18,22,16.428],[23,28,16.707],[29,37,17.217],[38,42,17.821],[43,45,18.146],[46,55,18.309],[56,67,19.133],[68,77,20.155],[78,92,20.886],[93,97,22.395],[98,113,22.721],[114,118,24.056],[119,122,24.404],[123,136,24.625],[137,142,25.937],[143,148,26.494],[149,160,26.854],[161,168,27.887],[169,172,28.317],[173,179,28.491],[180,188,28.978],[189,196,29.408],[197,204,29.93],[205,208,30.685],[209,223,31.057]]],["Sieh den Zins deines Tagesgeld-/Sparkontos nach, eine einzige Zahl.",32.589,37.361,[[0,4,32.589],[5,8,32.821],[9,13,33.077],[14,20,33.437],[21,42,33.773],[43,48,35.457],[49,53,36.037],[54,61,36.339],[62,67,36.873]]],["Ruf dir die letzte Inflationszahl in Erinnerung, die du gehört hast.",37.744,41.25,[[0,3,37.744],[4,7,38.034],[8,11,38.185],[12,18,38.325],[19,33,38.673],[34,36,39.602],[37,48,39.729],[49,52,40.263],[53,55,40.38],[56,62,40.484],[63,68,40.856]]],["Größer oder kleiner?",41.529,42.887,[[0,6,41.529],[7,11,42.109],[12,20,42.353]]],["Nur vergleichen, nicht handeln.",43.131,45.349,[[0,3,43.131],[4,16,43.433],[17,22,44.408],[23,31,44.722]]],["In Lektion 3.1 hast du den stillen Gegner deiner Kaufkraft kennengelernt: die Inflation.",45.558,51.618,[[0,2,45.558],[3,10,45.767],[11,14,46.254],[15,19,47.334],[20,22,47.578],[23,26,47.705],[27,34,47.903],[35,41,48.321],[42,48,48.727],[49,58,49.006],[59,73,49.563],[74,77,50.561],[78,88,50.747]]],["Dieselbe Menge Geld kauft mit der Zeit weniger, und liegt die Inflation über deinem Sparzins, verlierst du real an Wert, auch wenn die Zahl auf dem Konto gleich bleibt.",52.001,61.811,[[0,8,52.001],[9,14,52.489],[15,19,52.767],[20,25,53.116],[26,29,53.429],[30,33,53.568],[34,38,53.719],[39,47,54.021],[48,51,54.869],[52,57,55.113],[58,61,55.333],[62,71,55.472],[72,76,56.146],[77,83,56.332],[84,93,56.599],[94,103,57.516],[104,106,57.922],[107,111,58.061],[112,114,58.491],[115,120,58.642],[121,125,59.281],[126,130,59.571],[131,134,59.757],[135,139,59.919],[140,143,60.233],[144,147,60.372],[148,153,60.558],[154,160,60.964],[161,168,61.335]]],["Genau daraus stammt der Merksatz Nominalzins minus Inflation gleich Realzins.",62.137,68.244,[[0,5,62.137],[6,12,62.52],[13,19,63.054],[20,23,63.391],[24,32,63.577],[33,44,64.482],[45,50,65.713],[51,60,66.189],[61,67,66.932],[68,77,67.315]]],["„Die ehrliche Frage an jedes geparkte Geld ist nicht ‚wie viel Zins?', sondern ‚wie viel Zins minus Inflation?'“",68.569,75.419,[[0,4,68.569],[5,13,68.813],[14,19,69.207],[20,22,69.591],[23,28,69.765],[29,37,70.043],[38,42,70.519],[43,46,70.868],[47,52,71.1],[53,57,71.402],[58,62,71.68],[63,70,71.982],[71,78,72.69],[79,83,73.108],[84,88,73.364],[89,93,73.608],[94,99,73.967],[100,112,74.397]]]]}