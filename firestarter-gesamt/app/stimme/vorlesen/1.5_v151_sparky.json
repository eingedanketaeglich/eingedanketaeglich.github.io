{"s":[["Warum ein Brief?",0.0,1.173,[[0,5,0.0],[6,9,0.511],[10,16,0.662]]],["Der Nordstern und das Versprechen",1.869,3.646,[[0,3,1.869],[4,13,2.067],[14,17,2.728],[18,21,2.879],[22,33,3.042]]],["Eine Richtung trägt weiter als eine Zahl.",4.598,7.094,[[0,4,4.598],[5,13,4.911],[14,19,5.41],[20,26,5.712],[27,30,6.095],[31,35,6.293],[36,41,6.525]]],["Ein Zahlenziel ist „500.000 € bis 60“; ein Nordstern ist „in Ruhe selbst entscheiden können“.",7.535,15.441,[[0,3,7.535],[4,14,7.755],[15,18,8.499],[19,27,8.847],[28,29,10.054],[30,33,10.542],[34,38,10.739],[39,42,12.086],[43,52,12.26],[53,56,12.852],[57,60,13.27],[61,65,13.688],[66,72,14.025],[73,84,14.408],[85,93,14.907]]],["Zahlen ändern sich, die Richtung trägt.",16.045,18.146,[[0,6,16.045],[7,13,16.498],[14,19,16.823],[20,23,17.101],[24,32,17.252],[33,39,17.612]]],["Und warum aufschreiben?",18.75,20.097,[[0,3,18.75],[4,9,18.959],[10,23,19.365]]],["Weil das geschriebene Wort stärker verpflichtet als ein Vorsatz im Kopf.",20.538,24.578,[[0,4,20.538],[5,8,20.724],[9,21,20.886],[22,26,21.478],[27,34,21.943],[35,47,22.442],[48,51,23.092],[52,55,23.301],[56,63,23.464],[64,66,23.94],[67,72,24.079]]],["Ein Brief mit Datum und Unterschrift ist ein Versprechen, dem du später wieder begegnest.",25.089,30.453,[[0,3,25.089],[4,9,25.321],[10,13,25.693],[14,19,25.878],[20,23,26.343],[24,36,26.517],[37,40,27.318],[41,44,27.573],[45,57,27.701],[58,61,28.642],[62,64,28.827],[65,71,28.967],[72,78,29.373],[79,89,29.617]]],["Brief und Zinseszins liegen auf derselben Zeitachse.",31.056,34.563,[[0,5,31.056],[6,9,31.532],[10,20,31.707],[21,27,32.705],[28,31,33.019],[32,41,33.169],[42,52,33.622]]],["Während dein Kapital im Stillen wächst, wächst auch dein Wofür.",35.167,39.056,[[0,7,35.167],[8,12,35.492],[13,20,35.689],[21,23,36.316],[24,31,36.455],[32,39,36.815],[40,46,37.477],[47,51,37.825],[52,56,38.057],[57,63,38.232]]]]}