{"s":[["Warum ein Brief?",0.0,1.091,[[0,5,0.0],[6,9,0.476],[10,16,0.604]]],["Der Nordstern und das Versprechen",1.207,2.81,[[0,3,1.207],[4,13,1.393],[14,17,1.95],[18,21,2.055],[22,33,2.218]]],["Eine Richtung trägt weiter als eine Zahl.",3.135,5.375,[[0,4,3.135],[5,13,3.379],[14,19,3.773],[20,26,4.063],[27,30,4.447],[31,35,4.69],[36,41,4.923]]],["Ein Zahlenziel ist „500.000 € bis 60“; ein Nordstern ist „in Ruhe selbst entscheiden können“.",5.526,11.854,[[0,3,5.526],[4,14,5.724],[15,18,6.455],[19,27,6.803],[28,29,7.918],[30,33,8.278],[34,38,8.452],[39,42,9.242],[43,52,9.427],[53,56,10.008],[57,60,10.159],[61,65,10.333],[66,72,10.6],[73,84,10.948],[85,93,11.401]]],["Zahlen ändern sich, die Richtung trägt.",12.132,13.92,[[0,6,12.132],[7,13,12.539],[14,19,12.841],[20,23,13.015],[24,32,13.119],[33,39,13.456]]],["Und warum aufschreiben?",14.048,15.244,[[0,3,14.048],[4,9,14.234],[10,23,14.57]]],["Weil das geschriebene Wort stärker verpflichtet als ein Vorsatz im Kopf.",15.372,19.063,[[0,4,15.372],[5,8,15.58],[9,21,15.766],[22,26,16.265],[27,34,16.544],[35,47,16.974],[48,51,17.647],[52,55,17.856],[56,63,18.03],[64,66,18.506],[67,72,18.634]]],["Ein Brief mit Datum und Unterschrift ist ein Versprechen, dem du später wieder begegnest.",19.505,24.067,[[0,3,19.505],[4,9,19.714],[10,13,20.05],[14,19,20.201],[20,23,20.642],[24,36,20.817],[37,40,21.49],[41,44,21.676],[45,57,21.815],[58,61,22.372],[62,64,22.535],[65,71,22.663],[72,78,23.081],[79,89,23.336]]],["Brief und Zinseszins liegen auf derselben Zeitachse.",24.578,27.527,[[0,5,24.578],[6,9,24.927],[10,20,25.054],[21,27,25.844],[28,31,26.111],[32,41,26.273],[42,52,26.761]]],["Während dein Kapital im Stillen wächst, wächst auch dein Wofür.",27.771,31.207,[[0,7,27.771],[8,12,28.119],[13,20,28.305],[21,23,28.874],[24,31,29.001],[32,39,29.326],[40,46,29.756],[47,51,30.07],[52,56,30.232],[57,63,30.406]]]]}