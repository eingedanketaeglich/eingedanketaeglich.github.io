{"s":[["Bildung schlägt Beratung",0.0,1.811,[[0,7,0.0],[8,15,0.604],[16,24,1.115]]],["Warum ein gut gemeinter Rat dich abhängig machen kann, und Verstehen dich freier macht als jedes Produkt.",2.252,7.848,[[0,5,2.252],[6,9,2.554],[10,13,2.67],[14,23,2.926],[24,27,3.355],[28,32,3.587],[33,41,3.855],[42,48,4.365],[49,54,4.621],[55,58,5.271],[59,68,5.41],[69,73,5.759],[74,80,6.002],[81,86,6.351],[87,90,6.838],[91,96,7.036],[97,105,7.291]]],["Stell dir vor, jemand bietet dir an, dich für immer zu tragen.",8.127,11.633,[[0,5,8.127],[6,9,8.348],[10,14,8.452],[15,21,9.137],[22,28,9.404],[29,32,9.694],[33,36,9.868],[37,41,10.101],[42,45,10.403],[46,51,10.588],[52,54,10.89],[55,62,11.041]]],["Bequem, bis du merkst:",11.784,13.421,[[0,7,11.784],[8,11,12.608],[12,14,12.783],[15,22,12.887]]],["Du hast das Gehen verlernt.",13.595,15.244,[[0,2,13.595],[3,7,13.781],[8,11,13.978],[12,17,14.199],[18,27,14.548]]],["Genau das passiert oft bei der Geldanlage: jemand „trägt“ dich, und du wirst nie selbst sicher auf den Beinen.",15.418,21.537,[[0,5,15.418],[6,9,15.685],[10,18,15.836],[19,22,16.196],[23,26,16.568],[27,30,16.707],[31,42,16.835],[43,49,17.891],[50,57,18.216],[58,63,18.901],[64,67,19.319],[68,70,19.435],[71,76,19.54],[77,80,19.807],[81,87,20.062],[88,94,20.55],[95,98,20.817],[99,102,20.956],[103,110,21.096]]],["Nicht, weil Berater böse wären, die meisten meinen es gut.",21.781,24.915,[[0,6,21.781],[7,11,22.048],[12,19,22.315],[20,24,22.907],[25,31,23.278],[32,35,23.65],[36,43,23.801],[44,50,24.161],[51,53,24.462],[54,58,24.579]]],["Sondern weil das Modell dahinter dich abhängig hält, statt dich frei zu machen.",25.24,29.467,[[0,7,25.24],[8,12,25.623],[13,16,25.832],[17,23,25.995],[24,32,26.367],[33,37,26.819],[38,46,27.133],[47,52,27.598],[53,58,28.19],[59,63,28.422],[64,68,28.596],[69,71,28.886],[72,79,29.037]]],["Warum kann ein gut gemeinter Rat dich abhängig machen?",29.641,32.613,[[0,5,29.641],[6,10,30.012],[11,14,30.268],[15,18,30.5],[19,28,30.814],[29,32,31.231],[33,37,31.464],[38,46,31.707],[47,54,32.195]]],["Was bleibt am Ende bei dir, bei Beratung, was bei Bildung?",32.822,36.34,[[0,3,32.822],[4,10,32.985],[11,13,33.252],[14,18,33.368],[19,22,33.565],[23,27,33.704],[28,31,34.192],[32,41,34.343],[42,45,35.307],[46,49,35.562],[50,58,35.713]]],["Wo hast du bisher eine Entscheidung abgegeben, die dir gehört?",36.514,39.544,[[0,2,36.514],[3,7,36.723],[8,10,36.886],[11,17,36.99],[18,22,37.315],[23,35,37.478],[36,46,37.942],[47,50,38.511],[51,54,38.65],[55,62,38.836]]],["„Bildung will sich selbst überflüssig machen.“",39.625,42.168,[[0,8,39.625],[9,13,40.136],[14,18,40.287],[19,25,40.438],[26,37,40.868],[38,46,41.471]]]]}