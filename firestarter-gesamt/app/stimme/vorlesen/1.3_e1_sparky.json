{"s":[["Bildung schlägt Beratung",0.0,1.416,[[0,7,0.0],[8,15,0.557],[16,24,0.882]]],["Warum ein gut gemeinter Rat dich abhängig machen kann, und Verstehen dich freier macht als jedes Produkt.",2.02,7.767,[[0,5,2.02],[6,9,2.415],[10,13,2.566],[14,23,2.81],[24,27,3.262],[28,32,3.622],[33,41,3.82],[42,48,4.238],[49,54,4.493],[55,58,5.236],[59,68,5.399],[69,73,5.851],[74,80,6.026],[81,86,6.385],[87,90,6.641],[91,96,6.885],[97,105,7.163]]],["Stell dir vor, jemand bietet dir an, dich für immer zu tragen.",8.208,11.587,[[0,5,8.208],[6,9,8.487],[10,14,8.626],[15,21,9.102],[22,28,9.427],[29,32,9.718],[33,36,9.88],[37,41,10.275],[42,45,10.484],[46,51,10.623],[52,54,10.879],[55,62,11.018]]],["Bequem, bis du merkst:",12.028,13.769,[[0,7,12.028],[8,11,12.806],[12,14,13.003],[15,22,13.131]]],["Du hast das Gehen verlernt.",14.048,15.604,[[0,2,14.048],[3,7,14.222],[8,11,14.42],[12,17,14.628],[18,27,14.954]]],["Genau das passiert oft bei der Geldanlage: jemand „trägt“ dich, und du wirst nie selbst sicher auf den Beinen.",16.416,22.895,[[0,5,16.416],[6,9,16.846],[10,18,17.101],[19,22,17.508],[23,26,17.763],[27,30,17.891],[31,42,18.019],[43,49,19.11],[50,57,19.458],[58,63,20.062],[64,67,20.712],[68,70,20.84],[71,76,20.956],[77,80,21.258],[81,87,21.478],[88,94,21.862],[95,98,22.129],[99,102,22.268],[103,110,22.419]]],["Nicht, weil Berater böse wären, die meisten meinen es gut.",23.22,26.575,[[0,6,23.22],[7,11,23.545],[12,19,23.719],[20,24,24.172],[25,31,24.497],[32,35,25.182],[36,43,25.333],[44,50,25.739],[51,53,26.029],[54,58,26.157]]],["Sondern weil das Modell dahinter dich abhängig hält, statt dich frei zu machen.",26.958,31.045,[[0,7,26.958],[8,12,27.411],[13,16,27.585],[17,23,27.748],[24,32,28.131],[33,37,28.526],[38,46,28.711],[47,52,29.21],[53,58,29.721],[59,63,29.977],[64,68,30.128],[69,71,30.418],[72,79,30.58]]],["Warum kann ein gut gemeinter Rat dich abhängig machen?",31.648,34.47,[[0,5,31.648],[6,10,32.078],[11,14,32.299],[15,18,32.438],[19,28,32.658],[29,32,33.1],[33,37,33.332],[38,46,33.506],[47,54,33.936]]],["Was bleibt am Ende bei dir, bei Beratung, was bei Bildung?",34.911,38.522,[[0,3,34.911],[4,10,35.143],[11,13,35.456],[14,18,35.607],[19,22,35.828],[23,27,35.979],[28,31,36.559],[32,41,36.71],[42,45,37.546],[46,49,37.767],[50,58,37.906]]],["Wo hast du bisher eine Entscheidung abgegeben, die dir gehört?",38.963,42.028,[[0,2,38.963],[3,7,39.16],[8,10,39.334],[11,17,39.462],[18,22,39.799],[23,35,39.984],[36,46,40.495],[47,50,41.122],[51,54,41.273],[55,62,41.424]]],["„Bildung will sich selbst überflüssig machen.“",42.631,45.371,[[0,8,42.631],[9,13,43.247],[14,18,43.444],[19,25,43.618],[26,37,44.071],[38,46,44.71]]]]}