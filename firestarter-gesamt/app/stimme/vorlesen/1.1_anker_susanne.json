{"s":[["Was du mitnimmst, und dein Anker",0.0,2.206,[[0,3,0.0],[4,6,0.383],[7,17,0.522],[18,21,1.335],[22,26,1.579],[27,32,1.869]]],["Drei Sätze, die wichtigsten Begriffe, dein persönliches Warum.",2.264,6.711,[[0,4,2.264],[5,11,2.577],[12,15,3.193],[16,27,3.367],[28,37,3.959],[38,42,4.818],[43,55,5.132],[56,62,6.049]]],["Drei Sätze zum Mitnehmen",7.094,9.009,[[0,4,7.094],[5,10,7.488],[11,14,8.011],[15,24,8.278]]],["Finanzwissen · Selbstbestimmung · Vermögensaufbau, die drei Leitbegriffe.",9.253,15.302,[[0,12,9.253],[13,14,10.507],[15,31,10.96],[32,33,12.237],[34,50,12.516],[51,54,13.886],[55,59,14.071],[60,73,14.373]]],["Bildung, kein Verkaufsgespräch, ehrliche Grenzen schützen dich.",15.627,19.679,[[0,8,15.627],[9,13,16.37],[14,31,16.649],[32,40,17.961],[41,48,18.46],[49,57,18.936],[58,63,19.343]]],["Neun Bausteine, ein Leitsatz.",20.004,22.059,[[0,4,20.004],[5,15,20.364],[16,19,21.107],[20,29,21.386]]],["„Finanzen und Börse sind kein Hobby.“",22.234,24.73,[[0,9,22.234],[10,13,22.942],[14,19,23.093],[20,24,23.604],[25,29,23.859],[30,37,24.207]]],["Der Gedanke, den fast keiner zu Ende denkt",25.055,27.783,[[0,3,25.055],[4,12,25.252],[13,16,25.833],[17,21,26.065],[22,28,26.436],[29,31,26.889],[32,36,27.075],[37,42,27.388]]],["Du hast noch nie einen Euro verloren, und trotzdem fehlt dir am Ende womöglich der größte Teil deines Vermögens.",28.108,34.725,[[0,2,28.108],[3,7,28.364],[8,12,28.654],[13,16,28.909],[17,22,29.188],[23,27,29.49],[28,37,29.861],[38,41,30.628],[42,50,30.79],[51,56,31.301],[57,60,31.556],[61,63,31.719],[64,68,31.881],[69,78,32.16],[79,82,32.752],[83,89,32.926],[90,94,33.448],[95,101,33.762],[102,112,34.04]]],["Nicht, weil dir jemand etwas weggenommen hätte.",34.969,37.291,[[0,6,34.969],[7,11,35.283],[12,15,35.468],[16,22,35.596],[23,28,35.898],[29,40,36.2],[41,47,36.792]]],["Sondern weil dein Geld einfach stillstand, während die Zeit weiterlief.",37.535,42.783,[[0,7,37.535],[8,12,38.057],[13,17,38.29],[18,22,38.522],[23,30,38.928],[31,42,39.497],[43,50,40.612],[51,54,40.983],[55,59,41.169],[60,71,41.796]]],["Das ist das Unheimliche am stillen Saboteur:",43.166,46.173,[[0,3,43.166],[4,7,43.549],[8,11,43.758],[12,23,44.025],[24,26,44.826],[27,34,44.989],[35,44,45.372]]],["Er raubt nichts, was du siehst.",46.498,48.449,[[0,2,46.498],[3,8,46.707],[9,16,47.102],[17,20,47.485],[21,23,47.705],[24,31,47.88]]],["Er verhindert nur, dass etwas entsteht.",48.774,50.957,[[0,2,48.774],[3,13,48.936],[14,18,49.459],[19,23,49.807],[24,29,50.028],[30,39,50.365]]],["Und weil auf deinem Kontoauszug nie eine rote Zahl auftaucht, merkst du jahrelang gar nicht, dass er überhaupt da ist.",51.235,59.014,[[0,3,51.235],[4,8,51.421],[9,12,51.63],[13,19,51.746],[20,31,52.048],[32,35,53.023],[36,40,53.325],[41,45,53.58],[46,50,53.929],[51,61,54.242],[62,68,55.148],[69,71,55.531],[72,81,55.798],[82,85,56.483],[86,92,56.75],[93,97,57.11],[98,100,57.365],[101,110,57.516],[111,113,58.166],[114,118,58.573]]],["In diesem Baustein schaust du ihm zum ersten Mal ins Gesicht, und verstehst, warum genau dieses Nicht-Hinschauen der eigentliche Preis ist.",59.339,67.234,[[0,2,59.339],[3,9,59.502],[10,18,59.792],[19,26,60.407],[27,29,60.697],[30,33,60.802],[34,37,60.93],[38,44,61.127],[45,48,61.464],[49,52,61.661],[53,61,61.824],[62,65,62.601],[66,76,62.764],[77,82,63.333],[83,88,63.658],[89,95,64.076],[96,112,64.505],[113,116,65.469],[117,128,65.713],[129,134,66.34],[135,139,66.746]]],["Begriffe in diesem Baustein",67.477,69.242,[[0,8,67.477],[9,11,68.093],[12,18,68.232],[19,27,68.58]]],["Zinseszins & Zinseszins-Kontinuität",69.683,73.178,[[0,10,69.683],[11,12,70.867],[13,35,71.262]]],["Der stille Saboteur",73.619,75.059,[[0,3,73.619],[4,10,73.898],[11,19,74.316]]],["Die drei Leitbegriffe",75.5,76.684,[[0,3,75.5],[4,8,75.686],[9,21,75.941]]],["Bildung statt Beratung",76.765,78.158,[[0,7,76.765],[8,13,77.265],[14,22,77.543]]],["Notgroschen",78.6,79.412,[[0,11,78.6]]],["Nordsterne & Selbstlern-Bibliothek",79.691,82.001,[[0,10,79.691],[11,12,80.515],[13,34,80.701]]],["Dein Anker:",82.442,83.417,[[0,4,82.442],[5,11,82.825]]],["Mein Warum",83.592,84.393,[[0,4,83.592],[5,10,83.928]]],["Warum nimmst du deine Finanzen gerade jetzt in die Hand?",84.996,88.05,[[0,5,84.996],[6,12,85.403],[13,15,85.67],[16,21,85.879],[22,30,86.099],[31,37,86.633],[38,43,87.04],[44,46,87.376],[47,50,87.481],[51,56,87.609]]],["Ein Satz reicht, nur für dich.",88.375,90.651,[[0,3,88.375],[4,8,88.677],[9,16,89.013],[17,20,89.629],[21,24,89.977],[25,30,90.151]]],["Du greifst ihn in Lektion 1.5, deinem Zukunftsbrief, wieder auf.",90.859,95.55,[[0,2,90.859],[3,10,91.08],[11,14,91.579],[15,17,91.8],[18,25,91.951],[26,30,92.566],[31,37,93.611],[38,52,93.971],[53,59,94.83],[60,64,95.109]]],["Häufige Fragen, kurz & klar",95.875,97.965,[[0,7,95.875],[8,15,96.316],[16,20,97.082],[21,22,97.489],[23,27,97.663]]],["Brauche ich Vorwissen oder Mathematik?",98.023,100.194,[[0,7,98.023],[8,11,98.418],[12,21,98.627],[22,26,99.219],[27,38,99.451]]],["Ist Firestarter eine Anlageberatung?",100.438,102.841,[[0,3,100.438],[4,15,100.717],[16,20,101.483],[21,36,101.703]]],["Bekomme ich ein Renditeversprechen?",103.085,105.117,[[0,7,103.085],[8,11,103.503],[12,15,103.689],[16,35,103.898]]],["Muss ich danach eine Präsenzveranstaltung besuchen?",105.395,108.762,[[0,4,105.395],[5,8,105.697],[9,15,105.848],[16,20,106.255],[21,41,106.522],[42,51,107.984]]]]}