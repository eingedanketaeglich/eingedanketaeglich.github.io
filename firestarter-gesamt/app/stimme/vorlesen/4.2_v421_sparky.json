{"s":[["Die Aktie, ein Stück Eigentum",0.0,1.962,[[0,3,0.0],[4,10,0.232],[11,14,0.987],[15,20,1.126],[21,29,1.416]]],["Gibst du dem Bäcker 100 € und dir gehört dafür ein winziges Stück von allem, hast du ihm Geld geliehen?",3.077,8.928,[[0,5,3.077],[6,8,3.402],[9,12,3.518],[13,19,3.669],[20,23,3.994],[24,25,4.377],[26,29,4.83],[30,33,4.969],[34,40,5.085],[41,46,5.445],[47,50,5.921],[51,59,6.084],[60,65,6.536],[66,69,6.769],[70,76,6.954],[77,81,7.651],[82,84,7.872],[85,88,7.988],[89,93,8.127],[94,103,8.394]]],["Nein.",9.625,10.147,[[0,5,9.625]]],["Du bist Mit-Eigentümer.",10.96,12.539,[[0,2,10.96],[3,7,11.157],[8,23,11.494]]],["Genau das ist eine Aktie: ein Eigentumsanteil.",13.351,16.893,[[0,5,13.351],[6,9,13.793],[10,13,14.083],[14,18,14.28],[19,25,14.489],[26,29,15.43],[30,46,15.65]]],["Als Eigentümer profitierst du auf zwei Wegen:",17.496,20.143,[[0,3,17.496],[4,14,17.775],[15,26,18.343],[27,29,18.97],[30,33,19.098],[34,38,19.284],[39,45,19.609]]],["Dividende",20.747,21.408,[[0,9,20.747]]],["dein Anteil am ausgeschütteten Gewinn",21.85,23.823,[[0,4,21.85],[5,11,22.105],[12,14,22.581],[15,30,22.732],[31,37,23.44]]],["Wertsteigerung",24.265,25.077,[[0,14,24.265]]],["wollen mehr Leute ein Stück, steigt der Preis deines Anteils",25.135,28.456,[[0,6,25.135],[7,11,25.426],[12,17,25.635],[18,21,25.96],[22,28,26.111],[29,35,26.842],[36,39,27.155],[40,45,27.283],[46,52,27.608],[53,60,27.91]]],["Beide Wege haben eine Kehrseite:",29.152,31.254,[[0,5,29.152],[6,10,29.512],[11,16,29.907],[17,21,30.209],[22,32,30.429]]],["Läuft das Unternehmen schlecht, fällt die Dividende aus und der Wert kann sinken.",31.532,36.084,[[0,5,31.532],[6,9,31.846],[10,21,32.032],[22,31,32.496],[32,37,33.274],[38,41,33.541],[42,51,33.657],[52,55,34.214],[56,59,34.667],[60,63,34.841],[64,68,34.992],[69,73,35.306],[74,81,35.526]]],["Als Eigentümer trägst du das unternehmerische Risiko mit, du sitzt im selben Boot.",36.78,41.459,[[0,3,36.78],[4,14,37.07],[15,21,37.697],[22,24,38.023],[25,28,38.127],[29,45,38.336],[46,52,39.056],[53,57,39.474],[58,60,40.019],[61,66,40.182],[67,69,40.484],[70,76,40.646],[77,82,40.983]]],["Eine Aktie ist kein Papier mit hüpfenden Zahlen, sondern ein Eigentumstitel mit Stimmrecht.",42.063,47.868,[[0,4,42.063],[5,10,42.295],[11,14,42.701],[15,19,42.934],[20,26,43.201],[27,30,43.688],[31,40,43.839],[41,48,44.373],[49,56,45.256],[57,60,45.697],[61,75,45.906],[76,79,46.916],[80,91,47.09]]],["Du bist nicht Kunde des Marktes, sondern Teilhaber an echter Wirtschaft, einen garantierten Ertrag gibt es dafür nicht.",48.471,55.217,[[0,2,48.471],[3,7,48.634],[8,13,48.855],[14,19,49.099],[20,23,49.458],[24,32,49.656],[33,40,50.387],[41,50,50.77],[51,53,51.362],[54,60,51.502],[61,72,51.78],[73,78,52.651],[79,91,52.918],[92,98,53.603],[99,103,54.01],[104,106,54.23],[107,112,54.335],[113,119,54.602]]]]}