{"s":[["Die Grenze.",0.0,0.778,[[0,3,0.0],[4,11,0.197]]],["Notgroschen ist Sicherheit, nicht Renditequelle",1.289,4.052,[[0,11,1.289],[12,15,1.927],[16,27,2.171],[28,33,2.984],[34,47,3.286]]],["Verzinste Einlagen haben eine klare Aufgabe:",4.11,6.687,[[0,9,4.11],[10,18,4.644],[19,24,5.132],[25,29,5.341],[30,35,5.526],[36,44,6.026]]],["Sicherheit und Verfügbarkeit, vor allem für den Notgroschen.",7.07,10.797,[[0,10,7.07],[11,14,7.802],[15,29,7.988],[30,33,9.137],[34,39,9.311],[40,43,9.52],[44,47,9.671],[48,60,9.845]]],["Sie sind nicht der Ort, an dem Vermögen wächst.",11.18,13.56,[[0,3,11.18],[4,8,11.308],[9,14,11.517],[15,18,11.749],[19,23,11.923],[24,26,12.26],[27,30,12.353],[31,39,12.539],[40,47,12.992]]],["Wer mit Zins-Hopping (ständig dem nächsten Aktionszins hinterher) Vermögen aufbauen will, verwechselt die Aufgaben.",13.677,20.318,[[0,3,13.677],[4,7,13.897],[8,20,14.234],[21,29,15.314],[30,33,15.802],[34,42,15.964],[43,54,16.37],[55,65,17.137],[66,74,17.984],[75,83,18.414],[84,89,18.843],[90,101,19.145],[102,105,19.656],[106,115,19.807]]],["Die klare Linie:",20.341,21.026,[[0,3,20.341],[4,9,20.446],[10,16,20.771]]],["Der Notgroschen bleibt sicher und verfügbar, niemals in Schwankung.",21.049,24.73,[[0,3,21.049],[4,15,21.223],[16,22,21.816],[23,29,22.106],[30,33,22.477],[34,44,22.675],[45,52,23.453],[53,55,23.952],[56,67,24.068]]],["Was darüber hinaus lange frei ist, gehört in den Vermögensaufbau (Baustein 4 ff.), nicht ins nächste Festgeld.",25.055,31.963,[[0,3,25.055],[4,11,25.252],[12,18,25.6],[19,24,26.007],[25,29,26.262],[30,34,26.552],[35,41,27.087],[42,44,27.365],[45,48,27.435],[49,64,27.621],[65,74,28.793],[75,76,29.583],[77,82,30.117],[83,88,30.558],[89,92,30.837],[93,100,31.022],[101,110,31.348]]],["Verzinste Einlagen und Vermögensaufbau sind zwei verschiedene Werkzeuge.",32.207,36.061,[[0,9,32.207],[10,18,32.764],[19,22,33.344],[23,38,33.472],[39,43,34.401],[44,48,34.587],[49,61,34.877],[62,72,35.353]]],["Das eine hält den Notgroschen sicher, das andere lässt Vermögen über Jahrzehnte wachsen.",36.305,40.623,[[0,3,36.305],[4,8,36.502],[9,13,36.769],[14,17,36.944],[18,29,37.129],[30,37,37.745],[38,41,38.046],[42,48,38.209],[49,54,38.557],[55,63,38.801],[64,68,39.3],[69,79,39.556],[80,88,40.205]]],["Sie zu verwechseln kostet auf beiden Seiten, entweder Sicherheit oder Wachstum.",40.647,44.327,[[0,3,40.647],[4,6,40.832],[7,18,40.983],[19,25,41.517],[26,29,41.889],[30,36,42.04],[37,44,42.33],[45,53,42.702],[54,64,43.015],[65,69,43.503],[70,79,43.688]]],["Drei Sätze zum Mitnehmen",44.652,46.301,[[0,4,44.652],[5,10,45.186],[11,14,45.639],[15,24,45.813]]],["Tagesgeld, Festgeld, Geldmarkt-ETF verzinsen ruhendes Geld; der Tausch ist immer Verfügbarkeit gegen Zins.",46.359,53.87,[[0,10,46.359],[11,20,47.079],[21,34,47.717],[35,44,49.099],[45,53,49.865],[54,59,50.469],[60,63,51.2],[64,70,51.351],[71,74,51.711],[75,80,51.874],[81,94,52.059],[95,100,52.837],[101,106,53.197]]],["Vorsicht vor der Lockzins-Falle.",54.079,56.413,[[0,8,54.079],[9,12,55.008],[13,16,55.228],[17,32,55.344]]],["Realzins = Einlagenzins − Inflation:",56.587,60.534,[[0,8,56.587],[9,10,57.771],[11,23,58.444],[24,25,59.57],[26,36,59.617]]],["Ist er negativ, schrumpft dein Geld still, auch wenn die Zahl gleich bleibt.",60.743,64.969,[[0,3,60.743],[4,6,60.952],[7,15,61.033],[16,25,61.823],[26,30,62.252],[31,35,62.485],[36,42,62.705],[43,47,63.39],[48,52,63.576],[53,56,63.715],[57,61,63.855],[62,68,64.11],[69,76,64.412]]],["Verzinste Einlagen sind Sicherheit, keine Renditequelle.",65.143,68.464,[[0,9,65.143],[10,18,65.712],[19,23,66.246],[24,35,66.409],[36,41,67.117],[42,56,67.512]]],["Zins-Hopping ersetzt den Zinseszins nicht.",68.673,71.703,[[0,12,68.673],[13,20,69.509],[21,24,69.915],[25,35,70.17],[36,42,71.088]]]]}