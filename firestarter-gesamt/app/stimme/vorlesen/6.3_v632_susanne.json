{"s":[["Der Realzins-Test, ruht dein Geld oder schrumpft es?",0.0,4.296,[[0,3,0.0],[4,18,0.43],[19,23,1.916],[24,28,2.206],[29,33,2.438],[34,38,3.019],[39,48,3.413],[49,52,3.936]]],["Die wichtigste Rechnung dieser Lektion ist eine simple Subtraktion.",4.807,8.51,[[0,3,4.807],[4,14,4.981],[15,23,5.48],[24,30,5.863],[31,38,6.118],[39,42,6.664],[43,47,6.861],[48,54,7.129],[55,67,7.512]]],["Ein Zins allein sagt wenig, was zählt, ist der Realzins.",8.835,12.794,[[0,3,8.835],[4,8,9.091],[9,15,9.439],[16,20,9.927],[21,27,10.252],[28,31,10.82],[32,38,11.134],[39,42,11.575],[43,46,11.738],[47,56,11.889]]],["Ist der Realzins positiv, wächst deine Kaufkraft wirklich.",13.073,16.73,[[0,3,13.073],[4,7,13.293],[8,16,13.479],[17,25,14.245],[26,32,15.012],[33,38,15.337],[39,48,15.615],[49,58,16.184]]],["Ist er negativ, der Zins also kleiner als die Inflation, dann ruht dein Geld nicht, sondern schrumpft still, auch wenn die Zahl auf dem Konto gleich bleibt.",16.939,25.89,[[0,3,16.939],[4,6,17.16],[7,15,17.253],[16,19,18.147],[20,24,18.321],[25,29,18.623],[30,37,18.959],[38,41,19.493],[42,45,19.702],[46,56,19.83],[57,61,20.794],[62,66,21.014],[67,71,21.235],[72,76,21.444],[77,83,21.722],[84,91,22.175],[92,101,22.558],[102,108,22.965],[109,113,23.743],[114,118,23.963],[119,122,24.126],[123,127,24.265],[128,131,24.567],[132,135,24.695],[136,141,24.869],[142,148,25.171],[149,156,25.461]]],["Hinschauen statt parken: bei jedem ruhenden Geld einmal „Zins − Inflation“ rechnen.",26.065,31.556,[[0,10,26.065],[11,16,26.68],[17,24,26.982],[25,28,27.818],[29,34,28.003],[35,43,28.34],[44,48,28.805],[49,55,29.199],[56,61,29.699],[62,63,30.302],[64,74,30.36],[75,83,30.999]]],["Konditionen vergleichen statt verharren:",31.835,34.343,[[0,11,31.835],[12,23,32.729],[24,29,33.356],[30,40,33.669]]],["Hausbank-Zins und aktiv gewählte Einlageform liegen oft weit auseinander.",34.552,39.161,[[0,13,34.552],[14,17,35.527],[18,23,35.724],[24,32,36.142],[33,44,36.572],[45,51,37.489],[52,55,37.861],[56,60,38.116],[61,73,38.395]]],["Die Aufgabe trennen:",39.486,40.705,[[0,3,39.486],[4,11,39.672],[12,20,40.171]]],["Notgroschen bleibt sicher; was lange frei ist, gehört auf den Vermögens-Weg (Baustein 4 ff.), nicht ins nächste Festgeld.",40.775,48.751,[[0,11,40.775],[12,18,41.46],[19,26,41.75],[27,30,42.516],[31,36,42.737],[37,41,42.981],[42,46,43.282],[47,53,43.596],[54,57,43.933],[58,61,44.06],[62,75,44.211],[76,85,45.094],[86,87,45.756],[88,93,46.568],[94,99,47.021],[100,103,47.404],[104,111,47.648],[112,121,48.031]]],["Ein Zins von null fühlt sich harmlos an.",49.03,51.491,[[0,3,49.03],[4,8,49.297],[9,12,49.633],[13,17,49.831],[18,23,50.167],[24,28,50.411],[29,36,50.609],[37,40,51.131]]],["Aber bei spürbarer Inflation ist „null Zins“ in Wahrheit ein Minus an Kaufkraft.",51.7,56.472,[[0,4,51.7],[5,8,51.932],[9,18,52.06],[19,28,52.663],[29,32,53.325],[33,38,53.592],[39,44,54.092],[45,47,54.509],[48,56,54.66],[57,60,55.113],[61,66,55.287],[67,69,55.647],[70,80,55.787]]],["Die einzige ehrliche Frage lautet:",56.715,58.736,[[0,3,56.715],[4,11,56.936],[12,20,57.47],[21,26,57.853],[27,34,58.225]]],["„wie viel Zins minus Inflation?“",58.944,61.162,[[0,4,58.944],[5,9,59.223],[10,14,59.513],[15,20,59.897],[21,32,60.21]]]]}