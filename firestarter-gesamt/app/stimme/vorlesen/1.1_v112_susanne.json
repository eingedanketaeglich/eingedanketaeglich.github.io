{"s":[["Was Firestarter ist, und was nicht",0.0,2.229,[[0,3,0.0],[4,15,0.337],[16,20,1.173],[21,24,1.498],[25,28,1.614],[29,34,1.869]]],["Die ehrlichste Art, Vertrauen aufzubauen: sagen, wo die Grenzen liegen.",2.554,7.326,[[0,3,2.554],[4,14,2.752],[15,19,3.262],[20,29,3.529],[30,41,4.087],[42,48,5.236],[49,51,5.793],[52,55,6.049],[56,63,6.2],[64,71,6.792]]],["Bildung, die dir das Prinzip erklärt, keine auf deinen Einzelfall zugeschnittene Empfehlung.",7.651,13.108,[[0,8,7.651],[9,12,8.243],[13,16,8.382],[17,20,8.522],[21,28,8.684],[29,37,9.195],[38,43,10.019],[44,47,10.379],[48,54,10.53],[55,65,10.925],[66,80,11.645],[81,92,12.376]]],["ehrliche Sprache:",13.491,14.64,[[0,8,13.491],[9,17,13.92]]],["Es fällt nie eine Zahl wie „so viel bekommst du“.",14.965,18.599,[[0,2,14.965],[3,8,15.186],[9,12,15.488],[13,17,15.778],[18,22,16.091],[23,26,16.533],[27,30,16.834],[31,35,17.287],[36,44,17.566],[45,49,18.088]]],["ein Fundament, aktives Handeln gehört nicht zu Firestarter.",18.843,23.092,[[0,3,18.843],[4,14,19.052],[15,22,20.016],[23,30,20.55],[31,37,20.968],[38,43,21.397],[44,46,21.803],[47,59,22.024]]],["die Schicht darunter, das konkrete Depot-Zusammenstellen kommt später.",23.371,27.829,[[0,3,23.371],[4,11,23.533],[12,21,23.812],[22,25,24.601],[26,34,24.857],[35,56,25.461],[57,62,26.819],[63,70,27.098]]],["steuerliches Grundwissen, damit du die richtigen Fragen stellen kannst.",28.154,32.02,[[0,12,28.154],[13,25,28.851],[26,31,29.78],[32,34,30.081],[35,38,30.186],[39,48,30.314],[49,55,30.755],[56,63,31.149],[64,71,31.544]]],["Und was ist es dann zusammengefasst?",32.345,34.296,[[0,3,32.345],[4,7,32.531],[8,11,32.752],[12,14,32.926],[15,19,33.042],[20,36,33.251]]],["Bildung.",34.621,35.364,[[0,8,34.621]]],["Ein Fundament.",35.747,36.769,[[0,3,35.747],[4,14,35.979]]],["Eine Selbstlern-Bibliothek, durch die du dich selbst bewegst, und auf der alles Weitere ruht.",37.21,43.642,[[0,4,37.21],[5,27,37.651],[28,33,39.416],[34,37,39.706],[38,40,39.834],[41,45,39.961],[46,52,40.136],[53,61,40.554],[62,65,41.424],[66,69,41.773],[70,73,41.982],[74,79,42.167],[80,87,42.585],[88,93,43.119]]],["Was ein Programm nicht verspricht, schützt dich, nicht den Anbieter.",44.025,48.123,[[0,3,44.025],[4,7,44.315],[8,16,44.501],[17,22,44.93],[23,34,45.186],[35,42,45.801],[43,48,46.242],[49,54,46.788],[55,58,47.148],[59,68,47.38]]],["Ein Programm ohne Rendite-Werbung hat nur ein Interesse: dass du es verstehst.",48.506,53.591,[[0,3,48.506],[4,12,48.715],[13,17,49.179],[18,33,49.458],[34,37,50.329],[38,41,50.549],[42,45,50.898],[46,56,51.165],[57,61,52.024],[62,64,52.303],[65,67,52.465],[68,78,52.616]]]]}