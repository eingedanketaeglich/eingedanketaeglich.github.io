{"s":[["Warum diese Rechnung in keinem Bankprospekt steht",0.0,2.798,[[0,5,0.0],[6,11,0.372],[12,20,0.615],[21,23,1.045],[24,30,1.242],[31,43,1.73],[44,49,2.438]]],["Ist Stehenbleiben nicht besser als Stürzen?",3.007,5.526,[[0,3,3.007],[4,17,3.32],[18,23,4.052],[24,30,4.319],[31,34,4.667],[35,43,4.841]]],["Klingt logisch, ist aber oft falsch.",5.7,7.755,[[0,6,5.7],[7,15,6.002],[16,19,6.618],[20,24,6.838],[25,28,7.036],[29,36,7.245]]],["Echter, schmerzhafter Verlust, steht aber sofort wieder auf.",8.081,11.157,[[0,7,8.081],[8,21,8.499],[22,30,9.207],[31,36,9.706],[37,41,9.985],[42,48,10.159],[49,55,10.565],[56,60,10.809]]],["Der Motor läuft von niedrigerer Basis weiter und holt auf.",11.238,14.373,[[0,3,11.238],[4,9,11.424],[10,15,11.796],[16,19,12.063],[20,31,12.202],[32,37,12.817],[38,44,13.201],[45,48,13.595],[49,53,13.746],[54,58,14.002]]],["Kostet den Motor ein paar Jahre.",14.454,16.057,[[0,6,14.454],[7,10,14.838],[11,16,14.965],[17,20,15.29],[21,25,15.418],[26,32,15.581]]],["Verliert optisch nichts Neues, bleibt aber unten.",16.15,18.808,[[0,8,16.15],[9,16,16.567],[17,23,16.997],[24,30,17.334],[31,37,17.775],[38,42,18.088],[43,49,18.286]]],["Der Motor produziert jedes Jahr nichts.",19.191,21.362,[[0,3,19.191],[4,9,19.365],[10,20,19.714],[21,26,20.341],[27,31,20.619],[32,39,20.84]]],["Kostet jedes Jahr plus dessen Zins-auf-Zins.",21.432,24.114,[[0,6,21.432],[7,12,21.85],[13,17,22.14],[18,22,22.349],[23,29,22.639],[30,44,23.046]]],["Der Knoten, den die meisten nicht sehen:",24.439,26.401,[[0,3,24.439],[4,11,24.625],[12,15,25.101],[16,19,25.275],[20,27,25.391],[28,33,25.809],[34,40,26.041]]],["Beim Zinseszins ist die Zeit der Treibstoff, nicht der momentane Punktestand.",26.494,30.685,[[0,4,26.494],[5,15,26.749],[16,19,27.481],[20,23,27.62],[24,28,27.771],[29,32,28.003],[33,44,28.131],[45,50,28.839],[51,54,29.13],[55,64,29.269],[65,77,29.896]]],["Ein Prospekt zeigt dir meist nur die Durchschnitts-Rendite über den ganzen Zeitraum.",31.068,34.981,[[0,3,31.068],[4,12,31.254],[13,18,31.8],[19,22,32.044],[23,28,32.183],[29,32,32.485],[33,36,32.636],[37,58,32.74],[59,63,33.704],[64,67,33.878],[68,74,34.017],[75,84,34.377]]],["Diese Zahl ist nicht gelogen, aber sie glättet die Talphasen weg und macht die teuren Wartejahre unsichtbar.",35.19,40.972,[[0,5,35.19],[6,10,35.503],[11,14,35.84],[15,20,36.014],[21,29,36.188],[30,34,36.78],[35,38,37.036],[39,46,37.175],[47,50,37.512],[51,60,37.663],[61,64,38.29],[65,68,38.603],[69,74,38.777],[75,78,38.998],[79,85,39.137],[86,96,39.509],[97,108,40.17]]],["Viele vertrauen ihr Geld „Profis“ an und glauben, es sei betreut, faktisch liegt es oft als unbetreutes Depot da („kaufen und wegschauen“), und im Tal lautet der einzige Rat „aushalten“.",41.297,52.698,[[0,5,41.297],[6,15,41.633],[16,19,42.156],[20,24,42.295],[25,33,42.562],[34,36,43.154],[37,40,43.375],[41,49,43.561],[50,52,43.979],[53,56,44.095],[57,65,44.269],[66,74,45.151],[75,80,45.732],[81,83,46.022],[84,87,46.161],[88,91,46.451],[92,103,46.765],[104,109,47.369],[110,112,47.729],[113,121,48.1],[122,125,48.692],[126,139,48.808],[140,143,49.795],[144,146,50.004],[147,150,50.12],[151,157,50.41],[158,161,50.724],[162,169,50.968],[170,173,51.444],[174,186,51.769]]],["Diese Einordnung richtet sich gegen das Kaufen-und-Wegschauen, nicht gegen ETFs als Instrument; sie ist allgemeine Bildung, keine Aussage über einzelne Anbieter.",52.976,62.299,[[0,5,52.976],[6,16,53.313],[17,24,53.928],[25,29,54.253],[30,35,54.486],[36,39,54.706],[40,62,54.985],[63,68,56.401],[69,74,56.691],[75,79,56.947],[80,83,57.411],[84,95,57.62],[96,99,58.63],[100,103,58.781],[104,114,59.106],[115,123,59.64],[124,129,60.302],[130,137,60.627],[138,142,61.068],[143,151,61.289],[152,161,61.695]]],["Auch Profis bekommen Wadenkrämpfe; sie gehen nur besser damit um.",62.543,66.095,[[0,4,62.543],[5,11,62.752],[12,20,63.216],[21,34,63.599],[35,38,64.726],[39,44,64.9],[45,48,65.097],[49,55,65.236],[56,61,65.527],[62,65,65.805]]],["Wir trainieren dreierlei: den Krampf früh erkennen → ihn durchhalten statt am Tiefpunkt aufzugeben → das Tal mit der Zeit methodisch navigieren.",66.374,74.548,[[0,3,66.374],[4,14,66.548],[15,25,66.978],[26,29,67.883],[30,36,68.104],[37,41,68.464],[42,50,68.789],[51,52,69.358],[53,56,69.567],[57,68,69.764],[69,74,70.345],[75,77,70.635],[78,87,70.774],[88,98,71.262],[99,100,71.982],[101,104,72.272],[105,108,72.527],[109,112,72.818],[113,116,72.957],[117,121,73.131],[122,132,73.468],[133,144,73.944]]],["Wer durchläuft, unterbricht den Zinseszins nicht.",74.757,77.555,[[0,3,74.757],[4,15,74.942],[16,27,75.546],[28,31,76.01],[32,42,76.185],[43,49,76.881]]]]}