{"s":[["Fonds und ETF, der gemeinsame Korb",0.0,2.635,[[0,5,0.0],[6,9,0.453],[10,14,0.627],[15,18,1.625],[19,29,1.776],[30,34,2.392]]],["Fünfhundert Aktien einzeln kaufen?",2.717,4.621,[[0,11,2.717],[12,18,3.251],[19,26,3.68],[27,34,4.052]]],["Ein Albtraum.",5.062,6.107,[[0,3,5.062],[4,13,5.329]]],["Eleganter: alles in einen Korb, mit einer Order gekauft.",6.548,10.728,[[0,10,6.548],[11,16,7.93],[17,19,8.324],[20,25,8.475],[26,31,8.719],[32,35,9.265],[36,41,9.462],[42,47,9.718],[48,56,10.031]]],["Dieser Korb heißt Fonds; seine günstigste Bauform heißt ETF.",11.169,15.615,[[0,6,11.169],[7,11,11.564],[12,17,11.877],[18,24,12.26],[25,30,13.201],[31,41,13.491],[42,49,14.06],[50,55,14.571],[56,60,14.884]]],["Die wichtigste Gabelung, zwei Arten, den Korb zu füllen:",16.057,19.633,[[0,3,16.057],[4,14,16.219],[15,24,16.73],[25,29,17.508],[30,36,17.822],[37,40,18.437],[41,45,18.692],[46,48,18.994],[49,56,19.168]]],["Wer füllt den Korb? ein Manager-Team wählt aus",20.329,23.116,[[0,3,20.329],[4,9,20.678],[10,13,20.91],[14,19,21.084],[20,23,21.966],[24,36,22.175],[37,42,22.802],[43,46,23.023]]],["Laufende Kosten / Jahr: oft rund 1,5 bis 2 %",23.174,27.249,[[0,8,23.174],[9,15,23.534],[16,17,24.114],[18,23,24.254],[24,27,25.182],[28,32,25.438],[33,36,25.786],[37,40,26.506],[41,42,26.692],[43,44,26.97]]],["Wer füllt den Korb? ein Index-Rezept",27.853,30.488,[[0,3,27.853],[4,9,28.108],[10,13,28.306],[14,19,28.468],[20,23,29.501],[24,36,29.745]]],["Laufende Kosten / Jahr: oft nur 0,05 bis 0,50 %",31.08,35.713,[[0,8,31.08],[9,15,31.498],[16,17,32.079],[18,23,32.241],[24,27,33.089],[28,31,33.391],[32,36,33.751],[37,40,34.621],[41,45,34.796],[46,47,35.689]]],["Das Geld im Fonds ist Sondervermögen, rechtlich getrennt vom Anbieter, es gehört weiter dir.",36.421,41.576,[[0,3,36.421],[4,8,36.641],[9,11,36.885],[12,17,37.025],[18,21,37.373],[22,37,37.524],[38,47,38.569],[48,56,38.975],[57,60,39.323],[61,70,39.509],[71,73,40.31],[74,80,40.531],[81,87,40.856],[88,92,41.146]]],["Aber ehrlich:",42.179,43.062,[[0,4,42.179],[5,13,42.493]]],["Sondervermögen schützt vor der Pleite des Anbieters, nicht vor Kursrückgängen.",43.503,47.717,[[0,14,43.503],[15,22,44.432],[23,26,44.826],[27,30,44.954],[31,37,45.082],[38,41,45.442],[42,52,45.616],[53,58,46.463],[59,62,46.777],[63,78,46.928]]],["Ein Insolvenz-Schutz, kein Markt-Schutz.",48.228,50.527,[[0,3,48.228],[4,21,48.449],[22,26,49.575],[27,40,49.877]]]]}