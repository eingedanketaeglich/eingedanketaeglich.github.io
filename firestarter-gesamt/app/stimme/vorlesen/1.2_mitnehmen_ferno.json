{"s":[["Was du mitnimmst",0.0,0.906,[[0,3,0.0],[4,6,0.267],[7,16,0.383]]],["Drei Sätze, und die Fragen, die jetzt oft kommen.",1.683,4.505,[[0,4,1.683],[5,11,2.043],[12,15,2.833],[16,19,2.961],[20,27,3.077],[28,31,3.46],[32,37,3.576],[38,41,3.855],[42,49,4.087]]],["Drei Sätze zum Mitnehmen",5.561,6.966,[[0,4,5.561],[5,10,5.898],[11,14,6.281],[15,24,6.49]]],["Kontinuität schlägt Höhe, der Motor ist das „hoch n“, nicht der Zinssatz.",7.872,12.992,[[0,11,7.872],[12,19,8.707],[20,25,9.044],[26,29,9.961],[30,35,10.112],[36,39,10.403],[40,43,10.519],[44,49,10.67],[50,53,11.041],[54,59,11.703],[60,63,12.063],[64,73,12.237]]],["37.000 € sind der entgangene Lauf, nie entstanden, nicht entnommen.",13.897,18.878,[[0,6,13.897],[7,8,14.884],[9,13,15.232],[14,17,15.395],[18,28,15.523],[29,34,16.057],[35,38,16.858],[39,50,17.078],[51,56,18.019],[57,67,18.332]]],["Langes Verharren im Tal kostet jedes Jahr plus dessen Zinseszins, teurer als ein erholter Sturz.",19.946,26.146,[[0,6,19.946],[7,16,20.399],[17,19,20.933],[20,23,21.06],[24,30,21.397],[31,36,21.815],[37,41,22.163],[42,46,22.384],[47,53,22.686],[54,65,22.999],[66,72,24.172],[73,76,24.787],[77,80,25.008],[81,89,25.147],[90,96,25.612]]],["Häufige Fragen, kurz & klar",26.831,28.537,[[0,7,26.831],[8,15,27.307],[16,20,27.829],[21,22,28.131],[23,27,28.224]]],["Sind die 7 % ein Renditeversprechen?",28.92,31.405,[[0,4,28.92],[5,8,29.129],[9,10,29.292],[11,12,29.64],[13,16,30.047],[17,36,30.337]]],["Wurden die 37.000 € in einem Crash „verloren“?",31.997,35.666,[[0,6,31.997],[7,10,32.264],[11,17,32.403],[18,19,33.495],[20,22,33.878],[23,28,34.017],[29,34,34.238],[35,46,34.737]]],["Soll ich bei jedem Tal verkaufen oder aktiv handeln?",36.455,39.323,[[0,4,36.455],[5,8,36.675],[9,12,36.792],[13,18,36.942],[19,22,37.244],[23,32,37.511],[33,37,38.115],[38,43,38.324],[44,52,38.754]]],["Ist „kaufen und liegen lassen“ also schlecht?",39.926,42.597,[[0,3,39.926],[4,11,40.286],[12,15,40.971],[16,22,41.134],[23,30,41.436],[31,35,41.749],[36,45