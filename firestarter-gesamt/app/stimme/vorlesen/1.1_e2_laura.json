{"s":[["Nimm diese Fragen mit",0.0,1.033,[[0,4,0.0],[5,10,0.267],[11,17,0.534],[18,21,0.906]]],["Drei Neugier-Fragen, und dein erster eigener Schritt.",1.057,4.133,[[0,4,1.057],[5,20,1.37],[21,24,2.287],[25,29,2.45],[30,36,2.705],[37,44,3.204],[45,53,3.622]]],["Warum gehört „der Funke“ dir, und nicht dem Berater?",4.574,7.663,[[0,5,4.574],[6,12,4.923],[13,17,5.248],[18,24,5.654],[25,29,6.002],[30,33,6.397],[34,39,6.583],[40,43,6.792],[44,52,6.943]]],["Warum schützt dich gerade das, was ein Programm nicht verspricht?",7.988,11.157,[[0,5,7.988],[6,13,8.336],[14,18,8.649],[19,25,8.835],[26,30,9.23],[31,34,9.497],[35,38,9.694],[39,47,9.822],[48,53,10.24],[54,65,10.437]]],["Warum sind „Finanzen und Börse kein Hobby“?",11.436,13.955,[[0,5,11.436],[6,10,11.784],[11,20,12.04],[21,24,12.736],[25,30,12.864],[31,35,13.235],[36,43,13.444]]],["So nutzt du eine Neugier-Frage",14.338,15.824,[[0,2,14.338],[3,8,14.571],[9,11,14.814],[12,16,14.954],[17,30,15.139]]],["Innehalten statt googeln:",15.871,17.38,[[0,10,15.871],[11,16,16.498],[17,25,16.776]]],["Du nimmst die Frage einfach mit in die Lektion.",17.624,20.097,[[0,2,17.624],[3,9,17.798],[10,13,18.042],[14,19,18.17],[20,27,18.564],[28,31,19.017],[32,34,19.238],[35,38,19.319],[39,47,19.435]]],["Beim Lesen mitdenken:",20.422,21.873,[[0,4,20.422],[5,10,20.712],[11,21,21.084]]],["Sobald etwas dazu auftaucht:",22.198,24.033,[[0,6,22.198],[7,12,22.686],[13,17,22.999],[18,28,23.313]]],["Aha, ein Stück der Antwort.",24.277,25.983,[[0,4,24.277],[5,8,24.857],[9,14,25.043],[15,18,25.321],[19,27,25.449]]],["Selbst beantworten:",26.157,27.318,[[0,6,26.157],[7,19,26.54]]],["Am Ende sagst du sie dir in eigenen Worten.",27.562,30.012,[[0,2,27.562],[3,7,27.771],[8,13,28.027],[14,16,28.329],[17,20,28.456],[21,24,28.607],[25,27,28.886],[28,35,29.095],[36,43,29.478]]],["Öffne dein Online-Banking und sieh dir eine einzige Zahl an:",30.186,33.309,[[0,5,30.186],[6,10,30.535],[11,25,30.732],[26,29,31.498],[30,34,31.638],[35,38,31.789],[39,43,31.951],[4