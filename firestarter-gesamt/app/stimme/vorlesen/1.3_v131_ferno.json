{"s":[["Der Berater meint es gut, und macht dich trotzdem abhängig",0.0,3.251,[[0,3,0.0],[4,11,0.209],[12,17,0.639],[18,20,0.894],[21,25,1.022],[26,29,1.718],[30,35,1.892],[36,40,2.09],[41,49,2.287],[50,58,2.844]]],["Anlageberatung ist, nüchtern betrachtet, ein Geschäftsmodell.",3.332,7.221,[[0,14,3.332],[15,19,4.261],[20,28,4.795],[29,40,5.213],[41,44,6.177],[45,61,6.327]]],["Und es lebt von einer Lücke.",8.336,10.019,[[0,3,8.336],[4,6,8.638],[7,11,8.812],[12,15,9.056],[16,21,9.276],[22,28,9.567]]],["Die Wissens-Lücke",10.623,11.575,[[0,3,10.623],[4,17,10.855]]],["Du weißt weniger als der Berater, genau dieser Abstand ist sein Wert.",12.69,16.962,[[0,2,12.69],[3,8,12.875],[9,16,13.224],[17,20,13.735],[21,24,13.886],[25,33,14.013],[34,39,14.849],[40,46,15.267],[47,54,15.615],[55,58,16.057],[59,63,16.219],[64,69,16.509]]],["Schließt sich die Lücke, braucht man ihn weniger.",17.775,20.387,[[0,8,17.775],[9,13,18.158],[14,17,18.32],[18,24,18.437],[25,32,19.156],[33,36,19.505],[37,40,19.667],[41,49,19.807]]],["Das fertige Produkt",20.991,22.187,[[0,3,20.991],[4,11,21.269],[12,19,21.734]]],["Oft steht am Ende ein Produkt, das ohnehin verkauft werden soll.",23.487,27.249,[[0,3,23.487],[4,9,23.835],[10,12,24.149],[13,17,24.311],[18,21,24.613],[22,30,24.776],[31,34,25.449],[35,42,25.728],[43,51,26.192],[52,58,26.622],[59,64,26.889]]],["Die Frage ist nicht ob, sondern welches.",27.945,30.314,[[0,3,27.945],[4,9,28.108],[10,13,28.444],[14,19,28.595],[20,23,28.851],[24,31,29.315],[32,40,29.652]]],["Abgegebene Verantwortung",31.01,32.357,[[0,10,31.01],[11,24,31.672]]],["Du delegierst die Entscheidung, und damit das Verstehen.",32.961,35.956,[[0,2,32.961],[3,13,33.239],[14,17,33.762],[18,31,33.89],[32,35,34.702],[36,41,34.865],[42,45,35.144],[46,56,35.318]]],["Bequem heute, teuer auf Dauer.",36.398,38.394,[[0,6,36.398],[7,13,36.908],[14,19,37.373],[20,23,37.744],[24,30,37.918]]],["Das Problem ist nicht der schlechte Berater, es ist das gute Modell.",39.207,42.946,[[0,3,39.207],[4,11,39.428],[12,15,39.846],[16,21,40.008],[22,25,40.194],[26,35,40.333],[36,44,40.728],[45,47,41.622],[48,51,41.808],[52,55,41.935],[56,60,42.121],[61,68,42.411]]],["Selbst ein ehrlicher, kompetenter Berater arbeitet in einem System, das von deiner Unwissenheit lebt.",43.549,49.319,[[0,6,43.549],[7,10,43.909],[11,21,44.095],[22,33,44.583],[34,41,45.198],[42,50,45.732],[51,53,46.138],[54,59,46.231],[60,67,46.452],[68,71,47.357],[72,75,47.566],[76,82,47.729],[83,95,48.019],[96,101,48.716]]]]}