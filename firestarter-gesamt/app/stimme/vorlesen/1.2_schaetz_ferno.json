{"s":[["Schätzrunde:",0.0,0.824,[[0,12,0.0]]],["Wie gut ist dein Gefühl?",1.637,3.065,[[0,3,1.637],[4,7,1.904],[8,11,2.183],[12,16,2.322],[17,24,2.508]]],["Vier Fragen, mal ist die Endsumme geschwärzt, mal die Jahre.",3.762,7.814,[[0,4,3.762],[5,12,4.098],[13,16,5.016],[17,20,5.375],[21,24,5.503],[25,33,5.654],[34,45,6.049],[46,49,6.931],[50,53,7.163],[54,60,7.268]]],["Schätze, dann laufen 10 Sekunden; danach erscheint die Lösung.",8.51,11.97,[[0,8,8.51],[9,13,8.916],[14,20,9.114],[21,23,9.474],[24,33,9.752],[34,40,10.542],[41,50,10.96],[51,54,11.331],[55,62,11.447]]],["Es wird nichts benotet.",12.481,13.839,[[0,2,12.481],[3,7,12.666],[8,14,12.841],[15,23,13.061]]]]}