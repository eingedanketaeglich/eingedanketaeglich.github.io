{"s":[["Warum diese Rechnung in keinem Bankprospekt steht",0.0,2.891,[[0,5,0.0],[6,11,0.383],[12,20,0.639],[21,23,1.115],[24,30,1.242],[31,43,1.567],[44,49,2.473]]],["Ist Stehenbleiben nicht besser als Stürzen?",3.332,5.759,[[0,3,3.332],[4,17,3.587],[18,23,4.272],[24,30,4.551],[31,34,4.911],[35,43,5.097]]],["Klingt logisch, ist aber oft falsch.",5.84,8.394,[[0,6,5.84],[7,15,6.165],[16,19,7.163],[20,24,7.361],[25,28,7.523],[29,36,7.79]]],["Echter, schmerzhafter Verlust, steht aber sofort wieder auf.",8.545,12.04,[[0,7,8.545],[8,21,9.056],[22,30,9.764],[31,36,10.53],[37,41,10.809],[42,48,10.971],[49,55,11.32],[56,60,11.564]]],["Der Motor läuft von niedrigerer Basis weiter und holt auf.",12.214,15.522,[[0,3,12.214],[4,9,12.376],[10,15,12.701],[16,19,13.061],[20,31,13.224],[32,37,13.885],[38,44,14.338],[45,48,14.675],[49,53,14.803],[54,58,15.046]]],["Kostet den Motor ein paar Jahre.",15.673,17.264,[[0,6,15.673],[7,10,16.08],[11,16,16.173],[17,20,16.498],[21,25,16.625],[26,32,16.8]]],["Verliert optisch nichts Neues, bleibt aber unten.",17.38,20.712,[[0,8,17.38],[9,16,17.821],[17,23,18.274],[24,30,18.715],[31,37,19.621],[38,42,20.016],[43,49,20.213]]],["Der Motor produziert jedes Jahr nichts.",20.886,23.011,[[0,3,20.886],[4,9,21.049],[10,20,21.351],[21,26,21.85],[27,31,22.129],[32,39,22.338]]],["Kostet jedes Jahr plus dessen Zins-auf-Zins.",23.127,26.436,[[0,6,23.127],[7,12,23.557],[13,17,23.847],[18,22,24.125],[23,29,24.683],[30,44,25.043]]],["Der Knoten, den die meisten nicht sehen:",26.552,28.387,[[0,3,26.552],[4,11,26.726],[12,15,27.156],[16,19,27.307],[20,27,27.423],[28,33,27.783],[34,40,28.015]]],["Beim Zinseszins ist die Zeit der Treibstoff, nicht der momentane Punktestand.",28.596,33.275,[[0,4,28.596],[5,15,28.84],[16,19,29.71],[20,23,29.861],[24,28,30.035],[29,32,30.395],[33,44,30.546],[45,50,31.382],[51,54,31.58],[55,64,31.777],[65,77,32.404]]],["Ein Prospekt zeigt dir meist nur die Durchschnitts-Rendite über den ganzen Zeitraum.",33.449,37.826,[[0,3,33.449],[4,12,33.6],[13,18,34.157],[19,22,34.389],[23,28,34.494],[29,32,34.737],[33,36,34.865],[37,58,35.051],[59,63,36.328],[64,67,36.514],[68,74,36.665],[75,84,37.106]]],["Diese Zahl ist nicht gelogen, aber sie glättet die Talphasen weg und macht die teuren Wartejahre unsichtbar.",38.07,43.944,[[0,5,38.07],[6,10,38.383],[11,14,38.627],[15,20,38.743],[21,29,38.998],[30,34,39.509],[35,38,39.683],[39,46,39.823],[47,50,40.275],[51,60,40.461],[61,64,41.053],[65,68,41.39],[69,74,41.518],[75,78,41.715],[79,85,41.866],[86,96,42.353],[97,108,43.143]]],["Viele vertrauen ihr Geld „Profis“ an und glauben, es sei betreut, faktisch liegt es oft als unbetreutes Depot da („kaufen und wegschauen“), und im Tal lautet der einzige Rat „aushalten“.",44.188,55.937,[[0,5,44.188],[6,15,44.478],[16,19,44.943],[20,24,45.059],[25,33,45.465],[34,36,46.521],[37,40,46.847],[41,49,46.974],[50,52,47.334],[53,56,47.439],[57,65,47.59],[66,74,48.472],[75,80,48.89],[81,83,49.122],[84,87,49.25],[88,91,49.482],[92,103,49.784],[104,109,50.446],[110,112,50.852],[113,121,51.258],[122,125,52.025],[126,139,52.152],[140,143,53.035],[144,146,53.151],[147,150,53.267],[151,157,53.58],[158,161,53.882],[162,169,54.021],[170,173,54.427],[174,186,54.857]]],["Diese Einordnung richtet sich gegen das Kaufen-und-Wegschauen, nicht gegen ETFs als Instrument; sie ist allgemeine Bildung, keine Aussage über einzelne Anbieter.",56.181,65.933,[[0,5,56.181],[6,16,56.448],[17,24,56.912],[25,29,57.237],[30,35,57.411],[36,39,57.632],[40,62,57.887],[63,68,59.954],[69,74,60.383],[75,79,60.685],[80,83,61.301],[84,95,61.521],[96,99,62.543],[100,103,62.682],[104,114,62.856],[115,123,63.286],[124,129,64.064],[130,137,64.342],[138,142,64.842],[143,151,65.051],[152,161,65.41]]],["Auch Profis bekommen Wadenkrämpfe; sie gehen nur besser damit um.",65.979,70.38,[[0,4,65.979],[5,11,66.339],[12,20,66.978],[21,34,67.581],[35,38,68.905],[39,44,69.08],[45,48,69.289],[49,55,69.451],[56,61,69.73],[62,65,69.997]]],["Wir trainieren dreierlei: den Krampf früh erkennen → ihn durchhalten statt am Tiefpunkt aufzugeben → das Tal mit der Zeit methodisch navigieren.",70.554,79.447,[[0,3,70.554],[4,14,70.74],[15,25,71.111],[26,29,71.901],[30,36,72.18],[37,41,72.76],[42,50,73.097],[51,52,73.596],[53,56,73.793],[57,68,74.002],[69,74,74.745],[75,77,74.978],[78,87,75.105],[88,98,75.744],[99,100,76.533],[101,104,76.812],[105,108,76.998],[109,112,77.253],[113,116,77.381],[117,121,77.532],[122,132,77.985],[133,144,78.658]]],["Wer durchläuft, unterbricht den Zinseszins nicht.",79.726,82.849,[[0,3,79.726],[4,15,79.889],[16,27,80.69],[28,31,81.189],[32,42,81.375],[43,49,82.234]]]]}