{"s":[["Wo warst du bisher abhängig?",0.0,1.521,[[0,2,0.0],[3,8,0.221],[9,11,0.488],[12,18,0.592],[19,28,0.906]]],["Abhängigkeit ist kein Grund für Scham, sie ist normal, solange das Wissen fehlt.",2.125,6.745,[[0,12,2.125],[13,16,2.879],[17,21,3.053],[22,27,3.297],[28,31,3.529],[32,38,3.669],[39,42,4.423],[43,46,4.574],[47,54,4.748],[55,62,5.364],[63,66,5.747],[67,73,5.921],[74,80,6.223]]],["Der erste Akt der Selbstbestimmung ist, sie zu sehen.",7.349,10.437,[[0,3,7.349],[4,9,7.535],[10,13,7.941],[14,17,8.15],[18,34,8.278],[35,39,9.091],[40,43,9.532],[44,46,9.752],[47,53,9.938]]],["Bei welcher Geldentscheidung habe ich zuletzt einfach vertraut, ohne es selbst zu verstehen?",11.041,16.196,[[0,3,11.041],[4,11,11.227],[12,28,11.633],[29,33,12.655],[34,37,12.922],[38,45,13.05],[46,53,13.514],[54,63,13.886],[64,68,14.617],[69,71,14.919],[72,78,15.035],[79,81,15.395],[82,92,15.546]]],["Wem habe ich sie überlassen, und welches Interesse hatte diese Person oder Stelle?",16.893,21.665,[[0,3,16.893],[4,8,17.241],[9,12,17.497],[13,16,17.613],[17,28,17.764],[29,32,18.658],[33,40,18.82],[41,50,19.168],[51,56,19.737],[57,62,19.97],[63,69,20.202],[70,74,20.805],[75,82,21.061]]],["Was müsste ich verstehen, um es beim nächsten Mal selbst zu entscheiden?",22.175,26.053,[[0,3,22.175],[4,10,22.454],[11,14,22.791],[15,25,22.919],[26,28,23.766],[29,31,23.917],[32,36,24.021],[37,45,24.219],[46,49,24.579],[50,56,24.799],[57,59,25.194],[60,72,25.368]]],["Erster praktischer Schritt, der Notgroschen",27.168,29.908,[[0,6,27.168],[7,18,27.609],[19,27,28.131],[28,31,29.06],[32,43,29.234]]],["Eine Reserve aus 3 bis 6 Netto-Monatsgehältern auf einem getrennten Konto fängt Notfälle ab, ohne dass du in Panik etwas verkaufen musst.",31.023,39.684,[[0,4,31.023],[5,12,31.359],[13,16,31.917],[17,18,32.172],[19,22,32.427],[23,24,32.59],[25,46,32.973],[47,50,34.424],[51,56,34.633],[57,67,34.831],[68,73,35.33],[74,79,36.026],[80,88,36.375],[89,92,36.851],[93,97,37.327],[98,102,37.64],[103,105,37.814],[106,108,37.942],[109,114,38.058],[115,120,38.465],[121,130,38.755],[131,137,39.231]]],["Er ist der erste der vier Geldtöpfe, mehr dazu in Baustein 2.",40.496,44.734,[[0,2,40.496],[3,6,40.67],[7,10,40.798],[11,16,40.961],[17,20,41.367],[21,25,41.518],[26,36,41.762],[37,41,42.853],[42,46,43.074],[47,49,43.515],[50,58,43.643],[59,61,44.165]]],["Kreuze an, was auf dich zutrifft.",45.117,47.242,[[0,6,45.117],[7,10,45.547],[11,14,45.965],[15,18,46.197],[19,23,46.324],[24,33,46.511]]],["Ein Spiegel, keine Beratung, nichts wird gespeichert.",47.683,51.364,[[0,3,47.683],[4,12,47.939],[13,18,48.693],[19,28,49.007],[29,35,49.959],[36,40,50.354],[41,53,50.551]]],["Drei Sätze zum Mitnehmen",52.176,53.546,[[0,4,52.176],[5,10,52.559],[11,14,52.931],[15,24,53.105]]],["Anlageberatung lebt von der Wissens-Lücke, das Problem ist das Modell, nicht die Person.",53.604,59.224,[[0,14,53.604],[15,19,54.707],[20,23,55.021],[24,27,55.183],[28,42,55.323],[43,46,56.46],[47,54,56.681],[55,58,57.122],[59,62,57.261],[63,70,57.424],[71,76,58.214],[77,80,58.457],[81,88,58.585]]],["Bildung will sich selbst überflüssig machen; Beratung hält die Abhängigkeit.",60.036,64.518,[[0,7,60.036],[8,12,60.501],[13,17,60.675],[18,24,60.861],[25,36,61.29],[37,44,61.882],[45,53,62.626],[54,58,63.264],[59,62,63.461],[63,76,63.589]]],["Der erste Akt der Selbstbestimmung ist, die eigene Abhängigkeit zu erkennen, der Notgroschen ist der erste praktische Schritt.",65.633,73.376,[[0,3,65.633],[4,9,65.842],[10,13,66.225],[14,17,66.445],[18,34,66.585],[35,39,67.374],[40,43,68.071],[44,50,68.268],[51,63,68.709],[64,66,69.359],[67,76,69.487],[77,80,70.416],[81,92,70.602],[93,96,71.414],[97,100,71.612],[101,106,71.797],[107,117,72.204],[118,126,72.703]]]]}