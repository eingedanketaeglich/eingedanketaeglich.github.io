{"s":[["Die Aktie, ein Stück Eigentum",0.0,2.438,[[0,3,0.0],[4,10,0.244],[11,14,0.987],[15,20,1.3],[21,29,1.695]]],["Gibst du dem Bäcker 100 € und dir gehört dafür ein winziges Stück von allem, hast du ihm Geld geliehen?",2.879,9.172,[[0,5,2.879],[6,8,3.228],[9,12,3.367],[13,19,3.529],[20,23,3.866],[24,25,4.377],[26,29,4.772],[30,33,4.899],[34,40,5.05],[41,46,5.375],[47,50,5.817],[51,59,5.956],[60,65,6.444],[66,69,6.769],[70,76,7.059],[77,81,7.709],[82,84,7.93],[85,88,8.057],[89,93,8.22],[94,103,8.545]]],["Nein.",9.497,10.054,[[0,5,9.497]]],["Du bist Mit-Eigentümer.",10.298,11.831,[[0,2,10.298],[3,7,10.495],[8,23,10.762]]],["Genau das ist eine Aktie: ein Eigentumsanteil.",12.04,16.01,[[0,5,12.04],[6,9,12.469],[10,13,12.864],[14,18,13.084],[19,25,13.317],[26,29,14.118],[30,46,14.408]]],["Als Eigentümer profitierst du auf zwei Wegen:",16.254,19.028,[[0,3,16.254],[4,14,16.533],[15,26,17.194],[27,29,17.786],[30,33,17.937],[34,38,18.158],[39,45,18.471]]],["Dividende",19.354,20.143,[[0,9,19.354]]],["dein Anteil am ausgeschütteten Gewinn",20.352,22.5,[[0,4,20.352],[5,11,20.7],[12,14,21.199],[15,30,21.362],[31,37,22.117]]],["Wertsteigerung",22.825,23.777,[[0,14,22.825]]],["wollen mehr Leute ein Stück, steigt der Preis deines Anteils",23.847,27.736,[[0,6,23.847],[7,11,24.276],[12,17,24.555],[18,21,25.077],[22,28,25.275],[29,35,26.006],[36,39,26.343],[40,45,26.482],[46,52,26.819],[53,60,27.132]]],["Beide Wege haben eine Kehrseite:",28.177,30.487,[[0,5,28.177],[6,10,28.56],[11,16,28.932],[17,21,29.326],[22,32,29.617]]],["Läuft das Unternehmen schlecht, fällt die Dividende aus und der Wert kann sinken.",30.813,35.584,[[0,5,30.813],[6,9,31.068],[10,21,31.242],[22,31,31.765],[32,37,32.542],[38,41,32.821],[42,51,32.926],[52,55,33.494],[56,59,33.994],[60,63,34.156],[64,68,34.307],[69,73,34.667],[74,81,34.922]]],["Als Eigentümer trägst du das unternehmerische Risiko mit, du sitzt im selben Boot.",35.863,40.82,[[0,3,35.863],[4,14,36.107],[15,21,36.699],[22,24,37.012],[25,28,37.163],[29,45,37.395],[46,52,38.127],[53,57,38.696],[58,60,39.241],[61,66,39.427],[67,69,39.752],[70,76,39.903],[77,82,40.286]]],["Eine Aktie ist kein Papier mit hüpfenden Zahlen, sondern ein Eigentumstitel mit Stimmrecht.",41.145,46.985,[[0,4,41.145],[5,10,41.401],[11,14,41.877],[15,19,42.086],[20,26,42.318],[27,30,42.759],[31,40,42.91],[41,48,43.456],[49,56,44.199],[57,60,44.675],[61,75,44.919],[76,79,45.964],[80,91,46.149]]],["Du bist nicht Kunde des Marktes, sondern Teilhaber an echter Wirtschaft, einen garantierten Ertrag gibt es dafür nicht.",47.31,54.892,[[0,2,47.31],[3,7,47.484],[8,13,47.74],[14,19,47.984],[20,23,48.32],[24,32,48.518],[33,40,49.284],[41,50,49.748],[51,53,50.422],[54,60,50.596],[61,72,50.921],[73,78,51.745],[79,91,52.094],[92,98,52.79],[99,103,53.382],[104,106,53.754],[107,112,53.905],[113,119,54.276]]]]}