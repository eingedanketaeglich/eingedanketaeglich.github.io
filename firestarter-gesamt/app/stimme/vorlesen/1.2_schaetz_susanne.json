{"s":[["Schätzrunde:",0.0,0.906,[[0,12,0.0]]],["Wie gut ist dein Gefühl?",1.149,2.694,[[0,3,1.149],[4,7,1.37],[8,11,1.707],[12,16,1.846],[17,24,2.043]]],["Vier Fragen, mal ist die Endsumme geschwärzt, mal die Jahre.",2.972,6.838,[[0,4,2.972],[5,12,3.239],[13,16,4.098],[17,20,4.4],[21,24,4.516],[25,33,4.679],[34,45,5.132],[46,49,5.898],[50,53,6.118],[54,60,6.223]]],["Schätze, dann laufen 10 Sekunden; danach erscheint die Lösung.",7.163,11.006,[[0,8,7.163],[9,13,7.709],[14,20,7.953],[21,23,8.348],[24,33,8.649],[34,40,9.451],[41,50,9.915],[51,54,10.286],[55,62,10.426]]],["Es wird nichts benotet.",11.331,12.817,[[0,2,11.331],[3,7,11.552],[8,14,11.726],[15,23,11.981]]]]}