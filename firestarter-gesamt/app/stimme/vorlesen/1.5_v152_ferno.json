{"s":[["Deine drei Nordsterne als Zielkoordinaten",0.0,2.81,[[0,5,0.0],[6,10,0.372],[11,21,0.685],[22,25,1.405],[26,41,1.707]]],["Je eine Aussage, die in 12 Monaten wahr sein soll.",3.413,6.92,[[0,2,3.413],[3,7,3.704],[8,16,3.889],[17,20,4.702],[21,23,4.876],[24,26,5.016],[27,34,5.55],[35,39,6.06],[40,44,6.304],[45,50,6.548]]],["„Ich verstehe meine Geldentscheidungen und kann gute von schlechten Ratschlägen unterscheiden.“",7.198,12.074,[[0,4,7.198],[5,13,7.535],[14,19,8.011],[20,38,8.266],[39,42,9.172],[43,47,9.358],[48,52,9.648],[53,56,10.066],[57,67,10.275],[68,79,10.762],[80,95,11.343]]],["„Ich baue ununterbrochen auf.",13.189,15.139,[[0,4,13.189],[5,9,13.572],[10,24,13.944],[25,29,14.721]]],["Der Lauf wird nicht unterbrochen - ich handle bewusst, egal was der Markt macht.“",15.418,20.062,[[0,3,15.418],[4,8,15.616],[9,13,15.906],[14,19,16.173],[20,32,16.417],[33,34,17.183],[35,38,17.496],[39,45,17.682],[46,54,17.961],[55,59,18.623],[60,63,19.006],[64,67,19.192],[68,73,19.308],[74,81,19.586]]],["„Ich bin nicht beratungsresistent, kann aber meine Entscheidungen selbst treffen und begründen.“",21.177,26.25,[[0,4,21.177],[5,8,21.548],[9,14,21.746],[15,34,21.99],[35,39,23.325],[40,44,23.534],[45,50,23.719],[51,65,23.986],[66,72,24.625],[73,80,24.985],[81,84,25.403],[85,96,25.531]]],["Die meisten kennen ihren Kontostand, aber nicht ihr Wofür.",26.947,30.593,[[0,3,26.947],[4,11,27.121],[12,18,27.574],[19,24,27.934],[25,36,28.212],[37,41,29.199],[42,47,29.466],[48,51,29.733],[52,58,29.884]]],["Der Brief dreht das um: erst die Richtung, dann die Zahl.",31.289,35.295,[[0,3,31.289],[4,9,31.498],[10,15,31.8],[16,19,32.044],[20,23,32.357],[24,28,33.251],[29,32,33.46],[33,42,33.588],[43,47,34.319],[48,51,34.54],[52,57,34.691]]]]}