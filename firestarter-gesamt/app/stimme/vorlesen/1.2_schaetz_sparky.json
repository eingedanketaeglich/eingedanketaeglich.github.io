{"s":[["Schätzrunde:",0.0,0.94,[[0,12,0.0]]],["Wie gut ist dein Gefühl?",1.451,2.961,[[0,3,1.451],[4,7,1.66],[8,11,1.985],[12,16,2.125],[17,24,2.31]]],["Vier Fragen, mal ist die Endsumme geschwärzt, mal die Jahre.",3.564,7.639,[[0,4,3.564],[5,12,3.878],[13,16,4.737],[17,20,5.05],[21,24,5.178],[25,33,5.341],[34,45,5.759],[46,49,6.653],[50,53,6.92],[54,60,7.036]]],["Schätze, dann laufen 10 Sekunden; danach erscheint die Lösung.",8.081,12.318,[[0,8,8.081],[9,13,8.789],[14,20,9.021],[21,23,9.392],[24,33,9.659],[34,40,10.774],[41,50,11.227],[51,54,11.587],[55,62,11.703]]],["Es wird nichts benotet.",12.597,14.257,[[0,2,12.597],[3,7,12.841],[8,14,13.119],[15,23,13.398]]]]}