{"s":[["Was du mitnimmst, und dein Anker",0.0,1.73,[[0,3,0.0],[4,6,0.221],[7,17,0.313],[18,21,1.219],[22,26,1.347],[27,32,1.509]]],["Drei Sätze, die wichtigsten Begriffe, dein persönliches Warum.",1.753,5.468,[[0,4,1.753],[5,11,1.997],[12,15,2.473],[16,27,2.624],[28,37,3.146],[38,42,4.052],[43,55,4.342],[56,62,4.946]]],["Drei Sätze zum Mitnehmen",5.712,6.908,[[0,4,5.712],[5,10,6.026],[11,14,6.339],[15,24,6.502]]],["Finanzwissen · Selbstbestimmung · Vermögensaufbau, die drei Leitbegriffe.",6.954,11.494,[[0,12,6.954],[13,14,7.802],[15,31,8.022],[32,33,9.021],[34,50,9.125],[51,54,10.252],[55,59,10.403],[60,73,10.739]]],["Bildung, kein Verkaufsgespräch, ehrliche Grenzen schützen dich.",11.773,15.291,[[0,8,11.773],[9,13,12.33],[14,31,12.527],[32,40,13.537],[41,48,13.921],[49,57,14.397],[58,63,14.78]]],["Neun Bausteine, ein Leitsatz.",15.5,17.369,[[0,4,15.5],[5,15,15.778],[16,19,16.475],[20,29,16.672]]],["„Finanzen und Börse sind kein Hobby.“",17.45,19.563,[[0,9,17.45],[10,13,18.065],[14,19,18.181],[20,24,18.634],[25,29,18.878],[30,37,19.11]]],["Der Gedanke, den fast keiner zu Ende denkt",19.842,21.932,[[0,3,19.842],[4,12,19.993],[13,16,20.364],[17,21,20.608],[22,28,20.933],[29,31,21.223],[32,36,21.374],[37,42,21.583]]],["Du hast noch nie einen Euro verloren, und trotzdem fehlt dir am Ende womöglich der größte Teil deines Vermögens.",22.442,28.015,[[0,2,22.442],[3,7,22.616],[8,12,22.767],[13,16,22.907],[17,22,23.104],[23,27,23.348],[28,37,23.673],[38,41,24.323],[42,50,24.486],[51,56,24.892],[57,60,25.113],[61,63,25.229],[64,68,25.391],[69,78,25.589],[79,82,26.065],[83,89,26.239],[90,94,26.68],[95,101,26.97],[102,112,27.237]]],["Nicht, weil dir jemand etwas weggenommen hätte.",28.224,30.117,[[0,6,28.224],[7,11,28.48],[12,15,28.631],[16,22,28.781],[23,28,29.06],[29,40,29.304],[41,47,29.733]]],["Sondern weil dein Geld einfach stillstand, während die Zeit weiterlief.",30.36,34.064,[[0,7,30.36],[8,12,30.662],[13,17,30.813],[18,22,31.011],[23,30,31.417],[31,42,31.696],[43,50,32.415],[51,54,32.671],[55,59,32.845],[60,71,33.251]]],["Das ist das Unheimliche am stillen Saboteur:",34.389,36.63,[[0,3,34.389],[4,7,34.621],[8,11,34.737],[12,23,34.958],[24,26,35.515],[27,34,35.643],[35,44,35.991]]],["Er raubt nichts, was du siehst.",36.955,38.847,[[0,2,36.955],[3,8,37.164],[9,16,37.524],[17,20,37.977],[21,23,38.151],[24,31,38.302]]],["Er verhindert nur, dass etwas entsteht.",39.056,40.832,[[0,2,39.056],[3,13,39.184],[14,18,39.579],[19,23,39.834],[24,29,40.031],[30,39,40.298]]],["Und weil auf deinem Kontoauszug nie eine rote Zahl auftaucht, merkst du jahrelang gar nicht, dass er überhaupt da ist.",40.879,47.996,[[0,3,40.879],[4,8,41.007],[9,12,41.181],[13,19,41.297],[20,31,41.564],[32,35,42.377],[36,40,42.655],[41,45,42.853],[46,50,43.212],[51,61,43.514],[62,68,44.478],[69,71,44.733],[72,81,44.873],[82,85,45.36],[86,92,45.558],[93,97,46.475],[98,100,46.649],[101,110,46.73],[111,113,47.288],[114,118,47.555]]],["In diesem Baustein schaust du ihm zum ersten Mal ins Gesicht, und verstehst, warum genau dieses Nicht-Hinschauen der eigentliche Preis ist.",48.205,55.635,[[0,2,48.205],[3,9,48.344],[10,18,48.565],[19,26,48.994],[27,29,49.273],[30,33,49.354],[34,37,49.517],[38,44,49.691],[45,48,49.935],[49,52,50.12],[53,61,50.26],[62,65,50.991],[66,76,51.142],[77,82,51.954],[83,88,52.279],[89,95,52.639],[96,112,53.069],[113,116,54.009],[117,128,54.253],[129,134,54.88],[135,139,55.24]]],["Begriffe in diesem Baustein",55.844,57.179,[[0,8,55.844],[9,11,56.331],[12,18,56.424],[19,27,56.633]]],["Zinseszins & Zinseszins-Kontinuität",57.457,60.395,[[0,10,57.457],[11,12,58.468],[13,35,58.618]]],["Der stille Saboteur",60.639,61.892,[[0,3,60.639],[4,10,60.871],[11,19,61.184]]],["Die drei Leitbegriffe",62.276,63.506,[[0,3,62.276],[4,8,62.496],[9,21,62.775]]],["Bildung statt Beratung",63.715,65.108,[[0,7,63.715],[8,13,64.342],[14,22,64.563]]],["Notgroschen",65.492,66.142,[[0,11,65.492]]],["Nordsterne & Selbstlern-Bibliothek",66.165,68.034,[[0,10,66.165],[11,12,66.815],[13,34,66.943]]],["Dein Anker:",68.417,69.381,[[0,4,68.417],[5,11,68.789]]],["Mein Warum",69.659,70.391,[[0,4,69.659],[5,10,69.938]]],["Warum nimmst du deine Finanzen gerade jetzt in die Hand?",70.832,73.34,[[0,5,70.832],[6,12,71.157],[13,15,71.389],[16,21,71.482],[22,30,71.668],[31,37,72.109],[38,43,72.365],[44,46,72.643],[47,50,72.724],[51,56,72.852]]],["Ein Satz reicht, nur für dich.",73.456,75.244,[[0,3,73.456],[4,8,73.642],[9,16,73.874],[17,20,74.489],[21,24,74.652],[25,30,74.779]]],["Du greifst ihn in Lektion 1.5, deinem Zukunftsbrief, wieder auf.",75.453,80.097,[[0,2,75.453],[3,10,75.627],[11,14,76.033],[15,17,76.277],[18,25,76.37],[26,30,76.776],[31,37,77.903],[38,52,78.17],[53,59,79.377],[60,64,79.667]]],["Häufige Fragen, kurz & klar",80.248,81.745,[[0,7,80.248],[8,15,80.619],[16,20,80.979],[21,22,81.235],[23,27,81.339]]],["Brauche ich Vorwissen oder Mathematik?",82.128,84.055,[[0,7,82.128],[8,11,82.488],[12,21,82.639],[22,26,83.185],[27,38,83.37]]],["Ist Firestarter eine Anlageberatung?",84.264,86.284,[[0,3,84.264],[4,15,84.45],[16,20,85.17],[21,36,85.344]]],["Bekomme ich ein Renditeversprechen?",86.493,88.096,[[0,7,86.493],[8,11,86.807],[12,15,86.958],[16,35,87.12]]],["Muss ich danach eine Präsenzveranstaltung besuchen?",88.119,90.928,[[0,4,88.119],[5,8,88.305],[9,15,88.409],[16,20,88.757],[21,41,89.036],[42,51,90.174]]]]}