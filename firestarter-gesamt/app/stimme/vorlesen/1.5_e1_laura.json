{"s":[["Der Zukunftsbrief",0.0,1.184,[[0,3,0.0],[4,17,0.267]]],["Ein Seemann steuert nicht nach dem Wasser vor dem Bug, sondern nach einem Stern.",2.299,6.536,[[0,3,2.299],[4,11,2.635],[12,19,3.065],[20,25,3.506],[26,30,3.727],[31,34,3.913],[35,41,4.063],[42,45,4.389],[46,49,4.528],[50,54,4.679],[55,62,5.19],[63,67,5.515],[68,73,5.712],[74,80,5.944]]],["Dein Nordstern ist kein Geldbetrag, er ist die Richtung, die auch dann gilt, wenn die See rau wird.",6.861,12.121,[[0,4,6.861],[5,14,7.105],[15,18,7.732],[19,23,7.93],[24,35,8.243],[36,38,9.288],[39,42,9.52],[43,46,9.659],[47,56,9.787],[57,60,10.205],[61,65,10.368],[66,70,10.577],[71,76,10.774],[77,81,11.029],[82,85,11.192],[86,89,11.331],[90,93,11.517],[94,99,11.703]]],["Diese Lektion schließt Baustein 1 ab: mit einem Brief an dein zukünftiges Ich.",12.365,17.102,[[0,5,12.365],[6,13,12.678],[14,22,13.177],[23,31,13.526],[32,33,14.025],[34,37,14.292],[38,41,14.815],[42,47,15.001],[48,53,15.244],[54,56,15.604],[57,61,15.72],[62,73,15.929],[74,78,16.73]]],["Warum schlägt ein geschriebener Brief den bloßen Vorsatz?",17.427,20.225,[[0,5,17.427],[6,13,17.764],[14,17,18.089],[18,31,18.216],[32,37,18.739],[38,41,19.029],[42,48,19.18],[49,57,19.563]]],["Was ist dein Wofür jenseits des Kontostands?",20.55,23.325,[[0,3,20.55],[4,7,20.794],[8,12,20.933],[13,18,21.154],[19,27,21.653],[28,31,22.222],[32,44,22.408]]],["Was macht eine Selbstverpflichtung überprüfbar?",23.708,26.053,[[0,3,23.708],[4,9,23.963],[10,14,24.184],[15,34,24.393],[35,47,25.194]]],["In Lektion 1.4 hast du eine ehrliche Standortbestimmung gemacht und für jeden der drei Leitbegriffe zwei Marken gesetzt, wo du heute stehst und wo du hinwillst.",26.378,35.295,[[0,2,26.378],[3,10,26.541],[11,14,27.017],[15,19,27.806],[20,22,28.003],[23,27,28.131],[28,36,28.387],[37,55,28.816],[56,63,29.71],[64,67,30.221],[68,71,30.476],[72,77,30.662],[78,81,30.987],[82,86,31.127],[87,99,31.37],[100,104,32.032],[105,111,32.311],[112,120,32.636],[121,123,33.1],[124,126,33.251],[127,132,33.39],[133,139,33.669],[140,143,34.215],[144,146,34.412],[147,149,34.551],[150,160,34.668]]],["Eine niedrige Zahl galt dabei als Startkapital, nicht als Urteil; genau diese Zielwerte werden jetzt zur Rohform deiner Nordsterne.",35.736,43.341,[[0,4,35.736],[5,13,35.979],[14,18,36.444],[19,23,36.827],[24,29,37.036],[30,33,37.384],[34,47,37.547],[48,53,38.51],[54,57,38.754],[58,65,38.928],[66,71,39.741],[72,77,40.101],[78,87,40.38],[88,94,40.995],[95,100,41.297],[101,104,41.599],[105,112,41.797],[113,119,42.342],[120,131,42.598]]],["„Die meisten kennen ihren Kontostand, aber nicht ihr Wofür.“",43.724,47.509,[[0,4,43.724],[5,12,44.072],[13,19,44.525],[20,25,44.838],[26,37,45.105],[38,42,46.023],[43,48,46.301],[49,52,46.603],[53,60,46.731]]]]}