{"s":[["Der Zukunftsbrief",0.0,1.277,[[0,3,0.0],[4,17,0.325]]],["Ein Seemann steuert nicht nach dem Wasser vor dem Bug, sondern nach einem Stern.",1.881,6.502,[[0,3,1.881],[4,11,2.206],[12,19,2.728],[20,25,3.193],[26,30,3.471],[31,34,3.657],[35,41,3.808],[42,45,4.133],[46,49,4.296],[50,54,4.447],[55,62,5.05],[63,67,5.433],[68,73,5.666],[74,80,5.898]]],["Dein Nordstern ist kein Geldbetrag, er ist die Richtung, die auch dann gilt, wenn die See rau wird.",6.78,12.945,[[0,4,6.78],[5,14,7.047],[15,18,7.686],[19,23,7.86],[24,35,8.139],[36,38,9.218],[39,42,9.404],[43,46,9.555],[47,56,9.752],[57,60,10.217],[61,65,10.437],[66,70,10.774],[71,76,11.064],[77,81,11.424],[82,85,11.656],[86,89,11.877],[90,93,12.214],[94,99,12.492]]],["Diese Lektion schließt Baustein 1 ab: mit einem Brief an dein zukünftiges Ich.",13.224,18.263,[[0,5,13.224],[6,13,13.537],[14,22,14.025],[23,31,14.373],[32,33,14.884],[34,37,15.267],[38,41,15.883],[42,47,16.057],[48,53,16.277],[54,56,16.626],[57,61,16.846],[62,73,17.148],[74,78,17.938]]],["Warum schlägt ein geschriebener Brief den bloßen Vorsatz?",18.588,21.49,[[0,5,18.588],[6,13,18.971],[14,17,19.308],[18,31,19.412],[32,37,19.946],[38,41,20.225],[42,48,20.376],[49,57,20.759]]],["Was ist dein Wofür jenseits des Kontostands?",21.734,24.718,[[0,3,21.734],[4,7,21.955],[8,12,22.082],[13,18,22.338],[19,27,23.046],[28,31,23.603],[32,44,23.801]]],["Was macht eine Selbstverpflichtung überprüfbar?",24.996,27.678,[[0,3,24.996],[4,9,25.321],[10,14,25.589],[15,34,25.809],[35,47,26.819]]],["In Lektion 1.4 hast du eine ehrliche Standortbestimmung gemacht und für jeden der drei Leitbegriffe zwei Marken gesetzt, wo du heute stehst und wo du hinwillst.",28.061,37.292,[[0,2,28.061],[3,10,28.247],[11,14,28.735],[15,19,29.478],[20,22,29.675],[23,27,29.792],[28,36,30.035],[37,55,30.5],[56,63,31.382],[64,67,32.009],[68,71,32.206],[72,77,32.357],[78,81,32.682],[82,86,32.845],[87,99,33.135],[100,104,33.878],[105,111,34.285],[112,120,34.656],[121,123,35.109],[124,126,35.271],[127,132,35.399],[133,139,35.724],[140,143,36.142],[144,146,36.305],[147,149,36.456],[150,160,36.595]]],["Eine niedrige Zahl galt dabei als Startkapital, nicht als Urteil; genau diese Zielwerte werden jetzt zur Rohform deiner Nordsterne.",37.617,46.243,[[0,4,37.617],[5,13,37.919],[14,18,38.429],[19,23,38.859],[24,29,39.126],[30,33,39.486],[34,47,39.695],[48,53,40.937],[54,57,41.239],[58,65,41.448],[66,71,42.377],[72,77,42.76],[78,87,43.131],[88,94,43.735],[95,100,44.072],[101,104,44.409],[105,112,44.606],[113,119,45.105],[120,131,45.407]]],["„Die meisten kennen ihren Kontostand, aber nicht ihr Wofür.“",46.487,49.691,[[0,4,46.487],[5,12,46.731],[13,19,47.126],[20,25,47.427],[26,37,47.683],[38,42,48.321],[43,48,48.6],[49,52,48.821],[53,60,48.925]]]]}