{"s":[["Der stille Saboteur, den niemand zeigt",0.0,2.334,[[0,3,0.0],[4,10,0.244],[11,20,0.58],[21,24,1.382],[25,32,1.591],[33,38,1.95]]],["Er nimmt dir nichts, er verhindert, dass etwas entsteht.",3.146,6.409,[[0,2,3.146],[3,8,3.355],[9,12,3.564],[13,20,3.692],[21,23,4.458],[24,35,4.586],[36,40,5.201],[41,46,5.41],[47,56,5.7]]],["Stell dir vor, jemand bremst dich aus, aber nicht in deiner Tasche, sondern in deiner Zukunft.",7.105,12.841,[[0,5,7.105],[6,9,7.349],[10,14,7.488],[15,21,8.185],[22,28,8.522],[29,33,8.847],[34,38,9.044],[39,43,9.741],[44,49,10.008],[50,52,10.228],[53,59,10.31],[60,67,10.577],[68,75,11.366],[76,78,11.738],[79,85,11.831],[86,94,12.109]]],["Du merkst es nicht, weil das Geld nie auf deinem Konto war.",13.351,16.37,[[0,2,13.351],[3,9,13.537],[10,12,13.897],[13,19,14.025],[20,24,14.327],[25,28,14.501],[29,33,14.675],[34,37,15.023],[38,41,15.221],[42,48,15.36],[49,54,15.616],[55,59,15.952]]],["Es hätte dort sein können.",16.811,18.205,[[0,2,16.811],[3,8,17.02],[9,13,17.276],[14,18,17.473],[19,26,17.752]]],["Es kam nur nie an.",18.448,19.668,[[0,2,18.448],[3,6,18.657],[7,10,18.89],[11,14,19.041],[15,18,19.226]]],["Wir nennen ihn den stillen Saboteur.",20.271,22.303,[[0,3,20.271],[4,10,20.48],[11,14,20.817],[15,18,20.968],[19,26,21.13],[27,36,21.525]]],["Und um ihn zu verstehen, musst du zuerst den stillen Motor kennen, an dem er sabotiert: den Zinseszins.",22.907,29.164,[[0,3,22.907],[4,6,23.139],[7,10,23.278],[11,13,23.394],[14,24,23.534],[25,30,24.335],[31,33,24.59],[34,40,24.729],[41,44,25.159],[45,52,25.31],[53,58,25.635],[59,66,25.972],[67,69,26.401],[70,73,26.552],[74,76,26.715],[77,87,26.796],[88,91,27.945],[92,103,28.201]]],["Stell ihn dir wie einen Marathonläufer vor, seine ganze Kraft steckt nicht in der Geschwindigkeit, sondern darin, dass er nicht aufhört.",29.675,36.978,[[0,5,29.675],[6,9,30.012],[10,13,30.151],[14,17,30.372],[18,23,30.546],[24,38,30.755],[39,43,31.568],[44,49,32.23],[50,55,32.497],[56,61,32.81],[62,68,33.17],[69,74,33.472],[75,77,33.693],[78,81,33.774],[82,98,33.89],[99,106,34.9],[107,113,35.202],[114,118,35.748],[119,121,35.957],[122,127,36.038],[128,136,36.316]]],["Keine Sorge vor der Mathematik:",37.582,39.277,[[0,5,37.582],[6,11,37.965],[12,15,38.279],[16,19,38.418],[20,31,38.522]]],["Wir rechnen alles gemeinsam und Schritt für Schritt.",39.556,42.017,[[0,3,39.556],[4,11,39.718],[12,17,40.066],[18,27,40.345],[28,31,40.984],[32,39,41.146],[40,43,41.425],[44,52,41.564]]],["Du brauchst nur die vier Grundrechenarten.",42.458,44.664,[[0,2,42.458],[3,11,42.621],[12,15,42.992],[16,19,43.224],[20,24,43.364],[25,42,43.608]]],["Wie werden aus 10.000 € rund 58.000 €, allein durch Nichtaufhören?",45.105,50.783,[[0,3,45.105],[4,10,45.291],[11,14,45.605],[15,21,45.837],[22,23,46.499],[24,28,47.184],[29,35,47.497],[36,38,48.681],[39,45,49.448],[46,51,49.784],[52,66,50.005]]],["Warum ist Stillstand oft teurer als ein zwischenzeitlicher Verlust?",51.386,55.044,[[0,5,51.386],[6,9,51.77],[10,20,51.967],[21,24,52.594],[25,31,52.814],[32,35,53.314],[36,39,53.546],[40,58,53.674],[59,67,54.463]]],["Warum steht diese Rechnung in keinem Hochglanz-Prospekt?",55.554,58.445,[[0,5,55.554],[6,11,55.891],[12,17,56.112],[18,26,56.332],[27,29,56.785],[30,36,56.959],[37,56,57.331]]],["Zwei Schritte weiter wartet der Zinseszins-Rechner.",59.258,61.894,[[0,4,59.258],[5,13,59.537],[14,20,59.85],[21,27,60.268],[28,31,60.628],[32,51,60.779]]],["Gib dort eine eigene Zahl ein, zum Beispiel den Betrag, den du im Monat übrig hättest, und schau, was die Kontinuität über die Jahre daraus macht.",62.172,70.079,[[0,3,62.172],[4,8,62.428],[9,13,62.648],[14,20,62.857],[21,25,63.194],[26,30,63.496],[31,34,64.007],[35,43,64.192],[44,47,64.564],[48,55,64.692],[56,59,65.249],[60,62,65.423],[63,65,65.528],[66,71,65.609],[72,77,66.027],[78,86,66.329],[87,90,67.153],[91,97,67.315],[98,101,67.71],[102,105,67.908],[106,117,68.024],[118,122,68.802],[123,126,68.964],[127,132,69.057],[133,139,69.324],[140,146,69.649]]],["Eine Lehrannahme, kein Versprechen.",70.775,72.784,[[0,4,70.775],[5,17,71.054],[18,22,71.843],[23,35,72.099]]],["Das Schlimmste, das passieren kann?",73.48,75.164,[[0,3,73.48],[4,15,73.69],[16,19,74.108],[20,29,74.27],[30,35,74.723]]],["Nichts.",75.605,76.186,[[0,7,75.605]]],["Kein Geld bewegt sich, keine Entscheidung fällt.",76.697,79.599,[[0,4,76.697],[5,9,77.022],[10,16,77.242],[17,22,77.626],[23,28,78.148],[29,41,78.485],[42,48,78.972]]]]}