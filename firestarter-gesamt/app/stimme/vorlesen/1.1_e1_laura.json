{"s":[["Der Funke gehört dir",0.0,1.138,[[0,3,0.0],[4,9,0.244],[10,16,0.58],[17,20,0.94]]],["Worum es hier wirklich geht.",1.184,2.717,[[0,5,1.184],[6,8,1.498],[9,13,1.614],[14,22,1.8],[23,28,2.206]]],["Die Videos entstehen gerade, der Text trägt allein.",2.995,6.153,[[0,3,2.995],[4,10,3.158],[11,20,3.622],[21,28,4.04],[29,32,4.795],[33,37,4.992],[38,43,5.317],[44,51,5.608]]],["Stell dir ein Lagerfeuer in der Dämmerung vor.",6.397,8.858,[[0,5,6.397],[6,9,6.711],[10,13,6.873],[14,24,7.047],[25,27,7.709],[28,31,7.814],[32,41,7.953],[42,46,8.417]]],["Du könntest warten, bis jemand vorbeikommt und es dir anzündet, und hoffen, dass er es gut mit dir meint.",8.975,14.327,[[0,2,8.975],[3,11,9.149],[12,19,9.567],[20,23,9.938],[24,30,10.124],[31,42,10.403],[43,46,11.134],[47,49,11.296],[50,53,11.413],[54,63,11.54],[64,67,12.33],[68,75,12.55],[76,80,12.876],[81,83,13.073],[84,86,13.154],[87,90,13.317],[91,94,13.537],[95,98,13.665],[99,105,13.828]]],["Oder du nimmst selbst ein Streichholz und schlägst deinen eigenen Funken.",14.768,18.495,[[0,4,14.768],[5,7,15.105],[8,14,15.244],[15,21,15.523],[22,25,15.883],[26,37,16.01],[38,41,16.684],[42,50,16.788],[51,57,17.16],[58,65,17.473],[66,73,17.856]]],["Genau darum geht es in „Firestarter“: dass du den Funken schlägst.",18.82,23.058,[[0,5,18.82],[6,11,19.273],[12,16,19.691],[17,19,19.935],[20,22,20.062],[23,37,20.144],[38,42,21.502],[43,45,21.734],[46,49,21.862],[50,56,22.024],[57,66,22.396]]],["Nicht eine Bank.",23.499,24.532,[[0,5,23.499],[6,10,23.801],[11,16,24.068]]],["Nicht ein Berater, der dir am Ende ein Produkt verkauft.",24.776,27.481,[[0,5,24.776],[6,9,25.055],[10,18,25.182],[19,22,25.658],[23,26,25.798],[27,29,25.914],[30,34,26.088],[35,38,26.332],[39,46,26.448],[47,56,26.819]]],["Und keine Sorge:",27.632,28.735,[[0,3,27.632],[4,9,27.852],[10,16,28.224]]],["Hier wird dir nichts übergestülpt und nichts verkauft.",28.828,31.452,[[0,4,28.828],[5,9,29.072],[10,13,29.211],[14,20,29.362],[21,33,29.664],[34,37,30.36],[38,44,30.5],[45,54,30.813]]],["Firestarter ist eine Bibliothek zum Selbstlernen, du arbeitest dich in deinem Tempo durch kurze Videos und eigene Reflexion.",31.73,38.812,[[0,11,31.73],[12,15,32.427],[16,20,32.624],[21,31,32.845],[32,35,33.53],[36,49,33.716],[50,52,34.598],[53,62,34.784],[63,67,35.271],[68,70,35.48],[71,77,35.608],[78,83,35.945],[84,89,36.281],[90,95,36.537],[96,102,36.92],[103,106,37.442],[107,113,37.663],[114,124,37.988]]],["Du brauchst kein Vorwissen und keine Mathematik außer den vier Grundrechenarten.",39.195,43.491,[[0,2,39.195],[3,11,39.346],[12,16,39.671],[17,26,39.88],[27,30,40.472],[31,36,40.658],[37,47,40.995],[48,53,41.68],[54,57,42.005],[58,62,42.202],[63,80,42.469]]],["Du siehst die drei Leitbegriffe, auf denen alles steht.",43.607,46.37,[[0,2,43.607],[3,9,43.769],[10,13,44.013],[14,18,44.141],[19,32,44.385],[33,36,45.058],[37,42,45.244],[43,48,45.557],[49,55,45.848]]],["Sie sagt ehrlich, was Firestarter nicht ist, denn ehrliche Grenzen schützen dich.",46.649,51.026,[[0,3,46.649],[4,8,46.811],[9,17,47.09],[18,21,47.508],[22,33,47.752],[34,39,48.413],[40,44,48.669],[45,49,49.017],[50,58,49.331],[59,66,49.83],[67,75,50.294],[76,81,50.654]]],["Und sie legt die ganze Reise durch die neun Bausteine vor dir aus.",51.467,54.706,[[0,3,51.467],[4,7,51.641],[8,12,51.769],[13,16,51.954],[17,22,52.07],[23,28,52.419],[29,34,52.767],[35,38,52.976],[39,43,53.092],[44,53,53.301],[54,57,53.835],[58,61,53.998],[62,66,54.16]]]]}