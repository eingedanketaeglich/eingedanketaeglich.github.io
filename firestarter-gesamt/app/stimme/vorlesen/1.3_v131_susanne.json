{"s":[["Der Berater meint es gut, und macht dich trotzdem abhängig",0.0,3.262,[[0,3,0.0],[4,11,0.221],[12,17,0.662],[18,20,0.871],[21,25,1.01],[26,29,1.451],[30,35,1.695],[36,40,1.927],[41,49,2.113],[50,58,2.647]]],["Anlageberatung ist, nüchtern betrachtet, ein Geschäftsmodell.",3.587,7.744,[[0,14,3.587],[15,19,4.702],[20,28,5.248],[29,40,5.654],[41,44,6.56],[45,61,6.745]]],["Und es lebt von einer Lücke.",7.988,9.741,[[0,3,7.988],[4,6,8.266],[7,11,8.417],[12,15,8.742],[16,21,8.928],[22,28,9.183]]],["Die Wissens-Lücke",9.95,11.076,[[0,3,9.95],[4,17,10.17]]],["Du weißt weniger als der Berater, genau dieser Abstand ist sein Wert.",11.587,15.941,[[0,2,11.587],[3,8,11.807],[9,16,12.132],[17,20,12.643],[21,24,12.864],[25,33,13.015],[34,39,13.642],[40,46,14.071],[47,54,14.489],[55,58,15.023],[59,63,15.221],[64,69,15.465]]],["Schließt sich die Lücke, braucht man ihn weniger.",16.219,19.087,[[0,8,16.219],[9,13,16.684],[14,17,16.904],[18,24,17.044],[25,32,17.636],[33,36,18.007],[37,40,18.181],[41,49,18.309]]],["Das fertige Produkt",19.412,20.701,[[0,3,19.412],[4,11,19.702],[12,19,20.178]]],["Oft steht am Ende ein Produkt, das ohnehin verkauft werden soll.",21.142,24.509,[[0,3,21.142],[4,9,21.467],[10,12,21.711],[13,17,21.85],[18,21,22.106],[22,30,22.245],[31,34,22.698],[35,42,22.942],[43,51,23.359],[52,58,23.801],[59,64,24.079]]],["Die Frage ist nicht ob, sondern welches.",24.683,27.249,[[0,3,24.683],[4,9,24.846],[10,13,25.182],[14,19,25.333],[20,23,25.6],[24,31,26.099],[32,40,26.517]]],["Abgegebene Verantwortung",27.574,29.13,[[0,10,27.574],[11,24,28.363]]],["Du delegierst die Entscheidung, und damit das Verstehen.",29.455,33.1,[[0,2,29.455],[3,13,29.733],[14,17,30.267],[18,31,30.395],[32,35,31.324],[36,41,31.649],[42,45,32.137],[46,56,32.346]]],["Bequem heute, teuer auf Dauer.",33.274,35.805,[[0,6,33.274],[7,13,33.843],[14,19,34.61],[20,23,35.074],[24,30,35.295]]],["Das Problem ist nicht der schlechte Berater, es ist das gute Modell.",36.189,39.741,[[0,3,36.189],[4,11,36.421],[12,15,36.827],[16,21,36.955],[22,25,37.129],[26,35,37.245],[36,44,37.628],[45,47,38.232],[48,51,38.418],[52,55,38.545],[56,60,38.778],[61,68,39.137]]],["Selbst ein ehrlicher, kompetenter Berater arbeitet in einem System, das von deiner Unwissenheit lebt.",40.066,46.533,[[0,6,40.066],[7,10,40.461],[11,21,40.705],[22,33,41.285],[34,41,42.075],[42,50,42.644],[51,53,43.201],[54,59,43.317],[60,67,43.561],[68,71,44.327],[72,75,44.548],[76,82,44.71],[83,95,45.07],[96,101,45.871]]]]}