{"s":[["Wo warst du bisher abhängig?",0.0,1.602,[[0,2,0.0],[3,8,0.209],[9,11,0.453],[12,18,0.557],[19,28,0.882]]],["Abhängigkeit ist kein Grund für Scham, sie ist normal, solange das Wissen fehlt.",2.113,6.49,[[0,12,2.113],[13,16,2.879],[17,21,3.03],[22,27,3.239],[28,31,3.506],[32,38,3.634],[39,42,4.18],[43,46,4.354],[47,54,4.516],[55,62,5.05],[63,66,5.468],[67,73,5.642],[74,80,5.956]]],["Der erste Akt der Selbstbestimmung ist, sie zu sehen.",7.001,10.008,[[0,3,7.001],[4,9,7.21],[10,13,7.616],[14,17,7.825],[18,34,7.976],[35,39,8.766],[40,43,9.114],[44,46,9.346],[47,53,9.532]]],["Bei welcher Geldentscheidung habe ich zuletzt einfach vertraut, ohne es selbst zu verstehen?",10.612,15.336,[[0,3,10.612],[4,11,10.786],[12,28,11.122],[29,33,11.912],[34,37,12.121],[38,45,12.283],[46,53,12.725],[54,63,13.084],[64,68,13.746],[69,71,14.059],[72,78,14.164],[79,81,14.489],[82,92,14.652]]],["Wem habe ich sie überlassen, und welches Interesse hatte diese Person oder Stelle?",15.847,20.097,[[0,3,15.847],[4,8,16.149],[9,12,16.347],[13,16,16.451],[17,28,16.59],[29,32,17.31],[33,40,17.496],[41,50,17.879],[51,56,18.285],[57,62,18.506],[63,69,18.761],[70,74,19.237],[75,82,19.481]]],["Was müsste ich verstehen, um es beim nächsten Mal selbst zu entscheiden?",20.538,23.916,[[0,3,20.538],[4,10,20.851],[11,14,21.165],[15,25,21.292],[26,28,21.803],[29,31,21.931],[32,36,22.047],[37,45,22.233],[46,49,22.581],[50,56,22.755],[57,59,23.08],[60,72,23.208]]],["Erster praktischer Schritt, der Notgroschen",24.299,26.644,[[0,6,24.299],[7,18,24.706],[19,27,25.24],[28,31,25.774],[32,43,25.971]]],["Eine Reserve aus 3 bis 6 Netto-Monatsgehältern auf einem getrennten Konto fängt Notfälle ab, ohne dass du in Panik etwas verkaufen musst.",27.155,35.526,[[0,4,27.155],[5,12,27.48],[13,16,28.037],[17,18,28.293],[19,22,28.618],[23,24,28.804],[25,46,29.164],[47,50,30.441],[51,56,30.626],[57,67,30.87],[68,73,31.37],[74,79,31.822],[80,88,32.089],[89,92,32.6],[93,97,33.274],[98,102,33.564],[103,105,33.738],[106,108,33.866],[109,114,33.97],[115,120,34.342],[121,130,34.644],[131,137,35.12]]],["Er ist der erste der vier Geldtöpfe, mehr dazu in Baustein 2.",35.654,39.473,[[0,2,35.654],[3,6,35.828],[7,10,35.979],[11,16,36.153],[17,20,36.571],[21,25,36.71],[26,36,36.896],[37,41,37.72],[42,46,37.999],[47,49,38.37],[50,58,38.486],[59,61,38.986]]],["Kreuze an, was auf dich zutrifft.",39.752,41.772,[[0,6,39.752],[7,10,40.263],[11,14,40.518],[15,18,40.762],[19,23,40.913],[24,33,41.11]]],["Ein Spiegel, keine Beratung, nichts wird gespeichert.",42.213,45.835,[[0,3,42.213],[4,12,42.48],[13,18,43.27],[19,28,43.595],[29,35,44.454],[36,40,44.86],[41,53,45.057]]],["Drei Sätze zum Mitnehmen",46.044,47.345,[[0,4,46.044],[5,10,46.346],[11,14,46.694],[15,24,46.869]]],["Anlageberatung lebt von der Wissens-Lücke, das Problem ist das Modell, nicht die Person.",47.948,53.173,[[0,14,47.948],[15,19,49.051],[20,23,49.295],[24,27,49.446],[28,42,49.585],[43,46,50.607],[47,54,50.816],[55,58,51.234],[59,62,51.362],[63,70,51.559],[71,76,52.163],[77,80,52.395],[81,88,52.499]]],["Bildung will sich selbst überflüssig machen; Beratung hält die Abhängigkeit.",53.498,57.874,[[0,7,53.498],[8,12,53.974],[13,17,54.171],[18,24,54.345],[25,36,54.729],[37,44,55.309],[45,53,55.889],[54,58,56.516],[59,62,56.737],[63,76,56.911]]],["Der erste Akt der Selbstbestimmung ist, die eigene Abhängigkeit zu erkennen, der Notgroschen ist der erste praktische Schritt.",58.316,65.432,[[0,3,58.316],[4,9,58.525],[10,13,58.931],[14,17,59.14],[18,34,59.291],[35,39,60.092],[40,43,60.475],[44,50,60.672],[51,63,61.044],[64,66,61.729],[67,76,61.857],[77,80,62.669],[81,92,62.855],[93,96,63.645],[97,100,63.819],[101,106,64.004],[107,117,64.399],[118,126,64.887]]]]}