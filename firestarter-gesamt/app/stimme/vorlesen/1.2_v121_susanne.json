{"s":[["Der stille Motor: einfacher Zins vs.",0.0,2.833,[[0,3,0.0],[4,10,0.36],[11,17,0.697],[18,27,1.498],[28,32,2.148],[33,36,2.601]]],["Zinseszins",3.042,3.971,[[0,10,3.042]]],["Zwei Wörter, ein winziger Unterschied, riesige Wirkung über die Zeit.",4.342,9.079,[[0,4,4.342],[5,12,4.69],[13,16,5.492],[17,25,5.712],[26,38,6.153],[39,46,7.129],[47,54,7.593],[55,59,8.162],[60,63,8.371],[64,69,8.522]]],["Einfacher Zins",9.451,10.426,[[0,9,9.451],[10,14,10.101]]],["Du entnimmst den Zins jedes Jahr.",10.472,12.841,[[0,2,10.472],[3,12,10.658],[13,16,11.169],[17,21,11.424],[22,27,11.9],[28,33,12.33]]],["Das Kapital bleibt gleich.",13.038,14.896,[[0,3,13.038],[4,11,13.282],[12,18,13.886],[19,26,14.245]]],["Es wächst in einer geraden Linie.",15.139,17.554,[[0,2,15.139],[3,9,15.395],[10,12,15.824],[13,18,15.999],[19,26,16.266],[27,33,16.858]]],["Zinseszins",18.053,18.97,[[0,10,18.053]]],["Du lässt den Zins liegen.",19.295,20.991,[[0,2,19.295],[3,8,19.516],[9,12,19.783],[13,17,20.027],[18,25,20.422]]],["Zins wird auf Kapital und auf frühere Zinsen gezahlt.",21.234,24.114,[[0,4,21.234],[5,9,21.583],[10,13,21.792],[14,21,21.919],[22,25,22.488],[26,29,22.755],[30,37,22.871],[38,44,23.266],[45,53,23.591]]],["Es wächst gekrümmt (exponentiell).",24.299,26.378,[[0,2,24.299],[3,9,24.485],[10,18,24.775],[19,34,25.333]]],["Das Endkapital nach n Jahren ergibt sich aus Startkapital K₀ und Zinssatz i:",26.621,32.032,[[0,3,26.621],[4,14,26.854],[15,19,27.492],[20,21,27.736],[22,28,27.898],[29,35,28.398],[36,40,28.734],[41,44,28.955],[45,57,29.152],[58,60,30.0],[61,64,30.766],[65,73,30.975],[74,76,31.683]]],["Rechnen wir es mit 10.000 € und 7 % (historische Lehrannahme):",32.31,36.769,[[0,7,32.31],[8,11,32.659],[12,14,32.798],[15,18,32.937],[19,25,33.077],[26,27,33.739],[28,31,34.249],[32,33,34.458],[34,35,34.818],[36,48,35.329],[49,62,35.968]]],["Jahr 1 → 10.700 €.",36.931,39.404,[[0,4,36.931],[5,6,37.256],[7,8,37.686],[9,15,37.756],[16,18,39.021]]],["Jahr 2 → 11.449 €, nicht glatt 11.400 €.",39.625,44.687,[[0,4,39.625],[5,6,39.938],[7,8,40.321],[9,15,40.403],[16,18,42.191],[19,24,42.69],[25,30,42.934],[31,37,43.421],[38,40,44.269]]],["Die 49 € Differenz sind der Zins auf den Zins des ersten Jahres, klein, unscheinbar.",44.989,50.399,[[0,3,44.989],[4,6,45.163],[7,8,45.859],[9,18,46.208],[19,23,46.614],[24,27,46.788],[28,32,46.986],[33,36,47.299],[37,40,47.427],[41,45,47.589],[46,49,47.879],[50,56,48.065],[57,64,48.402],[65,71,49.064],[72,84,49.598]]],["Aber der Motor läuft weiter.",50.585,52.036,[[0,4,50.585],[5,8,50.794],[9,14,50.898],[15,20,51.339],[21,28,51.583]]],["Der eigentliche Motor ist nicht die 7 %, es ist das „hoch n“, die Anzahl der ununterbrochenen Jahre.",52.291,59.002,[[0,3,52.291],[4,15,52.454],[16,21,52.872],[22,25,53.232],[26,31,53.394],[32,35,53.58],[36,37,53.731],[38,40,54.033],[41,43,54.694],[44,47,54.857],[48,51,54.996],[52,57,55.275],[58,61,55.983],[62,65,56.633],[66,72,56.807],[73,76,57.272],[77,93,57.539],[94,100,58.375]]],["Der Zinseszins ist kein Sprinter, sondern ein Marathonläufer, der nie stehen bleibt.",59.385,64.9,[[0,3,59.385],[4,14,59.629],[15,18,60.499],[19,23,60.72],[24,33,60.975],[34,41,61.927],[42,45,62.369],[46,61,62.543],[62,65,63.541],[66,69,63.75],[70,76,63.994],[77,84,64.389]]],["Kontinuität schlägt Höhe.",65.225,67.291,[[0,11,65.225],[12,19,66.27],[20,25,66.688]]],["Die 7-%-Rechnung ist ein historisches Lehrbeispiel, kein Renditeversprechen.",67.674,73.189,[[0,3,67.674],[4,16,67.883],[17,20,69.091],[21,24,69.3],[25,37,69.451],[38,51,70.194],[52,56,71.332],[57,76,71.691]]]]}