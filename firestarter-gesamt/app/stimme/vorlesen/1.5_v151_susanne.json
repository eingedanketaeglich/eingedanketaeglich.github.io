{"s":[["Warum ein Brief?",0.0,1.08,[[0,5,0.0],[6,9,0.383],[10,16,0.534]]],["Der Nordstern und das Versprechen",1.358,3.611,[[0,3,1.358],[4,13,1.637],[14,17,2.531],[18,21,2.728],[22,33,2.926]]],["Eine Richtung trägt weiter als eine Zahl.",4.214,6.594,[[0,4,4.214],[5,13,4.516],[14,19,4.934],[20,26,5.248],[27,30,5.642],[31,35,5.828],[36,41,6.084]]],["Ein Zahlenziel ist „500.000 € bis 60“; ein Nordstern ist „in Ruhe selbst entscheiden können“.",6.803,14.431,[[0,3,6.803],[4,14,7.036],[15,18,7.802],[19,27,8.057],[28,29,9.346],[30,33,9.718],[34,38,9.961],[39,42,10.983],[43,52,11.18],[53,56,11.854],[57,60,12.179],[61,65,12.562],[66,72,12.922],[73,84,13.375],[85,93,13.886]]],["Zahlen ändern sich, die Richtung trägt.",14.814,16.927,[[0,6,14.814],[7,13,15.302],[14,19,15.662],[20,23,15.882],[24,32,16.022],[33,39,16.416]]],["Und warum aufschreiben?",17.206,18.46,[[0,3,17.206],[4,9,17.391],[10,23,17.682]]],["Weil das geschriebene Wort stärker verpflichtet als ein Vorsatz im Kopf.",18.785,22.918,[[0,4,18.785],[5,8,19.005],[9,21,19.191],[22,26,19.76],[27,34,20.12],[35,47,20.666],[48,51,21.409],[52,55,21.641],[56,63,21.815],[64,66,22.303],[67,72,22.43]]],["Ein Brief mit Datum und Unterschrift ist ein Versprechen, dem du später wieder begegnest.",23.301,28.386,[[0,3,23.301],[4,9,23.498],[10,13,23.835],[14,19,24.032],[20,23,24.59],[24,36,24.88],[37,40,25.6],[41,44,25.797],[45,57,25.925],[58,61,26.552],[62,64,26.738],[65,71,26.877],[72,78,27.295],[79,89,27.55]]],["Brief und Zinseszins liegen auf derselben Zeitachse.",28.711,32.125,[[0,5,28.711],[6,9,29.129],[10,20,29.338],[21,27,30.244],[28,31,30.58],[32,41,30.755],[42,52,31.242]]],["Während dein Kapital im Stillen wächst, wächst auch dein Wofür.",32.403,36.455,[[0,7,32.403],[8,12,32.752],[13,20,32.949],[21,23,33.506],[24,31,33.646],[32,39,34.087],[40,46,34.772],[47,51,35.143],[52,56,35.352],[57,63,35.596]]]]}