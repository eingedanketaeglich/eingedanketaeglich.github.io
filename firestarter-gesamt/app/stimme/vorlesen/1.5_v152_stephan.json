{"s":[["Deine drei Nordsterne als Zielkoordinaten",0.0,2.902,[[0,5,0.0],[6,10,0.313],[11,21,0.569],[22,25,1.393],[26,41,1.776]]],["Je eine Aussage, die in 12 Monaten wahr sein soll.",3.286,6.026,[[0,2,3.286],[3,7,3.448],[8,16,3.622],[17,20,4.11],[21,23,4.342],[24,26,4.47],[27,34,4.83],[35,39,5.19],[40,44,5.41],[45,50,5.654]]],["„Ich verstehe meine Geldentscheidungen und kann gute von schlechten Ratschlägen unterscheiden.“",6.2,10.786,[[0,4,6.2],[5,13,6.536],[14,19,6.896],[20,38,7.117],[39,42,7.93],[43,47,8.046],[48,52,8.29],[53,56,8.766],[57,67,9.009],[68,79,9.462],[80,95,10.043]]],["„Ich baue ununterbrochen auf.",10.995,13.096,[[0,4,10.995],[5,9,11.308],[10,24,11.703],[25,29,12.597]]],["Der Lauf wird nicht unterbrochen - ich handle bewusst, egal was der Markt macht.“",13.305,17.95,[[0,3,13.305],[4,8,13.468],[9,13,14.049],[14,19,14.246],[20,32,14.455],[33,34,15.14],[35,38,15.349],[39,45,15.465],[46,54,15.697],[55,59,16.417],[60,63,16.881],[64,67,17.056],[68,73,17.195],[74,81,17.508]]],["„Ich bin nicht beratungsresistent, kann aber meine Entscheidungen selbst treffen und begründen.“",18.124,23.128,[[0,4,18.124],[5,8,18.46],[9,14,18.623],[15,34,18.89],[35,39,20.33],[40,44,20.527],[45,50,20.689],[51,65,20.922],[66,72,21.467],[73,80,21.955],[81,84,22.338],[85,96,22.454]]],["Die meisten kennen ihren Kontostand, aber nicht ihr Wofür.",23.371,27.33,[[0,3,23.371],[4,11,23.546],[12,18,23.917],[19,24,24.242],[25,36,24.602],[37,41,25.728],[42,47,25.984],[48,51,26.297],[52,58,26.564]]],["Der Brief dreht das um: erst die Richtung, dann die Zahl.",27.505,31.208,[[0,3,27.505],[4,9,27.679],[10,15,27.992],[16,19,28.236],[20,23,28.445],[24,28,29.002],[29,32,29.211],[33,42,29.35],[43,47,30.105],[48,51,30.361],[52,57,30.558]]]]}