{"s":[["Der Zinseszins-Rechner, dein Werkzeug",0.0,2.601,[[0,3,0.0],[4,23,0.29],[24,28,1.707],[29,37,2.009]]],["Genau diesen Rechner bekommst du in die Hand, aber erst, wenn du selbst geschätzt hast statt einfach abzulesen.",3.413,9.149,[[0,5,3.413],[6,12,3.762],[13,20,4.075],[21,29,4.423],[30,32,4.83],[33,35,4.946],[36,39,5.016],[40,45,5.132],[46,50,5.573],[51,56,5.886],[57,61,6.235],[62,64,6.385],[65,71,6.536],[72,81,6.896],[82,86,7.372],[87,92,7.686],[93,100,7.999],[101,111,8.348]]],["Gleich kommen vier Fragen.",9.532,10.89,[[0,6,9.532],[7,13,9.857],[14,18,10.159],[19,26,10.344]]],["Rate mit, den frei bedienbaren Rechner schaltest du dir als Bonus frei, sobald du Baustein 1 abgeschlossen hast.",11.273,17.45,[[0,4,11.273],[5,9,11.587],[10,13,12.028],[14,18,12.272],[19,30,12.55],[31,38,13.166],[39,48,13.549],[49,51,13.955],[52,55,14.083],[56,59,14.234],[60,65,14.455],[66,71,14.849],[72,78,15.186],[79,81,15.546],[82,90,15.685],[91,92,16.184],[93,106,16.44],[107,112,17.078]]],["Danach liegt er dauerhaft in deinem Rechner-Fenster.",17.52,20.341,[[0,6,17.52],[7,12,17.972],[13,15,18.205],[16,25,18.297],[26,28,18.855],[29,35,18.936],[36,52,19.191]]]]}