{"s":[["Der stille Motor: einfacher Zins vs.",0.0,3.042,[[0,3,0.0],[4,10,0.232],[11,17,0.534],[18,27,1.405],[28,32,1.997],[33,36,2.554]]],["Zinseszins",3.065,3.843,[[0,10,3.065]]],["Zwei Wörter, ein winziger Unterschied, riesige Wirkung über die Zeit.",4.447,8.696,[[0,4,4.447],[5,12,4.807],[13,16,5.48],[17,25,5.666],[26,38,6.13],[39,46,6.92],[47,54,7.419],[55,59,7.86],[60,63,8.069],[64,69,8.197]]],["Einfacher Zins",9.3,10.205,[[0,9,9.3],[10,14,9.868]]],["Du entnimmst den Zins jedes Jahr.",10.321,12.399,[[0,2,10.321],[3,12,10.519],[13,16,10.983],[17,21,11.18],[22,27,11.575],[28,33,11.912]]],["Das Kapital bleibt gleich.",12.783,14.373,[[0,3,12.783],[4,11,13.015],[12,18,13.514],[19,26,13.816]]],["Es wächst in einer geraden Linie.",14.698,16.683,[[0,2,14.698],[3,9,14.954],[10,12,15.29],[13,18,15.406],[19,26,15.615],[27,33,16.08]]],["Zinseszins",17.635,18.413,[[0,10,17.635]]],["Du lässt den Zins liegen.",18.494,19.818,[[0,2,18.494],[3,8,18.668],[9,12,18.889],[13,17,19.098],[18,25,19.411]]],["Zins wird auf Kapital und auf frühere Zinsen gezahlt.",20.131,23.08,[[0,4,20.131],[5,9,20.48],[10,13,20.665],[14,21,20.793],[22,25,21.443],[26,29,21.641],[30,37,21.745],[38,44,22.14],[45,53,22.477]]],["Es wächst gekrümmt (exponentiell).",23.347,25.553,[[0,2,23.347],[3,9,23.568],[10,18,23.858],[19,34,24.427]]],["Das Endkapital nach n Jahren ergibt sich aus Startkapital K₀ und Zinssatz i:",26.052,31.219,[[0,3,26.052],[4,14,26.296],[15,19,27.028],[20,21,27.213],[22,28,27.376],[29,35,27.864],[36,40,28.189],[41,44,28.351],[45,57,28.525],[58,60,29.28],[61,64,30.0],[65,73,30.186],[74,76,30.778]]],["Rechnen wir es mit 10.000 € und 7 % (historische Lehrannahme):",31.648,36.165,[[0,7,31.648],[8,11,32.02],[12,14,32.148],[15,18,32.299],[19,25,32.438],[26,27,33.135],[28,31,33.599],[32,33,33.82],[34,35,34.133],[36,48,34.667],[49,62,35.492]]],["Jahr 1 → 10.700 €.",36.49,38.87,[[0,4,36.49],[5,6,36.746],[7,8,37.152],[9,15,37.291],[16,18,38.568]]],["Jahr 2 → 11.449 €, nicht glatt 11.400 €.",39.23,44.2