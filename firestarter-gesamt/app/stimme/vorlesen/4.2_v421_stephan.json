{"s":[["Die Aktie, ein Stück Eigentum",0.0,2.206,[[0,3,0.0],[4,10,0.197],[11,14,1.045],[15,20,1.207],[21,29,1.544]]],["Gibst du dem Bäcker 100 € und dir gehört dafür ein winziges Stück von allem, hast du ihm Geld geliehen?",2.647,8.057,[[0,5,2.647],[6,8,2.891],[9,12,2.984],[13,19,3.111],[20,23,3.344],[24,25,3.727],[26,29,4.029],[30,33,4.122],[34,40,4.249],[41,46,4.516],[47,50,4.818],[51,59,4.969],[60,65,5.48],[66,69,5.712],[70,76,5.875],[77,81,6.478],[82,84,6.676],[85,88,6.827],[89,93,7.036],[94,103,7.43]]],["Nein.",8.382,8.824,[[0,5,8.382]]],["Du bist Mit-Eigentümer.",9.149,10.716,[[0,2,9.149],[3,7,9.323],[8,23,9.648]]],["Genau das ist eine Aktie: ein Eigentumsanteil.",10.925,13.92,[[0,5,10.925],[6,9,11.204],[10,13,11.378],[14,18,11.54],[19,25,11.738],[26,29,12.423],[30,46,12.666]]],["Als Eigentümer profitierst du auf zwei Wegen:",14.164,16.637,[[0,3,14.164],[4,14,14.362],[15,26,14.826],[27,29,15.348],[30,33,15.453],[34,38,15.72],[39,45,16.126]]],["Dividende",16.846,17.38,[[0,9,16.846]]],["dein Anteil am ausgeschütteten Gewinn",17.427,19.168,[[0,4,17.427],[5,11,17.647],[12,14,17.984],[15,30,18.112],[31,37,18.797]]],["Wertsteigerung",19.551,20.306,[[0,14,19.551]]],["wollen mehr Leute ein Stück, steigt der Preis deines Anteils",20.352,23.743,[[0,6,20.352],[7,11,20.619],[12,17,20.863],[18,21,21.27],[22,28,21.421],[29,35,22.129],[36,39,22.442],[40,45,22.582],[46,52,22.93],[53,60,23.232]]],["Beide Wege haben eine Kehrseite:",24.068,26.111,[[0,5,24.068],[6,10,24.369],[11,16,24.66],[17,21,24.962],[22,32,25.205]]],["Läuft das Unternehmen schlecht, fällt die Dividende aus und der Wert kann sinken.",26.436,30.871,[[0,5,26.436],[6,9,26.657],[10,21,26.819],[22,31,27.202],[32,37,27.864],[38,41,28.119],[42,51,28.247],[52,55,28.769],[56,59,29.269],[60,63,29.408],[64,68,29.547],[69,73,30.023],[74,81,30.302]]],["Als Eigentümer trägst du das unternehmerische Risiko mit, du sitzt im selben Boot.",31.045,35.259,[[0,3,31.045],[4,14,31.219],[15,21,31.742],[22,24,32.02],[25,28,32.125],[29,45,32.357],[46,52,33.007],[53,57,33.39],[58,60,33.669],[61,66,33.843],[67,69,34.18],[70,76,34.389],[77,82,34.737]]],["Eine Aktie ist kein Papier mit hüpfenden Zahlen, sondern ein Eigentumstitel mit Stimmrecht.",35.468,40.437,[[0,4,35.468],[5,10,35.689],[11,14,36.037],[15,19,36.211],[20,26,36.409],[27,30,36.873],[31,40,37.024],[41,48,37.477],[49,56,37.814],[57,60,38.139],[61,75,38.382],[76,79,39.532],[80,91,39.694]]],["Du bist nicht Kunde des Marktes, sondern Teilhaber an echter Wirtschaft, einen garantierten Ertrag gibt es dafür nicht.",40.646,47.182,[[0,2,40.646],[3,7,40.751],[8,13,40.913],[14,19,41.145],[20,23,41.459],[24,32,41.644],[33,40,42.515],[41,50,42.922],[51,53,43.618],[54,60,43.746],[61,72,44.013],[73,78,44.524],[79,91,44.872],[92,98,45.58],[99,103,46.01],[104,106,46.23],[107,112,46.335],[113,119,46.59]]]]}