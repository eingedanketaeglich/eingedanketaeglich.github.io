{"s":[["Die Grenze.",0.0,0.964,[[0,3,0.0],[4,11,0.325]]],["Notgroschen ist Sicherheit, nicht Renditequelle",1.289,3.843,[[0,11,1.289],[12,15,1.939],[16,27,2.09],[28,33,2.786],[34,47,3.042]]],["Verzinste Einlagen haben eine klare Aufgabe:",4.284,6.873,[[0,9,4.284],[10,18,4.911],[19,24,5.433],[25,29,5.7],[30,35,5.886],[36,44,6.223]]],["Sicherheit und Verfügbarkeit, vor allem für den Notgroschen.",7.047,10.019,[[0,10,7.047],[11,14,7.605],[15,29,7.709],[30,33,8.603],[34,39,8.812],[40,43,9.067],[44,47,9.207],[48,60,9.334]]],["Sie sind nicht der Ort, an dem Vermögen wächst.",10.17,12.365,[[0,3,10.17],[4,8,10.368],[9,14,10.588],[15,18,10.809],[19,23,10.983],[24,26,11.238],[27,30,11.331],[31,39,11.505],[40,47,11.9]]],["Wer mit Zins-Hopping (ständig dem nächsten Aktionszins hinterher) Vermögen aufbauen will, verwechselt die Aufgaben.",12.516,18.716,[[0,3,12.516],[4,7,12.701],[8,20,12.841],[21,29,13.561],[30,33,14.211],[34,42,14.408],[43,54,14.757],[55,65,15.419],[66,74,16.208],[75,83,16.696],[84,89,17.137],[90,101,17.439],[102,105,17.984],[106,115,18.112]]],["Die klare Linie:",18.832,19.784,[[0,3,18.832],[4,9,18.983],[10,16,19.343]]],["Der Notgroschen bleibt sicher und verfügbar, niemals in Schwankung.",19.877,23.325,[[0,3,19.877],[4,15,20.063],[16,22,20.62],[23,29,20.887],[30,33,21.2],[34,44,21.316],[45,52,22.152],[53,55,22.652],[56,67,22.744]]],["Was darüber hinaus lange frei ist, gehört in den Vermögensaufbau (Baustein 4 ff.), nicht ins nächste Festgeld.",23.65,30.07,[[0,3,23.65],[4,11,23.871],[12,18,24.207],[19,24,24.567],[25,29,24.788],[30,34,25.02],[35,41,25.252],[42,44,25.6],[45,48,25.693],[49,64,25.867],[65,74,26.889],[75,76,27.551],[77,82,27.829],[83,88,28.503],[89,92,28.828],[93,100,29.025],[101,110,29.397]]],["Verzinste Einlagen und Vermögensaufbau sind zwei verschiedene Werkzeuge.",30.395,34.342,[[0,9,30.395],[10,18,31.022],[19,22,31.556],[23,38,31.707],[39,43,32.647],[44,48,32.833],[49,61,33.158],[62,72,33.611]]],["Das eine hält den Notgroschen sicher, das andere lässt Vermögen über Jahrzehnte wachsen.",34.621,39.091,[[0,3,34.621],[4,8,34.865],[9,13,35.213],[14,17,35.376],[18,29,35.503],[30,37,36.107],[38,41,36.618],[42,48,36.862],[49,54,37.187],[55,63,37.419],[64,68,37.872],[69,79,38.081],[80,88,38.557]]],["Sie zu verwechseln kostet auf beiden Seiten, entweder Sicherheit oder Wachstum.",39.533,43.712,[[0,3,39.533],[4,6,39.753],[7,18,39.892],[19,25,40.461],[26,29,40.856],[30,36,40.995],[37,44,41.286],[45,53,41.855],[54,64,42.272],[65,69,42.818],[70,79,43.085]]],["Drei Sätze zum Mitnehmen",44.037,45.268,[[0,4,44.037],[5,10,44.316],[11,14,44.664],[15,24,44.827]]],["Tagesgeld, Festgeld, Geldmarkt-ETF verzinsen ruhendes Geld; der Tausch ist immer Verfügbarkeit gegen Zins.",45.593,52.617,[[0,10,45.593],[11,20,46.557],[21,34,47.276],[35,44,48.344],[45,53,48.879],[54,59,49.296],[60,63,50.04],[64,70,50.225],[71,74,50.574],[75,80,50.759],[81,94,50.992],[95,100,51.781],[101,106,52.048]]],["Vorsicht vor der Lockzins-Falle.",52.826,54.521,[[0,8,52.826],[9,12,53.314],[13,16,53.453],[17,32,53.592]]],["Realzins = Einlagenzins − Inflation:",54.765,57.923,[[0,8,54.765],[9,10,55.519],[11,23,55.996],[24,25,56.959],[26,36,57.052]]],["Ist er negativ, schrumpft dein Geld still, auch wenn die Zahl gleich bleibt.",58.097,61.847,[[0,3,58.097],[4,6,58.306],[7,15,58.422],[16,25,59.188],[26,30,59.525],[31,35,59.711],[36,42,59.908],[43,47,60.349],[48,52,60.581],[53,56,60.732],[57,61,60.883],[62,68,61.139],[69,76,61.406]]],["Verzinste Einlagen sind Sicherheit, keine Renditequelle.",62.172,65.26,[[0,9,62.172],[10,18,62.787],[19,23,63.252],[24,35,63.437],[36,41,64.064],[42,56,64.436]]],["Zins-Hopping ersetzt den Zinseszins nicht.",65.411,68.128,[[0,12,65.411],[13,20,66.143],[21,24,66.491],[25,35,66.7],[36,42,67.501]]]]}