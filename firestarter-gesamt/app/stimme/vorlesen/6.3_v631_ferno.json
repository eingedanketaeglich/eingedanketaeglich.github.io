{"s":[["Tagesgeld, Festgeld, Geldmarkt-ETF",0.0,3.262,[[0,10,0.0],[11,20,1.091],[21,34,2.02]]],["„Sicher“ heißt nicht automatisch „klug“.",3.367,6.536,[[0,8,3.367],[9,14,4.598],[15,20,4.923],[21,32,5.178],[33,40,5.886]]],["Geld, das ruht, kann trotzdem ein wenig arbeiten, es unterscheidet sich vor allem in einer Frage:",7.117,12.736,[[0,5,7.117],[6,9,7.755],[10,15,8.115],[16,20,8.649],[21,29,8.87],[30,33,9.323],[34,39,9.439],[40,49,9.752],[50,52,10.53],[53,66,10.751],[67,71,11.262],[72,75,11.436],[76,81,11.598],[82,84,11.865],[85,90,11.981],[91,97,12.19]]],["Wie schnell kommst du wieder dran?",13.653,15.105,[[0,3,13.653],[4,11,13.839],[12,18,14.141],[19,21,14.373],[22,28,14.466],[29,34,14.698]]],["Tagesgeld",15.778,16.451,[[0,9,15.778]]],["Verfügbarkeit: jederzeit",17.136,19.238,[[0,14,17.136],[15,24,18.704]]],["Idee: flexibel parken, Zins meist variabel",19.296,23.348,[[0,5,19.296],[6,14,20.445],[15,22,20.944],[23,27,21.711],[28,33,22.407],[34,42,22.755]]],["Festgeld",24.021,24.497,[[0,8,24.021]]],["Verfügbarkeit: erst nach Ablauf",25.182,27.098,[[0,14,25.182],[15,19,26.285],[20,24,26.517],[25,31,26.691]]],["Idee: für mehr Zins bindest du das Geld eine feste Zeit",27.678,30.557,[[0,5,27.678],[6,9,28.363],[10,14,28.549],[15,19,28.735],[20,27,29.013],[28,30,29.292],[31,34,29.373],[35,39,29.524],[40,44,29.733],[45,50,29.907],[51,55,30.267]]],["Geldmarkt-ETF",31.231,32.136,[[0,13,31.231]]],["Verfügbarkeit: börsentäglich",32.81,34.644,[[0,14,32.81],[15,28,34.006]]],["Idee: bildet kurzfristige Geldmarkt-Zinsen ab.",34.702,37.198,[[0,5,34.702],[6,12,35.329],[13,25,35.631],[26,42,36.246],[43,46,36.966]]],["Übergang Richtung Wertpapier",37.396,40.089,[[0,8,37.396],[9,17,38.94],[18,28,39.393]]],["Eine kleine Leiter:",40.763,41.842,[[0,4,40.763],[5,11,41.076],[12,19,41.401]]],["Tagesgeld, Festgeld, Geldmarkt-ETF · der Tausch ist immer derselbe:",41.982,47.508,[[0,10,41.982],[11,20,42.922],[21,34,43.828],[35,36,45.035],[37,40,45.546],[41,47,45.755],[48,51,46.359],[52,57,46.661],[58,67,46.893]]],["Verfügbarkeit gegen Zins.",47.775,49.609,[[0,13,47.775],[14,19,48.75],[20,25,49.099]]],["Der Tausch ist immer derselbe:",50.283,52.059,[[0,3,50.283],[4,10,50.48],[11,14,50.863],[15,20,51.165],[21,30,51.444]]],["Verfügbarkeit gegen Zins.",52.257,53.742,[[0,13,52.257],[14,19,53.034],[20,25,53.29]]],["Beim Festgeld lauert die Lockzins-Falle:",54.416,57.086,[[0,4,54.416],[5,13,54.66],[14,20,55.53],[21,24,55.937],[25,40,56.088]]],["Ein hoher Aktionszins gilt oft nur für Neukunden und nur kurz, danach fällt das Geld still auf den niedrigeren Bestandszins zurück.",57.783,65.956,[[0,3,57.783],[4,9,57.98],[10,21,58.282],[22,26,59.199],[27,30,59.443],[31,34,59.617],[35,38,59.768],[39,48,59.954],[49,52,60.906],[53,56,61.103],[57,62,61.324],[63,69,62.403],[70,75,62.81],[76,79,63.007],[80,84,63.181],[85,90,63.437],[91,94,63.82],[95,98,63.982],[99,110,64.133],[111,123,64.737],[124,131,65.503]]],["„Sicher parken“ ist kein einziger Zustand, sondern eine kleine Leiter, von jederzeit verfügbar bis börsentäglich handelbar.",66.769,74.675,[[0,7,66.769],[8,15,67.349],[16,19,68.127],[20,24,68.371],[25,33,68.696],[34,42,69.137],[43,50,69.903],[51,55,70.251],[56,62,70.46],[63,70,70.867],[71,74,71.575],[75,84,71.854],[85,94,72.376],[95,98,72.98],[99,112,73.235],[113,123,74.048]]],["Der höchste beworbene Zins ist nicht automatisch der beste; entscheidend ist, was nach der Aktion übrig bleibt.",75.371,82.709,[[0,3,75.371],[4,11,75.604],[12,21,76.022],[22,26,76.567],[27,30,77.276],[31,36,77.543],[37,48,77.798],[49,52,78.437],[53,59,78.587],[60,72,79.412],[73,77,80.05],[78,81,80.596],[82,86,80.933],[87,90,81.153],[91,97,81.258],[98,103,81.745],[104,111,82.036]]]]}