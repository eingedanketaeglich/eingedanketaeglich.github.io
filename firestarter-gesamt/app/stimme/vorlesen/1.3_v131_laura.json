{"s":[["Der Berater meint es gut, und macht dich trotzdem abhängig",0.0,3.123,[[0,3,0.0],[4,11,0.232],[12,17,0.708],[18,20,0.929],[21,25,1.057],[26,29,1.44],[30,35,1.66],[36,40,1.892],[41,49,2.067],[50,58,2.589]]],["Anlageberatung ist, nüchtern betrachtet, ein Geschäftsmodell.",3.936,7.663,[[0,14,3.936],[15,19,4.957],[20,28,5.364],[29,40,5.793],[41,44,6.536],[45,61,6.711]]],["Und es lebt von einer Lücke.",7.988,9.555,[[0,3,7.988],[4,6,8.278],[7,11,8.44],[12,15,8.649],[16,21,8.812],[22,28,9.044]]],["Die Wissens-Lücke",9.88,10.786,[[0,3,9.88],[4,17,10.054]]],["Du weißt weniger als der Berater, genau dieser Abstand ist sein Wert.",11.598,15.906,[[0,2,11.598],[3,8,11.784],[9,16,12.086],[17,20,12.527],[21,24,12.736],[25,33,12.875],[34,39,13.595],[40,46,14.036],[47,54,14.362],[55,58,14.919],[59,63,15.151],[64,69,15.43]]],["Schließt sich die Lücke, braucht man ihn weniger.",16.15,18.495,[[0,8,16.15],[9,13,16.486],[14,17,16.684],[18,24,16.8],[25,32,17.241],[33,36,17.566],[37,40,17.729],[41,49,17.845]]],["Das fertige Produkt",18.704,19.946,[[0,3,18.704],[4,11,19.006],[12,19,19.482]]],["Oft steht am Ende ein Produkt, das ohnehin verkauft werden soll.",21.246,24.497,[[0,3,21.246],[4,9,21.537],[10,12,21.815],[13,17,21.978],[18,21,22.175],[22,30,22.326],[31,34,22.756],[35,42,22.999],[43,51,23.394],[52,58,23.801],[59,64,24.068]]],["Die Frage ist nicht ob, sondern welches.",24.671,26.866,[[0,3,24.671],[4,9,24.845],[10,13,25.182],[14,19,25.356],[20,23,25.623],[24,31,25.844],[32,40,26.181]]],["Abgegebene Verantwortung",27.249,28.688,[[0,10,27.249],[11,24,27.957]]],["Du delegierst die Entscheidung, und damit das Verstehen.",29.292,32.206,[[0,2,29.292],[3,13,29.536],[14,17,30.105],[18,31,30.244],[32,35,30.941],[36,41,31.104],[42,45,31.417],[46,56,31.603]]],["Bequem heute, teuer auf Dauer.",32.59,34.807,[[0,6,32.59],[7,13,33.089],[14,19,33.739],[20,23,34.122],[24,30,34.343]]],["Das Problem ist nicht der schlechte Berater, es ist das gute Modell.",34.958,38.453,[[0,3,34.958],[4,11,35.179],[12,15,35.55],[16,21,35.701],[22,25,35.898],[26,35,36.003],[36,44,36.363],[45,47,37.036],[48,51,37.268],[52,55,37.419],[56,60,37.605],[61,68,37.872]]],["Selbst ein ehrlicher, kompetenter Berater arbeitet in einem System, das von deiner Unwissenheit lebt.",38.836,44.49,[[0,6,38.836],[7,10,39.23],[11,21,39.393],[22,33,39.915],[34,41,40.531],[42,50,41.065],[51,53,41.564],[54,59,41.669],[60,67,41.912],[68,71,42.435],[72,75,42.621],[76,82,42.783],[83,95,43.12],[96,101,43.874]]]]}