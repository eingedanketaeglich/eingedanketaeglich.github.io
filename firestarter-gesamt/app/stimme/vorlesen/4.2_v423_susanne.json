{"s":[["Fonds und ETF, der gemeinsame Korb",0.0,2.543,[[0,5,0.0],[6,9,0.406],[10,14,0.615],[15,18,1.567],[19,29,1.741],[30,34,2.322]]],["Fünfhundert Aktien einzeln kaufen?",2.624,5.097,[[0,11,2.624],[12,18,3.274],[19,26,3.878],[27,34,4.389]]],["Ein Albtraum.",5.48,6.606,[[0,3,5.48],[4,13,5.817]]],["Eleganter: alles in einen Korb, mit einer Order gekauft.",6.989,10.971,[[0,10,6.989],[11,16,8.162],[17,19,8.58],[20,25,8.731],[26,31,9.009],[32,35,9.509],[36,41,9.706],[42,47,9.95],[48,56,10.286]]],["Dieser Korb heißt Fonds; seine günstigste Bauform heißt ETF.",11.18,15.987,[[0,6,11.18],[7,11,11.598],[12,17,11.889],[18,24,12.318],[25,30,13.351],[31,41,13.653],[42,49,14.211],[50,55,14.721],[56,60,15.116]]],["Die wichtigste Gabelung, zwei Arten, den Korb zu füllen:",16.312,19.935,[[0,3,16.312],[4,14,16.498],[15,24,17.032],[25,29,17.729],[30,36,18.135],[37,40,18.611],[41,45,18.843],[46,48,19.122],[49,56,19.273]]],["Wer füllt den Korb? ein Manager-Team wählt aus",20.318,23.29,[[0,3,20.318],[4,9,20.712],[10,13,20.98],[14,19,21.2],[20,23,21.978],[24,36,22.222],[37,42,22.849],[43,46,23.162]]],["Laufende Kosten / Jahr: oft rund 1,5 bis 2 %",23.371,27.33,[[0,8,23.371],[9,15,23.801],[16,17,24.404],[18,23,24.532],[24,27,25.217],[28,32,25.473],[33,36,25.809],[37,40,26.552],[41,42,26.75],[43,44,27.052]]],["Wer füllt den Korb? ein Index-Rezept",27.841,30.569,[[0,3,27.841],[4,9,28.12],[10,13,28.398],[14,19,28.607],[20,23,29.466],[24,36,29.722]]],["Laufende Kosten / Jahr: oft nur 0,05 bis 0,50 %",30.906,36.27,[[0,8,30.906],[9,15,31.428],[16,17,32.032],[18,23,32.218],[24,27,32.926],[28,31,33.135],[32,36,33.495],[37,40,34.575],[41,45,34.853],[46,47,35.991]]],["Das Geld im Fonds ist Sondervermögen, rechtlich getrennt vom Anbieter, es gehört weiter dir.",36.862,42.492,[[0,3,36.862],[4,8,37.071],[9,11,37.338],[12,17,37.477],[18,21,37.732],[22,37,37.93],[38,47,38.974],[48,56,39.358],[57,60,39.764],[61,70,39.996],[71,73,40.913],[74,80,41.122],[81,87,41.459],[88,92,41.877]]],["Aber ehrlich:",42.