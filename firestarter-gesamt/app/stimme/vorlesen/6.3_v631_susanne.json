{"s":[["Tagesgeld, Festgeld, Geldmarkt-ETF",0.0,3.309,[[0,10,0.0],[11,20,1.091],[21,34,1.985]]],["„Sicher“ heißt nicht automatisch „klug“.",3.483,6.385,[[0,8,3.483],[9,14,4.261],[15,20,4.609],[21,32,4.923],[33,40,5.689]]],["Geld, das ruht, kann trotzdem ein wenig arbeiten, es unterscheidet sich vor allem in einer Frage:",6.711,12.748,[[0,5,6.711],[6,9,7.105],[10,15,7.372],[16,20,7.732],[21,29,7.964],[30,33,8.638],[34,39,8.858],[40,49,9.276],[50,52,10.205],[53,66,10.414],[67,71,10.971],[72,75,11.134],[76,81,11.297],[82,84,11.587],[85,90,11.738],[91,97,12.016]]],["Wie schnell kommst du wieder dran?",12.957,14.71,[[0,3,12.957],[4,11,13.201],[12,18,13.595],[19,21,13.897],[22,28,14.002],[29,34,14.234]]],["Tagesgeld",14.954,15.638,[[0,9,14.954]]],["Verfügbarkeit: jederzeit",15.685,17.484,[[0,14,15.685],[15,24,16.881]]],["Idee: flexibel parken, Zins meist variabel",17.554,21.339,[[0,5,17.554],[6,14,18.32],[15,22,18.994],[23,27,19.795],[28,33,20.317],[34,42,20.782]]],["Festgeld",21.397,22.001,[[0,8,21.397]]],["Verfügbarkeit: erst nach Ablauf",22.361,24.555,[[0,14,22.361],[15,19,23.452],[20,24,23.765],[25,31,24.021]]],["Idee: für mehr Zins bindest du das Geld eine feste Zeit",24.915,28.793,[[0,5,24.915],[6,9,25.855],[10,14,26.099],[15,19,26.366],[20,27,26.761],[28,30,27.121],[31,34,27.26],[35,39,27.469],[40,44,27.759],[45,50,27.991],[51,55,28.421]]],["Geldmarkt-ETF",29.094,30.232,[[0,13,29.094]]],["Verfügbarkeit: börsentäglich",30.65,32.635,[[0,14,30.65],[15,28,31.8]]],["Idee: bildet kurzfristige Geldmarkt-Zinsen ab.",32.693,35.712,[[0,5,32.693],[6,12,33.297],[13,25,33.703],[26,42,34.481],[43,46,35.41]]],["Übergang Richtung Wertpapier",36.095,37.918,[[0,8,36.095],[9,17,36.733],[18,28,37.105]]],["Eine kleine Leiter:",38.243,39.473,[[0,4,38.243],[5,11,38.533],[12,19,38.881]]],["Tagesgeld, Festgeld, Geldmarkt-ETF · der Tausch ist immer derselbe:",39.624,45.093,[[0,10,39.624],[11,20,40.518],[21,34,41.505],[35,36,43.073],[37,40,43.363],[41,47,43.56],[48,51,43.932],[52,57,44.164],[58,67,44.431]]],["Verfügbarkeit gegen Zins.",45.244,47.182,[[0,13,45.244],[14,19,46.254],[20,25,46.648]]],["Der Tausch ist immer derselbe:",47.426,49.307,[[0,3,47.426],[4,10,47.658],[11,14,48.053],[15,20,48.32],[21,30,48.599]]],["Verfügbarkeit gegen Zins.",49.458,51.119,[[0,13,49.458],[14,19,50.294],[20,25,50.631]]],["Beim Festgeld lauert die Lockzins-Falle:",51.362,54.01,[[0,4,51.362],[5,13,51.641],[14,20,52.349],[21,24,52.732],[25,40,52.872]]],["Ein hoher Aktionszins gilt oft nur für Neukunden und nur kurz, danach fällt das Geld still auf den niedrigeren Bestandszins zurück.",54.253,62.496,[[0,3,54.253],[4,9,54.497],[10,21,54.845],[22,26,55.797],[27,30,56.03],[31,34,56.262],[35,38,56.448],[39,48,56.599],[49,52,57.318],[53,56,57.504],[57,62,57.76],[63,69,58.63],[70,75,59.118],[76,79,59.339],[80,84,59.513],[85,90,59.745],[91,94,60.14],[95,98,60.302],[99,110,60.476],[111,123,61.068],[124,131,61.974]]],["„Sicher parken“ ist kein einziger Zustand, sondern eine kleine Leiter, von jederzeit verfügbar bis börsentäglich handelbar.",62.822,70.913,[[0,7,62.822],[8,15,63.332],[16,19,63.878],[20,24,64.122],[25,33,64.366],[34,42,64.795],[43,50,65.561],[51,55,65.967],[56,62,66.142],[63,70,66.513],[71,74,67.291],[75,84,67.581],[85,94,68.301],[95,98,68.986],[99,112,69.311],[113,123,70.194]]],["Der höchste beworbene Zins ist nicht automatisch der beste; entscheidend ist, was nach der Aktion übrig bleibt.",71.238,78.112,[[0,3,71.238],[4,11,71.447],[12,21,71.854],[22,26,72.434],[27,30,72.922],[31,36,73.177],[37,48,73.479],[49,52,74.106],[53,59,74.257],[60,72,75.058],[73,77,75.673],[78,81,75.894],[82,86,76.219],[87,90,76.463],[91,97,76.591],[98,103,77.113],[104,111,77.473]]]]}