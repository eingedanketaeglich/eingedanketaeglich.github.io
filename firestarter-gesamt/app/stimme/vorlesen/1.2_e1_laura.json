{"s":[["Der stille Saboteur, den niemand zeigt",0.0,2.357,[[0,3,0.0],[4,10,0.267],[11,20,0.604],[21,24,1.382],[25,32,1.591],[33,38,1.962]]],["Er nimmt dir nichts, er verhindert, dass etwas entsteht.",2.682,5.433,[[0,2,2.682],[3,8,2.856],[9,12,3.065],[13,20,3.193],[21,23,3.715],[24,35,3.843],[36,40,4.319],[41,46,4.516],[47,56,4.818]]],["Stell dir vor, jemand bremst dich aus, aber nicht in deiner Tasche, sondern in deiner Zukunft.",5.712,11.146,[[0,5,5.712],[6,9,6.026],[10,14,6.153],[15,21,6.618],[22,28,6.954],[29,33,7.268],[34,38,7.465],[39,43,8.011],[44,49,8.301],[50,52,8.58],[53,59,8.684],[60,67,9.021],[68,75,9.659],[76,78,9.985],[79,85,10.089],[86,94,10.449]]],["Du merkst es nicht, weil das Geld nie auf deinem Konto war.",11.529,14.442,[[0,2,11.529],[3,9,11.691],[10,12,12.028],[13,19,12.179],[20,24,12.481],[25,28,12.632],[29,33,12.806],[34,37,13.119],[38,41,13.316],[42,48,13.456],[49,54,13.711],[55,59,14.024]]],["Es hätte dort sein können.",14.686,15.952,[[0,2,14.686],[3,8,14.86],[9,13,15.069],[14,18,15.278],[19,26,15.511]]],["Es kam nur nie an.",16.196,17.287,[[0,2,16.196],[3,6,16.393],[7,10,16.625],[11,14,16.776],[15,18,16.95]]],["Wir nennen ihn den stillen Saboteur.",17.531,19.493,[[0,3,17.531],[4,10,17.716],[11,14,18.088],[15,18,18.274],[19,26,18.459],[27,36,18.819]]],["Und um ihn zu verstehen, musst du zuerst den stillen Motor kennen, an dem er sabotiert: den Zinseszins.",19.667,25.878,[[0,3,19.667],[4,6,19.876],[7,10,20.004],[11,13,20.131],[14,24,20.282],[25,30,20.758],[31,33,20.979],[34,40,21.141],[41,44,21.617],[45,52,21.815],[53,58,22.221],[59,66,22.581],[67,69,23.185],[70,73,23.336],[74,76,23.545],[77,87,23.649],[88,91,24.578],[92,103,24.833]]],["Stell ihn dir wie einen Marathonläufer vor, seine ganze Kraft steckt nicht in der Geschwindigkeit, sondern darin, dass er nicht aufhört.",26.122,32.937,[[0,5,26.122],[6,9,26.424],[10,13,26.528],[14,17,26.714],[18,23,26.865],[24,38,27.074],[39,43,27.91],[44,49,28.386],[50,55,28.665],[56,61,29.013],[62,68,29.338],[69,74,29.64],[75,77,29.849],[78,81,29.919],[82,98,30.035],[99,106,31.114],[107,113,31.405],[114,118,31.788],[119,121,31.985],[122,127,32.055],[128,136,32.299]]],["Keine Sorge vor der Mathematik:",33.541,35.236,[[0,5,33.541],[6,11,33.854],[12,15,34.156],[16,19,34.307],[20,31,34.423]]],["Wir rechnen alles gemeinsam und Schritt für Schritt.",35.364,38.266,[[0,3,35.364],[4,11,35.561],[12,17,35.991],[18,27,36.316],[28,31,37.082],[32,39,37.314],[40,43,37.639],[44,52,37.79]]],["Du brauchst nur die vier Grundrechenarten.",38.545,40.599,[[0,2,38.545],[3,11,38.707],[12,15,39.056],[16,19,39.218],[20,24,39.369],[25,42,39.636]]],["Wie werden aus 10.000 € rund 58.000 €, allein durch Nichtaufhören?",40.669,45.696,[[0,3,40.669],[4,10,40.89],[11,14,41.191],[15,21,41.424],[22,23,42.085],[24,28,42.41],[29,35,42.701],[36,38,43.897],[39,45,44.326],[46,51,44.674],[52,66,44.895]]],["Warum ist Stillstand oft teurer als ein zwischenzeitlicher Verlust?",46.021,49.504,[[0,5,46.021],[6,9,46.346],[10,20,46.532],[21,24,47.124],[25,31,47.31],[32,35,47.763],[36,39,47.948],[40,58,48.088],[59,67,48.935]]],["Warum steht diese Rechnung in keinem Hochglanz-Prospekt?",50.015,53.045,[[0,5,50.015],[6,11,50.363],[12,17,50.619],[18,26,50.862],[27,29,51.315],[30,36,51.513],[37,56,51.931]]],["Zwei Schritte weiter wartet der Zinseszins-Rechner.",53.324,55.901,[[0,4,53.324],[5,13,53.579],[14,20,53.881],[21,27,54.218],[28,31,54.543],[32,51,54.706]]],["Gib dort eine eigene Zahl ein, zum Beispiel den Betrag, den du im Monat übrig hättest, und schau, was die Kontinuität über die Jahre daraus macht.",56.076,63.912,[[0,3,56.076],[4,8,56.285],[9,13,56.528],[14,20,56.726],[21,25,57.086],[26,30,57.387],[31,34,57.747],[35,43,57.956],[44,47,58.363],[48,55,58.514],[56,59,58.955],[60,62,59.117],[63,65,59.245],[66,71,59.326],[72,77,59.686],[78,86,59.965],[87,90,60.615],[91,97,60.778],[98,101,61.114],[102,105,61.335],[106,117,61.497],[118,122,62.484],[123,126,62.728],[127,132,62.833],[133,139,63.111],[140,146,63.483]]],["Eine Lehrannahme, kein Versprechen.",64.295,66.281,[[0,4,64.295],[5,17,64.574],[18,22,65.375],[23,35,65.642]]],["Das Schlimmste, das passieren kann?",66.455,68.138,[[0,3,66.455],[4,15,66.664],[16,19,67.14],[20,29,67.314],[30,35,67.755]]],["Nichts.",68.312,68.8,[[0,7,68.312]]],["Kein Geld bewegt sich, keine Entscheidung fällt.",68.881,71.424,[[0,4,68.881],[5,9,69.148],[10,16,69.357],[17,22,69.717],[23,28,70.019],[29,41,70.321],[42,48,70.797]]]]}