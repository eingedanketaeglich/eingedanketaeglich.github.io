{"s":[["Der Zinseszins-Rechner, dein Werkzeug",0.0,2.218,[[0,3,0.0],[4,23,0.244],[24,28,1.149],[29,37,1.428]]],["Genau diesen Rechner bekommst du in die Hand, aber erst, wenn du selbst geschätzt hast statt einfach abzulesen.",2.601,8.162,[[0,5,2.601],[6,12,2.891],[13,20,3.111],[21,29,3.402],[30,32,3.75],[33,35,3.855],[36,39,3.936],[40,45,4.04],[46,50,4.632],[51,56,4.888],[57,61,5.306],[62,64,5.457],[65,71,5.596],[72,81,5.956],[82,86,6.385],[87,92,6.699],[93,100,6.989],[101,111,7.384]]],["Gleich kommen vier Fragen.",8.336,9.892,[[0,6,8.336],[7,13,8.649],[14,18,9.033],[19,26,9.346]]],["Rate mit, den frei bedienbaren Rechner schaltest du dir als Bonus frei, sobald du Baustein 1 abgeschlossen hast.",10.101,16.614,[[0,4,10.101],[5,9,10.414],[10,13,10.925],[14,18,11.192],[19,30,11.517],[31,38,12.156],[39,48,12.55],[49,51,12.934],[52,55,13.05],[56,59,13.224],[60,65,13.445],[66,71,13.886],[72,78,14.548],[79,81,14.861],[82,90,14.977],[91,92,15.383],[93,106,15.627],[107,112,16.219]]],["Danach liegt er dauerhaft in deinem Rechner-Fenster.",16.823,19.737,[[0,6,16.823],[7,12,17.253],[13,15,17.485],[16,25,17.74],[26,28,18.309],[29,35,18.39],[36,52,18.657]]]]}