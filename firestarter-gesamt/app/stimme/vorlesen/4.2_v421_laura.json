{"s":[["Die Aktie, ein Stück Eigentum",0.0,1.95,[[0,3,0.0],[4,10,0.279],[11,14,0.882],[15,20,1.08],[21,29,1.405]]],["Gibst du dem Bäcker 100 € und dir gehört dafür ein winziges Stück von allem, hast du ihm Geld geliehen?",2.334,8.452,[[0,5,2.334],[6,8,2.659],[9,12,2.833],[13,19,2.995],[20,23,3.332],[24,25,3.796],[26,29,4.272],[30,33,4.423],[34,40,4.598],[41,46,4.934],[47,50,5.433],[51,59,5.608],[60,65,6.107],[66,69,6.374],[70,76,6.56],[77,81,7.279],[82,84,7.488],[85,88,7.593],[89,93,7.721],[94,103,7.953]]],["Nein.",8.963,9.416,[[0,5,8.963]]],["Du bist Mit-Eigentümer.",9.567,11.029,[[0,2,9.567],[3,7,9.741],[8,23,10.008]]],["Genau das ist eine Aktie: ein Eigentumsanteil.",11.204,14.373,[[0,5,11.204],[6,9,11.564],[10,13,11.773],[14,18,11.958],[19,25,12.167],[26,29,12.829],[30,46,13.061]]],["Als Eigentümer profitierst du auf zwei Wegen:",14.652,17.147,[[0,3,14.652],[4,14,14.93],[15,26,15.51],[27,29,16.114],[30,33,16.23],[34,38,16.393],[39,45,16.718]]],["Dividende",17.24,17.983,[[0,9,17.24]]],["dein Anteil am ausgeschütteten Gewinn",18.587,20.839,[[0,4,18.587],[5,11,18.866],[12,14,19.353],[15,30,19.609],[31,37,20.421]]],["Wertsteigerung",21.223,22.117,[[0,14,21.223]]],["wollen mehr Leute ein Stück, steigt der Preis deines Anteils",22.186,25.507,[[0,6,22.186],[7,11,22.476],[12,17,22.685],[18,21,22.999],[22,28,23.138],[29,35,23.777],[36,39,24.079],[40,45,24.206],[46,52,24.566],[53,60,24.903]]],["Beide Wege haben eine Kehrseite:",26.11,28.061,[[0,5,26.11],[6,10,26.493],[11,16,26.819],[17,21,27.074],[22,32,27.271]]],["Läuft das Unternehmen schlecht, fällt die Dividende aus und der Wert kann sinken.",28.305,32.624,[[0,5,28.305],[6,9,28.583],[10,21,28.769],[22,31,29.233],[32,37,29.942],[38,41,30.197],[42,51,30.313],[52,55,30.859],[56,59,31.219],[60,63,31.37],[64,68,31.532],[69,73,31.822],[74,81,32.043]]],["Als Eigentümer trägst du das unternehmerische Risiko mit, du sitzt im selben Boot.",32.798,37.233,[[0,3,32.798],[4,14,33.076],[15,21,33.692],[22,24,34.017],[25,28,34.133],[29,45,34.319],[46,52,35.062],[53,57,35.526],[58,60,35.828],[61,66,36.002],[67,69,36.327],[70,76,36.466],[77,82,36.768]]],["Eine Aktie ist kein Papier mit hüpfenden Zahlen, sondern ein Eigentumstitel mit Stimmrecht.",37.616,42.689,[[0,4,37.616],[5,10,37.848],[11,14,38.266],[15,19,38.452],[20,26,38.719],[27,30,39.148],[31,40,39.311],[41,48,39.845],[49,56,40.286],[57,60,40.634],[61,75,40.843],[76,79,41.807],[80,91,41.958]]],["Du bist nicht Kunde des Marktes, sondern Teilhaber an echter Wirtschaft, einen garantierten Ertrag gibt es dafür nicht.",43.293,50.434,[[0,2,43.293],[3,7,43.456],[8,13,43.688],[14,19,43.909],[20,23,44.234],[24,32,44.431],[33,40,45.07],[41,50,45.441],[51,53,46.15],[54,60,46.324],[61,72,46.614],[73,78,47.601],[79,91,47.914],[92,98,48.657],[99,103,49.133],[104,106,49.4],[107,112,49.516],[113,119,49.795]]]]}