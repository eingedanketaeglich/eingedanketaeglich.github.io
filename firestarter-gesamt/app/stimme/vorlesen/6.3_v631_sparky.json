{"s":[["Tagesgeld, Festgeld, Geldmarkt-ETF",0.0,2.786,[[0,10,0.0],[11,20,0.929],[21,34,1.695]]],["„Sicher“ heißt nicht automatisch „klug“.",2.961,6.931,[[0,8,2.961],[9,14,4.389],[15,20,4.702],[21,32,4.957],[33,40,5.596]]],["Geld, das ruht, kann trotzdem ein wenig arbeiten, es unterscheidet sich vor allem in einer Frage:",7.442,12.783,[[0,5,7.442],[6,9,7.79],[10,15,7.999],[16,20,8.406],[21,29,8.591],[30,33,9.044],[34,39,9.16],[40,49,9.451],[50,52,10.472],[53,66,10.681],[67,71,11.238],[72,75,11.401],[76,81,11.552],[82,84,11.831],[85,90,11.935],[91,97,12.144]]],["Wie schnell kommst du wieder dran?",13.224,14.861,[[0,3,13.224],[4,11,13.41],[12,18,13.781],[19,21,14.048],[22,28,14.141],[29,34,14.373]]],["Tagesgeld",15.975,16.765,[[0,9,15.975]]],["Verfügbarkeit: jederzeit",17.369,19.099,[[0,14,17.369],[15,24,18.565]]],["Idee: flexibel parken, Zins meist variabel",19.145,22.733,[[0,5,19.145],[6,14,19.923],[15,22,20.515],[23,27,21.258],[28,33,21.781],[34,42,22.117]]],["Festgeld",23.046,23.754,[[0,8,23.046]]],["Verfügbarkeit: erst nach Ablauf",24.265,26.262,[[0,14,24.265],[15,19,25.391],[20,24,25.658],[25,31,25.856]]],["Idee: für mehr Zins bindest du das Geld eine feste Zeit",26.32,29.989,[[0,5,26.32],[6,9,27.156],[10,14,27.342],[15,19,27.62],[20,27,28.12],[28,30,28.456],[31,34,28.584],[35,39,28.758],[40,44,29.025],[45,50,29.223],[51,55,29.617]]],["Geldmarkt-ETF",30.674,31.777,[[0,13,30.674]]],["Verfügbarkeit: börsentäglich",32.055,33.925,[[0,14,32.055],[15,28,33.17]]],["Idee: bildet kurzfristige Geldmarkt-Zinsen ab.",33.971,37.14,[[0,5,33.971],[6,12,34.784],[13,25,35.155],[26,42,35.875],[43,46,36.769]]],["Übergang Richtung Wertpapier",37.651,39.242,[[0,8,37.651],[9,17,38.197],[18,28,38.545]]],["Eine kleine Leiter:",40.356,41.68,[[0,4,40.356],[5,11,40.774],[12,19,41.134]]],["Tagesgeld, Festgeld, Geldmarkt-ETF · der Tausch ist immer derselbe:",41.854,47.009,[[0,10,41.854],[11,20,42.69],[21,34,43.421],[35,36,44.652],[37,40,45.279],[41,47,45.43],[48,51,45.836],[52,57,46.057],[58,67,46.3]]],["Verfügbarkeit gegen Zins.",47.519,49.273,[[0,13,47.519],[14,19,48.425],[20,25,48.692]]],["Der Tausch ist immer derselbe:",49.783,51.478,[[0,3,49.783],[4,10,49.981],[11,14,50.376],[15,20,50.573],[21,30,50.794]]],["Verfügbarkeit gegen Zins.",51.687,53.394,[[0,13,51.687],[14,19,52.605],[20,25,52.872]]],["Beim Festgeld lauert die Lockzins-Falle:",54.091,56.424,[[0,4,54.091],[5,13,54.311],[14,20,54.915],[21,24,55.252],[25,40,55.391]]],["Ein hoher Aktionszins gilt oft nur für Neukunden und nur kurz, danach fällt das Geld still auf den niedrigeren Bestandszins zurück.",56.668,64.04,[[0,3,56.668],[4,9,56.877],[10,21,57.133],[22,26,58.026],[27,30,58.27],[31,34,58.514],[35,38,58.642],[39,48,58.77],[49,52,59.652],[53,56,59.826],[57,62,59.965],[63,69,60.569],[70,75,61.022],[76,79,61.219],[80,84,61.405],[85,90,61.718],[91,94,62.102],[95,98,62.253],[99,110,62.369],[111,123,62.903],[124,131,63.588]]],["„Sicher parken“ ist kein einziger Zustand, sondern eine kleine Leiter, von jederzeit verfügbar bis börsentäglich handelbar.",64.482,71.935,[[0,7,64.482],[8,15,65.039],[16,19,65.503],[20,24,65.701],[25,33,65.921],[34,42,66.362],[43,50,67.175],[51,55,67.488],[56,62,67.674],[63,70,68.023],[71,74,68.754],[75,84,68.998],[85,94,69.543],[95,98,70.252],[99,112,70.507],[113,123,71.297]]],["Der höchste beworbene Zins ist nicht automatisch der beste; entscheidend ist, was nach der Aktion übrig bleibt.",72.539,79.04,[[0,3,72.539],[4,11,72.713],[12,21,73.084],[22,26,73.584],[27,30,73.99],[31,36,74.164],[37,48,74.385],[49,52,74.977],[53,59,75.116],[60,72,76.022],[73,77,76.591],[78,81,77.09],[82,86,77.322],[87,90,77.508],[91,97,77.612],[98,103,78.077],[104,111,78.379]]]]}