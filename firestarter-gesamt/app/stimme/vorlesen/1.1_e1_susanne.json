{"s":[["Der Funke gehört dir",0.0,1.37,[[0,3,0.0],[4,9,0.325],[10,16,0.662],[17,20,1.091]]],["Worum es hier wirklich geht.",1.428,2.972,[[0,5,1.428],[6,8,1.846],[9,13,1.962],[14,22,2.148],[23,28,2.566]]],["Die Videos entstehen gerade, der Text trägt allein.",3.297,6.165,[[0,3,3.297],[4,10,3.471],[11,20,3.855],[21,28,4.249],[29,32,4.772],[33,37,4.969],[38,43,5.317],[44,51,5.642]]],["Stell dir ein Lagerfeuer in der Dämmerung vor.",6.49,8.963,[[0,5,6.49],[6,9,6.757],[10,13,6.931],[14,24,7.117],[25,27,7.837],[28,31,7.941],[32,41,8.081],[42,46,8.522]]],["Du könntest warten, bis jemand vorbeikommt und es dir anzündet, und hoffen, dass er es gut mit dir meint.",9.207,14.838,[[0,2,9.207],[3,11,9.369],[12,19,9.764],[20,23,10.147],[24,30,10.31],[31,42,10.577],[43,46,11.447],[47,49,11.622],[50,53,11.726],[54,63,11.889],[64,67,12.829],[68,75,13.038],[76,80,13.363],[81,83,13.572],[84,86,13.665],[87,90,13.828],[91,94,14.095],[95,98,14.223],[99,105,14.397]]],["Oder du nimmst selbst ein Streichholz und schlägst deinen eigenen Funken.",15.163,18.901,[[0,4,15.163],[5,7,15.535],[8,14,15.662],[15,21,15.952],[22,25,16.301],[26,37,16.417],[38,41,17.032],[42,50,17.16],[51,57,17.508],[58,65,17.868],[66,73,18.286]]],["Genau darum geht es in „Firestarter“: dass du den Funken schlägst.",19.18,23.592,[[0,5,19.18],[6,11,19.586],[12,16,19.97],[17,19,20.167],[20,22,20.318],[23,37,20.573],[38,42,22.094],[43,45,22.326],[46,49,22.454],[50,56,22.617],[57,66,23.0]]],["Nicht eine Bank.",23.685,24.695,[[0,5,23.685],[6,10,23.94],[11,16,24.161]]],["Nicht ein Berater, der dir am Ende ein Produkt verkauft.",24.973,27.748,[[0,5,24.973],[6,9,25.24],[10,18,25.368],[19,22,25.983],[23,26,26.123],[27,29,26.251],[30,34,26.425],[35,38,26.668],[39,46,26.796],[47,56,27.156]]],["Und keine Sorge:",27.992,28.968,[[0,3,27.992],[4,9,28.19],[10,16,28.526]]],["Hier wird dir nichts übergestülpt und nichts verkauft.",29.026,31.696,[[0,4,29.026],[5,9,29.269],[10,13,29.455],[14,20,29.629],[21,33,29.966],[34,37,30.639],[38,44,30.79],[45,54,31.104]]],["Firestarter ist eine Bibliothek zum Selbstlernen, du arbeitest dich in deinem Tempo durch kurze Videos und eigene Reflexion.",31.974,39.358,[[0,11,31.974],[12,15,32.729],[16,20,32.892],[21,31,33.112],[32,35,33.82],[36,49,34.041],[50,52,35.156],[53,62,35.33],[63,67,35.771],[68,70,35.992],[71,77,36.084],[78,83,36.375],[84,89,36.746],[90,95,36.967],[96,102,37.362],[103,106,37.965],[107,113,38.151],[114,124,38.511]]],["Du brauchst kein Vorwissen und keine Mathematik außer den vier Grundrechenarten.",39.684,44.188,[[0,2,39.684],[3,11,39.846],[12,16,40.206],[17,26,40.496],[27,30,41.17],[31,36,41.355],[37,47,41.634],[48,53,42.273],[54,57,42.644],[58,62,42.853],[63,80,43.109]]],["Du siehst die drei Leitbegriffe, auf denen alles steht.",44.432,47.311,[[0,2,44.432],[3,9,44.664],[10,13,44.931],[14,18,45.071],[19,32,45.373],[33,36,46.081],[37,42,46.208],[43,48,46.51],[49,55,46.789]]],["Sie sagt ehrlich, was Firestarter nicht ist, denn ehrliche Grenzen schützen dich.",47.59,52.559,[[0,3,47.59],[4,8,47.822],[9,17,48.159],[18,21,48.589],[22,33,48.856],[34,39,49.61],[40,44,49.889],[45,49,50.481],[50,58,50.725],[59,66,51.143],[67,75,51.735],[76,81,52.188]]],["Und sie legt die ganze Reise durch die neun Bausteine vor dir aus.",52.838,56.611,[[0,3,52.838],[4,7,53.047],[8,12,53.209],[13,16,53.43],[17,22,53.569],[23,28,53.952],[29,34,54.335],[35,38,54.556],[39,43,54.73],[44,53,55.02],[54,57,55.624],[58,61,55.833],[62,66,56.007]]]]}