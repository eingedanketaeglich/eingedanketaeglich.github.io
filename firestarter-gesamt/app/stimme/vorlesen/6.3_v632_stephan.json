{"s":[["Der Realzins-Test, ruht dein Geld oder schrumpft es?",0.0,3.936,[[0,3,0.0],[4,18,0.244],[19,23,1.567],[24,28,1.95],[29,33,2.194],[34,38,2.647],[39,48,2.937],[49,52,3.506]]],["Die wichtigste Rechnung dieser Lektion ist eine simple Subtraktion.",4.11,7.814,[[0,3,4.11],[4,14,4.261],[15,23,4.783],[24,30,5.341],[31,38,5.573],[39,42,6.072],[43,47,6.2],[48,54,6.397],[55,67,6.78]]],["Ein Zins allein sagt wenig, was zählt, ist der Realzins.",8.139,11.9,[[0,3,8.139],[4,8,8.313],[9,15,8.58],[16,20,8.998],[21,27,9.242],[28,31,9.555],[32,38,9.776],[39,42,10.461],[43,46,10.67],[47,56,10.867]]],["Ist der Realzins positiv, wächst deine Kaufkraft wirklich.",12.028,15.975,[[0,3,12.028],[4,7,12.214],[8,16,12.353],[17,25,12.852],[26,32,13.711],[33,38,14.327],[39,48,14.605],[49,58,15.313]]],["Ist er negativ, der Zins also kleiner als die Inflation, dann ruht dein Geld nicht, sondern schrumpft still, auch wenn die Zahl auf dem Konto gleich bleibt.",16.149,25.994,[[0,3,16.149],[4,6,16.37],[7,15,16.463],[16,19,17.426],[20,24,17.589],[25,29,17.879],[30,37,18.134],[38,41,18.529],[42,45,18.692],[46,56,18.843],[57,61,19.992],[62,66,20.259],[67,71,20.712],[72,76,20.967],[77,83,21.281],[84,91,21.803],[92,101,22.163],[102,108,22.778],[109,113,23.591],[114,118,23.789],[119,122,23.928],[123,127,24.067],[128,131,24.369],[132,135,24.497],[136,141,24.648],[142,148,25.054],[149,156,25.402]]],["Hinschauen statt parken: bei jedem ruhenden Geld einmal „Zins − Inflation“ rechnen.",26.169,32.217,[[0,10,26.169],[11,16,26.854],[17,24,27.179],[25,28,27.701],[29,34,27.852],[35,43,28.107],[44,48,28.525],[49,55,28.885],[56,61,29.396],[62,63,30.441],[64,74,30.499],[75,83,31.648]]],["Konditionen vergleichen statt verharren:",32.426,34.841,[[0,11,32.426],[12,23,33.053],[24,29,33.669],[30,40,34.063]]],["Hausbank-Zins und aktiv gewählte Einlageform liegen oft weit auseinander.",35.085,39.799,[[0,13,35.085],[14,17,36.374],[18,23,36.513],[24,32,36.919],[33,44,37.372],[45,51,38.266],[52,55,38.521],[56,60,38.823],[61,73,39.102]]],["Die Aufgabe trennen:",40.008,41.122,[[0,3,40.008],[4,11,40.17],[12,20,40.623]]],["Notgroschen bleibt sicher; was lange frei ist, gehört auf den Vermögens-Weg (Baustein 4 ff.), nicht ins nächste Festgeld.",41.273,49.063,[[0,11,41.273],[12,18,42.097],[19,26,42.353],[27,30,42.98],[31,36,43.165],[37,41,43.386],[42,46,43.665],[47,53,43.92],[54,57,44.152],[58,61,44.28],[62,75,44.454],[76,85,45.429],[86,87,46.103],[88,93,46.555],[94,99,47.252],[100,103,47.682],[104,111,47.972],[112,121,48.309]]],["Ein Zins von null fühlt sich harmlos an.",49.272,51.757,[[0,3,49.272],[4,8,49.435],[9,12,49.713],[13,17,49.934],[18,23,50.456],[24,28,50.712],[29,36,50.921],[37,40,51.443]]],["Aber bei spürbarer Inflation ist „null Zins“ in Wahrheit ein Minus an Kaufkraft.",52.001,57.689,[[0,4,52.001],[5,8,52.337],[9,18,52.5],[19,28,53.057],[29,32,53.672],[33,38,53.951],[39,44,54.532],[45,47,55.216],[48,56,55.391],[57,60,55.809],[61,66,55.96],[67,69,56.668],[70,80,56.9]]],["Die einzige ehrliche Frage lautet:",57.933,59.57,[[0,3,57.933],[4,11,58.107],[12,20,58.514],[21,26,58.827],[27,34,59.164]]],["„wie viel Zins minus Inflation?“",59.744,62.879,[[0,4,59.744],[5,9,60.104],[10,14,60.383],[15,20,61.126],[21,32,61.741]]]]}