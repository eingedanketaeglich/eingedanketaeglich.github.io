{"s":[["Der Abstand ist dein Wachstumsraum",0.0,2.078,[[0,3,0.0],[4,11,0.267],[12,15,0.848],[16,20,1.033],[21,34,1.3]]],["Schau dir die drei Abstände zwischen Heute und Ziel an, genau sie sind dein persönlicher Wachstumsraum.",3.193,8.963,[[0,5,3.193],[6,9,3.506],[10,13,3.634],[14,18,3.75],[19,27,3.994],[28,36,4.528],[37,42,4.911],[43,46,5.259],[47,51,5.41],[52,55,5.724],[56,61,6.362],[62,65,6.792],[66,70,6.989],[71,75,7.198],[76,88,7.442],[89,103,8.081]]],["Der größte Abstand zeigt, wo deine nächsten Schritte am meisten bewirken.",9.659,13.862,[[0,3,9.659],[4,10,9.857],[11,18,10.263],[19,25,10.704],[26,28,11.355],[29,34,11.622],[35,43,11.865],[44,52,12.26],[53,55,12.643],[56,63,12.806],[64,73,13.212]]],["Keine feste Stufenzahl, dein Tempo bestimmst du selbst.",14.466,18.181,[[0,5,14.466],[6,11,14.849],[12,23,15.197],[24,28,16.254],[29,34,16.567],[35,44,17.02],[45,47,17.461],[48,55,17.624]]],["Deine drei Zielwerte sind die Rohform deiner Nordsterne.",18.878,22.291,[[0,5,18.878],[6,10,19.179],[11,20,19.435],[21,25,20.364],[26,29,20.596],[30,37,20.747],[38,44,21.293],[45,56,21.571]]],["Als Nächstes gießt du sie in einen Brief an dein zukünftiges Ich, mit einer konkreten, überprüfbaren Selbstverpflichtung.",22.802,29.501,[[0,3,22.802],[4,12,23.115],[13,18,23.568],[19,21,23.823],[22,25,23.951],[26,28,24.114],[29,34,24.241],[35,40,24.474],[41,43,24.834],[44,48,24.938],[49,60,25.135],[61,65,25.936],[66,69,26.517],[70,75,26.714],[76,86,26.935],[87,100,27.597],[101,121,28.421]]],["Drei Sätze zum Mitnehmen",29.942,31.323,[[0,4,29.942],[5,10,30.325],[11,14,30.673],[15,24,30.859]]],["Die drei Leitbegriffe sind eine Kette:",32.275,34.458,[[0,3,32.275],[4,8,32.507],[9,21,32.798],[22,26,33.459],[27,31,33.668],[32,38,33.901]]],["Wissen trägt Selbstbestimmung, beides trägt Aufbau.",35.154,38.51,[[0,6,35.154],[7,12,35.607],[13,30,35.921],[31,37,37.128],[38,43,37.569],[44,51,37.918]]],["Eine niedrige Zahl heute ist dein Startkapital, kein Urteil.",39.113,43.223,[[0,4,39.113],[5,13,39.45],[14,18,39.926],[19,24,40.251],[25,28,40.878],[29,33,41.11],[34,47,41.296],[48,52,42.353],[53,60,42.666]]],["Der Abstand zwischen Heute und Ziel ist dein Wachstumsraum.",43.92,47.415,[[0,3,43.92],[4,11,44.106],[12,20,44.524],[21,26,44.907],[27,30,45.302],[31,35,45.476],[36,39,45.847],[40,44,46.045],[45,59,46.335]]]]}