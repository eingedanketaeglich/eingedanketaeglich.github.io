{"s":[["Die drei Leitbegriffe, dein Dreieck",0.0,2.531,[[0,3,0.0],[4,8,0.232],[9,22,0.522],[23,27,1.672],[28,35,1.997]]],["Das ganze Programm steht auf drei Begriffen, mit R&F in der Mitte.",3.646,7.709,[[0,3,3.646],[4,9,3.959],[10,18,4.284],[19,24,4.714],[25,28,4.969],[29,33,5.12],[34,44,5.375],[45,48,6.026],[49,52,6.409],[53,55,7.07],[56,59,7.175],[60,66,7.303]]],["Du kannst nichts steuern, was du nicht verstehst.",8.313,10.832,[[0,2,8.313],[3,9,8.51],[10,16,8.824],[17,25,9.079],[26,29,9.485],[30,32,9.671],[33,38,9.834],[39,49,10.089]]],["Solange Geld, Zinsen und Börse eine Black Box sind, entscheiden andere.",11.784,16.045,[[0,7,11.784],[8,13,12.249],[14,20,12.678],[21,24,13.177],[25,30,13.328],[31,35,13.735],[36,41,13.92],[42,45,14.176],[46,51,14.443],[52,63,14.965],[64,71,15.546]]],["Wissen allein füllt kein Depot.",16.741,18.924,[[0,6,16.741],[7,13,17.183],[14,19,17.624],[20,24,18.019],[25,31,18.344]]],["Es wird erst wertvoll, wenn es in Handlung übergeht.",19.528,22.024,[[0,2,19.528],[3,7,19.714],[8,12,19.911],[13,22,20.108],[23,27,20.619],[28,30,20.77],[31,33,20.886],[34,42,21.002],[43,52,21.397]]],["Nicht reich werden um des Reichtums willen, sondern frei werden in deinen Entscheidungen.",22.976,27.585,[[0,5,22.976],[6,11,23.301],[12,18,23.568],[19,21,23.847],[22,25,23.963],[26,35,24.149],[36,43,24.659],[44,51,25.24],[52,56,25.588],[57,63,25.913],[64,66,26.262],[67,73,26.436],[74,89,26.831]]],["Drei Leitbegriffe – dein erster Baustein",28.7,31.475,[[0,4,28.7],[5,17,29.06],[18,19,29.907],[20,24,30.232],[25,31,30.592],[32,40,30.964]]],["Finanzwissen führt zu Selbstbestimmung, und beides zusammen führt zu Vermögensaufbau.",32.287,37.233,[[0,12,32.287],[13,18,33.135],[19,21,33.378],[22,39,33.564],[40,43,34.818],[44,50,35.015],[51,59,35.364],[60,65,35.863],[66,68,36.118],[69,85,36.246]]],["Der Funke gehört dir, nicht dem Berater.",37.744,39.973,[[0,3,37.744],[4,9,37.918],[10,16,38.243],[17,21,38.591],[22,27,39.056],[28,31,39.265],[32,40,39.404]]],["Ein Feuer, da