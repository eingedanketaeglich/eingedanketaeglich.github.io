{"s":[["Die drei Leitbegriffe, dein Dreieck",0.0,2.624,[[0,3,0.0],[4,8,0.337],[9,22,0.708],[23,27,1.776],[28,35,2.055]]],["Das ganze Programm steht auf drei Begriffen, mit R&F in der Mitte.",3.065,7.256,[[0,3,3.065],[4,9,3.309],[10,18,3.622],[19,24,4.063],[25,28,4.377],[29,33,4.528],[34,44,4.83],[45,48,5.515],[49,52,5.84],[53,55,6.455],[56,59,6.618],[60,66,6.757]]],["Du kannst nichts steuern, was du nicht verstehst.",7.407,10.136,[[0,2,7.407],[3,9,7.581],[10,16,7.999],[17,25,8.336],[26,29,8.847],[30,32,9.091],[33,38,9.265],[39,49,9.474]]],["Solange Geld, Zinsen und Börse eine Black Box sind, entscheiden andere.",10.414,15.047,[[0,7,10.414],[8,13,10.844],[14,20,11.366],[21,24,11.889],[25,30,12.051],[31,35,12.55],[36,41,12.748],[42,45,13.015],[46,51,13.293],[52,63,13.839],[64,71,14.431]]],["Wissen allein füllt kein Depot.",15.326,17.706,[[0,6,15.326],[7,13,15.767],[14,19,16.417],[20,24,16.777],[25,31,17.067]]],["Es wird erst wertvoll, wenn es in Handlung übergeht.",18.031,20.817,[[0,2,18.031],[3,7,18.228],[8,12,18.426],[13,22,18.669],[23,27,19.25],[28,30,19.412],[31,33,19.54],[34,42,19.668],[43,52,20.167]]],["Nicht reich werden um des Reichtums willen, sondern frei werden in deinen Entscheidungen.",21.142,26.529,[[0,5,21.142],[6,11,21.456],[12,18,21.769],[19,21,22.199],[22,25,22.338],[26,35,22.524],[36,43,23.116],[44,51,23.778],[52,56,24.3],[57,63,24.741],[64,66,25.229],[67,73,25.38],[74,89,25.705]]],["Drei Leitbegriffe – dein erster Baustein",26.773,29.885,[[0,4,26.773],[5,17,27.121],[18,19,28.073],[20,24,28.352],[25,31,28.7],[32,40,29.153]]],["Finanzwissen führt zu Selbstbestimmung, und beides zusammen führt zu Vermögensaufbau.",30.163,35.608,[[0,12,30.163],[13,18,31.045],[19,21,31.312],[22,39,31.533],[40,43,32.763],[44,50,32.984],[51,59,33.437],[60,65,33.994],[66,68,34.226],[69,85,34.389]]],["Der Funke gehört dir, nicht dem Berater.",35.852,38.557,[[0,3,35.852],[4,9,36.13],[10,16,36.525],[17,21,36.885],[22,27,37.431],[28,31,37.721],[32,40,37.872]]],["Ein Feuer, das du selbst entfacht hast, kann dir niemand mehr ausreden.",38.731,43.003,[[0,3,38.731],[4,10,38.951],[11,14,39.3],[15,17,39.462],[18,24,39.625],[25,33,40.043],[34,39,40.577],[40,44,41.018],[45,48,41.239],[49,56,41.424],[57,61,41.866],[62,71,42.051]]]]}