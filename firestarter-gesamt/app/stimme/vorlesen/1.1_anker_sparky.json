{"s":[["Was du mitnimmst, und dein Anker",0.0,1.788,[[0,3,0.0],[4,6,0.267],[7,17,0.383],[18,21,1.184],[22,26,1.335],[27,32,1.533]]],["Drei Sätze, die wichtigsten Begriffe, dein persönliches Warum.",1.823,6.258,[[0,4,1.823],[5,11,2.055],[12,15,2.995],[16,27,3.146],[28,37,3.657],[38,42,4.83],[43,55,5.05],[56,62,5.712]]],["Drei Sätze zum Mitnehmen",6.861,8.185,[[0,4,6.861],[5,10,7.221],[11,14,7.593],[15,24,7.779]]],["Finanzwissen · Selbstbestimmung · Vermögensaufbau, die drei Leitbegriffe.",8.22,14.211,[[0,12,8.22],[13,14,9.114],[15,31,9.903],[32,33,11.018],[34,50,11.529],[51,54,12.875],[55,59,13.038],[60,73,13.328]]],["Bildung, kein Verkaufsgespräch, ehrliche Grenzen schützen dich.",15.163,19.215,[[0,8,15.163],[9,13,15.859],[14,31,16.126],[32,40,17.566],[41,48,18.007],[49,57,18.437],[58,63,18.831]]],["Neun Bausteine, ein Leitsatz.",19.598,21.78,[[0,4,19.598],[5,15,19.923],[16,19,20.817],[20,29,21.014]]],["„Finanzen und Börse sind kein Hobby.“",22.164,24.904,[[0,9,22.164],[10,13,22.953],[14,19,23.116],[20,24,23.708],[25,29,23.975],[30,37,24.277]]],["Der Gedanke, den fast keiner zu Ende denkt",26.204,28.688,[[0,3,26.204],[4,12,26.378],[13,16,27.086],[17,21,27.295],[22,28,27.574],[29,31,27.969],[32,36,28.143],[37,42,28.375]]],["Du hast noch nie einen Euro verloren, und trotzdem fehlt dir am Ende womöglich der größte Teil deines Vermögens.",29.13,36.003,[[0,2,29.13],[3,7,29.339],[8,12,29.571],[13,16,29.78],[17,22,30.012],[23,27,30.279],[28,37,30.65],[38,41,31.579],[42,50,31.719],[51,56,32.392],[57,60,32.729],[61,63,32.845],[64,68,33.007],[69,78,33.216],[79,82,33.994],[83,89,34.203],[90,94,34.691],[95,101,34.981],[102,112,35.26]]],["Nicht, weil dir jemand etwas weggenommen hätte.",36.514,38.754,[[0,6,36.514],[7,11,36.85],[12,15,37.013],[16,22,37.129],[23,28,37.431],[29,40,37.709],[41,47,38.244]]],["Sondern weil dein Geld einfach stillstand, während die Zeit weiterlief.",39.079,42.76,[[0,7,39.079],[8,12,39.463],[13,17,39.625],[18,22,39.799],[23,30,40.113],[31,42,40.484],[43,50,41.309],[51,54,41.61],[55,59,41.75],[60,71,42.063]]],["Das ist das Unheimliche am stillen Saboteur:",43.456,46.034,[[0,3,43.456],[4,7,43.747],[8,11,43.863],[12,23,44.107],[24,26,44.78],[27,34,44.919],[35,44,45.268]]],["Er raubt nichts, was du siehst.",46.638,48.414,[[0,2,46.638],[3,8,46.87],[9,16,47.23],[17,20,47.543],[21,23,47.729],[24,31,47.868]]],["Er verhindert nur, dass etwas entsteht.",48.925,51.247,[[0,2,48.925],[3,13,49.099],[14,18,49.575],[19,23,50.063],[24,29,50.295],[30,39,50.608]]],["Und weil auf deinem Kontoauszug nie eine rote Zahl auftaucht, merkst du jahrelang gar nicht, dass er überhaupt da ist.",51.851,58.828,[[0,3,51.851],[4,8,52.036],[9,12,52.269],[13,19,52.396],[20,31,52.652],[32,35,53.627],[36,40,53.917],[41,45,54.138],[46,50,54.44],[51,61,54.742],[62,68,55.763],[69,71,56.088],[72,81,56.239],[82,85,56.715],[86,92,56.936],[93,97,57.423],[98,100,57.632],[101,110,57.714],[111,113,58.167],[114,118,58.422]]],["In diesem Baustein schaust du ihm zum ersten Mal ins Gesicht, und verstehst, warum genau dieses Nicht-Hinschauen der eigentliche Preis ist.",59.525,67.501,[[0,2,59.525],[3,9,59.711],[10,18,60.024],[19,26,60.651],[27,29,61.011],[30,33,61.127],[34,37,61.278],[38,44,61.499],[45,48,61.893],[49,52,62.102],[53,61,62.253],[62,65,63.101],[66,76,63.286],[77,82,64.03],[83,88,64.378],[89,95,64.773],[96,112,65.144],[113,116,66.003],[117,128,66.212],[129,134,66.7],[135,139,67.083]]],["Begriffe in diesem Baustein",68.198,69.626,[[0,8,68.198],[9,11,68.697],[12,18,68.79],[19,27,69.057]]],["Zinseszins & Zinseszins-Kontinuität",70.229,72.853,[[0,10,70.229],[11,12,71.204],[13,35,71.355]]],["Der stille Saboteur",73.538,74.664,[[0,3,73.538],[4,10,73.747],[11,19,74.072]]],["Die drei Leitbegriffe",75.105,76.359,[[0,3,75.105],[4,8,75.291],[9,21,75.581]]],["Bildung statt Beratung",76.789,78.066,[[0,7,76.789],[8,13,77.253],[14,22,77.509]]],["Notgroschen",78.67,79.378,[[0,11,78.67]]],["Nordsterne & Selbstlern-Bibliothek",79.703,81.642,[[0,10,79.703],[11,12,80.4],[13,34,80.528]]],["Dein Anker:",82.339,83.256,[[0,4,82.339],[5,11,82.71]]],["Mein Warum",83.86,84.545,[[0,4,83.86],[5,10,84.127]]],["Warum nimmst du deine Finanzen gerade jetzt in die Hand?",85.659,88.539,[[0,5,85.659],[6,12,86.089],[13,15,86.321],[16,21,86.437],[22,30,86.658],[31,37,87.192],[38,43,87.505],[44,46,87.807],[47,50,87.888],[51,56,88.016]]],["Ein Satz reicht, nur für dich.",89.142,91.07,[[0,3,89.142],[4,8,89.409],[9,16,89.688],[17,20,90.245],[21,24,90.443],[25,30,90.582]]],["Du greifst ihn in Lektion 1.5, deinem Zukunftsbrief, wieder auf.",91.453,96.143,[[0,2,91.453],[3,10,91.615],[11,14,92.045],[15,17,92.219],[18,25,92.312],[26,30,92.788],[31,37,94.018],[38,52,94.332],[53,59,95.296],[60,64,95.609]]],["Häufige Fragen, kurz & klar",96.956,98.779,[[0,7,96.956],[8,15,97.397],[16,20,98.001],[21,22,98.326],[23,27,98.419]]],["Brauche ich Vorwissen oder Mathematik?",99.383,101.612,[[0,7,99.383],[8,11,99.743],[12,21,99.882],[22,26,100.532],[27,38,100.834]]],["Ist Firestarter eine Anlageberatung?",102.053,104.387,[[0,3,102.053],[4,15,102.343],[16,20,103.075],[21,36,103.272]]],["Bekomme ich ein Renditeversprechen?",104.897,106.813,[[0,7,104.897],[8,11,105.304],[12,15,105.478],[16,35,105.629]]],["Muss ich danach eine Präsenzveranstaltung besuchen?",107.324,110.017,[[0,4,107.324],[5,8,107.556],[9,15,107.672],[16,20,108.032],[21,41,108.23],[42,51,109.251]]]]}