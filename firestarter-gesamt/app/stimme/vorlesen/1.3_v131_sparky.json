{"s":[["Der Berater meint es gut, und macht dich trotzdem abhängig",0.0,3.088,[[0,3,0.0],[4,11,0.232],[12,17,0.708],[18,20,0.929],[21,25,1.068],[26,29,1.637],[30,35,1.811],[36,40,1.997],[41,49,2.159],[50,58,2.647]]],["Anlageberatung ist, nüchtern betrachtet, ein Geschäftsmodell.",3.204,7.349,[[0,14,3.204],[15,19,4.18],[20,28,4.783],[29,40,5.201],[41,44,6.246],[45,61,6.397]]],["Und es lebt von einer Lücke.",7.674,9.125,[[0,3,7.674],[4,6,7.86],[7,11,7.988],[12,15,8.231],[16,21,8.394],[22,28,8.615]]],["Die Wissens-Lücke",9.938,10.82,[[0,3,9.938],[4,17,10.136]]],["Du weißt weniger als der Berater, genau dieser Abstand ist sein Wert.",10.937,15.383,[[0,2,10.937],[3,8,11.122],[9,16,11.413],[17,20,11.877],[21,24,12.086],[25,33,12.202],[34,39,13.177],[40,46,13.618],[47,54,13.909],[55,58,14.431],[59,63,14.617],[64,69,14.884]]],["Schließt sich die Lücke, braucht man ihn weniger.",15.894,18.274,[[0,8,15.894],[9,13,16.254],[14,17,16.416],[18,24,16.532],[25,32,16.985],[33,36,17.38],[37,40,17.531],[41,49,17.647]]],["Das fertige Produkt",18.448,19.655,[[0,3,18.448],[4,11,18.727],[12,19,19.191]]],["Oft steht am Ende ein Produkt, das ohnehin verkauft werden soll.",20.956,24.357,[[0,3,20.956],[4,9,21.316],[10,12,21.594],[13,17,21.757],[18,21,22.001],[22,30,22.14],[31,34,22.616],[35,42,22.848],[43,51,23.231],[52,58,23.672],[59,64,23.916]]],["Die Frage ist nicht ob, sondern welches.",24.683,27.097,[[0,3,24.683],[4,9,24.857],[10,13,25.24],[14,19,25.391],[20,23,25.623],[24,31,26.006],[32,40,26.354]]],["Abgegebene Verantwortung",27.794,29.257,[[0,10,27.794],[11,24,28.502]]],["Du delegierst die Entscheidung, und damit das Verstehen.",29.698,32.623,[[0,2,29.698],[3,13,29.988],[14,17,30.51],[18,31,30.638],[32,35,31.323],[36,41,31.497],[42,45,31.788],[46,56,31.95]]],["Bequem heute, teuer auf Dauer.",33.227,35.294,[[0,6,33.227],[7,13,33.75],[14,19,34.26],[20,23,34.597],[24,30,34.76]]],["Das Problem ist nicht der schlechte Berater, es ist das gute Modell.",35.99,39.682,[[0,3,35.99],[4,11,36.223],[12,15,36.652],[16,21,36.803],[22,25,36.989],[26,35,37.105],[36,44,37.465],[45,47,38.278],[48,51,38.475],[52,55,38.591],[56,60,38.777],[61,68,39.079]]],["Selbst ein ehrlicher, kompetenter Berater arbeitet in einem System, das von deiner Unwissenheit lebt.",40.286,46.346,[[0,6,40.286],[7,10,40.704],[11,21,40.901],[22,33,41.435],[34,41,42.062],[42,50,42.863],[51,53,43.386],[54,59,43.49],[60,67,43.723],[68,71,44.442],[72,75,44.64],[76,82,44.791],[83,95,45.093],[96,101,45.743]]]]}