{"s":[["Der Zinseszins-Rechner, dein Werkzeug",0.0,3.135,[[0,3,0.0],[4,23,0.383],[24,28,2.043],[29,37,2.438]]],["Genau diesen Rechner bekommst du in die Hand, aber erst, wenn du selbst geschätzt hast statt einfach abzulesen.",3.576,10.553,[[0,5,3.576],[6,12,4.017],[13,20,4.377],[21,29,4.841],[30,32,5.236],[33,35,5.387],[36,39,5.515],[40,45,5.677],[46,50,6.327],[51,56,6.629],[57,61,6.954],[62,64,7.129],[65,71,7.349],[72,81,7.779],[82,86,8.278],[87,92,8.707],[93,100,9.056],[101,111,9.555]]],["Gleich kommen vier Fragen.",10.879,12.249,[[0,6,10.879],[7,13,11.18],[14,18,11.424],[19,26,11.633]]],["Rate mit, den frei bedienbaren Rechner schaltest du dir als Bonus frei, sobald du Baustein 1 abgeschlossen hast.",12.457,20.097,[[0,4,12.457],[5,9,12.806],[10,13,13.293],[14,18,13.56],[19,30,13.909],[31,38,14.663],[39,48,15.163],[49,51,15.592],[52,55,15.72],[56,59,15.94],[60,65,16.173],[66,71,16.614],[72,78,17.357],[79,81,17.81],[82,90,18.007],[91,92,18.576],[93,106,18.994],[107,112,19.725]]],["Danach liegt er dauerhaft in deinem Rechner-Fenster.",20.375,23.406,[[0,6,20.375],[7,12,20.817],[13,15,21.049],[16,25,21.211],[26,28,21.85],[29,35,21.954],[36,52,22.233]]]]}