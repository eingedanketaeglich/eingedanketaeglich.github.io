{"s":[["Was Firestarter ist, und was nicht",0.0,1.985,[[0,3,0.0],[4,15,0.302],[16,20,1.068],[21,24,1.347],[25,28,1.451],[29,34,1.649]]],["Die ehrlichste Art, Vertrauen aufzubauen: sagen, wo die Grenzen liegen.",2.426,6.513,[[0,3,2.426],[4,14,2.717],[15,19,3.204],[20,29,3.413],[30,41,3.866],[42,48,4.818],[49,51,5.317],[52,55,5.48],[56,63,5.596],[64,71,6.06]]],["Bildung, die dir das Prinzip erklärt, keine auf deinen Einzelfall zugeschnittene Empfehlung.",6.838,11.865,[[0,8,6.838],[9,12,7.326],[13,16,7.454],[17,20,7.593],[21,28,7.755],[29,37,8.162],[38,43,8.789],[44,47,9.207],[48,54,9.369],[55,65,9.741],[66,80,10.484],[81,92,11.122]]],["ehrliche Sprache:",12.19,13.27,[[0,8,12.19],[9,17,12.608]]],["Es fällt nie eine Zahl wie „so viel bekommst du“.",13.421,16.939,[[0,2,13.421],[3,8,13.618],[9,12,13.92],[13,17,14.211],[18,22,14.454],[23,26,14.861],[27,30,15.267],[31,35,15.824],[36,44,16.057],[45,49,16.544]]],["ein Fundament, aktives Handeln gehört nicht zu Firestarter.",17.148,20.898,[[0,3,17.148],[4,14,17.264],[15,22,18.053],[23,30,18.506],[31,37,18.947],[38,43,19.226],[44,46,19.47],[47,59,19.749]]],["die Schicht darunter, das konkrete Depot-Zusammenstellen kommt später.",21.142,24.81,[[0,3,21.142],[4,11,21.293],[12,21,21.56],[22,25,22.071],[26,34,22.245],[35,56,22.744],[57,62,24.009],[63,70,24.218]]],["steuerliches Grundwissen, damit du die richtigen Fragen stellen kannst.",25.054,28.49,[[0,12,25.054],[13,25,25.762],[26,31,26.355],[32,34,26.575],[35,38,26.68],[39,48,26.842],[49,55,27.225],[56,63,27.596],[64,71,27.956]]],["Und was ist es dann zusammengefasst?",28.699,30.348,[[0,3,28.699],[4,7,28.897],[8,11,29.094],[12,14,29.222],[15,19,29.326],[20,36,29.512]]],["Bildung.",30.441,31.021,[[0,8,30.441]]],["Ein Fundament.",31.045,32.066,[[0,3,31.045],[4,14,31.242]]],["Eine Selbstlern-Bibliothek, durch die du dich selbst bewegst, und auf der alles Weitere ruht.",32.124,37.407,[[0,4,32.124],[5,27,32.38],[28,33,33.994],[34,37,34.214],[38,40,34.33],[41,45,34.458],[46,52,34.621],[53,61,35.004],[62,65,35.828],[66,69,36.049],[70,73,36.199],[74,79,36.304],[80,87,36.559],[88,93,36.977]]],["Was ein Programm nicht verspricht, schützt dich, nicht den Anbieter.",37.616,41.401,[[0,3,37.616],[4,7,37.813],[8,16,37.929],[17,22,38.336],[23,34,38.603],[35,42,39.218],[43,48,39.601],[49,54,40.112],[55,58,40.484],[59,68,40.704]]],["Ein Programm ohne Rendite-Werbung hat nur ein Interesse: dass du es verstehst.",41.575,45.975,[[0,3,41.575],[4,12,41.749],[13,17,42.306],[18,33,42.562],[34,37,43.386],[38,41,43.525],[42,45,43.653],[46,56,43.839],[57,61,44.71],[62,64,44.93],[65,67,45.069],[68,78,45.186]]]]}