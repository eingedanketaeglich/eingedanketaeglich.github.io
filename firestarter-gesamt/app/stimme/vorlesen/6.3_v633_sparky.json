{"s":[["Die Grenze.",0.0,0.871,[[0,3,0.0],[4,11,0.221]]],["Notgroschen ist Sicherheit, nicht Renditequelle",1.567,4.574,[[0,11,1.567],[12,15,2.299],[16,27,2.519],[28,33,3.46],[34,47,3.75]]],["Verzinste Einlagen haben eine klare Aufgabe:",5.526,8.301,[[0,9,5.526],[10,18,6.223],[19,24,6.792],[25,29,7.036],[30,35,7.233],[36,44,7.593]]],["Sicherheit und Verfügbarkeit, vor allem für den Notgroschen.",8.812,12.179,[[0,10,8.812],[11,14,9.416],[15,29,9.555],[30,33,10.693],[34,39,10.867],[40,43,11.099],[44,47,11.227],[48,60,11.355]]],["Sie sind nicht der Ort, an dem Vermögen wächst.",12.992,15.441,[[0,3,12.992],[4,8,13.166],[9,14,13.375],[15,18,13.607],[19,23,13.758],[24,26,14.129],[27,30,14.269],[31,39,14.466],[40,47,14.907]]],["Wer mit Zins-Hopping (ständig dem nächsten Aktionszins hinterher) Vermögen aufbauen will, verwechselt die Aufgaben.",15.882,22.639,[[0,3,15.882],[4,7,16.103],[8,20,16.277],[21,29,17.124],[30,33,17.809],[34,42,17.984],[43,54,18.343],[55,65,19.017],[66,74,19.992],[75,83,20.491],[84,89,20.921],[90,101,21.246],[102,105,21.815],[106,115,21.943]]],["Die klare Linie:",22.964,24.102,[[0,3,22.964],[4,9,23.138],[10,16,23.533]]],["Der Notgroschen bleibt sicher und verfügbar, niemals in Schwankung.",24.346,27.922,[[0,3,24.346],[4,15,24.52],[16,22,25.089],[23,29,25.344],[30,33,25.658],[34,44,25.785],[45,52,26.679],[53,55,27.132],[56,67,27.237]]],["Was darüber hinaus lange frei ist, gehört in den Vermögensaufbau (Baustein 4 ff.), nicht ins nächste Festgeld.",28.525,36.257,[[0,3,28.525],[4,11,28.758],[12,18,29.21],[19,24,29.686],[25,29,29.965],[30,34,30.29],[35,41,30.836],[42,44,31.196],[45,48,31.277],[49,64,31.463],[65,74,32.566],[75,76,33.297],[77,82,33.622],[83,88,34.667],[89,92,34.992],[93,100,35.189],[101,110,35.526]]],["Verzinste Einlagen und Vermögensaufbau sind zwei verschiedene Werkzeuge.",37.07,41.11,[[0,9,37.07],[10,18,37.674],[19,22,38.254],[23,38,38.371],[39,43,39.299],[44,48,39.497],[49,61,39.822],[62,72,40.309]]],["Das eine hält den Notgroschen sicher, das andere lässt Vermögen über Jahrzehnte wachsen.",41.621,46.405,[[0,3,41.621],[4,8,41.865],[9,13,42.132],[14,17,42.318],[18,29,42.457],[30,37,43.026],[38,41,43.676],[42,48,43.908],[49,54,44.326],[55,63,44.57],[64,68,45.035],[69,79,45.255],[80,88,45.801]]],["Sie zu verwechseln kostet auf beiden Seiten, entweder Sicherheit oder Wachstum.",47.102,51.85,[[0,3,47.102],[4,6,47.311],[7,18,47.461],[19,25,48.088],[26,29,48.448],[30,36,48.611],[37,44,48.936],[45,53,49.737],[54,64,50.19],[65,69,50.91],[70,79,51.177]]],["Drei Sätze zum Mitnehmen",52.663,53.951,[[0,4,52.663],[5,10,53.011],[11,14,53.348],[15,24,53.51]]],["Tagesgeld, Festgeld, Geldmarkt-ETF verzinsen ruhendes Geld; der Tausch ist immer Verfügbarkeit gegen Zins.",54.068,62.16,[[0,10,54.068],[11,20,55.066],[21,34,55.995],[35,44,57.655],[45,53,58.247],[54,59,58.677],[60,63,59.513],[64,70,59.698],[71,74,60.07],[75,80,60.256],[81,94,60.499],[95,100,61.312],[101,106,61.614]]],["Vorsicht vor der Lockzins-Falle.",62.764,64.784,[[0,8,62.764],[9,12,63.484],[13,16,63.669],[17,32,63.786]]],["Realzins = Einlagenzins − Inflation:",65.295,69.231,[[0,8,65.295],[9,10,66.2],[11,23,66.851],[24,25,67.942],[26,36,68.302]]],["Ist er negativ, schrumpft dein Geld still, auch wenn die Zahl gleich bleibt.",69.927,74.235,[[0,3,69.927],[4,6,70.217],[7,15,70.322],[16,25,71.088],[26,30,71.495],[31,35,71.68],[36,42,71.889],[43,47,72.656],[48,52,72.888],[53,56,73.062],[57,61,73.213],[62,68,73.445],[69,76,73.747]]],["Verzinste Einlagen sind Sicherheit, keine Renditequelle.",74.676,77.973,[[0,9,74.676],[10,18,75.291],[19,23,75.825],[24,35,76.011],[36,41,76.742],[42,56,77.079]]],["Zins-Hopping ersetzt den Zinseszins nicht.",78.414,81.224,[[0,12,78.414],[13,20,79.238],[21,24,79.703],[25,35,79.912],[36,42,80.608]]]]}