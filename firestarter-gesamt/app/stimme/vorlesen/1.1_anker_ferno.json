{"s":[["Was du mitnimmst, und dein Anker",0.0,1.811,[[0,3,0.0],[4,6,0.267],[7,17,0.406],[18,21,1.138],[22,26,1.289],[27,32,1.521]]],["Drei Sätze, die wichtigsten Begriffe, dein persönliches Warum.",1.846,6.397,[[0,4,1.846],[5,11,2.171],[12,15,2.961],[16,27,3.135],[28,37,3.738],[38,42,4.725],[43,55,5.039],[56,62,5.851]]],["Drei Sätze zum Mitnehmen",7.094,8.557,[[0,4,7.094],[5,10,7.442],[11,14,7.814],[15,24,8.011]]],["Finanzwissen · Selbstbestimmung · Vermögensaufbau, die drei Leitbegriffe.",9.369,14.872,[[0,12,9.369],[13,14,10.368],[15,31,10.786],[32,33,11.854],[34,50,12.214],[51,54,13.56],[55,59,13.723],[60,73,14.002]]],["Bildung, kein Verkaufsgespräch, ehrliche Grenzen schützen dich.",15.685,19.83,[[0,8,15.685],[9,13,16.579],[14,31,16.858],[32,40,18.228],[41,48,18.692],[49,57,19.099],[58,63,19.459]]],["Neun Bausteine, ein Leitsatz.",20.527,22.442,[[0,4,20.527],[5,15,20.817],[16,19,21.525],[20,29,21.746]]],["„Finanzen und Börse sind kein Hobby.“",22.884,25.449,[[0,9,22.884],[10,13,23.627],[14,19,23.801],[20,24,24.405],[25,29,24.695],[30,37,24.927]]],["Der Gedanke, den fast keiner zu Ende denkt",26.146,28.317,[[0,3,26.146],[4,12,26.332],[13,16,26.738],[17,21,26.912],[22,28,27.249],[29,31,27.586],[32,36,27.76],[37,42,28.027]]],["Du hast noch nie einen Euro verloren, und trotzdem fehlt dir am Ende womöglich der größte Teil deines Vermögens.",29.269,35.26,[[0,2,29.269],[3,7,29.466],[8,12,29.687],[13,16,29.861],[17,22,30.012],[23,27,30.256],[28,37,30.569],[38,41,31.301],[42,50,31.452],[51,56,31.951],[57,60,32.195],[61,63,32.357],[64,68,32.531],[69,78,32.775],[79,82,33.286],[83,89,33.472],[90,94,34.006],[95,101,34.273],[102,112,34.575]]],["Nicht, weil dir jemand etwas weggenommen hätte.",35.956,38.255,[[0,6,35.956],[7,11,36.363],[12,15,36.549],[16,22,36.676],[23,28,37.001],[29,40,37.315],[41,47,37.837]]],["Sondern weil dein Geld einfach stillstand, während die Zeit weiterlief.",38.859,42.899,[[0,7,38.859],[8,12,39.451],[13,17,39.672],[18,22,39.869],[23,30,40.148],[31,42,40.461],[43,50,41.343],[51,54,41.703],[55,59,41.866],[60,71,42.191]]],["Das ist das Unheimliche am stillen Saboteur:",43.596,46.034,[[0,3,43.596],[4,7,43.909],[8,11,44.049],[12,23,44.292],[24,26,44.861],[27,34,44.989],[35,44,45.302]]],["Er raubt nichts, was du siehst.",46.73,48.495,[[0,2,46.73],[3,8,46.963],[9,16,47.299],[17,20,47.601],[21,23,47.787],[24,31,47.961]]],["Er verhindert nur, dass etwas entsteht.",49.192,51.572,[[0,2,49.192],[3,13,49.389],[14,18,49.865],[19,23,50.353],[24,29,50.585],[30,39,50.898]]],["Und weil auf deinem Kontoauszug nie eine rote Zahl auftaucht, merkst du jahrelang gar nicht, dass er überhaupt da ist.",52.268,59.13,[[0,3,52.268],[4,8,52.454],[9,12,52.652],[13,19,52.826],[20,31,53.174],[32,35,53.998],[36,40,54.219],[41,45,54.439],[46,50,54.799],[51,61,55.078],[62,68,56.053],[69,71,56.355],[72,81,56.506],[82,85,57.028],[86,92,57.226],[93,97,57.702],[98,100,57.911],[101,110,58.004],[111,113,58.503],[114,118,58.77]]],["In diesem Baustein schaust du ihm zum ersten Mal ins Gesicht, und verstehst, warum genau dieses Nicht-Hinschauen der eigentliche Preis ist.",59.734,67.803,[[0,2,59.734],[3,9,59.896],[10,18,60.14],[19,26,60.593],[27,29,60.883],[30,33,60.999],[34,37,61.138],[38,44,61.394],[45,48,61.812],[49,52,62.067],[53,61,62.218],[62,65,63.147],[66,76,63.31],[77,82,64.146],[83,88,64.471],[89,95,64.877],[96,112,65.318],[113,116,66.293],[117,128,66.549],[129,134,67.095],[135,139,67.443]]],["Begriffe in diesem Baustein",68.441,69.939,[[0,8,68.441],[9,11,68.999],[12,18,69.138],[19,27,69.417]]],["Zinseszins & Zinseszins-Kontinuität",70.694,73.259,[[0,10,70.694],[11,12,71.634],[13,35,71.82]]],["Der stille Saboteur",73.91,74.978,[[0,3,73.91],[4,10,74.119],[11,19,74.455]]],["Die drei Leitbegriffe",75.535,76.626,[[0,3,75.535],[4,8,75.709],[9,21,75.941]]],["Bildung statt Beratung",77.033,78.217,[[0,7,77.033],[8,13,77.439],[14,22,77.694]]],["Notgroschen",78.972,79.68,[[0,11,78.972]]],["Nordsterne & Selbstlern-Bibliothek",80.156,82.292,[[0,10,80.156],[11,12,80.992],[13,34,81.189]]],["Dein Anker:",83.035,83.848,[[0,4,83.035],[5,11,83.395]]],["Mein Warum",84.173,84.916,[[0,4,84.173],[5,10,84.521]]],["Warum nimmst du deine Finanzen gerade jetzt in die Hand?",86.019,89.003,[[0,5,86.019],[6,12,86.425],[13,15,86.669],[16,21,86.82],[22,30,87.052],[31,37,87.586],[38,43,88.028],[44,46,88.364],[47,50,88.446],[51,56,88.585]]],["Ein Satz reicht, nur für dich.",90.117,91.987,[[0,3,90.117],[4,8,90.35],[9,16,90.617],[17,20,91.197],[21,24,91.464],[25,30,91.615]]],["Du greifst ihn in Lektion 1.5, deinem Zukunftsbrief, wieder auf.",92.683,96.932,[[0,2,92.683],[3,10,92.857],[11,14,93.275],[15,17,93.449],[18,25,93.6],[26,30,94.1],[31,37,94.831],[38,52,95.087],[53,59,96.131],[60,64,96.491]]],["Häufige Fragen, kurz & klar",97.629,99.394,[[0,7,97.629],[8,15,98.117],[16,20,98.569],[21,22,98.906],[23,27,99.034]]],["Brauche ich Vorwissen oder Mathematik?",100.091,102.424,[[0,7,100.091],[8,11,100.578],[12,21,100.752],[22,26,101.403],[27,38,101.623]]],["Ist Firestarter eine Anlageberatung?",102.865,105.35,[[0,3,102.865],[4,15,103.156],[16,20,104.061],[21,36,104.305]]],["Bekomme ich ein Renditeversprechen?",105.733,107.695,[[0,7,105.733],[8,11,106.198],[12,15,106.395],[16,35,106.557]]],["Muss ich danach eine Präsenzveranstaltung besuchen?",108.136,110.992,[[0,4,108.136],[5,8,108.369],[9,15,108.496],[16,20,108.937],[21,41,109.146],[42,51,110.273]]]]}