{"s":[["Was du mitnimmst",0.0,1.057,[[0,3,0.0],[4,6,0.348],[7,16,0.488]]],["Drei Sätze, und die Fragen, die jetzt oft kommen.",2.171,5.166,[[0,4,2.171],[5,11,2.577],[12,15,3.193],[16,19,3.344],[20,27,3.471],[28,31,3.994],[32,37,4.133],[38,41,4.412],[42,49,4.644]]],["Drei Sätze zum Mitnehmen",5.492,6.803,[[0,4,5.492],[5,10,5.828],[11,14,6.188],[15,24,6.374]]],["Kontinuität schlägt Höhe, der Motor ist das „hoch n“, nicht der Zinssatz.",7.5,12.608,[[0,11,7.5],[12,19,8.51],[20,25,8.87],[26,29,9.578],[30,35,9.741],[36,39,10.101],[40,43,10.24],[44,49,10.426],[50,53,10.879],[54,59,11.447],[60,63,11.703],[64,73,11.865]]],["37.000 € sind der entgangene Lauf, nie entstanden, nicht entnommen.",13.212,18.68,[[0,6,13.212],[7,8,14.269],[9,13,14.988],[14,17,15.186],[18,28,15.314],[29,34,15.848],[35,38,16.556],[39,50,16.788],[51,56,17.717],[57,67,18.03]]],["Langes Verharren im Tal kostet jedes Jahr plus dessen Zinseszins, teurer als ein erholter Sturz.",19.284,25.217,[[0,6,19.284],[7,16,19.702],[17,19,20.143],[20,23,20.294],[24,30,20.735],[31,36,21.2],[37,41,21.536],[42,46,21.803],[47,53,22.082],[54,65,22.372],[66,72,23.417],[73,76,23.893],[77,80,24.079],[81,89,24.195],[90,96,24.59]]],["Häufige Fragen, kurz & klar",25.797,27.84,[[0,7,25.797],[8,15,26.215],[16,20,27.016],[21,22,27.376],[23,27,27.504]]],["Sind die 7 % ein Renditeversprechen?",28.212,30.871,[[0,4,28.212],[5,8,28.444],[9,10,28.607],[11,12,28.92],[13,16,29.501],[17,36,29.698]]],["Wurden die 37.000 € in einem Crash „verloren“?",31.358,35.294,[[0,6,31.358],[7,10,31.683],[11,17,31.811],[18,19,32.902],[20,22,33.309],[23,28,33.471],[29,34,33.692],[35,46,34.238]]],["Soll ich bei jedem Tal verkaufen oder aktiv handeln?",35.956,38.974,[[0,4,35.956],[5,8,36.188],[9,12,36.315],[13,18,36.466],[19,22,36.803],[23,32,37.0],[33,37,37.755],[38,43,38.01],[44,52,38.417]]],["Ist „kaufen und liegen lassen“ also schlecht?",39.578,42.283,[[0,3,39.578],[4,11,40.019],[12,15,40.634],[16,22,40.774],[23,30,41.029],[31,35,41.447],[36,45,41.702]]],