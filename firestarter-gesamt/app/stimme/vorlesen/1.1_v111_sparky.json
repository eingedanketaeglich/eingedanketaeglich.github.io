{"s":[["Die drei Leitbegriffe, dein Dreieck",0.0,2.357,[[0,3,0.0],[4,8,0.197],[9,22,0.441],[23,27,1.498],[28,35,1.823]]],["Das ganze Programm steht auf drei Begriffen, mit R&F in der Mitte.",3.309,7.639,[[0,3,3.309],[4,9,3.576],[10,18,3.913],[19,24,4.516],[25,28,4.795],[29,33,4.923],[34,44,5.178],[45,48,6.072],[49,52,6.269],[53,55,6.85],[56,59,6.954],[60,66,7.082]]],["Du kannst nichts steuern, was du nicht verstehst.",8.081,10.519,[[0,2,8.081],[3,9,8.243],[10,16,8.568],[17,25,8.824],[26,29,9.288],[30,32,9.474],[33,38,9.59],[39,49,9.764]]],["Solange Geld, Zinsen und Börse eine Black Box sind, entscheiden andere.",11.029,15.813,[[0,7,11.029],[8,13,11.459],[14,20,12.121],[21,24,12.701],[25,30,12.852],[31,35,13.305],[36,41,13.514],[42,45,13.781],[46,51,14.013],[52,63,14.721],[64,71,15.267]]],["Wissen allein füllt kein Depot.",16.765,18.82,[[0,6,16.765],[7,13,17.16],[14,19,17.671],[20,24,17.973],[25,31,18.205]]],["Es wird erst wertvoll, wenn es in Handlung übergeht.",19.261,22.117,[[0,2,19.261],[3,7,19.505],[8,12,19.714],[13,22,19.923],[23,27,20.643],[28,30,20.84],[31,33,20.968],[34,42,21.072],[43,52,21.49]]],["Nicht reich werden um des Reichtums willen, sondern frei werden in deinen Entscheidungen.",22.558,27.47,[[0,5,22.558],[6,11,22.884],[12,18,23.22],[19,21,23.58],[22,25,23.708],[26,35,23.882],[36,43,24.393],[44,51,25.136],[52,56,25.531],[57,63,25.844],[64,66,26.227],[67,73,26.355],[74,89,26.634]]],["Drei Leitbegriffe – dein erster Baustein",27.911,30.732,[[0,4,27.911],[5,17,28.271],[18,19,29.223],[20,24,29.513],[25,31,29.733],[32,40,30.163]]],["Finanzwissen führt zu Selbstbestimmung, und beides zusammen führt zu Vermögensaufbau.",31.684,37.477,[[0,12,31.684],[13,18,32.671],[19,21,32.961],[22,39,33.135],[40,43,34.447],[44,50,34.679],[51,59,35.155],[60,65,35.829],[66,68,36.154],[69,85,36.293]]],["Der Funke gehört dir, nicht dem Berater.",38.081,40.833,[[0,3,38.081],[4,9,38.278],[10,16,38.638],[17,21,38.963],[22,27,39.683],[28,31,39.985],[32,40,40.148]]],["Ein Feuer, d