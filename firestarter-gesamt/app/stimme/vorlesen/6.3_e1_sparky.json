{"s":[["Verzinste Einlagen.",0.0,1.312,[[0,9,0.0],[10,19,0.662]]],["Geld, das ruht, soll nicht schlafen",1.591,3.669,[[0,5,1.591],[6,9,1.95],[10,15,2.171],[16,20,2.74],[21,26,2.972],[27,35,3.146]]],["Dein Notgroschen liegt „sicher“, aber verdient er auch etwas, oder verliert er still an Kaufkraft?",4.621,11.331,[[0,4,4.621],[5,16,4.865],[17,22,5.503],[23,32,5.793],[33,37,7.825],[38,46,8.092],[47,49,8.44],[50,54,8.522],[55,61,8.684],[62,66,9.369],[67,75,9.636],[76,78,9.985],[79,84,10.066],[85,87,10.391],[88,98,10.519]]],["Deine Konten haben jetzt Aufgaben.",11.773,13.607,[[0,5,11.773],[6,12,12.074],[13,18,12.481],[19,24,12.713],[25,34,12.98]]],["Eines trägt den Notgroschen.",13.932,15.569,[[0,5,13.932],[6,11,14.362],[12,15,14.629],[16,28,14.779]]],["Drei Etappen: die drei Wege, ruhendes Geld zu verzinsen (Tagesgeld, Festgeld, Geldmarkt-ETF) samt Lockzins-Falle, dann der Realzins-Test (Zins minus Inflation), zuletzt die Grenze zwischen „sicher parken“ und „investieren“.",16.01,33.065,[[0,4,16.01],[5,13,16.312],[14,17,17.148],[18,22,17.311],[23,28,17.578],[29,37,18.042],[38,42,18.53],[43,45,18.785],[46,55,18.936],[56,67,19.737],[68,77,20.991],[78,92,22.082],[93,97,23.812],[98,113,24.114],[114,118,25.333],[119,122,25.542],[123,136,25.681],[137,142,26.773],[143,148,27.446],[149,160,27.794],[161,168,28.92],[169,172,29.373],[173,179,29.501],[180,188,29.919],[189,196,30.29],[197,204,30.848],[205,208,31.533],[209,223,31.881]]],["Sieh den Zins deines Tagesgeld-/Sparkontos nach, eine einzige Zahl.",33.448,38.046,[[0,4,33.448],[5,8,33.704],[9,13,33.901],[14,20,34.238],[21,42,34.54],[43,48,36.003],[49,53,36.734],[54,61,37.013],[62,67,37.466]]],["Ruf dir die letzte Inflationszahl in Erinnerung, die du gehört hast.",38.65,42.133,[[0,3,38.65],[4,7,38.952],[8,11,39.079],[12,18,39.196],[19,33,39.532],[34,36,40.391],[37,48,40.496],[49,52,41.065],[53,55,41.204],[56,62,41.309],[63,68,41.668]]],["Größer oder kleiner?",42.574,44.107,[[0,6,42.574],[7,11,43.213],[12,20,43.48]]],["Nur vergleichen, nicht handeln.",44.71,46.719,[[0,3,44.71],[4,16,45.001],[17,22,45.883],[23,31,46.173]]],["In Lektion 3.1 hast du den stillen Gegner deiner Kaufkraft kennengelernt: die Inflation.",47.415,53.987,[[0,2,47.415],[3,10,47.624],[11,14,48.205],[15,19,49.61],[20,22,49.865],[23,26,49.981],[27,34,50.121],[35,41,50.48],[42,48,50.817],[49,58,51.072],[59,73,51.63],[74,77,52.895],[78,88,53.104]]],["Dieselbe Menge Geld kauft mit der Zeit weniger, und liegt die Inflation über deinem Sparzins, verlierst du real an Wert, auch wenn die Zahl auf dem Konto gleich bleibt.",54.683,64.203,[[0,8,54.683],[9,14,55.182],[15,19,55.461],[20,25,55.856],[26,29,56.216],[30,33,56.332],[34,38,56.483],[39,47,56.761],[48,51,57.574],[52,57,57.76],[58,61,57.969],[62,71,58.073],[72,76,58.7],[77,83,58.886],[84,93,59.13],[94,103,60.128],[104,106,60.535],[107,111,60.686],[112,114,61.08],[115,120,61.208],[121,125,61.939],[126,130,62.218],[131,134,62.369],[135,139,62.497],[140,143,62.775],[144,147,62.903],[148,153,63.066],[154,160,63.425],[161,168,63.739]]],["Genau daraus stammt der Merksatz Nominalzins minus Inflation gleich Realzins.",64.807,70.043,[[0,5,64.807],[6,12,65.179],[13,19,65.585],[20,23,65.875],[24,32,66.003],[33,44,66.676],[45,50,67.744],[51,60,68.127],[61,67,68.882],[68,77,69.184]]],["„Die ehrliche Frage an jedes geparkte Geld ist nicht ‚wie viel Zins?', sondern ‚wie viel Zins minus Inflation?'“",70.647,77.555,[[0,4,70.647],[5,13,70.902],[14,19,71.308],[20,22,71.715],[23,28,71.866],[29,37,72.133],[38,42,72.609],[43,46,72.876],[47,52,73.038],[53,57,73.34],[58,62,73.584],[63,70,73.863],[71,78,74.826],[79,83,75.267],[84,88,75.534],[89,93,75.778],[94,99,76.196],[100,112,76.556]]]]}