{"s":[["Wo stehst du, und wo willst du hin?",0.0,2.055,[[0,2,0.0],[3,9,0.29],[10,13,0.697],[14,17,1.033],[18,20,1.184],[21,27,1.324],[28,30,1.579],[31,35,1.718]]],["Bevor man eine Route plant, braucht man zwei Punkte: wo man ist und wo man hin will.",2.752,7.755,[[0,5,2.752],[6,9,3.088],[10,14,3.239],[15,20,3.402],[21,27,3.704],[28,35,4.319],[36,39,4.621],[40,44,4.795],[45,52,5.12],[53,55,6.014],[56,59,6.211],[60,63,6.409],[64,67,6.711],[68,70,6.92],[71,74,7.059],[75,78,7.221],[79,84,7.384]]],["Du arbeitest mit den drei Leitbegriffen aus Lektion 1.1.",8.452,11.923,[[0,2,8.452],[3,12,8.661],[13,16,9.091],[17,20,9.218],[21,25,9.369],[26,39,9.648],[40,43,10.333],[44,51,10.542],[52,56,10.913]]],["Finanzwissen, Selbstbestimmung, Vermögensaufbau.",12.307,15.302,[[0,13,12.307],[14,31,13.259],[32,48,14.222]]],["Diesmal ganz persönlich.",15.627,17.101,[[0,7,15.627],[8,12,16.161],[13,24,16.416]]],["Keine Prüfung, keine Note, die Grundlage für deinen Zukunftsbrief in 1.5.",17.427,22.175,[[0,5,17.427],[6,14,17.763],[15,20,18.251],[21,26,18.564],[27,30,19.261],[31,40,19.423],[41,44,19.969],[45,51,20.097],[52,65,20.352],[66,68,21.177],[69,73,21.339]]],["Wie hängen die drei Leitbegriffe zusammen?",22.616,24.81,[[0,3,22.616],[4,10,22.895],[11,14,23.208],[15,19,23.336],[20,32,23.603],[33,42,24.23]]],["Warum ist eine niedrige Zahl heute kein schlechtes Zeugnis?",25.321,28.468,[[0,5,25.321],[6,9,25.728],[10,14,25.913],[15,23,26.146],[24,28,26.622],[29,34,26.9],[35,39,27.167],[40,50,27.399],[51,59,27.852]]],["Was sagt der Abstand zwischen Heute und Ziel über dich aus?",29.164,32.391,[[0,3,29.164],[4,8,29.42],[9,12,29.687],[13,20,29.826],[21,29,30.406],[30,35,30.801],[36,39,31.172],[40,44,31.312],[45,49,31.59],[50,54,31.799],[55,59,31.973]]],["In Lektion 1.1 hast du die drei Leitbegriffe kennengelernt:",33.343,37.256,[[0,2,33.343],[3,10,33.506],[11,14,33.97],[15,19,35.178],[20,22,35.387],[23,26,35.491],[27,31,35.607],[32,44,35.874],[45,59,36.478]]],["Finanzwissen ist die Grundlage, Selbstbestimmung der Sinn und Vermögensaufbau das Ziel, zusammen bilden sie ein Dreieck mit R&F in der Mitte.",37.697,46.219,[[0,12,37.697],[13,16,38.51],[17,20,38.638],[21,31,38.765],[32,48,39.787],[49,52,40.623],[53,57,40.809],[58,61,41.145],[62,77,41.296],[78,81,42.097],[82,87,42.295],[88,96,42.968],[97,103,43.514],[104,107,43.804],[108,111,43.955],[112,119,44.094],[120,123,44.628],[124,127,44.884],[128,130,45.568],[131,134,45.696],[135,141,45.824]]],["Dort ging es allgemein um das Prinzip; hier setzt du dieselben drei Begriffe nun ganz persönlich für deinen eigenen Standort ein.",47.171,53.87,[[0,4,47.171],[5,9,47.496],[10,12,47.67],[13,22,47.798],[23,25,48.216],[26,29,48.297],[30,38,48.459],[39,43,49.644],[44,49,49.876],[50,52,50.12],[53,62,50.236],[63,67,50.665],[68,76,50.886],[77,80,51.292],[81,85,51.478],[86,96,51.733],[97,100,52.325],[101,107,52.453],[108,115,52.767],[116,124,53.092],[125,129,53.556]]],["„Eine niedrige Zahl heute ist dein Startkapital, kein Urteil.“",54.822,59.442,[[0,5,54.822],[6,14,55.309],[15,19,55.762],[20,25,56.087],[26,29,56.412],[30,34,56.54],[35,48,56.714],[49,53,57.782],[54,62,58.072]]]]}