{"s":[["Wo stehst du, und wo willst du hin?",0.0,2.032,[[0,2,0.0],[3,9,0.209],[10,13,0.522],[14,17,1.08],[18,20,1.184],[21,27,1.324],[28,30,1.533],[31,35,1.637]]],["Bevor man eine Route plant, braucht man zwei Punkte: wo man ist und wo man hin will.",2.159,7.152,[[0,5,2.159],[6,9,2.461],[10,14,2.601],[15,20,2.763],[21,27,3.065],[28,35,3.564],[36,39,3.878],[40,44,4.098],[45,52,4.505],[53,55,5.422],[56,59,5.619],[60,63,5.782],[64,67,6.258],[68,70,6.409],[71,74,6.536],[75,78,6.676],[79,84,6.85]]],["Du arbeitest mit den drei Leitbegriffen aus Lektion 1.1.",7.326,10.786,[[0,2,7.326],[3,12,7.5],[13,16,7.918],[17,20,8.046],[21,25,8.162],[26,39,8.464],[40,43,9.218],[44,51,9.381],[52,56,9.741]]],["Finanzwissen, Selbstbestimmung, Vermögensaufbau.",10.855,13.688,[[0,13,10.855],[14,31,11.691],[32,48,12.562]]],["Diesmal ganz persönlich.",13.932,15.244,[[0,7,13.932],[8,12,14.315],[13,24,14.535]]],["Keine Prüfung, keine Note, die Grundlage für deinen Zukunftsbrief in 1.5.",15.418,20.503,[[0,5,15.418],[6,14,15.673],[15,20,16.045],[21,26,16.289],[27,30,16.672],[31,40,16.799],[41,44,17.368],[45,51,17.496],[52,65,17.844],[66,68,19.11],[69,73,19.528]]],["Wie hängen die drei Leitbegriffe zusammen?",20.828,22.848,[[0,3,20.828],[4,10,21.002],[11,14,21.234],[15,19,21.35],[20,32,21.652],[33,42,22.256]]],["Warum ist eine niedrige Zahl heute kein schlechtes Zeugnis?",23.022,26.737,[[0,5,23.022],[6,9,23.382],[10,14,23.533],[15,23,23.789],[24,28,24.323],[29,34,24.706],[35,39,25.135],[40,50,25.391],[51,59,25.89]]],["Was sagt der Abstand zwischen Heute und Ziel über dich aus?",26.854,30.476,[[0,3,26.854],[4,8,27.074],[9,12,27.341],[13,20,27.492],[21,29,27.898],[30,35,28.224],[36,39,28.63],[40,44,28.804],[45,49,29.419],[50,54,29.686],[55,59,29.884]]],["In Lektion 1.1 hast du die drei Leitbegriffe kennengelernt:",30.65,34.493,[[0,2,30.65],[3,10,30.754],[11,14,31.114],[15,19,31.95],[20,22,32.136],[23,26,32.252],[27,31,32.45],[32,44,32.775],[45,59,33.552]]],["Finanzwissen ist die Grundlage, Selbstbestimmung der Sinn und Vermögensaufbau das Ziel, zusammen bilden sie ein Dreieck mit R&F in der Mitte.",34.737,43.619,[[0,12,34.737],[13,16,35.457],[17,20,35.573],[21,31,35.677],[32,48,36.455],[49,52,37.337],[53,57,37.558],[58,61,37.964],[62,77,38.15],[78,81,39.578],[82,87,39.868],[88,96,40.681],[97,103,41.238],[104,107,41.61],[108,111,41.761],[112,119,41.877],[120,123,42.364],[124,127,42.539],[128,130,43.003],[131,134,43.085],[135,141,43.201]]],["Dort ging es allgemein um das Prinzip; hier setzt du dieselben drei Begriffe nun ganz persönlich für deinen eigenen Standort ein.",43.828,50.306,[[0,4,43.828],[5,9,44.083],[10,12,44.257],[13,22,44.362],[23,25,44.791],[26,29,44.884],[30,38,45.035],[39,43,45.859],[44,49,46.057],[50,52,46.312],[53,62,46.498],[63,67,46.916],[68,76,47.171],[77,80,47.589],[81,85,47.833],[86,96,48.077],[97,100,48.611],[101,107,48.727],[108,115,49.017],[116,124,49.412],[125,129,49.888]]],["„Eine niedrige Zahl heute ist dein Startkapital, kein Urteil.“",50.55,55.356,[[0,5,50.55],[6,14,50.968],[15,19,51.525],[20,25,51.873],[26,29,52.291],[30,34,52.454],[35,48,52.698],[49,53,54.149],[54,62,54.532]]]]}