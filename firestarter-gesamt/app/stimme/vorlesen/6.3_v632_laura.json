{"s":[["Der Realzins-Test, ruht dein Geld oder schrumpft es?",0.0,3.704,[[0,3,0.0],[4,18,0.244],[19,23,1.637],[24,28,1.904],[29,33,2.101],[34,38,2.647],[39,48,2.937],[49,52,3.344]]],["Die wichtigste Rechnung dieser Lektion ist eine simple Subtraktion.",4.029,7.918,[[0,3,4.029],[4,14,4.214],[15,23,4.795],[24,30,5.19],[31,38,5.445],[39,42,6.06],[43,47,6.316],[48,54,6.583],[55,67,6.966]]],["Ein Zins allein sagt wenig, was zählt, ist der Realzins.",8.359,11.97,[[0,3,8.359],[4,8,8.557],[9,15,8.812],[16,20,9.125],[21,27,9.369],[28,31,9.938],[32,38,10.217],[39,42,10.704],[43,46,10.913],[47,56,11.088]]],["Ist der Realzins positiv, wächst deine Kaufkraft wirklich.",12.353,15.94,[[0,3,12.353],[4,7,12.55],[8,16,12.701],[17,25,13.34],[26,32,14.187],[33,38,14.501],[39,48,14.768],[49,58,15.336]]],["Ist er negativ, der Zins also kleiner als die Inflation, dann ruht dein Geld nicht, sondern schrumpft still, auch wenn die Zahl auf dem Konto gleich bleibt.",16.323,24.474,[[0,3,16.323],[4,6,16.556],[7,15,16.648],[16,19,17.496],[20,24,17.693],[25,29,17.995],[30,37,18.227],[38,41,18.599],[42,45,18.773],[46,56,18.889],[57,61,19.621],[62,66,19.853],[67,71,20.062],[72,76,20.248],[77,83,20.538],[84,91,20.967],[92,101,21.397],[102,108,21.861],[109,113,22.349],[114,118,22.581],[119,122,22.72],[123,127,22.848],[128,131,23.115],[132,135,23.243],[136,141,23.405],[142,148,23.73],[149,156,23.998]]],["Hinschauen statt parken: bei jedem ruhenden Geld einmal „Zins − Inflation“ rechnen.",24.915,30.162,[[0,10,24.915],[11,16,25.472],[17,24,25.751],[25,28,26.563],[29,34,26.761],[35,43,27.086],[44,48,27.527],[49,55,27.898],[56,61,28.282],[62,63,28.827],[64,74,28.897],[75,83,29.57]]],["Konditionen vergleichen statt verharren:",30.673,32.798,[[0,11,30.673],[12,23,31.358],[24,29,31.881],[30,40,32.171]]],["Hausbank-Zins und aktiv gewählte Einlageform liegen oft weit auseinander.",33.042,37.523,[[0,13,33.042],[14,17,33.982],[18,23,34.214],[24,32,34.656],[33,44,35.132],[45,51,35.944],[52,55,36.258],[56,60,36.478],[61,73,36.722]]],["Die Aufgabe trennen:",37.767,38.882,[[0,3,37.767],[4,11,37.953],[12,20,38.382]]],["Notgroschen bleibt sicher; was lange frei ist, gehört auf den Vermögens-Weg (Baustein 4 ff.), nicht ins nächste Festgeld.",39.16,46.777,[[0,11,39.16],[12,18,39.787],[19,26,40.054],[27,30,40.762],[31,36,40.995],[37,41,41.238],[42,46,41.517],[47,53,41.877],[54,57,42.237],[58,61,42.365],[62,75,42.516],[76,85,43.386],[86,87,44.048],[88,93,44.838],[94,99,45.221],[100,103,45.523],[104,111,45.697],[112,121,46.045]]],["Ein Zins von null fühlt sich harmlos an.",47.218,49.4,[[0,3,47.218],[4,8,47.438],[9,12,47.705],[13,17,47.879],[18,23,48.17],[24,28,48.414],[29,36,48.599],[37,40,49.075]]],["Aber bei spürbarer Inflation ist „null Zins“ in Wahrheit ein Minus an Kaufkraft.",49.679,54.427,[[0,4,49.679],[5,8,49.969],[9,18,50.132],[19,28,50.747],[29,32,51.362],[33,38,51.502],[39,44,51.943],[45,47,52.338],[48,56,52.477],[57,60,52.93],[61,66,53.104],[67,69,53.499],[70,80,53.638]]],["Die einzige ehrliche Frage lautet:",54.811,56.808,[[0,3,54.811],[4,11,55.031],[12,20,55.53],[21,26,55.925],[27,34,56.262]]],["„wie viel Zins minus Inflation?“",56.958,59.397,[[0,4,56.958],[5,9,57.26],[10,14,57.539],[15,20,57.992],[21,32,58.363]]]]}