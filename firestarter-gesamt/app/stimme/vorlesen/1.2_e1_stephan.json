{"s":[["Der stille Saboteur, den niemand zeigt",0.0,2.577,[[0,3,0.0],[4,10,0.244],[11,20,0.534],[21,24,1.358],[25,32,1.625],[33,38,2.043]]],["Er nimmt dir nichts, er verhindert, dass etwas entsteht.",3.019,5.979,[[0,2,3.019],[3,8,3.146],[9,12,3.344],[13,20,3.46],[21,23,4.307],[24,35,4.412],[36,40,4.923],[41,46,5.108],[47,56,5.352]]],["Stell dir vor, jemand bremst dich aus, aber nicht in deiner Tasche, sondern in deiner Zukunft.",6.153,11.738,[[0,5,6.153],[6,9,6.42],[10,14,6.536],[15,21,7.14],[22,28,7.442],[29,33,7.802],[34,38,8.034],[39,43,8.777],[44,49,8.986],[50,52,9.23],[53,59,9.334],[60,67,9.671],[68,75,10.043],[76,78,10.403],[79,85,10.553],[86,94,10.879]]],["Du merkst es nicht, weil das Geld nie auf deinem Konto war.",11.854,15.348,[[0,2,11.854],[3,9,12.016],[10,12,12.341],[13,19,12.469],[20,24,13.073],[25,28,13.235],[29,33,13.398],[34,37,13.746],[38,41,14.013],[42,48,14.199],[49,54,14.454],[55,59,14.849]]],["Es hätte dort sein können.",15.499,17.217,[[0,2,15.499],[3,8,15.696],[9,13,15.928],[14,18,16.381],[19,26,16.741]]],["Es kam nur nie an.",17.426,19.226,[[0,2,17.426],[3,6,17.624],[7,10,17.867],[11,14,18.425],[15,18,18.808]]],["Wir nennen ihn den stillen Saboteur.",19.435,21.908,[[0,3,19.435],[4,10,19.597],[11,14,19.946],[15,18,20.178],[19,26,20.445],[27,36,20.956]]],["Und um ihn zu verstehen, musst du zuerst den stillen Motor kennen, an dem er sabotiert: den Zinseszins.",22.082,28.293,[[0,3,22.082],[4,6,22.256],[7,10,22.36],[11,13,22.477],[14,24,22.604],[25,30,23.057],[31,33,23.243],[34,40,23.347],[41,44,23.719],[45,52,23.905],[53,58,24.357],[59,66,24.752],[67,69,25.425],[70,73,25.576],[74,76,25.774],[77,87,25.867],[88,91,26.761],[92,103,27.051]]],["Stell ihn dir wie einen Marathonläufer vor, seine ganze Kraft steckt nicht in der Geschwindigkeit, sondern darin, dass er nicht aufhört.",28.444,35.967,[[0,5,28.444],[6,9,28.711],[10,13,28.827],[14,17,29.129],[18,23,29.279],[24,38,29.535],[39,43,30.348],[44,49,31.044],[50,55,31.3],[56,61,31.625],[62,68,32.019],[69,74,32.368],[75,77,32.658],[78,81,32.762],[82,98,32.937],[99,106,33.703],[107,113,33.982],[114,118,34.399],[119,121,34.713],[122,127,34.968],[128,136,35.293]]],["Keine Sorge vor der Mathematik:",36.292,37.639,[[0,5,36.292],[6,11,36.547],[12,15,36.849],[16,19,36.977],[20,31,37.07]]],["Wir rechnen alles gemeinsam und Schritt für Schritt.",37.662,40.088,[[0,3,37.662],[4,11,37.813],[12,17,38.161],[18,27,38.393],[28,31,38.916],[32,39,39.043],[40,43,39.496],[44,52,39.67]]],["Du brauchst nur die vier Grundrechenarten.",40.263,43.014,[[0,2,40.263],[3,11,40.425],[12,15,40.773],[16,19,41.284],[20,24,41.516],[25,42,41.807]]],["Wie werden aus 10.000 € rund 58.000 €, allein durch Nichtaufhören?",43.258,49.26,[[0,3,43.258],[4,10,43.478],[11,14,43.838],[15,21,44.036],[22,23,44.756],[24,28,45.046],[29,35,45.359],[36,38,46.578],[39,45,47.321],[46,51,47.809],[52,66,48.227]]],["Warum ist Stillstand oft teurer als ein zwischenzeitlicher Verlust?",49.539,52.906,[[0,5,49.539],[6,9,49.818],[10,20,49.934],[21,24,50.619],[25,31,50.793],[32,35,51.188],[36,39,51.338],[40,58,51.443],[59,67,52.29]]],["Warum steht diese Rechnung in keinem Hochglanz-Prospekt?",53.231,56.122,[[0,5,53.231],[6,11,53.498],[12,17,53.73],[18,26,53.997],[27,29,54.403],[30,36,54.52],[37,56,54.856]]],["Zwei Schritte weiter wartet der Zinseszins-Rechner.",56.505,59.257,[[0,4,56.505],[5,13,56.737],[14,20,57.016],[21,27,57.318],[28,31,57.62],[32,51,57.829]]],["Gib dort eine eigene Zahl ein, zum Beispiel den Betrag, den du im Monat übrig hättest, und schau, was die Kontinuität über die Jahre daraus macht.",59.466,66.722,[[0,3,59.466],[4,8,59.675],[9,13,59.895],[14,20,60.058],[21,25,60.418],[26,30,60.766],[31,34,60.998],[35,43,61.161],[44,47,61.462],[48,55,61.602],[56,59,62.055],[60,62,62.205],[63,65,62.356],[66,71,62.438],[72,77,62.798],[78,86,63.099],[87,90,63.808],[91,97,63.959],[98,101,64.249],[102,105,64.423],[106,117,64.597],[118,122,65.456],[123,126,65.607],[127,132,65.712],[133,139,65.99],[140,146,66.315]]],["Eine Lehrannahme, kein Versprechen.",66.931,68.928,[[0,4,66.931],[5,17,67.186],[18,22,68.057],[23,35,68.324]]],["Das Schlimmste, das passieren kann?",69.137,70.809,[[0,3,69.137],[4,15,69.334],[16,19,69.833],[20,29,69.996],[30,35,70.402]]],["Nichts.",71.052,71.772,[[0,7,71.052]]],["Kein Geld bewegt sich, keine Entscheidung fällt.",71.923,74.768,[[0,4,71.923],[5,9,72.167],[10,16,72.399],[17,22,72.794],[23,28,73.409],[29,41,73.676],[42,48,74.141]]]]}