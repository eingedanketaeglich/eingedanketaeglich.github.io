{"s":[["Bildung schlägt Beratung",0.0,1.567,[[0,7,0.0],[8,15,0.557],[16,24,1.033]]],["Warum ein gut gemeinter Rat dich abhängig machen kann, und Verstehen dich freier macht als jedes Produkt.",2.868,8.615,[[0,5,2.868],[6,9,3.367],[10,13,3.518],[14,23,3.762],[24,27,4.238],[28,32,4.586],[33,41,4.795],[42,48,5.306],[49,54,5.596],[55,58,6.153],[59,68,6.316],[69,73,6.769],[74,80,6.954],[81,86,7.314],[87,90,7.558],[91,96,7.767],[97,105,8.057]]],["Stell dir vor, jemand bietet dir an, dich für immer zu tragen.",9.567,13.27,[[0,5,9.567],[6,9,9.868],[10,14,10.054],[15,21,10.623],[22,28,10.971],[29,32,11.262],[33,36,11.424],[37,41,11.842],[42,45,12.04],[46,51,12.272],[52,54,12.62],[55,62,12.783]]],["Bequem, bis du merkst:",13.967,15.569,[[0,7,13.967],[8,11,14.652],[12,14,14.849],[15,22,14.988]]],["Du hast das Gehen verlernt.",15.952,17.438,[[0,2,15.952],[3,7,16.138],[8,11,16.312],[12,17,16.509],[18,27,16.811]]],["Genau das passiert oft bei der Geldanlage: jemand „trägt“ dich, und du wirst nie selbst sicher auf den Beinen.",18.134,24.636,[[0,5,18.134],[6,9,18.518],[10,18,18.715],[19,22,19.098],[23,26,19.319],[27,30,19.423],[31,42,19.563],[43,49,20.77],[50,57,21.223],[58,63,21.966],[64,67,22.616],[68,70,22.755],[71,76,22.871],[77,80,23.15],[81,87,23.313],[88,94,23.696],[95,98,23.974],[99,102,24.102],[103,110,24.241]]],["Nicht, weil Berater böse wären, die meisten meinen es gut.",25.333,28.34,[[0,6,25.333],[7,11,25.588],[12,19,25.739],[20,24,26.18],[25,31,26.482],[32,35,26.97],[36,43,27.121],[44,50,27.504],[51,53,27.817],[54,58,27.933]]],["Sondern weil das Modell dahinter dich abhängig hält, statt dich frei zu machen.",28.85,32.716,[[0,7,28.85],[8,12,29.199],[13,16,29.373],[17,23,29.535],[24,32,29.884],[33,37,30.302],[38,46,30.51],[47,52,30.986],[53,58,31.474],[59,63,31.741],[64,68,31.927],[69,71,32.182],[72,79,32.322]]],["Warum kann ein gut gemeinter Rat dich abhängig machen?",33.529,36.35,[[0,5,33.529],[6,10,33.889],[11,14,34.075],[15,18,34.214],[19,28,34.469],[29,32,34.969],[33,37,35.247],[38,46,35.445],[47,54,35.932]]],["Was bleibt am Ende bei dir, bei Beratung, was bei Bildung?",36.791,40.216,[[0,3,36.791],[4,10,37.035],[11,13,37.326],[14,18,37.453],[19,22,37.674],[23,27,37.894],[28,31,38.278],[32,41,38.428],[42,45,39.264],[46,49,39.508],[50,58,39.659]]],["Wo hast du bisher eine Entscheidung abgegeben, die dir gehört?",40.82,43.932,[[0,2,40.82],[3,7,41.064],[8,10,41.25],[11,17,41.377],[18,22,41.795],[23,35,42.004],[36,46,42.515],[47,50,43.049],[51,54,43.189],[55,62,43.386]]],["„Bildung will sich selbst überflüssig machen.“",44.442,47.09,[[0,8,44.442],[9,13,45.011],[14,18,45.22],[19,25,45.406],[26,37,45.87],[38,46,46.521]]]]}