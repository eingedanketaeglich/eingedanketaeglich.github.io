{"s":[["Tagesgeld, Festgeld, Geldmarkt-ETF",0.0,2.868,[[0,10,0.0],[11,20,0.917],[21,34,1.788]]],["„Sicher“ heißt nicht automatisch „klug“.",3.077,5.77,[[0,8,3.077],[9,14,3.843],[15,20,4.04],[21,32,4.249],[33,40,4.946]]],["Geld, das ruht, kann trotzdem ein wenig arbeiten, es unterscheidet sich vor allem in einer Frage:",5.944,11.099,[[0,5,5.944],[6,9,6.374],[10,15,6.583],[16,20,7.129],[21,29,7.326],[30,33,7.709],[34,39,7.814],[40,49,8.127],[50,52,8.882],[53,66,9.056],[67,71,9.601],[72,75,9.799],[76,81,9.938],[82,84,10.228],[85,90,10.356],[91,97,10.553]]],["Wie schnell kommst du wieder dran?",11.308,12.957,[[0,3,11.308],[4,11,11.529],[12,18,11.947],[19,21,12.202],[22,28,12.295],[29,34,12.527]]],["Tagesgeld",13.166,14.141,[[0,9,13.166]]],["Verfügbarkeit: jederzeit",14.652,16.277,[[0,14,14.652],[15,24,15.778]]],["Idee: flexibel parken, Zins meist variabel",16.324,19.342,[[0,5,16.324],[6,14,16.951],[15,22,17.531],[23,27,18.123],[28,33,18.553],[34,42,18.855]]],["Festgeld",19.389,19.992,[[0,8,19.389]]],["Verfügbarkeit: erst nach Ablauf",20.375,22.442,[[0,14,20.375],[15,19,21.258],[20,24,21.548],[25,31,21.827]]],["Idee: für mehr Zins bindest du das Geld eine feste Zeit",22.883,25.983,[[0,5,22.883],[6,9,23.394],[10,14,23.557],[15,19,23.777],[20,27,24.276],[28,30,24.602],[31,34,24.718],[35,39,24.892],[40,44,25.17],[45,50,25.356],[51,55,25.716]]],["Geldmarkt-ETF",26.076,27.26,[[0,13,26.076]]],["Verfügbarkeit: börsentäglich",27.771,29.327,[[0,14,27.771],[15,28,28.584]]],["Idee: bildet kurzfristige Geldmarkt-Zinsen ab.",29.373,33.17,[[0,5,29.373],[6,12,30.174],[13,25,30.72],[26,42,31.591],[43,46,32.81]]],["Übergang Richtung Wertpapier",33.495,34.876,[[0,8,33.495],[9,17,33.936],[18,28,34.238]]],["Eine kleine Leiter:",35.318,36.363,[[0,4,35.318],[5,11,35.573],[12,19,35.887]]],["Tagesgeld, Festgeld, Geldmarkt-ETF · der Tausch ist immer derselbe:",36.537,42.191,[[0,10,36.537],[11,20,37.593],[21,34,38.51],[35,36,40.124],[37,40,40.298],[41,47,40.461],[48,51,40.914],[52,57,41.274],[58,67,41.552]]],["Verfügbarkeit gegen Zins.",42.4,44.141,[[0,13,42.4],[14,19,43.282],[20,25,43.561]]],["Der Tausch ist immer derselbe:",44.269,45.755,[[0,3,44.269],[4,10,44.455],[11,14,44.815],[15,20,44.966],[21,30,45.163]]],["Verfügbarkeit gegen Zins.",45.929,47.961,[[0,13,45.929],[14,19,47.032],[20,25,47.357]]],["Beim Festgeld lauert die Lockzins-Falle:",48.112,50.318,[[0,4,48.112],[5,13,48.309],[14,20,48.913],[21,24,49.192],[25,40,49.331]]],["Ein hoher Aktionszins gilt oft nur für Neukunden und nur kurz, danach fällt das Geld still auf den niedrigeren Bestandszins zurück.",50.353,57.679,[[0,3,50.353],[4,9,50.504],[10,21,50.782],[22,26,51.618],[27,30,51.897],[31,34,52.117],[35,38,52.257],[39,48,52.373],[49,52,52.93],[53,56,53.046],[57,62,53.185],[63,69,53.998],[70,75,54.312],[76,79,54.486],[80,84,54.648],[85,90,54.881],[91,94,55.38],[95,98,55.566],[99,110,55.716],[111,123,56.425],[124,131,57.156]]],["„Sicher parken“ ist kein einziger Zustand, sondern eine kleine Leiter, von jederzeit verfügbar bis börsentäglich handelbar.",57.957,64.366,[[0,7,57.957],[8,15,58.41],[16,19,58.758],[20,24,58.909],[25,33,59.107],[34,42,59.501],[43,50,60.012],[51,55,60.337],[56,62,60.534],[63,70,60.871],[71,74,61.289],[75,84,61.463],[85,94,61.904],[95,98,62.404],[99,112,62.717],[113,123,63.623]]],["Der höchste beworbene Zins ist nicht automatisch der beste; entscheidend ist, was nach der Aktion übrig bleibt.",64.876,71.703,[[0,3,64.876],[4,11,65.062],[12,21,65.411],[22,26,65.921],[27,30,66.49],[31,36,66.699],[37,48,66.931],[49,52,67.605],[53,59,67.779],[60,72,68.603],[73,77,69.137],[78,81,69.602],[82,86,69.88],[87,90,70.066],[91,97,70.205],[98,103,70.774],[104,111,71.111]]]]}