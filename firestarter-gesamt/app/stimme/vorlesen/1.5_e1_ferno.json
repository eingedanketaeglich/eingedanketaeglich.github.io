{"s":[["Der Zukunftsbrief",0.0,1.126,[[0,3,0.0],[4,17,0.267]]],["Ein Seemann steuert nicht nach dem Wasser vor dem Bug, sondern nach einem Stern.",2.078,6.211,[[0,3,2.078],[4,11,2.322],[12,19,2.682],[20,25,3.135],[26,30,3.344],[31,34,3.518],[35,41,3.669],[42,45,3.971],[46,49,4.122],[50,54,4.272],[55,62,4.899],[63,67,5.271],[68,73,5.457],[74,80,5.677]]],["Dein Nordstern ist kein Geldbetrag, er ist die Richtung, die auch dann gilt, wenn die See rau wird.",6.722,12.214,[[0,4,6.722],[5,14,7.001],[15,18,7.57],[19,23,7.721],[24,35,7.964],[36,38,9.16],[39,42,9.416],[43,46,9.543],[47,56,9.671],[57,60,10.043],[61,65,10.159],[66,70,10.333],[71,76,10.553],[77,81,10.995],[82,85,11.215],[86,89,11.366],[90,93,11.598],[94,99,11.807]]],["Diese Lektion schließt Baustein 1 ab: mit einem Brief an dein zukünftiges Ich.",12.91,18.402,[[0,5,12.91],[6,13,13.235],[14,22,13.781],[23,31,14.141],[32,33,14.675],[34,37,15.035],[38,41,15.917],[42,47,16.184],[48,53,16.544],[54,56,16.881],[57,61,17.008],[62,73,17.229],[74,78,18.053]]],["Warum schlägt ein geschriebener Brief den bloßen Vorsatz?",19.098,21.966,[[0,5,19.098],[6,13,19.481],[14,17,19.853],[18,31,19.969],[32,37,20.549],[38,41,20.805],[42,48,20.944],[49,57,21.339]]],["Was ist dein Wofür jenseits des Kontostands?",22.662,25.298,[[0,3,22.662],[4,7,22.895],[8,12,23.022],[13,18,23.208],[19,27,23.765],[28,31,24.323],[32,44,24.497]]],["Was macht eine Selbstverpflichtung überprüfbar?",26.111,28.34,[[0,3,26.111],[4,9,26.343],[10,14,26.54],[15,34,26.726],[35,47,27.515]]],["In Lektion 1.4 hast du eine ehrliche Standortbestimmung gemacht und für jeden der drei Leitbegriffe zwei Marken gesetzt, wo du heute stehst und wo du hinwillst.",28.943,38.975,[[0,2,28.943],[3,10,29.176],[11,14,29.721],[15,19,30.673],[20,22,30.859],[23,27,31.022],[28,36,31.347],[37,55,31.823],[56,63,32.775],[64,67,33.413],[68,71,33.611],[72,77,33.808],[78,81,34.098],[82,86,34.238],[87,99,34.528],[100,104,35.306],[105,111,35.643],[112,120,35.944],[121,123,36.629],[124,126,36.862],[127,132,37.013],[133,139,37.303],[140,143,37.848],[144,146,38.046],[147,149,38.197],[150,160,38.324]]],["Eine niedrige Zahl galt dabei als Startkapital, nicht als Urteil; genau diese Zielwerte werden jetzt zur Rohform deiner Nordsterne.",39.578,47.822,[[0,4,39.578],[5,13,39.857],[14,18,40.333],[19,23,40.67],[24,29,40.902],[30,33,41.297],[34,47,41.482],[48,53,42.678],[54,57,42.945],[58,65,43.119],[66,71,43.944],[72,77,44.42],[78,87,44.745],[88,94,45.337],[95,100,45.651],[101,104,46.022],[105,112,46.277],[113,119,46.846],[120,131,47.125]]],["„Die meisten kennen ihren Kontostand, aber nicht ihr Wofür.“",48.205,51.734,[[0,4,48.205],[5,12,48.53],[13,19,48.948],[20,25,49.261],[26,37,49.505],[38,42,50.26],[43,48,50.503],[49,52,50.771],[53,60,50.933]]]]}