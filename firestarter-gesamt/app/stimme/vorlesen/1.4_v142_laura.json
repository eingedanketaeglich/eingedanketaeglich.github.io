{"s":[["Wo stehst du heute?",0.0,1.161,[[0,2,0.0],[3,9,0.279],[10,12,0.592],[13,19,0.708]]],["Deine ehrliche Standortbestimmung",1.242,3.042,[[0,5,1.242],[6,14,1.614],[15,33,2.067]]],["Für jeden Begriff, deine Bewertung:",3.994,6.153,[[0,3,3.994],[4,9,4.249],[10,18,4.516],[19,24,5.155],[25,35,5.457]]],["Heute und dein Ziel in 3, 6 oder 12 Monaten.",6.432,9.938,[[0,5,6.432],[6,9,6.803],[10,14,6.92],[15,19,7.14],[20,22,7.535],[23,25,7.767],[26,27,8.115],[28,32,8.475],[33,35,8.789],[36,44,9.265]]],["Die Zahl heute ist dein Startkapital.",10.182,12.516,[[0,3,10.182],[4,8,10.403],[9,14,10.728],[15,18,11.122],[19,23,11.297],[24,37,11.517]]],["Eine niedrige Zahl heute ist dein Startkapital, kein Urteil.",12.725,16.277,[[0,4,12.725],[5,13,13.003],[14,18,13.468],[19,24,13.758],[25,28,14.095],[29,33,14.234],[34,47,14.431],[48,52,15.36],[53,60,15.662]]],["Wer ehrlich eine 3 setzt, ist weiter als jemand, der sich etwas vormacht.",16.661,20.805,[[0,3,16.661],[4,11,16.916],[12,16,17.334],[17,18,17.578],[19,25,17.833],[26,29,18.263],[30,36,18.495],[37,40,18.843],[41,48,19.041],[49,52,19.47],[53,57,19.633],[58,63,19.842],[64,73,20.144]]]]}