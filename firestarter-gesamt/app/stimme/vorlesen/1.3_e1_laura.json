{"s":[["Bildung schlägt Beratung",0.0,1.602,[[0,7,0.0],[8,15,0.592],[16,24,0.975]]],["Warum ein gut gemeinter Rat dich abhängig machen kann, und Verstehen dich freier macht als jedes Produkt.",2.554,8.278,[[0,5,2.554],[6,9,2.879],[10,13,3.019],[14,23,3.262],[24,27,3.75],[28,32,4.005],[33,41,4.203],[42,48,4.644],[49,54,4.934],[55,58,5.422],[59,68,5.619],[69,73,6.188],[74,80,6.385],[81,86,6.769],[87,90,7.082],[91,96,7.361],[97,105,7.686]]],["Stell dir vor, jemand bietet dir an, dich für immer zu tragen.",8.522,11.935,[[0,5,8.522],[6,9,8.777],[10,14,8.916],[15,21,9.369],[22,28,9.764],[29,32,10.066],[33,36,10.263],[37,41,10.449],[42,45,10.658],[46,51,10.855],[52,54,11.227],[55,62,11.378]]],["Bequem, bis du merkst:",12.144,13.735,[[0,7,12.144],[8,11,12.864],[12,14,13.061],[15,22,13.201]]],["Du hast das Gehen verlernt.",13.909,15.348,[[0,2,13.909],[3,7,14.071],[8,11,14.269],[12,17,14.466],[18,27,14.721]]],["Genau das passiert oft bei der Geldanlage: jemand „trägt“ dich, und du wirst nie selbst sicher auf den Beinen.",15.673,21.861,[[0,5,15.673],[6,9,15.998],[10,18,16.172],[19,22,16.567],[23,26,16.741],[27,30,16.869],[31,42,17.008],[43,49,18.018],[50,57,18.518],[58,63,19.063],[64,67,19.446],[68,70,19.597],[71,76,19.737],[77,80,20.062],[81,87,20.294],[88,94,20.677],[95,98,20.956],[99,102,21.107],[103,110,21.257]]],["Nicht, weil Berater böse wären, die meisten meinen es gut.",22.186,25.414,[[0,6,22.186],[7,11,22.465],[12,19,22.627],[20,24,23.092],[25,31,23.405],[32,35,23.858],[36,43,24.044],[44,50,24.473],[51,53,24.833],[54,58,24.984]]],["Sondern weil das Modell dahinter dich abhängig hält, statt dich frei zu machen.",25.797,29.64,[[0,7,25.797],[8,12,26.18],[13,16,26.343],[17,23,26.505],[24,32,26.865],[33,37,27.306],[38,46,27.504],[47,52,27.945],[53,58,28.41],[59,63,28.665],[64,68,28.828],[69,71,29.071],[72,79,29.199]]],["Warum kann ein gut gemeinter Rat dich abhängig machen?",29.791,32.496,[[0,5,29.791],[6,10,30.14],[11,14,30.337],[15,18,30.465],[19,28,30.697],[29,32,31.126],[33,37,31.359],[38,46,31.556],[47,54,32.009]]],["Was bleibt am Ende bei dir, bei Beratung, was bei Bildung?",32.821,36.304,[[0,3,32.821],[4,10,33.042],[11,13,33.332],[14,18,33.483],[19,22,33.715],[23,27,33.878],[28,31,34.377],[32,41,34.551],[42,45,35.352],[46,49,35.573],[50,58,35.736]]],["Wo hast du bisher eine Entscheidung abgegeben, die dir gehört?",36.63,39.637,[[0,2,36.63],[3,7,36.804],[8,10,36.989],[11,17,37.094],[18,22,37.477],[23,35,37.686],[36,46,38.22],[47,50,38.789],[51,54,38.917],[55,62,39.079]]],["„Bildung will sich selbst überflüssig machen.“",40.078,43.143,[[0,8,40.078],[9,13,40.623],[14,18,40.809],[19,25,40.983],[26,37,41.366],[38,46,41.924]]]]}