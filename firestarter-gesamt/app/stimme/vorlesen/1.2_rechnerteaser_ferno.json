{"s":[["Der Zinseszins-Rechner, dein Werkzeug",0.0,2.589,[[0,3,0.0],[4,23,0.267],[24,28,1.753],[29,37,2.043]]],["Genau diesen Rechner bekommst du in die Hand, aber erst, wenn du selbst geschätzt hast statt einfach abzulesen.",3.541,9.636,[[0,5,3.541],[6,12,3.947],[13,20,4.307],[21,29,4.644],[30,32,5.004],[33,35,5.12],[36,39,5.213],[40,45,5.352],[46,50,6.13],[51,56,6.409],[57,61,6.664],[62,64,6.803],[65,71,6.978],[72,81,7.338],[82,86,7.802],[87,92,7.988],[93,100,8.324],[101,111,8.8]]],["Gleich kommen vier Fragen.",10.333,11.784,[[0,6,10.333],[7,13,10.67],[14,18,10.971],[19,26,11.227]]],["Rate mit, den frei bedienbaren Rechner schaltest du dir als Bonus frei, sobald du Baustein 1 abgeschlossen hast.",12.481,19.365,[[0,4,12.481],[5,9,12.817],[10,13,13.607],[14,18,13.897],[19,30,14.211],[31,38,14.791],[39,48,15.163],[49,51,15.569],[52,55,15.673],[56,59,15.801],[60,65,16.01],[66,71,16.44],[72,78,17.043],[79,81,17.426],[82,90,17.577],[91,92,18.1],[93,106,18.367],[107,112,19.017]]],["Danach liegt er dauerhaft in deinem Rechner-Fenster.",19.748,22.616,[[0,6,19.748],[7,12,20.213],[13,15,20.433],[16,25,20.538],[26,28,21.107],[29,35,21.2],[36,52,21.478]]]]}