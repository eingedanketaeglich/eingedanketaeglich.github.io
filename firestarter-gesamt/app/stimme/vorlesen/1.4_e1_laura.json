{"s":[["Wo stehst du, und wo willst du hin?",0.0,2.299,[[0,2,0.0],[3,9,0.244],[10,13,0.627],[14,17,0.975],[18,20,1.277],[21,27,1.463],[28,30,1.73],[31,35,1.858]]],["Bevor man eine Route plant, braucht man zwei Punkte: wo man ist und wo man hin will.",2.995,7.779,[[0,5,2.995],[6,9,3.309],[10,14,3.46],[15,20,3.646],[21,27,3.959],[28,35,4.423],[36,39,4.772],[40,44,4.934],[45,52,5.178],[53,55,5.956],[56,59,6.118],[60,63,6.304],[64,67,6.745],[68,70,6.954],[71,74,7.105],[75,78,7.245],[79,84,7.442]]],["Du arbeitest mit den drei Leitbegriffen aus Lektion 1.1.",8.104,12.016,[[0,2,8.104],[3,12,8.29],[13,16,8.893],[17,20,9.033],[21,25,9.172],[26,39,9.474],[40,43,10.252],[44,51,10.437],[52,56,10.913]]],["Finanzwissen, Selbstbestimmung, Vermögensaufbau.",12.399,15.824,[[0,13,12.399],[14,31,13.421],[32,48,14.582]]],["Diesmal ganz persönlich.",15.975,17.438,[[0,7,15.975],[8,12,16.474],[13,24,16.741]]],["Keine Prüfung, keine Note, die Grundlage für deinen Zukunftsbrief in 1.5.",17.612,22.546,[[0,5,17.612],[6,14,17.914],[15,20,18.506],[21,26,18.819],[27,30,19.388],[31,40,19.574],[41,44,20.189],[45,51,20.352],[52,65,20.619],[66,68,21.432],[69,73,21.571]]],["Wie hängen die drei Leitbegriffe zusammen?",23.243,25.379,[[0,3,23.243],[4,10,23.498],[11,14,23.8],[15,19,23.916],[20,32,24.16],[33,42,24.81]]],["Warum ist eine niedrige Zahl heute kein schlechtes Zeugnis?",25.623,28.92,[[0,5,25.623],[6,9,26.017],[10,14,26.192],[15,23,26.401],[24,28,26.842],[29,34,27.167],[35,39,27.527],[40,50,27.782],[51,59,28.235]]],["Was sagt der Abstand zwischen Heute und Ziel über dich aus?",29.199,32.484,[[0,3,29.199],[4,8,29.419],[9,12,29.686],[13,20,29.837],[21,29,30.395],[30,35,30.778],[36,39,31.149],[40,44,31.289],[45,49,31.625],[50,54,31.811],[55,59,32.008]]],["In Lektion 1.1 hast du die drei Leitbegriffe kennengelernt:",32.519,36.432,[[0,2,32.519],[3,10,32.705],[11,14,33.227],[15,19,34.238],[20,22,34.47],[23,26,34.574],[27,31,34.702],[32,44,34.992],[45,59,35.619]]],["Finanzwissen ist die Grundlage, Selbstbestimmung der Sinn und Vermögensaufbau das Ziel, zusammen bilden sie ein Dreieck mit R&F in der Mitte.",37.036,45.894,[[0,12,37.036],[13,16,37.883],[17,20,38.046],[21,31,38.162],[32,48,39.265],[49,52,40.182],[53,57,40.356],[58,61,40.716],[62,77,40.89],[78,81,41.842],[82,87,42.074],[88,96,42.771],[97,103,43.305],[104,107,43.63],[108,111,43.781],[112,119,43.92],[120,123,44.466],[124,127,44.675],[128,130,45.174],[131,134,45.267],[135,141,45.418]]],["Dort ging es allgemein um das Prinzip; hier setzt du dieselben drei Begriffe nun ganz persönlich für deinen eigenen Standort ein.",46.173,53.197,[[0,4,46.173],[5,9,46.451],[10,12,46.625],[13,22,46.765],[23,25,47.264],[26,29,47.357],[30,38,47.531],[39,43,48.518],[44,49,48.762],[50,52,49.017],[53,62,49.168],[63,67,49.632],[68,76,49.841],[77,80,50.271],[81,85,50.468],[86,96,50.782],[97,100,51.351],[101,107,51.502],[108,115,51.862],[116,124,52.303],[125,129,52.848]]],["„Eine niedrige Zahl heute ist dein Startkapital, kein Urteil.“",54.311,58.793,[[0,5,54.311],[6,14,54.787],[15,19,55.263],[20,25,55.542],[26,29,55.983],[30,34,56.157],[35,48,56.378],[49,53,57.481],[54,62,57.817]]]]}