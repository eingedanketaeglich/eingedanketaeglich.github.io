{"s":[["Warum diese Rechnung in keinem Bankprospekt steht",0.0,2.508,[[0,5,0.0],[6,11,0.383],[12,20,0.604],[21,23,1.033],[24,30,1.161],[31,43,1.533],[44,49,2.194]]],["Ist Stehenbleiben nicht besser als Stürzen?",3.019,5.41,[[0,3,3.019],[4,17,3.367],[18,23,3.994],[24,30,4.214],[31,34,4.54],[35,43,4.725]]],["Klingt logisch, ist aber oft falsch.",5.851,8.255,[[0,6,5.851],[7,15,6.177],[16,19,7.001],[20,24,7.279],[25,28,7.488],[29,36,7.709]]],["Echter, schmerzhafter Verlust, steht aber sofort wieder auf.",8.696,12.341,[[0,7,8.696],[8,21,9.218],[22,30,9.996],[31,36,10.751],[37,41,11.029],[42,48,11.215],[49,55,11.645],[56,60,11.9]]],["Der Motor läuft von niedrigerer Basis weiter und holt auf.",12.783,16.138,[[0,3,12.783],[4,9,12.968],[10,15,13.351],[16,19,13.653],[20,31,13.827],[32,37,14.408],[38,44,14.768],[45,48,15.302],[49,53,15.487],[54,58,15.731]]],["Kostet den Motor ein paar Jahre.",16.579,18.297,[[0,6,16.579],[7,10,16.985],[11,16,17.136],[17,20,17.461],[21,25,17.6],[26,32,17.775]]],["Verliert optisch nichts Neues, bleibt aber unten.",18.808,21.432,[[0,8,18.808],[9,16,19.203],[17,23,19.597],[24,30,19.911],[31,37,20.422],[38,42,20.723],[43,49,20.932]]],["Der Motor produziert jedes Jahr nichts.",22.128,24.265,[[0,3,22.128],[4,9,22.314],[10,20,22.662],[21,26,23.208],[27,31,23.51],[32,39,23.696]]],["Kostet jedes Jahr plus dessen Zins-auf-Zins.",24.706,27.272,[[0,6,24.706],[7,12,25.135],[13,17,25.449],[18,22,25.669],[23,29,25.913],[30,44,26.238]]],["Der Knoten, den die meisten nicht sehen:",27.782,29.791,[[0,3,27.782],[4,11,27.956],[12,15,28.444],[16,19,28.595],[20,27,28.711],[28,33,29.094],[34,40,29.304]]],["Beim Zinseszins ist die Zeit der Treibstoff, nicht der momentane Punktestand.",30.07,34.679,[[0,4,30.07],[5,15,30.337],[16,19,31.126],[20,23,31.301],[24,28,31.452],[29,32,31.695],[33,44,31.823],[45,50,32.833],[51,54,33.1],[55,64,33.228],[65,77,33.808]]],["Ein Prospekt zeigt dir meist nur die Durchschnitts-Rendite über den ganzen Zeitraum.",35.19,39.486,[[0,3,35.19],[4,12,35.376],[13,18,35.852],[19,22,36.119],[23,28,36.246],[29,32,36.618],[33,36,36.804],[37,58,36.908],[59,63,38.0],[64,67,38.255],[68,74,38.383],[75,84,38.777]]],["Diese Zahl ist nicht gelogen, aber sie glättet die Talphasen weg und macht die teuren Wartejahre unsichtbar.",40.089,46.057,[[0,5,40.089],[6,10,40.403],[11,14,40.705],[15,20,40.844],[21,29,41.065],[30,34,41.761],[35,38,41.993],[39,46,42.121],[47,50,42.446],[51,60,42.597],[61,64,43.154],[65,68,43.665],[69,74,43.851],[75,78,44.106],[79,85,44.234],[86,96,44.64],[97,108,45.279]]],["Viele vertrauen ihr Geld „Profis“ an und glauben, es sei betreut, faktisch liegt es oft als unbetreutes Depot da („kaufen und wegschauen“), und im Tal lautet der einzige Rat „aushalten“.",46.661,59.675,[[0,5,46.661],[6,15,47.02],[16,19,47.543],[20,24,47.682],[25,33,47.961],[34,36,48.832],[37,40,49.447],[41,49,49.633],[50,52,50.039],[53,56,50.155],[57,65,50.353],[66,74,51.246],[75,80,51.873],[81,83,52.152],[84,87,52.338],[88,91,52.744],[92,103,53.023],[104,109,53.661],[110,112,54.01],[113,121,54.346],[122,125,55.298],[126,139,55.484],[140,143,56.61],[144,146,56.796],[147,150,56.947],[151,157,57.4],[158,161,57.713],[162,169,57.864],[170,173,58.282],[174,186,58.677]]],["Diese Einordnung richtet sich gegen das Kaufen-und-Wegschauen, nicht gegen ETFs als Instrument; sie ist allgemeine Bildung, keine Aussage über einzelne Anbieter.",60.116,69.648,[[0,5,60.116],[6,16,60.476],[17,24,61.138],[25,29,61.475],[30,35,61.66],[36,39,61.893],[40,62,62.102],[63,68,63.657],[69,74,63.913],[75,79,64.145],[80,83,64.679],[84,95,64.853],[96,99,65.921],[100,103,66.061],[104,114,66.27],[115,123,66.792],[124,129,67.581],[130,137,67.907],[138,142,68.394],[143,151,68.603],[152,161,69.009]]],["Auch Profis bekommen Wadenkrämpfe; sie gehen nur besser damit um.",70.345,74.118,[[0,4,70.345],[5,11,70.588],[12,20,71.041],[21,34,71.436],[35,38,72.609],[39,44,72.771],[45,48,72.98],[49,55,73.189],[56,61,73.468],[62,65,73.747]]],["Wir trainieren dreierlei: den Krampf früh erkennen → ihn durchhalten statt am Tiefpunkt aufzugeben → das Tal mit der Zeit methodisch navigieren.",74.629,83.383,[[0,3,74.629],[4,14,74.803],[15,25,75.256],[26,29,76.266],[30,36,76.475],[37,41,76.858],[42,50,77.125],[51,52,77.706],[53,56,78.019],[57,68,78.24],[69,74,78.82],[75,77,79.087],[78,87,79.227],[88,98,79.761],[99,100,80.492],[101,104,80.747],[105,108,81.003],[109,112,81.328],[113,116,81.467],[117,121,81.63],[122,132,82.094],[133,144,82.675]]],["Wer durchläuft, unterbricht den Zinseszins nicht.",83.987,86.889,[[0,3,83.987],[4,15,84.196],[16,27,84.904],[28,31,85.403],[32,42,85.589],[43,49,86.297]]]]}