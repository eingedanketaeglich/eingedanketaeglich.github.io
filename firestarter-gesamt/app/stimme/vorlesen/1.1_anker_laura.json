{"s":[["Was du mitnimmst, und dein Anker",0.0,2.032,[[0,3,0.0],[4,6,0.29],[7,17,0.453],[18,21,1.219],[22,26,1.382],[27,32,1.625]]],["Drei Sätze, die wichtigsten Begriffe, dein persönliches Warum.",2.125,5.863,[[0,4,2.125],[5,11,2.426],[12,15,2.961],[16,27,3.135],[28,37,3.692],[38,42,4.4],[43,55,4.679],[56,62,5.352]]],["Drei Sätze zum Mitnehmen",6.142,7.57,[[0,4,6.142],[5,10,6.467],[11,14,6.873],[15,24,7.047]]],["Finanzwissen · Selbstbestimmung · Vermögensaufbau, die drei Leitbegriffe.",7.628,12.794,[[0,12,7.628],[13,14,8.615],[15,31,8.8],[32,33,9.915],[34,50,10.124],[51,54,11.459],[55,59,11.633],[60,73,11.889]]],["Bildung, kein Verkaufsgespräch, ehrliche Grenzen schützen dich.",13.177,17.102,[[0,8,13.177],[9,13,13.909],[14,31,14.176],[32,40,15.43],[41,48,15.883],[49,57,16.336],[58,63,16.73]]],["Neun Bausteine, ein Leitsatz.",17.427,19.447,[[0,4,17.427],[5,15,17.717],[16,19,18.518],[20,29,18.716]]],["„Finanzen und Börse sind kein Hobby.“",19.83,22.14,[[0,9,19.83],[10,13,20.469],[14,19,20.573],[20,24,21.072],[25,29,21.305],[30,37,21.583]]],["Der Gedanke, den fast keiner zu Ende denkt",22.582,24.962,[[0,3,22.582],[4,12,22.779],[13,16,23.301],[17,21,23.51],[22,28,23.859],[29,31,24.219],[32,36,24.381],[37,42,24.613]]],["Du hast noch nie einen Euro verloren, und trotzdem fehlt dir am Ende womöglich der größte Teil deines Vermögens.",25.403,31.638,[[0,2,25.403],[3,7,25.589],[8,12,25.798],[13,16,26.053],[17,22,26.332],[23,27,26.634],[28,37,26.959],[38,41,27.632],[42,50,27.829],[51,56,28.398],[57,60,28.642],[61,63,28.758],[64,68,28.932],[69,78,29.153],[79,82,29.722],[83,89,29.873],[90,94,30.372],[95,101,30.651],[102,112,30.941]]],["Nicht, weil dir jemand etwas weggenommen hätte.",31.754,33.878,[[0,6,31.754],[7,11,32.079],[12,15,32.241],[16,22,32.381],[23,28,32.694],[29,40,32.985],[41,47,33.507]]],["Sondern weil dein Geld einfach stillstand, während die Zeit weiterlief.",33.995,37.93,[[0,7,33.995],[8,12,34.413],[13,17,34.61],[18,22,34.807],[23,30,35.121],[31,42,35.562],[43,50,36.375],[51,54,36.688],[55,59,36.851],[60,71,37.164]]],["Das ist das Unheimliche am stillen Saboteur:",38.372,41.053,[[0,3,38.372],[4,7,38.673],[8,11,38.813],[12,23,39.091],[24,26,39.788],[27,34,39.951],[35,44,40.31]]],["Er raubt nichts, was du siehst.",41.332,43.108,[[0,2,41.332],[3,8,41.541],[9,16,41.878],[17,20,42.214],[21,23,42.423],[24,31,42.563]]],["Er verhindert nur, dass etwas entsteht.",43.259,45.453,[[0,2,43.259],[3,13,43.422],[14,18,43.921],[19,23,44.246],[24,29,44.478],[30,39,44.838]]],["Und weil auf deinem Kontoauszug nie eine rote Zahl auftaucht, merkst du jahrelang gar nicht, dass er überhaupt da ist.",45.662,52.361,[[0,3,45.662],[4,8,45.825],[9,12,46.045],[13,19,46.173],[20,31,46.429],[32,35,47.311],[36,40,47.59],[41,45,47.799],[46,50,48.135],[51,61,48.414],[62,68,49.296],[69,71,49.656],[72,81,49.853],[82,85,50.48],[86,92,50.689],[93,97,50.968],[98,100,51.2],[101,110,51.293],[111,113,51.723],[114,118,51.978]]],["In diesem Baustein schaust du ihm zum ersten Mal ins Gesicht, und verstehst, warum genau dieses Nicht-Hinschauen der eigentliche Preis ist.",52.965,60.662,[[0,2,52.965],[3,9,53.128],[10,18,53.453],[19,26,54.01],[27,29,54.323],[30,33,54.439],[34,37,54.59],[38,44,54.846],[45,48,55.264],[49,52,55.496],[53,61,55.647],[62,65,56.541],[66,76,56.715],[77,82,57.342],[83,88,57.655],[89,95,58.004],[96,112,58.422],[113,116,59.2],[117,128,59.374],[129,134,59.896],[135,139,60.244]]],["Begriffe in diesem Baustein",61.046,62.532,[[0,8,61.046],[9,11,61.533],[12,18,61.649],[19,27,61.963]]],["Zinseszins & Zinseszins-Kontinuität",62.973,66.258,[[0,10,62.973],[11,12,64.273],[13,35,64.505]]],["Der stille Saboteur",66.955,68.174,[[0,3,66.955],[4,10,67.199],[11,19,67.536]]],["Die drei Leitbegriffe",68.615,69.869,[[0,3,68.615],[4,8,68.801],[9,21,69.08]]],["Bildung statt Beratung",70.31,71.704,[[0,7,70.31],[8,13,70.833],[14,22,71.135]]],["Notgroschen",72.307,73.062,[[0,11,72.307]]],["Nordsterne & Selbstlern-Bibliothek",73.306,75.628,[[0,10,73.306],[11,12,74.188],[13,34,74.397]]],["Dein Anker:",76.44,77.311,[[0,4,76.44],[5,11,76.812]]],["Mein Warum",77.427,78.054,[[0,4,77.427],[5,10,77.659]]],["Warum nimmst du deine Finanzen gerade jetzt in die Hand?",78.658,81.467,[[0,5,78.658],[6,12,79.018],[13,15,79.273],[16,21,79.412],[22,30,79.633],[31,37,80.144],[38,43,80.481],[44,46,80.806],[47,50,80.898],[51,56,81.015]]],["Ein Satz reicht, nur für dich.",81.746,83.836,[[0,3,81.746],[4,8,82.048],[9,16,82.385],[17,20,83.023],[21,24,83.267],[25,30,83.418]]],["Du greifst ihn in Lektion 1.5, deinem Zukunftsbrief, wieder auf.",84.08,88.457,[[0,2,84.08],[3,10,84.242],[11,14,84.672],[15,17,84.857],[18,25,84.962],[26,30,85.519],[31,37,86.564],[38,52,86.878],[53,59,87.748],[60,64,88.015]]],["Häufige Fragen, kurz & klar",88.782,90.616,[[0,7,88.782],[8,15,89.234],[16,20,89.803],[21,22,90.128],[23,27,90.256]]],["Brauche ich Vorwissen oder Mathematik?",90.79,92.892,[[0,7,90.79],[8,11,91.162],[12,21,91.301],[22,26,91.882],[27,38,92.16]]],["Ist Firestarter eine Anlageberatung?",93.066,95.19,[[0,3,93.066],[4,15,93.275],[16,20,94.029],[21,36,94.227]]],["Bekomme ich ein Renditeversprechen?",95.318,97.129,[[0,7,95.318],[8,11,95.69],[12,15,95.841],[16,35,96.003]]],["Muss ich danach eine Präsenzveranstaltung besuchen?",97.303,100.264,[[0,4,97.303],[5,8,97.582],[9,15,97.721],[16,20,98.105],[21,41,98.325],[42,51,99.416]]]]}