{"s":[["Der Zukunftsbrief",0.0,1.173,[[0,3,0.0],[4,17,0.279]]],["Ein Seemann steuert nicht nach dem Wasser vor dem Bug, sondern nach einem Stern.",1.614,5.828,[[0,3,1.614],[4,11,1.95],[12,19,2.45],[20,25,2.856],[26,30,3.088],[31,34,3.262],[35,41,3.413],[42,45,3.692],[46,49,3.831],[50,54,3.971],[55,62,4.574],[63,67,4.876],[68,73,5.05],[74,80,5.259]]],["Dein Nordstern ist kein Geldbetrag, er ist die Richtung, die auch dann gilt, wenn die See rau wird.",6.002,11.204,[[0,4,6.002],[5,14,6.223],[15,18,6.769],[19,23,6.896],[24,35,7.059],[36,38,7.79],[39,42,7.964],[43,46,8.092],[47,56,8.231],[57,60,8.707],[61,65,8.858],[66,70,9.044],[71,76,9.3],[77,81,9.961],[82,85,10.124],[86,89,10.252],[90,93,10.495],[94,99,10.751]]],["Diese Lektion schließt Baustein 1 ab: mit einem Brief an dein zukünftiges Ich.",11.355,16.382,[[0,5,11.355],[6,13,11.645],[14,22,12.098],[23,31,12.504],[32,33,12.992],[34,37,13.282],[38,41,13.898],[42,47,14.072],[48,53,14.281],[54,56,14.733],[57,61,14.931],[62,73,15.186],[74,78,15.976]]],["Warum schlägt ein geschriebener Brief den bloßen Vorsatz?",16.556,19.168,[[0,5,16.556],[6,13,16.835],[14,17,17.148],[18,31,17.253],[32,37,17.706],[38,41,17.973],[42,48,18.1],[49,57,18.46]]],["Was ist dein Wofür jenseits des Kontostands?",19.285,22.048,[[0,3,19.285],[4,7,19.517],[8,12,19.633],[13,18,19.865],[19,27,20.55],[28,31,21.038],[32,44,21.212]]],["Was macht eine Selbstverpflichtung überprüfbar?",22.257,24.683,[[0,3,22.257],[4,9,22.477],[10,14,22.686],[15,34,22.895],[35,47,23.801]]],["In Lektion 1.4 hast du eine ehrliche Standortbestimmung gemacht und für jeden der drei Leitbegriffe zwei Marken gesetzt, wo du heute stehst und wo du hinwillst.",24.892,34.308,[[0,2,24.892],[3,10,25.078],[11,14,25.484],[15,19,26.796],[20,22,26.994],[23,27,27.098],[28,36,27.296],[37,55,27.679],[56,63,28.526],[64,67,28.898],[68,71,29.026],[72,77,29.2],[78,81,29.478],[82,86,29.629],[87,99,29.92],[100,104,30.57],[105,111,30.802],[112,120,31.104],[121,123,31.87],[124,126,32.033],[127,132,32.149],[133,139,32.393],[140,143,32.903],[144,146,33.263],[147,149,33.437],[150,160,33.565]]],["Eine niedrige Zahl galt dabei als Startkapital, nicht als Urteil; genau diese Zielwerte werden jetzt zur Rohform deiner Nordsterne.",34.517,42.377,[[0,4,34.517],[5,13,34.761],[14,18,35.272],[19,23,35.632],[24,29,35.817],[30,33,36.119],[34,47,36.305],[48,53,37.292],[54,57,37.513],[58,65,37.71],[66,71,38.488],[72,77,38.824],[78,87,39.115],[88,94,39.788],[95,100,40.02],[101,104,40.427],[105,112,40.705],[113,119,41.355],[120,131,41.622]]],["„Die meisten kennen ihren Kontostand, aber nicht ihr Wofür.“",42.621,45.837,[[0,4,42.621],[5,12,42.888],[13,19,43.236],[20,25,43.573],[26,37,43.828],[38,42,44.467],[43,48,44.629],[49,52,44.827],[53,60,44.966]]]]}