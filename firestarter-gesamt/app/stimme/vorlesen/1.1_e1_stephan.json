{"s":[["Der Funke gehört dir",0.0,1.033,[[0,3,0.0],[4,9,0.209],[10,16,0.499],[17,20,0.766]]],["Worum es hier wirklich geht.",1.115,2.485,[[0,5,1.115],[6,8,1.382],[9,13,1.451],[14,22,1.614],[23,28,2.02]]],["Die Videos entstehen gerade, der Text trägt allein.",2.81,6.049,[[0,3,2.81],[4,10,2.949],[11,20,3.332],[21,28,3.715],[29,32,4.481],[33,37,4.644],[38,43,5.12],[44,51,5.492]]],["Stell dir ein Lagerfeuer in der Dämmerung vor.",6.374,8.626,[[0,5,6.374],[6,9,6.56],[10,13,6.687],[14,24,6.803],[25,27,7.477],[28,31,7.558],[32,41,7.732],[42,46,8.185]]],["Du könntest warten, bis jemand vorbeikommt und es dir anzündet, und hoffen, dass er es gut mit dir meint.",8.87,13.77,[[0,2,8.87],[3,11,9.009],[12,19,9.311],[20,23,9.671],[24,30,9.822],[31,42,10.054],[43,46,10.855],[47,49,11.006],[50,53,11.111],[54,63,11.25],[64,67,11.854],[68,75,11.97],[76,80,12.26],[81,83,12.458],[84,86,12.539],[87,90,12.713],[91,94,13.003],[95,98,13.154],[99,105,13.34]]],["Oder du nimmst selbst ein Streichholz und schlägst deinen eigenen Funken.",14.095,17.717,[[0,4,14.095],[5,7,14.49],[8,14,14.617],[15,21,14.919],[22,25,15.221],[26,37,15.349],[38,41,16.01],[42,50,16.127],[51,57,16.521],[58,65,16.812],[66,73,17.171]]],["Genau darum geht es in „Firestarter“: dass du den Funken schlägst.",17.996,22.431,[[0,5,17.996],[6,11,18.24],[12,16,18.53],[17,19,18.727],[20,22,18.843],[23,37,19.064],[38,42,20.736],[43,45,20.91],[46,49,21.026],[50,56,21.223],[57,66,21.699]]],["Nicht eine Bank.",22.547,23.29,[[0,5,22.547],[6,10,22.767],[11,16,22.965]]],["Nicht ein Berater, der dir am Ende ein Produkt verkauft.",23.499,26.088,[[0,5,23.499],[6,9,23.766],[10,18,23.882],[19,22,24.404],[23,26,24.532],[27,29,24.637],[30,34,24.764],[35,38,24.973],[39,46,25.101],[47,56,25.461]]],["Und keine Sorge:",26.296,27.249,[[0,3,26.296],[4,9,26.471],[10,16,26.749]]],["Hier wird dir nichts übergestülpt und nichts verkauft.",27.399,30.244,[[0,4,27.399],[5,9,27.62],[10,13,27.748],[14,20,27.864],[21,33,28.201],[34,37,29.013],[38,44,29.234],[45,54,29.582]]],["Firestarter ist eine Bibliothek zum Selbstlernen, du arbeitest dich in deinem Tempo durch kurze Videos und eigene Reflexion.",30.569,37.314,[[0,11,30.569],[12,15,31.231],[16,20,31.347],[21,31,31.509],[32,35,32.101],[36,49,32.276],[50,52,33.274],[53,62,33.448],[63,67,33.843],[68,70,34.04],[71,77,34.122],[78,83,34.4],[84,89,34.725],[90,95,35.085],[96,102,35.422],[103,106,35.991],[107,113,36.153],[114,124,36.513]]],["Du brauchst kein Vorwissen und keine Mathematik außer den vier Grundrechenarten.",37.523,41.854,[[0,2,37.523],[3,11,37.651],[12,16,38.092],[17,26,38.371],[27,30,39.032],[31,36,39.206],[37,47,39.45],[48,53,39.996],[54,57,40.275],[58,62,40.46],[63,80,40.751]]],["Du siehst die drei Leitbegriffe, auf denen alles steht.",42.237,45.325,[[0,2,42.237],[3,9,42.411],[10,13,42.678],[14,18,42.852],[19,32,43.212],[33,36,43.955],[37,42,44.094],[43,48,44.396],[49,55,44.744]]],["Sie sagt ehrlich, was Firestarter nicht ist, denn ehrliche Grenzen schützen dich.",45.453,50.584,[[0,3,45.453],[4,8,45.673],[9,17,46.033],[18,21,46.939],[22,33,47.183],[34,39,47.902],[40,44,48.135],[45,49,48.669],[50,58,48.878],[59,66,49.249],[67,75,49.679],[76,81,50.085]]],["Und sie legt die ganze Reise durch die neun Bausteine vor dir aus.",50.712,54.381,[[0,3,50.712],[4,7,50.875],[8,12,50.991],[13,16,51.153],[17,22,51.258],[23,28,51.618],[29,34,52.001],[35,38,52.244],[39,43,52.407],[44,53,52.767],[54,57,53.405],[58,61,53.614],[62,66,53.765]]]]}