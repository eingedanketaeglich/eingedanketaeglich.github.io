{"s":[["Schätzrunde:",0.0,0.743,[[0,12,0.0]]],["Wie gut ist dein Gefühl?",1.184,2.45,[[0,3,1.184],[4,7,1.358],[8,11,1.614],[12,16,1.73],[17,24,1.904]]],["Vier Fragen, mal ist die Endsumme geschwärzt, mal die Jahre.",2.694,6.153,[[0,4,2.694],[5,12,3.007],[13,16,3.402],[17,20,3.646],[21,24,3.738],[25,33,3.866],[34,45,4.226],[46,49,5.143],[50,53,5.41],[54,60,5.538]]],["Schätze, dann laufen 10 Sekunden; danach erscheint die Lösung.",6.327,9.706,[[0,8,6.327],[9,13,7.117],[14,20,7.291],[21,23,7.593],[24,33,7.79],[34,40,8.243],[41,50,8.568],[51,54,8.916],[55,62,9.079]]],["Es wird nichts benotet.",9.985,11.703,[[0,2,9.985],[3,7,10.194],[8,14,10.472],[15,23,10.867]]]]}