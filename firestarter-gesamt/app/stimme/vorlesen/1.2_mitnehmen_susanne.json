{"s":[["Was du mitnimmst",0.0,1.393,[[0,3,0.0],[4,6,0.488],[7,16,0.708]]],["Drei Sätze, und die Fragen, die jetzt oft kommen.",1.834,5.039,[[0,4,1.834],[5,11,2.229],[12,15,2.879],[16,19,3.17],[20,27,3.344],[28,31,3.808],[32,37,3.936],[38,41,4.272],[42,49,4.505]]],["Drei Sätze zum Mitnehmen",5.248,6.989,[[0,4,5.248],[5,10,5.631],[11,14,6.06],[15,24,6.293]]],["Kontinuität schlägt Höhe, der Motor ist das „hoch n“, nicht der Zinssatz.",7.314,12.817,[[0,11,7.314],[12,19,8.197],[20,25,8.533],[26,29,9.242],[30,35,9.427],[36,39,9.961],[40,43,10.159],[44,49,10.379],[50,53,10.937],[54,59,11.482],[60,63,11.796],[64,73,11.993]]],["37.000 € sind der entgangene Lauf, nie entstanden, nicht entnommen.",13.201,18.727,[[0,6,13.201],[7,8,14.373],[9,13,14.768],[14,17,14.965],[18,28,15.128],[29,34,15.627],[35,38,16.3],[39,50,16.591],[51,56,17.589],[57,67,17.949]]],["Langes Verharren im Tal kostet jedes Jahr plus dessen Zinseszins, teurer als ein erholter Sturz.",19.11,25.89,[[0,6,19.11],[7,16,19.551],[17,19,20.039],[20,23,20.19],[24,30,20.561],[31,36,21.072],[37,41,21.479],[42,46,21.769],[47,53,22.187],[54,65,22.547],[66,72,23.801],[73,76,24.427],[77,80,24.683],[81,89,24.892],[90,96,25.345]]],["Häufige Fragen, kurz & klar",26.215,28.375,[[0,7,26.215],[8,15,26.633],[16,20,27.191],[21,22,27.736],[23,27,27.945]]],["Sind die 7 % ein Renditeversprechen?",28.653,31.486,[[0,4,28.653],[5,8,28.921],[9,10,29.118],[11,12,29.501],[13,16,30.035],[17,36,30.291]]],["Wurden die 37.000 € in einem Crash „verloren“?",31.811,35.782,[[0,6,31.811],[7,10,32.183],[11,17,32.334],[18,19,33.646],[20,22,33.971],[23,28,34.099],[29,34,34.331],[35,46,34.784]]],["Soll ich bei jedem Tal verkaufen oder aktiv handeln?",36.107,39.508,[[0,4,36.107],[5,8,36.397],[9,12,36.548],[13,18,36.745],[19,22,37.128],[23,32,37.407],[33,37,38.115],[38,43,38.382],[44,52,38.858]]],["Ist „kaufen und liegen lassen“ also schlecht?",39.787,42.678,[[0,3,39.787],[4,11,40.135],[12,15,40.797],[16,22,40.971],[23,30,41.32],[31,35,41.714],[36,45,42.051]]],["Die naheliegende Frage „Was kann man gegen den stillen Saboteur tun?“ vertiefen wir später, ganz freiwillig, in unseren Präsenzveranstaltungen.",42.922,51.525,[[0,3,42.922],[4,16,43.131],[17,22,43.688],[23,27,44.326],[28,32,44.861],[33,36,45.116],[37,42,45.325],[43,46,45.569],[47,54,45.766],[55,63,46.172],[64,69,46.707],[70,79,47.496],[80,83,47.96],[84,91,48.123],[92,96,48.622],[97,108,48.889],[109,111,49.493],[112,119,49.655],[120,143,50.027]]],["Kein Muss:",51.768,52.57,[[0,4,51.768],[5,10,52.117]]],["Der Firestarter steht für sich.",52.72,54.892,[[0,3,52.72],[4,15,52.941],[16,21,53.835],[22,25,54.16],[26,31,54.311]]]]}