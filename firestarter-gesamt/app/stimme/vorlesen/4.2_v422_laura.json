{"s":[["Die Anleihe, der Kredit mit Zinsschein",0.0,2.543,[[0,3,0.0],[4,12,0.267],[13,16,1.057],[17,23,1.265],[24,27,1.707],[28,38,1.892]]],["Diesmal leihst du dem Bäcker 1.000 €, willst sie in fünf Jahren zurück und bekommst jedes Jahr Zinsen.",3.495,9.543,[[0,7,3.495],[8,14,4.04],[15,17,4.296],[18,21,4.4],[22,28,4.551],[29,34,4.957],[35,37,5.584],[38,44,6.037],[45,48,6.374],[49,51,6.502],[52,56,6.653],[57,63,7.001],[64,70,7.314],[71,74,7.697],[75,83,7.825],[84,89,8.371],[90,94,8.696],[95,102,8.905]]],["Jetzt bist du kein Eigentümer, sondern Gläubiger.",10.054,12.829,[[0,5,10.054],[6,10,10.356],[11,13,10.542],[14,18,10.67],[19,30,10.902],[31,38,11.714],[39,49,12.098]]],["Dieser handelbare Deal heißt Anleihe.",13.073,15.209,[[0,6,13.073],[7,17,13.433],[18,22,14.013],[23,28,14.269],[29,37,14.559]]],["Drei Dinge stehen darauf:",15.383,16.835,[[0,4,15.383],[5,10,15.697],[11,17,15.917],[18,25,16.196]]],["Betrag · Kupon (Zins) · Laufzeit.",17.113,20.19,[[0,6,17.113],[7,8,17.787],[9,14,17.856],[15,21,18.448],[22,23,19.296],[24,33,19.389]]],["Deine Rolle:",20.306,21.049,[[0,5,20.306],[6,12,20.62]]],["Eigentümer",21.177,21.885,[[0,10,21.177]]],["Dein Ertrag:",22.489,23.418,[[0,4,22.489],[5,12,22.814]]],["Dividende + Wertsteigerung",23.487,26.111,[[0,9,23.487],[10,11,24.37],[12,26,25.298]]],["Im Pleitefall: zuletzt bedient",26.436,28.329,[[0,2,26.436],[3,14,26.645],[15,22,27.585],[23,30,28.015]]],["Deine Rolle:",28.352,29.072,[[0,5,28.352],[6,12,28.619]]],["Gläubiger",29.153,29.768,[[0,9,29.153]]],["Dein Ertrag: fester Zins + Rückzahlung",29.884,33.356,[[0,4,29.884],[5,12,30.175],[13,19,30.778],[20,24,31.219],[25,26,31.788],[27,38,32.694]]],["Im Pleitefall: vor den Eigentümern bedient",33.53,36.014,[[0,2,33.53],[3,14,33.739],[15,18,34.703],[19,22,34.877],[23,34,35.062],[35,42,35.701]]],["Sicherheit ist nicht gratis, sie wird mit verzichteter Chance bezahlt.",36.049,39.788,[[0,10,36.049],[11,14,36.583],[15,20,36.734],[21,28,36.943],[29,32,37.628],[33,37,37.814],[38,41,38.011]