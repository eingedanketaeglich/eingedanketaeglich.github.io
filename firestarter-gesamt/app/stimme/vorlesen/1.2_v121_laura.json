{"s":[["Der stille Motor: einfacher Zins vs.",0.0,2.543,[[0,3,0.0],[4,10,0.255],[11,17,0.569],[18,27,1.231],[28,32,1.8],[33,36,2.206]]],["Zinseszins",2.566,3.379,[[0,10,2.566]]],["Zwei Wörter, ein winziger Unterschied, riesige Wirkung über die Zeit.",3.622,7.628,[[0,4,3.622],[5,12,3.971],[13,16,4.481],[17,25,4.702],[26,38,5.19],[39,46,5.933],[47,54,6.385],[55,59,6.757],[60,63,6.954],[64,69,7.105]]],["Einfacher Zins",7.837,8.719,[[0,9,7.837],[10,14,8.371]]],["Du entnimmst den Zins jedes Jahr.",8.789,10.89,[[0,2,8.789],[3,12,8.975],[13,16,9.416],[17,21,9.625],[22,27,10.054],[28,33,10.414]]],["Das Kapital bleibt gleich.",11.134,12.655,[[0,3,11.134],[4,11,11.343],[12,18,11.854],[19,26,12.109]]],["Es wächst in einer geraden Linie.",12.69,14.629,[[0,2,12.69],[3,9,12.91],[10,12,13.224],[13,18,13.34],[19,26,13.572],[27,33,14.013]]],["Zinseszins",15.012,15.883,[[0,10,15.012]]],["Du lässt den Zins liegen.",16.394,17.764,[[0,2,16.394],[3,8,16.591],[9,12,16.835],[13,17,17.021],[18,25,17.346]]],["Zins wird auf Kapital und auf frühere Zinsen gezahlt.",17.915,20.887,[[0,4,17.915],[5,9,18.24],[10,13,18.402],[14,21,18.542],[22,25,19.192],[26,29,19.389],[30,37,19.528],[38,44,19.923],[45,53,20.271]]],["Es wächst gekrümmt (exponentiell).",21.096,23.209,[[0,2,21.096],[3,9,21.282],[10,18,21.537],[19,34,22.141]]],["Das Endkapital nach n Jahren ergibt sich aus Startkapital K₀ und Zinssatz i:",23.383,28.445,[[0,3,23.383],[4,14,23.627],[15,19,24.3],[20,21,24.532],[22,28,24.706],[29,35,25.182],[36,40,25.531],[41,44,25.751],[45,57,25.914],[58,60,26.785],[61,64,27.319],[65,73,27.551],[74,76,28.12]]],["Rechnen wir es mit 10.000 € und 7 % (historische Lehrannahme):",28.689,33.403,[[0,7,28.689],[8,11,29.083],[12,14,29.246],[15,18,29.397],[19,25,29.559],[26,27,30.315],[28,31,30.698],[32,33,30.907],[34,35,31.255],[36,48,31.812],[49,62,32.648]]],["Jahr 1 → 10.700 €.",33.519,35.818,[[0,4,33.519],[5,6,33.867],[7,8,34.262],[9,15,34.32],[16,18,35.423]]],["Jahr 2 → 11.449 €, nicht glatt 11.400 €.",36.12,4