{"s":[["Warum diese Rechnung in keinem Bankprospekt steht",0.0,2.601,[[0,5,0.0],[6,11,0.476],[12,20,0.743],[21,23,1.138],[24,30,1.289],[31,43,1.672],[44,49,2.299]]],["Ist Stehenbleiben nicht besser als Stürzen?",3.297,5.782,[[0,3,3.297],[4,17,3.657],[18,23,4.4],[24,30,4.656],[31,34,4.969],[35,43,5.12]]],["Klingt logisch, ist aber oft falsch.",6.594,8.928,[[0,6,6.594],[7,15,6.943],[16,19,7.663],[20,24,7.872],[25,28,8.104],[29,36,8.359]]],["Echter, schmerzhafter Verlust, steht aber sofort wieder auf.",9.625,12.841,[[0,7,9.625],[8,21,10.101],[22,30,10.82],[31,36,11.366],[37,41,11.622],[42,48,11.784],[49,55,12.214],[56,60,12.446]]],["Der Motor läuft von niedrigerer Basis weiter und holt auf.",13.653,16.741,[[0,3,13.653],[4,9,13.851],[10,15,14.245],[16,19,14.501],[20,31,14.687],[32,37,15.244],[38,44,15.627],[45,48,15.987],[49,53,16.126],[54,58,16.358]]],["Kostet den Motor ein paar Jahre.",17.693,19.516,[[0,6,17.693],[7,10,18.111],[11,16,18.262],[17,20,18.599],[21,25,18.727],[26,32,18.959]]],["Verliert optisch nichts Neues, bleibt aber unten.",20.12,22.883,[[0,8,20.12],[9,16,20.515],[17,23,20.898],[24,30,21.211],[31,37,21.873],[38,42,22.198],[43,49,22.442]]],["Der Motor produziert jedes Jahr nichts.",23.394,25.681,[[0,3,23.394],[4,9,23.58],[10,20,23.963],[21,26,24.543],[27,31,24.857],[32,39,25.112]]],["Kostet jedes Jahr plus dessen Zins-auf-Zins.",26.633,29.152,[[0,6,26.633],[7,12,27.063],[13,17,27.33],[18,22,27.515],[23,29,27.806],[30,44,28.131]]],["Der Knoten, den die meisten nicht sehen:",29.965,31.916,[[0,3,29.965],[4,11,30.174],[12,15,30.65],[16,19,30.824],[20,27,30.952],[28,33,31.312],[34,40,31.532]]],["Beim Zinseszins ist die Zeit der Treibstoff, nicht der momentane Punktestand.",32.125,37.117,[[0,4,32.125],[5,15,32.403],[16,19,33.471],[20,23,33.692],[24,28,33.854],[29,32,34.133],[33,44,34.284],[45,50,35.271],[51,54,35.642],[55,64,35.817],[65,77,36.397]]],["Ein Prospekt zeigt dir meist nur die Durchschnitts-Rendite über den ganzen Zeitraum.",37.721,42.028,[[0,3,37.721],[4,12,37.895],[13,18,38.429],[19,22,38.707],[23,28,38.847],[29,32,39.137],[33,36,39.323],[37,58,39.474],[59,63,40.704],[64,67,40.971],[68,74,41.122],[75,84,41.471]]],["Diese Zahl ist nicht gelogen, aber sie glättet die Talphasen weg und macht die teuren Wartejahre unsichtbar.",42.469,48.657,[[0,5,42.469],[6,10,42.806],[11,14,43.073],[15,20,43.2],[21,29,43.409],[30,34,44.257],[35,38,44.512],[39,46,44.652],[47,50,45.07],[51,60,45.22],[61,64,45.87],[65,68,46.3],[69,74,46.497],[75,78,46.695],[79,85,46.857],[86,96,47.31],[97,108,47.914]]],["Viele vertrauen ihr Geld „Profis“ an und glauben, es sei betreut, faktisch liegt es oft als unbetreutes Depot da („kaufen und wegschauen“), und im Tal lautet der einzige Rat „aushalten“.",49.353,61.729,[[0,5,49.353],[6,15,49.737],[16,19,50.271],[20,24,50.41],[25,33,50.631],[34,36,51.223],[37,40,51.466],[41,49,51.617],[50,52,51.989],[53,56,52.07],[57,65,52.244],[66,74,53.405],[75,80,53.916],[81,83,54.137],[84,87,54.311],[88,91,54.578],[92,103,54.833],[104,109,55.46],[110,112,55.82],[113,121,56.192],[122,125,57.202],[126,139,57.318],[140,143,58.374],[144,146,58.583],[147,150,58.746],[151,157,59.303],[158,161,59.756],[162,169,59.941],[170,173,60.406],[174,186,60.777]]],["Diese Einordnung richtet sich gegen das Kaufen-und-Wegschauen, nicht gegen ETFs als Instrument; sie ist allgemeine Bildung, keine Aussage über einzelne Anbieter.",62.542,72.306,[[0,5,62.542],[6,16,62.937],[17,24,63.529],[25,29,63.819],[30,35,64.028],[36,39,64.283],[40,62,64.562],[63,68,66.164],[69,74,66.454],[75,79,66.721],[80,83,67.232],[84,95,67.395],[96,99,68.509],[100,103,68.695],[104,114,68.962],[115,123,69.496],[124,129,70.239],[130,137,70.611],[138,142,71.087],[143,151,71.296],[152,161,71.714]]],["Auch Profis bekommen Wadenkrämpfe; sie gehen nur besser damit um.",73.119,76.985,[[0,4,73.119],[5,11,73.362],[12,20,73.862],[21,34,74.268],[35,38,75.441],[39,44,75.615],[45,48,75.858],[49,55,76.114],[56,61,76.369],[62,65,76.648]]],["Wir trainieren dreierlei: den Krampf früh erkennen → ihn durchhalten statt am Tiefpunkt aufzugeben → das Tal mit der Zeit methodisch navigieren.",77.426,86.598,[[0,3,77.426],[4,14,77.681],[15,25,78.157],[26,29,79.608],[30,36,79.829],[37,41,80.259],[42,50,80.619],[51,52,81.245],[53,56,81.571],[57,68,81.722],[69,74,82.279],[75,77,82.569],[78,87,82.708],[88,98,83.196],[99,100,83.927],[101,104,84.229],[105,108,84.485],[109,112,84.74],[113,116,84.879],[117,121,85.042],[122,132,85.367],[133,144,85.924]]],["Wer durchläuft, unterbricht den Zinseszins nicht.",87.41,90.603,[[0,3,87.41],[4,15,87.666],[16,27,88.595],[28,31,89.14],[32,42,89.314],[43,49,90.023]]]]}