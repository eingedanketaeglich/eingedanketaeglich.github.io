{"s":[["Verzinste Einlagen.",0.0,1.358,[[0,9,0.0],[10,19,0.697]]],["Geld, das ruht, soll nicht schlafen",1.962,4.54,[[0,5,1.962],[6,9,2.612],[10,15,2.856],[16,20,3.692],[21,26,3.936],[27,35,4.098]]],["Dein Notgroschen liegt „sicher“, aber verdient er auch etwas, oder verliert er still an Kaufkraft?",5.352,11.505,[[0,4,5.352],[5,16,5.7],[17,22,6.374],[23,32,6.757],[33,37,8.22],[38,46,8.498],[47,49,8.893],[50,54,8.986],[55,61,9.16],[62,66,9.729],[67,75,10.008],[76,78,10.321],[79,84,10.403],[85,87,10.716],[88,98,10.844]]],["Deine Konten haben jetzt Aufgaben.",12.202,14.048,[[0,5,12.202],[6,12,12.527],[13,18,12.945],[19,24,13.189],[25,34,13.468]]],["Eines trägt den Notgroschen.",14.292,15.987,[[0,5,14.292],[6,11,14.687],[12,15,15.081],[16,28,15.256]]],["Drei Etappen: die drei Wege, ruhendes Geld zu verzinsen (Tagesgeld, Festgeld, Geldmarkt-ETF) samt Lockzins-Falle, dann der Realzins-Test (Zins minus Inflation), zuletzt die Grenze zwischen „sicher parken“ und „investieren“.",16.939,33.878,[[0,4,16.939],[5,13,17.298],[14,17,18.216],[18,22,18.401],[23,28,18.703],[29,37,19.365],[38,42,19.899],[43,45,20.213],[46,55,20.352],[56,67,21.165],[68,77,22.244],[78,92,23.243],[93,97,24.868],[98,113,25.309],[114,118,26.575],[119,122,26.877],[123,136,27.097],[137,142,28.27],[143,148,28.932],[149,160,29.292],[161,168,30.255],[169,172,30.754],[173,179,30.917],[180,188,31.277],[189,196,31.614],[197,204,32.101],[205,208,32.589],[209,223,32.844]]],["Sieh den Zins deines Tagesgeld-/Sparkontos nach, eine einzige Zahl.",34.655,39.578,[[0,4,34.655],[5,8,34.922],[9,13,35.166],[14,20,35.538],[21,42,35.874],[43,48,37.581],[49,53,38.278],[54,61,38.614],[62,67,39.114]]],["Ruf dir die letzte Inflationszahl in Erinnerung, die du gehört hast.",40.275,44.106,[[0,3,40.275],[4,7,40.588],[8,11,40.774],[12,18,40.925],[19,33,41.308],[34,36,42.388],[37,48,42.539],[49,52,43.049],[53,55,43.189],[56,62,43.363],[63,68,43.7]]],["Größer oder kleiner?",44.547,46.173,[[0,6,44.547],[7,11,45.313],[12,20,45.592]]],["Nur vergleichen, nicht handeln.",46.776,48.564,[[0,3,46.776],[4,16,47.032],[17,22,47.798],[23,31,48.077]]],["In Lektion 3.1 hast du den stillen Gegner deiner Kaufkraft kennengelernt: die Inflation.",49.516,55.391,[[0,2,49.516],[3,10,49.714],[11,14,50.143],[15,19,51.025],[20,22,51.234],[23,26,51.362],[27,34,51.583],[35,41,52.036],[42,48,52.43],[49,58,52.697],[59,73,53.22],[74,77,54.288],[78,88,54.532]]],["Dieselbe Menge Geld kauft mit der Zeit weniger, und liegt die Inflation über deinem Sparzins, verlierst du real an Wert, auch wenn die Zahl auf dem Konto gleich bleibt.",55.832,65.875,[[0,8,55.832],[9,14,56.331],[15,19,56.61],[20,25,57.167],[26,29,57.527],[30,33,57.655],[34,38,57.794],[39,47,58.131],[48,51,59.037],[52,57,59.292],[58,61,59.489],[62,71,59.594],[72,76,60.314],[77,83,60.546],[84,93,60.813],[94,103,61.835],[104,106,62.264],[107,111,62.415],[112,114,62.868],[115,120,63.019],[121,125,63.75],[126,130,63.936],[131,134,64.075],[135,139,64.226],[140,143,64.505],[144,147,64.621],[148,153,64.772],[154,160,65.097],[161,168,65.399]]],["Genau daraus stammt der Merksatz Nominalzins minus Inflation gleich Realzins.",66.478,72.284,[[0,5,66.478],[6,12,66.862],[13,19,67.523],[20,23,67.848],[24,32,67.999],[33,44,68.928],[45,50,69.985],[51,60,70.449],[61,67,71.064],[68,77,71.39]]],["„Die ehrliche Frage an jedes geparkte Geld ist nicht ‚wie viel Zins?', sondern ‚wie viel Zins minus Inflation?'“",72.98,81.502,[[0,4,72.98],[5,13,73.398],[14,19,73.828],[20,22,74.28],[23,28,74.443],[29,37,74.745],[38,42,75.232],[43,46,75.476],[47,52,75.639],[53,57,76.08],[58,62,76.556],[63,70,76.846],[71,78,77.787],[79,83,78.321],[84,88,78.785],[89,93,79.064],[94,99,79.517],[100,112,79.969]]]]}