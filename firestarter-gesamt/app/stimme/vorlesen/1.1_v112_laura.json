{"s":[["Was Firestarter ist, und was nicht",0.0,2.194,[[0,3,0.0],[4,15,0.395],[16,20,1.138],[21,24,1.533],[25,28,1.695],[29,34,1.974]]],["Die ehrlichste Art, Vertrauen aufzubauen: sagen, wo die Grenzen liegen.",2.218,6.304,[[0,3,2.218],[4,14,2.392],[15,19,2.891],[20,29,3.111],[30,41,3.622],[42,48,4.76],[49,51,5.19],[52,55,5.341],[56,63,5.445],[64,71,5.828]]],["Bildung, die dir das Prinzip erklärt, keine auf deinen Einzelfall zugeschnittene Empfehlung.",6.583,11.517,[[0,8,6.583],[9,12,7.117],[13,16,7.256],[17,20,7.384],[21,28,7.558],[29,37,7.999],[38,43,8.615],[44,47,9.021],[48,54,9.183],[55,65,9.497],[66,80,10.136],[81,92,10.82]]],["ehrliche Sprache:",11.761,12.841,[[0,8,11.761],[9,17,12.156]]],["Es fällt nie eine Zahl wie „so viel bekommst du“.",12.992,16.092,[[0,2,12.992],[3,8,13.189],[9,12,13.456],[13,17,13.677],[18,22,13.944],[23,26,14.362],[27,30,14.71],[31,35,15.128],[36,44,15.337],[45,49,15.766]]],["ein Fundament, aktives Handeln gehört nicht zu Firestarter.",16.266,19.969,[[0,3,16.266],[4,14,16.451],[15,22,17.462],[23,30,17.984],[31,37,18.379],[38,43,18.75],[44,46,18.982],[47,59,19.122]]],["die Schicht darunter, das konkrete Depot-Zusammenstellen kommt später.",20.12,23.986,[[0,3,20.12],[4,11,20.283],[12,21,20.55],[22,25,21.2],[26,34,21.455],[35,56,21.989],[57,62,23.15],[63,70,23.371]]],["steuerliches Grundwissen, damit du die richtigen Fragen stellen kannst.",24.23,27.608,[[0,12,24.23],[13,25,24.915],[26,31,25.542],[32,34,25.797],[35,38,25.902],[39,48,26.018],[49,55,26.413],[56,63,26.761],[64,71,27.109]]],["Und was ist es dann zusammengefasst?",28.05,29.954,[[0,3,28.05],[4,7,28.293],[8,11,28.491],[12,14,28.653],[15,19,28.793],[20,36,29.002]]],["Bildung.",30.128,30.824,[[0,8,30.128]]],["Ein Fundament.",31.335,32.287,[[0,3,31.335],[4,14,31.533]]],["Eine Selbstlern-Bibliothek, durch die du dich selbst bewegst, und auf der alles Weitere ruht.",32.612,37.605,[[0,4,32.612],[5,27,32.879],[28,33,34.006],[34,37,34.214],[38,40,34.331],[41,45,34.458],[46,52,34.632],[53,61,34.958],[62,65,35.596],[66,69,35.933],[70,73,36.13],[74,79,36.339],[80,87,36.745],[88,93,37.163]]],["Was ein Programm nicht verspricht, schützt dich, nicht den Anbieter.",37.93,41.285,[[0,3,37.93],[4,7,38.139],[8,16,38.266],[17,22,38.673],[23,34,38.905],[35,42,39.416],[43,48,39.741],[49,54,40.147],[55,58,40.414],[59,68,40.588]]],["Ein Programm ohne Rendite-Werbung hat nur ein Interesse: dass du es verstehst.",41.61,46.068,[[0,3,41.61],[4,12,41.796],[13,17,42.248],[18,33,42.469],[34,37,43.293],[38,41,43.467],[42,45,43.746],[46,56,44.025],[57,61,44.756],[62,64,44.977],[65,67,45.116],[68,78,45.232]]]]}