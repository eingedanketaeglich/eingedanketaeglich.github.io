{"s":[["Bildung schlägt Beratung",0.0,1.637,[[0,7,0.0],[8,15,0.557],[16,24,0.952]]],["Warum ein gut gemeinter Rat dich abhängig machen kann, und Verstehen dich freier macht als jedes Produkt.",1.962,7.79,[[0,5,1.962],[6,9,2.426],[10,13,2.624],[14,23,2.879],[24,27,3.355],[28,32,3.611],[33,41,3.796],[42,48,4.249],[49,54,4.528],[55,58,5.085],[59,68,5.271],[69,73,5.712],[74,80,5.921],[81,86,6.339],[87,90,6.641],[91,96,6.873],[97,105,7.175]]],["Stell dir vor, jemand bietet dir an, dich für immer zu tragen.",8.034,11.564,[[0,5,8.034],[6,9,8.324],[10,14,8.487],[15,21,8.882],[22,28,9.253],[29,32,9.567],[33,36,9.81],[37,41,10.089],[42,45,10.31],[46,51,10.484],[52,54,10.809],[55,62,10.96]]],["Bequem, bis du merkst:",11.714,13.41,[[0,7,11.714],[8,11,12.481],[12,14,12.725],[15,22,12.887]]],["Du hast das Gehen verlernt.",13.526,15.07,[[0,2,13.526],[3,7,13.7],[8,11,13.897],[12,17,14.106],[18,27,14.432]]],["Genau das passiert oft bei der Geldanlage: jemand „trägt“ dich, und du wirst nie selbst sicher auf den Beinen.",15.244,21.955,[[0,5,15.244],[6,9,15.569],[10,18,15.848],[19,22,16.278],[23,26,16.521],[27,30,16.661],[31,42,16.777],[43,49,17.787],[50,57,18.263],[58,63,18.983],[64,67,19.412],[68,70,19.598],[71,76,19.749],[77,80,20.109],[81,87,20.353],[88,94,20.759],[95,98,21.061],[99,102,21.212],[103,110,21.363]]],["Nicht, weil Berater böse wären, die meisten meinen es gut.",22.164,25.333,[[0,6,22.164],[7,11,22.454],[12,19,22.663],[20,24,23.139],[25,31,23.453],[32,35,23.824],[36,43,23.975],[44,50,24.405],[51,53,24.73],[54,58,24.857]]],["Sondern weil das Modell dahinter dich abhängig hält, statt dich frei zu machen.",25.542,30.013,[[0,7,25.542],[8,12,26.007],[13,16,26.216],[17,23,26.459],[24,32,26.959],[33,37,27.365],[38,46,27.598],[47,52,28.132],[53,58,28.48],[59,63,28.77],[64,68,28.991],[69,71,29.328],[72,79,29.502]]],["Warum kann ein gut gemeinter Rat dich abhängig machen?",30.338,33.217,[[0,5,30.338],[6,10,30.779],[11,14,30.965],[15,18,31.081],[19,28,31.278],[29,32,31.731],[33,37,31.986],[38,46,32.218],[47,54,32.729]]],["Was bleibt am Ende bei dir, bei Beratung, was bei Bildung?",33.426,37.048,[[0,3,33.426],[4,10,33.705],[11,13,34.041],[14,18,34.181],[19,22,34.436],[23,27,34.622],[28,31,35.04],[32,41,35.225],[42,45,35.98],[46,49,36.224],[50,58,36.375]]],["Wo hast du bisher eine Entscheidung abgegeben, die dir gehört?",37.373,40.508,[[0,2,37.373],[3,7,37.582],[8,10,37.768],[11,17,37.873],[18,22,38.244],[23,35,38.441],[36,46,38.999],[47,50,39.66],[51,54,39.823],[55,62,40.009]]],["„Bildung will sich selbst überflüssig machen.“",40.833,43.515,[[0,8,40.833],[9,13,41.46],[14,18,41.669],[19,25,41.843],[26,37,42.261],[38,46,42.946]]]]}