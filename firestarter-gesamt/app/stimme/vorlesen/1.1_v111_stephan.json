{"s":[["Die drei Leitbegriffe, dein Dreieck",0.0,2.357,[[0,3,0.0],[4,8,0.197],[9,22,0.418],[23,27,1.521],[28,35,1.823]]],["Das ganze Programm steht auf drei Begriffen, mit R&F in der Mitte.",2.798,6.327,[[0,3,2.798],[4,9,3.007],[10,18,3.286],[19,24,3.692],[25,28,3.936],[29,33,4.133],[34,44,4.423],[45,48,5.027],[49,52,5.248],[53,55,5.724],[56,59,5.805],[60,66,5.933]]],["Du kannst nichts steuern, was du nicht verstehst.",6.571,8.858,[[0,2,6.571],[3,9,6.734],[10,16,7.036],[17,25,7.372],[26,29,7.802],[30,32,7.953],[33,38,8.046],[39,49,8.231]]],["Solange Geld, Zinsen und Börse eine Black Box sind, entscheiden andere.",9.183,13.444,[[0,7,9.183],[8,13,9.601],[14,20,10.101],[21,24,10.565],[25,30,10.693],[31,35,11.099],[36,41,11.273],[42,45,11.494],[46,51,11.749],[52,63,12.376],[64,71,12.887]]],["Wissen allein füllt kein Depot.",13.653,15.882,[[0,6,13.653],[7,13,14.036],[14,19,14.547],[20,24,14.988],[25,31,15.302]]],["Es wird erst wertvoll, wenn es in Handlung übergeht.",16.091,18.808,[[0,2,16.091],[3,7,16.254],[8,12,16.405],[13,22,16.625],[23,27,17.113],[28,30,17.264],[31,33,17.391],[34,42,17.484],[43,52,17.995]]],["Nicht reich werden um des Reichtums willen, sondern frei werden in deinen Entscheidungen.",19.017,23.963,[[0,5,19.017],[6,11,19.319],[12,18,19.632],[19,21,19.946],[22,25,20.062],[26,35,20.236],[36,43,20.816],[44,51,21.467],[52,56,21.827],[57,63,22.21],[64,66,22.651],[67,73,22.802],[74,89,23.185]]],["Drei Leitbegriffe – dein erster Baustein",24.288,26.749,[[0,4,24.288],[5,17,24.636],[18,19,25.379],[20,24,25.542],[25,31,25.762],[32,40,26.122]]],["Finanzwissen führt zu Selbstbestimmung, und beides zusammen führt zu Vermögensaufbau.",27.19,32.229,[[0,12,27.19],[13,18,28.003],[19,21,28.293],[22,39,28.572],[40,43,29.431],[44,50,29.559],[51,59,29.86],[60,65,30.685],[66,68,30.929],[69,85,31.08]]],["Der Funke gehört dir, nicht dem Berater.",32.473,35.317,[[0,3,32.473],[4,9,32.705],[10,16,33.216],[17,21,33.552],[22,27,34.203],[28,31,34.609],[32,40,34.795]]],["Ein Feuer, d