{"s":[["Verzinste Einlagen.",0.0,1.544,[[0,9,0.0],[10,19,0.801]]],["Geld, das ruht, soll nicht schlafen",1.788,3.913,[[0,5,1.788],[6,9,2.218],[10,15,2.461],[16,20,2.926],[21,26,3.17],[27,35,3.379]]],["Dein Notgroschen liegt „sicher“, aber verdient er auch etwas, oder verliert er still an Kaufkraft?",4.296,9.892,[[0,4,4.296],[5,16,4.54],[17,22,5.155],[23,32,5.41],[33,37,6.316],[38,46,6.594],[47,49,6.954],[50,54,7.07],[55,61,7.314],[62,66,7.93],[67,75,8.197],[76,78,8.58],[79,84,8.673],[85,87,8.975],[88,98,9.102]]],["Deine Konten haben jetzt Aufgaben.",10.217,12.156,[[0,5,10.217],[6,12,10.519],[13,18,10.902],[19,24,11.157],[25,34,11.447]]],["Eines trägt den Notgroschen.",12.399,13.967,[[0,5,12.399],[6,11,12.806],[12,15,13.061],[16,28,13.201]]],["Drei Etappen: die drei Wege, ruhendes Geld zu verzinsen (Tagesgeld, Festgeld, Geldmarkt-ETF) samt Lockzins-Falle, dann der Realzins-Test (Zins minus Inflation), zuletzt die Grenze zwischen „sicher parken“ und „investieren“.",14.292,29.083,[[0,4,14.292],[5,13,14.606],[14,17,15.372],[18,22,15.523],[23,28,15.813],[29,37,16.15],[38,42,16.626],[43,45,16.858],[46,55,16.997],[56,67,17.752],[68,77,18.681],[78,92,19.319],[93,97,20.805],[98,113,21.107],[114,118,22.152],[119,122,22.361],[123,136,22.512],[137,142,23.592],[143,148,24.161],[149,160,24.497],[161,168,25.484],[169,172,25.902],[173,179,26.018],[180,188,26.413],[189,196,26.866],[197,204,27.388],[205,208,27.887],[209,223,28.108]]],["Sieh den Zins deines Tagesgeld-/Sparkontos nach, eine einzige Zahl.",29.466,33.564,[[0,4,29.466],[5,8,29.675],[9,13,29.849],[14,20,30.151],[21,42,30.441],[43,48,31.916],[49,53,32.415],[54,61,32.682],[62,67,33.123]]],["Ruf dir die letzte Inflationszahl in Erinnerung, die du gehört hast.",33.843,37.071,[[0,3,33.843],[4,7,34.098],[8,11,34.215],[12,18,34.331],[19,33,34.667],[34,36,35.503],[37,48,35.643],[49,52,36.142],[53,55,36.235],[56,62,36.351],[63,68,36.687]]],["Größer oder kleiner?",37.187,38.522,[[0,6,37.187],[7,11,37.674],[12,20,37.907]]],["Nur vergleichen, nicht handeln.",38.847,40.658,[[0,3,38.847],[4,16,39.044],[17,22,39.869],[23,31,40.124]]],["In Lektion 3.1 hast du den stillen Gegner deiner Kaufkraft kennengelernt: die Inflation.",40.937,46.254,[[0,2,40.937],[3,10,41.134],[11,14,41.645],[15,19,42.376],[20,22,42.562],[23,26,42.667],[27,34,42.829],[35,41,43.189],[42,48,43.549],[49,58,43.805],[59,73,44.304],[74,77,45.314],[78,88,45.465]]],["Dieselbe Menge Geld kauft mit der Zeit weniger, und liegt die Inflation über deinem Sparzins, verlierst du real an Wert, auch wenn die Zahl auf dem Konto gleich bleibt.",46.37,55.02,[[0,8,46.37],[9,14,46.858],[15,19,47.102],[20,25,47.38],[26,29,47.659],[30,33,47.775],[34,38,47.914],[39,47,48.158],[48,51,48.762],[52,57,48.959],[58,61,49.168],[62,71,49.273],[72,76,49.888],[77,83,50.051],[84,93,50.283],[94,103,51.339],[104,106,51.757],[107,111,51.897],[112,114,52.268],[115,120,52.396],[121,125,52.849],[126,130,53.081],[131,134,53.232],[135,139,53.383],[140,143,53.673],[144,147,53.801],[148,153,53.975],[154,160,54.312],[161,168,54.567]]],["Genau daraus stammt der Merksatz Nominalzins minus Inflation gleich Realzins.",55.461,60.256,[[0,5,55.461],[6,12,55.821],[13,19,56.169],[20,23,56.471],[24,32,56.611],[33,44,57.133],[45,50,58.097],[51,60,58.445],[61,67,59.142],[68,77,59.467]]],["„Die ehrliche Frage an jedes geparkte Geld ist nicht ‚wie viel Zins?', sondern ‚wie viel Zins minus Inflation?'“",60.581,67.106,[[0,4,60.581],[5,13,60.825],[14,19,61.22],[20,22,61.591],[23,28,61.742],[29,37,62.021],[38,42,62.509],[43,46,62.81],[47,52,62.985],[53,57,63.298],[58,62,63.519],[63,70,63.786],[71,78,64.598],[79,83,64.923],[84,88,65.144],[89,93,65.411],[94,99,65.817],[100,112,66.154]]]]}