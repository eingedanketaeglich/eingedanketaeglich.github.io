{"s":[["Der Funke gehört dir",0.0,1.277,[[0,3,0.0],[4,9,0.267],[10,16,0.662],[17,20,0.998]]],["Worum es hier wirklich geht.",1.66,3.088,[[0,5,1.66],[6,8,2.009],[9,13,2.101],[14,22,2.252],[23,28,2.635]]],["Die Videos entstehen gerade, der Text trägt allein.",3.529,6.908,[[0,3,3.529],[4,10,3.715],[11,20,4.18],[21,28,4.621],[29,32,5.375],[33,37,5.561],[38,43,6.037],[44,51,6.351]]],["Stell dir ein Lagerfeuer in der Dämmerung vor.",7.512,9.868,[[0,5,7.512],[6,9,7.779],[10,13,7.918],[14,24,8.069],[25,27,8.696],[28,31,8.789],[32,41,8.916],[42,46,9.381]]],["Du könntest warten, bis jemand vorbeikommt und es dir anzündet, und hoffen, dass er es gut mit dir meint.",10.379,16.742,[[0,2,10.379],[3,11,10.553],[12,19,10.96],[20,23,11.703],[24,30,11.923],[31,42,12.202],[43,46,12.98],[47,49,13.166],[50,53,13.27],[54,63,13.433],[64,67,14.396],[68,75,14.582],[76,80,15.267],[81,83,15.476],[84,86,15.569],[87,90,15.697],[91,94,15.975],[95,98,16.103],[99,105,16.277]]],["Oder du nimmst selbst ein Streichholz und schlägst deinen eigenen Funken.",17.345,21.455,[[0,4,17.345],[5,7,17.833],[8,14,18.007],[15,21,18.286],[22,25,18.657],[26,37,18.785],[38,41,19.656],[42,50,19.83],[51,57,20.225],[58,65,20.526],[66,73,20.886]]],["Genau darum geht es in „Firestarter“: dass du den Funken schlägst.",21.896,26.088,[[0,5,21.896],[6,11,22.338],[12,16,22.732],[17,19,22.941],[20,22,23.057],[23,37,23.15],[38,42,24.427],[43,45,24.66],[46,49,24.857],[50,56,25.031],[57,66,25.414]]],["Nicht eine Bank.",26.471,27.458,[[0,5,26.471],[6,10,26.773],[11,16,26.982]]],["Nicht ein Berater, der dir am Ende ein Produkt verkauft.",27.736,30.627,[[0,5,27.736],[6,9,28.026],[10,18,28.143],[19,22,28.746],[23,26,28.886],[27,29,29.002],[30,34,29.153],[35,38,29.431],[39,46,29.559],[47,56,29.942]]],["Und keine Sorge:",31.068,32.136,[[0,3,31.068],[4,9,31.277],[10,16,31.602]]],["Hier wird dir nichts übergestülpt und nichts verkauft.",32.461,35.143,[[0,4,32.461],[5,9,32.717],[10,13,32.868],[14,20,32.972],[21,33,33.262],[34,37,34.063],[38,44,34.237],[45,54,34.493]]],["Firestarter ist eine Bibliothek zum Selbstlernen, du arbeitest dich in deinem Tempo durch kurze Videos und eigene Reflexion.",35.84,43.224,[[0,11,35.84],[12,15,36.583],[16,20,36.757],[21,31,36.954],[32,35,37.616],[36,49,37.779],[50,52,38.765],[53,62,38.94],[63,67,39.427],[68,70,39.659],[71,77,39.764],[78,83,40.054],[84,89,40.565],[90,95,40.832],[96,102,41.192],[103,106,41.796],[107,113,42.005],[114,124,42.364]]],["Du brauchst kein Vorwissen und keine Mathematik außer den vier Grundrechenarten.",43.665,48.332,[[0,2,43.665],[3,11,43.827],[12,16,44.211],[17,26,44.431],[27,30,45.233],[31,36,45.442],[37,47,45.732],[48,53,46.498],[54,57,46.87],[58,62,47.032],[63,80,47.241]]],["Du siehst die drei Leitbegriffe, auf denen alles steht.",48.936,51.792,[[0,2,48.936],[3,9,49.122],[10,13,49.354],[14,18,49.459],[19,32,49.726],[33,36,50.573],[37,42,50.771],[43,48,51.049],[49,55,51.281]]],["Sie sagt ehrlich, was Firestarter nicht ist, denn ehrliche Grenzen schützen dich.",52.396,57.028,[[0,3,52.396],[4,8,52.57],[9,17,52.872],[18,21,53.301],[22,33,53.569],[34,39,54.288],[40,44,54.509],[45,49,55.287],[50,58,55.507],[59,66,55.902],[67,75,56.308],[76,81,56.703]]],["Und sie legt die ganze Reise durch die neun Bausteine vor dir aus.",57.539,61.022,[[0,3,57.539],[4,7,57.736],[8,12,57.853],[13,16,58.062],[17,22,58.178],[23,28,58.526],[29,34,58.897],[35,38,59.118],[39,43,59.246],[44,53,59.524],[54,57,60.047],[58,61,60.209],[62,66,60.349]]]]}