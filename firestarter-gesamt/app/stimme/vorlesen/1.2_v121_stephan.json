{"s":[["Der stille Motor: einfacher Zins vs.",0.0,2.752,[[0,3,0.0],[4,10,0.221],[11,17,0.476],[18,27,1.265],[28,32,1.753],[33,36,2.252]]],["Zinseszins",2.844,3.622,[[0,10,2.844]]],["Zwei Wörter, ein winziger Unterschied, riesige Wirkung über die Zeit.",4.063,7.964,[[0,4,4.063],[5,12,4.342],[13,16,4.702],[17,25,4.841],[26,38,5.259],[39,46,6.095],[47,54,6.618],[55,59,7.07],[60,63,7.279],[64,69,7.419]]],["Einfacher Zins",8.173,9.102,[[0,9,8.173],[10,14,8.707]]],["Du entnimmst den Zins jedes Jahr.",9.543,11.297,[[0,2,9.543],[3,12,9.729],[13,16,10.066],[17,21,10.252],[22,27,10.6],[28,33,10.89]]],["Das Kapital bleibt gleich.",11.471,13.015,[[0,3,11.471],[4,11,11.656],[12,18,12.132],[19,26,12.411]]],["Es wächst in einer geraden Linie.",13.096,15.197,[[0,2,13.096],[3,9,13.305],[10,12,13.677],[13,18,13.851],[19,26,14.083],[27,33,14.582]]],["Zinseszins",15.406,16.37,[[0,10,15.406]]],["Du lässt den Zins liegen.",16.811,18.32,[[0,2,16.811],[3,8,17.032],[9,12,17.241],[13,17,17.426],[18,25,17.833]]],["Zins wird auf Kapital und auf frühere Zinsen gezahlt.",18.494,21.478,[[0,4,18.494],[5,9,18.796],[10,13,18.936],[14,21,19.063],[22,25,19.679],[26,29,19.795],[30,37,19.922],[38,44,20.387],[45,53,20.782]]],["Es wächst gekrümmt (exponentiell).",21.652,24.23,[[0,2,21.652],[3,9,21.861],[10,18,22.175],[19,34,22.976]]],["Das Endkapital nach n Jahren ergibt sich aus Startkapital K₀ und Zinssatz i:",24.474,29.477,[[0,3,24.474],[4,14,24.717],[15,19,25.367],[20,21,25.6],[22,28,25.809],[29,35,26.157],[36,40,26.424],[41,44,26.587],[45,57,26.726],[58,60,27.48],[61,64,27.922],[65,73,28.107],[74,76,28.92]]],["Rechnen wir es mit 10.000 € und 7 % (historische Lehrannahme):",29.652,34.353,[[0,7,29.652],[8,11,30.07],[12,14,30.232],[15,18,30.371],[19,25,30.534],[26,27,31.196],[28,31,31.613],[32,33,31.799],[34,35,32.101],[36,48,32.751],[49,62,33.541]]],["Jahr 1 → 10.700 €.",34.528,36.745,[[0,4,34.528],[5,6,34.76],[7,8,35.166],[9,15,35.259],[16,18,36.304]]],["Jahr 2 → 11.449 €, nicht glatt 11.400 €.",37.05