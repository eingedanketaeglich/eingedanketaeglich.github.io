{"s":[["Wo warst du bisher abhängig?",0.0,1.776,[[0,2,0.0],[3,8,0.395],[9,11,0.65],[12,18,0.755],[19,28,1.115]]],["Abhängigkeit ist kein Grund für Scham, sie ist normal, solange das Wissen fehlt.",2.02,6.757,[[0,12,2.02],[13,16,2.752],[17,21,2.949],[22,27,3.251],[28,31,3.564],[32,38,3.738],[39,42,4.226],[43,46,4.435],[47,54,4.69],[55,62,5.317],[63,66,5.77],[67,73,5.956],[74,80,6.281]]],["Der erste Akt der Selbstbestimmung ist, sie zu sehen.",6.966,10.449,[[0,3,6.966],[4,9,7.152],[10,13,7.488],[14,17,7.814],[18,34,7.988],[35,39,8.847],[40,43,9.439],[44,46,9.694],[47,53,9.903]]],["Bei welcher Geldentscheidung habe ich zuletzt einfach vertraut, ohne es selbst zu verstehen?",10.658,15.569,[[0,3,10.658],[4,11,10.879],[12,28,11.238],[29,33,12.074],[34,37,12.341],[38,45,12.492],[46,53,12.957],[54,63,13.351],[64,68,13.99],[69,71,14.28],[72,78,14.408],[79,81,14.733],[82,92,14.895]]],["Wem habe ich sie überlassen, und welches Interesse hatte diese Person oder Stelle?",15.847,20.654,[[0,3,15.847],[4,8,16.196],[9,12,16.463],[13,16,16.579],[17,28,16.718],[29,32,17.473],[33,40,17.716],[41,50,18.134],[51,56,18.773],[57,62,19.017],[63,69,19.307],[70,74,19.853],[75,82,20.073]]],["Was müsste ich verstehen, um es beim nächsten Mal selbst zu entscheiden?",20.932,24.694,[[0,3,20.932],[4,10,21.188],[11,14,21.49],[15,25,21.606],[26,28,22.175],[29,31,22.326],[32,36,22.43],[37,45,22.662],[46,49,23.08],[50,56,23.382],[57,59,23.754],[60,72,23.893]]],["Erster praktischer Schritt, der Notgroschen",25.019,27.481,[[0,6,25.019],[7,18,25.437],[19,27,25.936],[28,31,26.343],[32,43,26.621]]],["Eine Reserve aus 3 bis 6 Netto-Monatsgehältern auf einem getrennten Konto fängt Notfälle ab, ohne dass du in Panik etwas verkaufen musst.",27.922,36.56,[[0,4,27.922],[5,12,28.212],[13,16,28.712],[17,18,28.979],[19,22,29.269],[23,24,29.466],[25,46,29.791],[47,50,31.173],[51,56,31.335],[57,67,31.556],[68,73,32.078],[74,79,32.926],[80,88,33.321],[89,92,33.89],[93,97,34.273],[98,102,34.609],[103,105,34.784],[106,108,34.911],[109,114,35.016],[115,120,35.376],[121,130,35.631],[131,137,36.107]]],["Er ist der erste der vier Geldtöpfe, mehr dazu in Baustein 2.",36.839,41.517,[[0,2,36.839],[3,6,37.047],[7,10,37.222],[11,16,37.477],[17,20,37.953],[21,25,38.127],[26,36,38.371],[37,41,39.462],[42,46,39.718],[47,49,40.194],[50,58,40.345],[59,61,40.89]]],["Kreuze an, was auf dich zutrifft.",41.842,43.723,[[0,6,41.842],[7,10,42.272],[11,14,42.504],[15,18,42.713],[19,23,42.841],[24,33,43.015]]],["Ein Spiegel, keine Beratung, nichts wird gespeichert.",44.106,47.973,[[0,3,44.106],[4,12,44.304],[13,18,45.082],[19,28,45.395],[29,35,46.289],[36,40,46.87],[41,53,47.125]]],["Drei Sätze zum Mitnehmen",48.356,50.225,[[0,4,48.356],[5,10,48.704],[11,14,49.284],[15,24,49.528]]],["Anlageberatung lebt von der Wissens-Lücke, das Problem ist das Modell, nicht die Person.",50.666,56.506,[[0,14,50.666],[15,19,51.815],[20,23,52.071],[24,27,52.222],[28,42,52.373],[43,46,53.476],[47,54,53.673],[55,58,54.137],[59,62,54.335],[63,70,54.579],[71,76,55.403],[77,80,55.67],[81,88,55.798]]],["Bildung will sich selbst überflüssig machen; Beratung hält die Abhängigkeit.",56.889,61.521,[[0,7,56.889],[8,12,57.411],[13,17,57.597],[18,24,57.783],[25,36,58.178],[37,44,58.781],[45,53,59.594],[54,58,60.256],[59,62,60.453],[63,76,60.604]]],["Der erste Akt der Selbstbestimmung ist, die eigene Abhängigkeit zu erkennen, der Notgroschen ist der erste praktische Schritt.",61.847,69.428,[[0,3,61.847],[4,9,62.137],[10,13,62.555],[14,17,62.799],[18,34,63.008],[35,39,63.901],[40,43,64.494],[44,50,64.691],[51,63,65.109],[64,66,65.782],[67,76,65.922],[77,80,66.514],[81,92,66.769],[93,96,67.524],[97,100,67.686],[101,106,67.907],[107,117,68.278],[118,126,68.812]]]]}