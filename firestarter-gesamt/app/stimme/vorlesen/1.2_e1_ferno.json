{"s":[["Der stille Saboteur, den niemand zeigt",0.0,2.519,[[0,3,0.0],[4,10,0.302],[11,20,0.65],[21,24,1.416],[25,32,1.718],[33,38,2.136]]],["Er nimmt dir nichts, er verhindert, dass etwas entsteht.",3.332,6.211,[[0,2,3.332],[3,8,3.506],[9,12,3.727],[13,20,3.855],[21,23,4.389],[24,35,4.551],[36,40,5.12],[41,46,5.317],[47,56,5.608]]],["Stell dir vor, jemand bremst dich aus, aber nicht in deiner Tasche, sondern in deiner Zukunft.",6.908,11.912,[[0,5,6.908],[6,9,7.175],[10,14,7.372],[15,21,7.697],[22,28,7.964],[29,33,8.29],[34,38,8.487],[39,43,9.102],[44,49,9.311],[50,52,9.52],[53,59,9.613],[60,67,9.88],[68,75,10.449],[76,78,10.774],[79,85,10.902],[86,94,11.215]]],["Du merkst es nicht, weil das Geld nie auf deinem Konto war.",12.725,15.662,[[0,2,12.725],[3,9,12.899],[10,12,13.235],[13,19,13.363],[20,24,13.572],[25,28,13.7],[29,33,13.886],[34,37,14.222],[38,41,14.501],[42,48,14.675],[49,54,14.931],[55,59,15.314]]],["Es hätte dort sein können.",15.987,17.218,[[0,2,15.987],[3,8,16.161],[9,13,16.37],[14,18,16.602],[19,26,16.823]]],["Es kam nur nie an.",17.601,18.692,[[0,2,17.601],[3,6,17.775],[7,10,17.972],[11,14,18.123],[15,18,18.356]]],["Wir nennen ihn den stillen Saboteur.",19.133,21.246,[[0,3,19.133],[4,10,19.354],[11,14,19.656],[15,18,19.795],[19,26,20.004],[27,36,20.422]]],["Und um ihn zu verstehen, musst du zuerst den stillen Motor kennen, an dem er sabotiert: den Zinseszins.",22.059,28.352,[[0,3,22.059],[4,6,22.361],[7,10,22.512],[11,13,22.64],[14,24,22.802],[25,30,23.394],[31,33,23.615],[34,40,23.777],[41,44,24.219],[45,52,24.381],[53,58,24.741],[59,66,25.101],[67,69,25.67],[70,73,25.856],[74,76,26.053],[77,87,26.157],[88,91,27.086],[92,103,27.353]]],["Stell ihn dir wie einen Marathonläufer vor, seine ganze Kraft steckt nicht in der Geschwindigkeit, sondern darin, dass er nicht aufhört.",28.955,36.375,[[0,5,28.955],[6,9,29.269],[10,13,29.397],[14,17,29.629],[18,23,29.896],[24,38,30.221],[39,43,31.069],[44,49,31.556],[50,55,31.812],[56,61,32.125],[62,68,32.439],[69,74,32.776],[75,77,32.985],[78,81,33.054],[82,98,33.182],[99,106,34.238],[107,113,34.552],[114,118,35.051],[119,121,35.283],[122,127,35.423],[128,136,35.783]]],["Keine Sorge vor der Mathematik:",37.187,38.836,[[0,5,37.187],[6,11,37.547],[12,15,37.861],[16,19,38.0],[20,31,38.105]]],["Wir rechnen alles gemeinsam und Schritt für Schritt.",39.115,41.982,[[0,3,39.115],[4,11,39.324],[12,17,39.707],[18,27,40.009],[28,31,40.67],[32,39,40.821],[40,43,41.309],[44,52,41.518]]],["Du brauchst nur die vier Grundrechenarten.",42.493,44.746,[[0,2,42.493],[3,11,42.632],[12,15,42.981],[16,19,43.166],[20,24,43.329],[25,42,43.666]]],["Wie werden aus 10.000 € rund 58.000 €, allein durch Nichtaufhören?",45.071,50.702,[[0,3,45.071],[4,10,45.268],[11,14,45.547],[15,21,45.744],[22,23,46.406],[24,28,46.731],[29,35,47.01],[36,38,48.264],[39,45,49.065],[46,51,49.448],[52,66,49.785]]],["Warum ist Stillstand oft teurer als ein zwischenzeitlicher Verlust?",51.306,55.137,[[0,5,51.306],[6,9,51.654],[10,20,51.805],[21,24,52.455],[25,31,52.78],[32,35,53.477],[36,39,53.697],[40,58,53.813],[59,67,54.591]]],["Warum steht diese Rechnung in keinem Hochglanz-Prospekt?",55.741,58.666,[[0,5,55.741],[6,11,56.112],[12,17,56.391],[18,26,56.693],[27,29,57.076],[30,36,57.227],[37,56,57.61]]],["Zwei Schritte weiter wartet der Zinseszins-Rechner.",59.781,62.915,[[0,4,59.781],[5,13,60.083],[14,20,60.419],[21,27,61.15],[28,31,61.626],[32,51,61.812]]],["Gib dort eine eigene Zahl ein, zum Beispiel den Betrag, den du im Monat übrig hättest, und schau, was die Kontinuität über die Jahre daraus macht.",63.612,71.065,[[0,3,63.612],[4,8,63.844],[9,13,64.099],[14,20,64.308],[21,25,64.657],[26,30,65.028],[31,34,65.283],[35,43,65.458],[44,47,65.829],[48,55,65.98],[56,59,66.41],[60,62,66.537],[63,65,66.677],[66,71,66.77],[72,77,67.141],[78,86,67.455],[87,90,68.209],[91,97,68.36],[98,101,68.639],[102,105,68.824],[106,117,68.952],[118,122,69.695],[123,126,69.869],[127,132,69.985],[133,139,70.299],[140,146,70.67]]],["Eine Lehrannahme, kein Versprechen.",71.762,73.852,[[0,4,71.762],[5,17,72.04],[18,22,73.004],[23,35,73.213]]],["Das Schlimmste, das passieren kann?",74.548,76.324,[[0,3,74.548],[4,15,74.768],[16,19,75.361],[20,29,75.546],[30,35,75.964]]],["Nichts.",76.928,77.45,[[0,7,76.928]]],["Kein Geld bewegt sich, keine Entscheidung fällt.",77.833,80.713,[[0,4,77.833],[5,9,78.135],[10,16,78.368],[17,22,78.727],[23,28,79.366],[29,41,79.691],[42,48,80.144]]]]}