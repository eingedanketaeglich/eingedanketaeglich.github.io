{"s":[["Was Firestarter ist, und was nicht",0.0,2.183,[[0,3,0.0],[4,15,0.302],[16,20,0.906],[21,24,1.509],[25,28,1.672],[29,34,1.881]]],["Die ehrlichste Art, Vertrauen aufzubauen: sagen, wo die Grenzen liegen.",3.135,7.767,[[0,3,3.135],[4,14,3.367],[15,19,3.901],[20,29,4.331],[30,41,4.934],[42,48,6.095],[49,51,6.548],[52,55,6.711],[56,63,6.827],[64,71,7.268]]],["Bildung, die dir das Prinzip erklärt, keine auf deinen Einzelfall zugeschnittene Empfehlung.",8.046,13.026,[[0,8,8.046],[9,12,8.591],[13,16,8.719],[17,20,8.847],[21,28,9.009],[29,37,9.474],[38,43,10.263],[44,47,10.623],[48,54,10.774],[55,65,11.064],[66,80,11.645],[81,92,12.26]]],["ehrliche Sprache:",13.723,14.884,[[0,8,13.723],[9,17,14.094]]],["Es fällt nie eine Zahl wie „so viel bekommst du“.",15.325,19.122,[[0,2,15.325],[3,8,15.569],[9,12,15.882],[13,17,16.196],[18,22,16.451],[23,26,16.8],[27,30,17.287],[31,35,17.879],[36,44,18.146],[45,49,18.622]]],["ein Fundament, aktives Handeln gehört nicht zu Firestarter.",19.934,24.044,[[0,3,19.934],[4,14,20.132],[15,22,21.13],[23,30,21.722],[31,37,22.256],[38,43,22.639],[44,46,22.895],[47,59,23.069]]],["die Schicht darunter, das konkrete Depot-Zusammenstellen kommt später.",24.648,28.665,[[0,3,24.648],[4,11,24.81],[12,21,25.101],[22,25,25.995],[26,34,26.215],[35,56,26.714],[57,62,27.806],[63,70,28.003]]],["steuerliches Grundwissen, damit du die richtigen Fragen stellen kannst.",29.176,32.705,[[0,12,29.176],[13,25,29.803],[26,31,30.534],[32,34,30.813],[35,38,30.917],[39,48,31.045],[49,55,31.451],[56,63,31.799],[64,71,32.125]]],["Und was ist es dann zusammengefasst?",33.657,35.712,[[0,3,33.657],[4,7,33.866],[8,11,34.087],[12,14,34.261],[15,19,34.388],[20,36,34.632]]],["Bildung.",36.316,36.977,[[0,8,36.316]]],["Ein Fundament.",37.221,38.231,[[0,3,37.221],[4,14,37.407]]],["Eine Selbstlern-Bibliothek, durch die du dich selbst bewegst, und auf der alles Weitere ruht.",38.475,43.827,[[0,4,38.475],[5,27,38.742],[28,33,40.205],[34,37,40.449],[38,40,40.577],[41,45,40.693],[46,52,40.844],[53,61,41.215],[62,65,42.19],[66,69,42.365],[70,73,42.492],[74,79,42.62],[80,87,42.91],[88,93,43.34]]],["Was ein Programm nicht verspricht, schützt dich, nicht den Anbieter.",44.269,47.903,[[0,3,44.269],[4,7,44.489],[8,16,44.628],[17,22,45.023],[23,34,45.209],[35,42,45.836],[43,48,46.219],[49,54,46.753],[55,58,47.02],[59,68,47.218]]],["Ein Programm ohne Rendite-Werbung hat nur ein Interesse: dass du es verstehst.",48.855,53.963,[[0,3,48.855],[4,12,49.04],[13,17,49.54],[18,33,49.795],[34,37,50.77],[38,41,51.06],[42,45,51.339],[46,56,51.583],[57,61,52.581],[62,64,52.814],[65,67,52.999],[68,78,53.115]]]]}