{"s":[["Warum ein Brief?",0.0,1.138,[[0,5,0.0],[6,9,0.406],[10,16,0.534]]],["Der Nordstern und das Versprechen",1.289,2.879,[[0,3,1.289],[4,13,1.486],[14,17,2.078],[18,21,2.171],[22,33,2.322]]],["Eine Richtung trägt weiter als eine Zahl.",3.39,5.538,[[0,4,3.39],[5,13,3.68],[14,19,4.063],[20,26,4.342],[27,30,4.679],[31,35,4.83],[36,41,5.05]]],["Ein Zahlenziel ist „500.000 € bis 60“; ein Nordstern ist „in Ruhe selbst entscheiden können“.",5.712,12.492,[[0,3,5.712],[4,14,5.863],[15,18,6.397],[19,27,6.722],[28,29,7.999],[30,33,8.394],[34,38,8.603],[39,42,9.543],[43,52,9.694],[53,56,10.24],[57,60,10.53],[61,65,10.925],[66,72,11.204],[73,84,11.587],[85,93,12.074]]],["Zahlen ändern sich, die Richtung trägt.",12.701,15.081,[[0,6,12.701],[7,13,13.073],[14,19,13.433],[20,23,13.886],[24,32,14.083],[33,39,14.512]]],["Und warum aufschreiben?",15.197,16.289,[[0,3,15.197],[4,9,15.348],[10,23,15.615]]],["Weil das geschriebene Wort stärker verpflichtet als ein Vorsatz im Kopf.",16.498,21.2,[[0,4,16.498],[5,8,16.648],[9,21,16.811],[22,26,17.275],[27,34,17.867],[35,47,18.436],[48,51,19.609],[52,55,19.818],[56,63,19.969],[64,66,20.515],[67,72,20.665]]],["Ein Brief mit Datum und Unterschrift ist ein Versprechen, dem du später wieder begegnest.",21.316,25.878,[[0,3,21.316],[4,9,21.467],[10,13,21.768],[14,19,21.908],[20,23,22.291],[24,36,22.477],[37,40,23.104],[41,44,23.243],[45,57,23.359],[58,61,24.241],[62,64,24.404],[65,71,24.497],[72,78,24.868],[79,89,25.101]]],["Brief und Zinseszins liegen auf derselben Zeitachse.",26.029,29.57,[[0,5,26.029],[6,9,26.505],[10,20,26.656],[21,27,28.061],[28,31,28.34],[32,41,28.479],[42,52,28.897]]],["Während dein Kapital im Stillen wächst, wächst auch dein Wofür.",29.814,33.669,[[0,7,29.814],[8,12,30.081],[13,20,30.255],[21,23,30.813],[24,31,30.94],[32,39,31.312],[40,46,32.032],[47,51,32.38],[52,56,32.601],[57,63,32.879]]]]}