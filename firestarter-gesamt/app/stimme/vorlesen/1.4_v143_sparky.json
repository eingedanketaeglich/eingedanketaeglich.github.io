{"s":[["Der Abstand ist dein Wachstumsraum",0.0,1.892,[[0,3,0.0],[4,11,0.232],[12,15,0.778],[16,20,0.964],[21,34,1.149]]],["Schau dir die drei Abstände zwischen Heute und Ziel an, genau sie sind dein persönlicher Wachstumsraum.",2.334,8.789,[[0,5,2.334],[6,9,2.972],[10,13,3.1],[14,18,3.216],[19,27,3.506],[28,36,4.098],[37,42,4.447],[43,46,4.981],[47,51,5.19],[52,55,5.503],[56,61,6.258],[62,65,6.687],[66,70,6.838],[71,75,7.024],[76,88,7.233],[89,103,7.837]]],["Der größte Abstand zeigt, wo deine nächsten Schritte am meisten bewirken.",9.23,13.351,[[0,3,9.23],[4,10,9.416],[11,18,9.822],[19,25,10.252],[26,28,10.948],[29,34,11.111],[35,43,11.366],[44,52,11.807],[53,55,12.167],[56,63,12.283],[64,73,12.666]]],["Keine feste Stufenzahl, dein Tempo bestimmst du selbst.",13.862,17.276,[[0,5,13.862],[6,11,14.234],[12,23,14.548],[24,28,15.569],[29,34,15.813],[35,44,16.161],[45,47,16.568],[48,55,16.696]]],["Deine drei Zielwerte sind die Rohform deiner Nordsterne.",17.88,21.154,[[0,5,17.88],[6,10,18.158],[11,20,18.449],[21,25,19.076],[26,29,19.238],[30,37,19.366],[38,44,19.97],[45,56,20.237]]],["Als Nächstes gießt du sie in einen Brief an dein zukünftiges Ich, mit einer konkreten, überprüfbaren Selbstverpflichtung.",21.757,28.596,[[0,3,21.757],[4,12,22.024],[13,18,22.57],[19,21,22.826],[22,25,22.942],[26,28,23.069],[29,34,23.197],[35,40,23.394],[41,43,23.743],[44,48,23.847],[49,60,24.033],[61,65,24.764],[66,69,25.484],[70,75,25.658],[76,86,25.879],[87,100,26.657],[101,121,27.504]]],["Drei Sätze zum Mitnehmen",29.71,31.08,[[0,4,29.71],[5,10,30.058],[11,14,30.441],[15,24,30.615]]],["Die drei Leitbegriffe sind eine Kette:",32.194,34.296,[[0,3,32.194],[4,8,32.368],[9,21,32.647],[22,26,33.344],[27,31,33.529],[32,38,33.738]]],["Wissen trägt Selbstbestimmung, beides trägt Aufbau.",34.737,37.964,[[0,6,34.737],[7,12,35.155],[13,30,35.457],[31,37,36.548],[38,43,37.001],[44,51,37.314]]],["Eine niedrige Zahl heute ist dein Startkapital, kein Urteil.",38.475,42.225,[[0,4,38.475],[5,13,38.731],[14,18,39.195],[19,24,39.509],[25,28,39.915],[29,33,40.066],[34,47,40.228],[48,52,41.204],[53,60,41.564]]],["Der Abstand zwischen Heute und Ziel ist dein Wachstumsraum.",42.922,46.486,[[0,3,42.922],[4,11,43.131],[12,20,43.642],[21,26,44.013],[27,30,44.373],[31,35,44.524],[36,39,45.0],[40,44,45.198],[45,59,45.383]]]]}