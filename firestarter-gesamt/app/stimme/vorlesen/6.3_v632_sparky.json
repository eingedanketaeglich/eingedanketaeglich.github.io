{"s":[["Der Realzins-Test, ruht dein Geld oder schrumpft es?",0.0,3.529,[[0,3,0.0],[4,18,0.255],[19,23,1.591],[24,28,1.846],[29,33,2.067],[34,38,2.485],[39,48,2.74],[49,52,3.181]]],["Die wichtigste Rechnung dieser Lektion ist eine simple Subtraktion.",4.342,8.255,[[0,3,4.342],[4,14,4.528],[15,23,5.074],[24,30,5.457],[31,38,5.712],[39,42,6.478],[43,47,6.745],[48,54,6.978],[55,67,7.326]]],["Ein Zins allein sagt wenig, was zählt, ist der Realzins.",8.858,12.666,[[0,3,8.858],[4,8,9.067],[9,15,9.358],[16,20,9.764],[21,27,10.031],[28,31,10.635],[32,38,10.879],[39,42,11.471],[43,46,11.668],[47,56,11.807]]],["Ist der Realzins positiv, wächst deine Kaufkraft wirklich.",13.363,16.892,[[0,3,13.363],[4,7,13.584],[8,16,13.711],[17,25,14.28],[26,32,15.197],[33,38,15.511],[39,48,15.755],[49,58,16.312]]],["Ist er negativ, der Zins also kleiner als die Inflation, dann ruht dein Geld nicht, sondern schrumpft still, auch wenn die Zahl auf dem Konto gleich bleibt.",17.589,26.54,[[0,3,17.589],[4,6,17.856],[7,15,17.972],[16,19,18.878],[20,24,19.075],[25,29,19.377],[30,37,19.609],[38,41,19.992],[42,45,20.178],[46,56,20.282],[57,61,21.385],[62,66,21.618],[67,71,21.861],[72,76,22.07],[77,83,22.337],[84,91,22.813],[92,101,23.15],[102,108,23.568],[109,113,24.323],[114,118,24.625],[119,122,24.776],[123,127,24.915],[128,131,25.194],[132,135,25.321],[136,141,25.472],[142,148,25.786],[149,156,26.064]]],["Hinschauen statt parken: bei jedem ruhenden Geld einmal „Zins − Inflation“ rechnen.",26.981,32.206,[[0,10,26.981],[11,16,27.562],[17,24,27.829],[25,28,28.781],[29,34,28.955],[35,43,29.303],[44,48,29.756],[49,55,30.29],[56,61,30.651],[62,63,30.987],[64,74,31.034],[75,83,31.626]]],["Konditionen vergleichen statt verharren:",32.717,34.842,[[0,11,32.717],[12,23,33.379],[24,29,33.89],[30,40,34.157]]],["Hausbank-Zins und aktiv gewählte Einlageform liegen oft weit auseinander.",35.225,39.648,[[0,13,35.225],[14,17,36.281],[18,23,36.467],[24,32,36.897],[33,44,37.315],[45,51,38.151],[52,55,38.441],[56,60,38.685],[61,73,38.929]]],["Die Aufgabe trennen:",40.252,41.401,[[0,3,40.252],[4,11,40.426],[12,20,40.879]]],["Notgroschen bleibt sicher; was lange frei ist, gehört auf den Vermögens-Weg (Baustein 4 ff.), nicht ins nächste Festgeld.",41.68,49.621,[[0,11,41.68],[12,18,42.319],[19,26,42.574],[27,30,43.352],[31,36,43.573],[37,41,43.816],[42,46,44.107],[47,53,44.467],[54,57,44.826],[58,61,44.954],[62,75,45.105],[76,85,45.999],[86,87,46.835],[88,93,47.16],[94,99,48.088],[100,103,48.39],[104,111,48.564],[112,121,48.878]]],["Ein Zins von null fühlt sich harmlos an.",50.004,52.21,[[0,3,50.004],[4,8,50.225],[9,12,50.538],[13,17,50.712],[18,23,50.991],[24,28,51.212],[29,36,51.386],[37,40,51.838]]],["Aber bei spürbarer Inflation ist „null Zins“ in Wahrheit ein Minus an Kaufkraft.",52.721,57.527,[[0,4,52.721],[5,8,53.011],[9,18,53.15],[19,28,53.708],[29,32,54.544],[33,38,54.834],[39,44,55.298],[45,47,55.67],[48,56,55.821],[57,60,56.204],[61,66,56.332],[67,69,56.657],[70,80,56.773]]],["Die einzige ehrliche Frage lautet:",58.038,59.838,[[0,3,58.038],[4,11,58.224],[12,20,58.665],[21,26,59.013],[27,34,59.362]]],["„wie viel Zins minus Inflation?“",59.989,62.09,[[0,4,59.989],[5,9,60.29],[10,14,60.499],[15,20,60.813],[21,32,61.115]]]]}