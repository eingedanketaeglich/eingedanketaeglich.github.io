{"s":[["Nimm diese Fragen mit",0.0,1.068,[[0,4,0.0],[5,10,0.279],[11,17,0.534],[18,21,0.894]]],["Drei Neugier-Fragen, und dein erster eigener Schritt.",1.219,4.331,[[0,4,1.219],[5,20,1.672],[21,24,2.635],[25,29,2.752],[30,36,3.03],[37,44,3.506],[45,53,3.843]]],["Warum gehört „der Funke“ dir, und nicht dem Berater?",4.609,7.918,[[0,5,4.609],[6,12,4.899],[13,17,5.283],[18,24,5.596],[25,29,6.06],[30,33,6.803],[34,39,6.954],[40,43,7.152],[44,52,7.279]]],["Warum schützt dich gerade das, was ein Programm nicht verspricht?",8.162,11.111,[[0,5,8.162],[6,13,8.406],[14,18,8.707],[19,25,8.905],[26,30,9.311],[31,34,9.52],[35,38,9.683],[39,47,9.799],[48,53,10.194],[54,65,10.426]]],["Warum sind „Finanzen und Börse kein Hobby“?",11.355,13.862,[[0,5,11.355],[6,10,11.633],[11,20,11.842],[21,24,12.481],[25,30,12.608],[31,35,13.026],[36,43,13.305]]],["So nutzt du eine Neugier-Frage",14.106,15.731,[[0,2,14.106],[3,8,14.268],[9,11,14.524],[12,16,14.663],[17,30,14.895]]],["Innehalten statt googeln:",15.801,17.357,[[0,10,15.801],[11,16,16.358],[17,25,16.683]]],["Du nimmst die Frage einfach mit in die Lektion.",17.531,20.491,[[0,2,17.531],[3,9,17.67],[10,13,17.926],[14,19,18.053],[20,27,18.436],[28,31,18.936],[32,34,19.4],[35,38,19.597],[39,47,19.76]]],["Beim Lesen mitdenken:",20.665,21.838,[[0,4,20.665],[5,10,20.863],[11,21,21.153]]],["Sobald etwas dazu auftaucht:",22.012,23.672,[[0,6,22.012],[7,12,22.384],[13,17,22.651],[18,28,22.929]]],["Aha, ein Stück der Antwort.",23.823,25.472,[[0,4,23.823],[5,8,24.311],[9,14,24.462],[15,18,24.694],[19,27,24.81]]],["Selbst beantworten:",25.681,26.714,[[0,6,25.681],[7,19,25.994]]],["Am Ende sagst du sie dir in eigenen Worten.",26.865,29.28,[[0,2,26.865],[3,7,27.063],[8,13,27.283],[14,16,27.585],[17,20,27.701],[21,24,27.84],[25,27,28.165],[28,35,28.386],[36,43,28.769]]],["Öffne dein Online-Banking und sieh dir eine einzige Zahl an:",29.489,32.821,[[0,5,29.489],[6,10,29.849],[11,25,30.139],[26,29,31.172],[30,34,31.277],[35,38,31.416],[39,43,31.521],[44,