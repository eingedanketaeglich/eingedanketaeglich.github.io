{"s":[["Wo stehst du, und wo willst du hin?",0.0,2.043,[[0,2,0.0],[3,9,0.221],[10,13,0.546],[14,17,0.964],[18,20,1.126],[21,27,1.254],[28,30,1.486],[31,35,1.602]]],["Bevor man eine Route plant, braucht man zwei Punkte: wo man ist und wo man hin will.",2.74,7.697,[[0,5,2.74],[6,9,3.111],[10,14,3.286],[15,20,3.495],[21,27,3.785],[28,35,4.296],[36,39,4.621],[40,44,4.76],[45,52,5.027],[53,55,6.002],[56,59,6.165],[60,63,6.351],[64,67,6.745],[68,70,6.885],[71,74,7.001],[75,78,7.163],[79,84,7.349]]],["Du arbeitest mit den drei Leitbegriffen aus Lektion 1.1.",8.301,12.202,[[0,2,8.301],[3,12,8.499],[13,16,8.998],[17,20,9.125],[21,25,9.253],[26,39,9.509],[40,43,10.333],[44,51,10.565],[52,56,11.041]]],["Finanzwissen, Selbstbestimmung, Vermögensaufbau.",12.585,16.173,[[0,13,12.585],[14,31,13.758],[32,48,14.965]]],["Diesmal ganz persönlich.",16.777,18.379,[[0,7,16.777],[8,12,17.346],[13,24,17.613]]],["Keine Prüfung, keine Note, die Grundlage für deinen Zukunftsbrief in 1.5.",18.82,23.917,[[0,5,18.82],[6,14,19.157],[15,20,19.772],[21,26,20.074],[27,30,20.84],[31,40,20.98],[41,44,21.641],[45,51,21.781],[52,65,22.036],[66,68,22.86],[69,73,22.977]]],["Wie hängen die drei Leitbegriffe zusammen?",24.521,26.634,[[0,3,24.521],[4,10,24.741],[11,14,25.032],[15,19,25.136],[20,32,25.403],[33,42,26.042]]],["Warum ist eine niedrige Zahl heute kein schlechtes Zeugnis?",27.145,30.372,[[0,5,27.145],[6,9,27.528],[10,14,27.69],[15,23,27.911],[24,28,28.387],[29,34,28.735],[35,39,29.025],[40,50,29.223],[51,59,29.699]]],["Was sagt der Abstand zwischen Heute und Ziel über dich aus?",30.883,34.216,[[0,3,30.883],[4,8,31.104],[9,12,31.371],[13,20,31.522],[21,29,32.056],[30,35,32.451],[36,39,32.857],[40,44,33.008],[45,49,33.322],[50,54,33.507],[55,59,33.681]]],["In Lektion 1.1 hast du die drei Leitbegriffe kennengelernt:",35.028,39.544,[[0,2,35.028],[3,10,35.214],[11,14,35.794],[15,19,37.211],[20,22,37.455],[23,26,37.582],[27,31,37.71],[32,44,38.024],[45,59,38.697]]],["Finanzwissen ist die Grundlage, Selbstbestimmung der Sinn und Vermögensaufbau das Ziel, zusammen bilden sie ein Dreieck mit R&F in der Mitte.",40.055,49.645,[[0,12,40.055],[13,16,40.949],[17,20,41.147],[21,31,41.263],[32,48,42.354],[49,52,43.248],[53,57,43.376],[58,61,43.852],[62,77,44.038],[78,81,45.466],[82,87,45.791],[88,96,46.383],[97,103,46.94],[104,107,47.242],[108,111,47.381],[112,119,47.521],[120,123,48.113],[124,127,48.322],[128,130,48.891],[131,134,48.995],[135,141,49.123]]],["Dort ging es allgemein um das Prinzip; hier setzt du dieselben drei Begriffe nun ganz persönlich für deinen eigenen Standort ein.",50.458,57.61,[[0,4,50.458],[5,9,50.806],[10,12,50.992],[13,22,51.132],[23,25,51.677],[26,29,51.782],[30,38,51.933],[39,43,52.954],[44,49,53.233],[50,52,53.5],[53,62,53.616],[63,67,54.046],[68,76,54.266],[77,80,54.789],[81,85,54.986],[86,96,55.253],[97,100,55.938],[101,107,56.112],[108,115,56.402],[116,124,56.762],[125,129,57.238]]],["„Eine niedrige Zahl heute ist dein Startkapital, kein Urteil.“",58.121,62.416,[[0,5,58.121],[6,14,58.539],[15,19,59.015],[20,25,59.305],[26,29,59.723],[30,34,59.92],[35,48,60.094],[49,53,61.325],[54,62,61.627]]]]}