{"s":[["Wo warst du bisher abhängig?",0.0,1.672,[[0,2,0.0],[3,8,0.267],[9,11,0.522],[12,18,0.65],[19,28,1.033]]],["Abhängigkeit ist kein Grund für Scham, sie ist normal, solange das Wissen fehlt.",2.786,8.057,[[0,12,2.786],[13,16,3.506],[17,21,3.669],[22,27,3.982],[28,31,4.249],[32,38,4.412],[39,42,5.236],[43,46,5.433],[47,54,5.619],[55,62,6.594],[63,66,6.989],[67,73,7.187],[74,80,7.488]]],["Der erste Akt der Selbstbestimmung ist, sie zu sehen.",9.009,12.063,[[0,3,9.009],[4,9,9.195],[10,13,9.578],[14,17,9.834],[18,34,9.985],[35,39,10.867],[40,43,11.122],[44,46,11.401],[47,53,11.598]]],["Bei welcher Geldentscheidung habe ich zuletzt einfach vertraut, ohne es selbst zu verstehen?",13.015,17.809,[[0,3,13.015],[4,11,13.189],[12,28,13.549],[29,33,14.338],[34,37,14.582],[38,45,14.71],[46,53,15.105],[54,63,15.418],[64,68,16.242],[69,71,16.544],[72,78,16.648],[79,81,16.962],[82,92,17.101]]],["Wem habe ich sie überlassen, und welches Interesse hatte diese Person oder Stelle?",18.506,23.266,[[0,3,18.506],[4,8,18.808],[9,12,19.063],[13,16,19.191],[17,28,19.33],[29,32,20.422],[33,40,20.584],[41,50,20.933],[51,56,21.443],[57,62,21.722],[63,69,22.012],[70,74,22.453],[75,82,22.662]]],["Was müsste ich verstehen, um es beim nächsten Mal selbst zu entscheiden?",23.963,27.945,[[0,3,23.963],[4,10,24.207],[11,14,24.543],[15,25,24.683],[26,28,25.646],[29,31,25.809],[32,36,25.936],[37,45,26.122],[46,49,26.517],[50,56,26.749],[57,59,27.086],[60,72,27.237]]],["Erster praktischer Schritt, der Notgroschen",29.059,31.684,[[0,6,29.059],[7,18,29.454],[19,27,29.988],[28,31,30.673],[32,43,30.975]]],["Eine Reserve aus 3 bis 6 Netto-Monatsgehältern auf einem getrennten Konto fängt Notfälle ab, ohne dass du in Panik etwas verkaufen musst.",32.636,41.401,[[0,4,32.636],[5,12,33.065],[13,16,33.588],[17,18,33.843],[19,22,34.11],[23,24,34.319],[25,46,34.644],[47,50,36.165],[51,56,36.386],[57,67,36.595],[68,73,37.117],[74,79,37.547],[80,88,37.825],[89,92,38.371],[93,97,38.917],[98,102,39.207],[103,105,39.381],[106,108,39.52],[109,114,39.683],[115,120,40.089],[121,130,40.38],[131,137,40.914]]],["Er ist der erste der vier Geldtöpfe, mehr dazu in Baustein 2.",42.098,46.126,[[0,2,42.098],[3,6,42.318],[7,10,42.469],[11,16,42.632],[17,20,43.038],[21,25,43.154],[26,36,43.375],[37,41,44.362],[42,46,44.582],[47,49,45.012],[50,58,45.14],[59,61,45.639]]],["Kreuze an, was auf dich zutrifft.",46.37,48.53,[[0,6,46.37],[7,10,46.8],[11,14,47.148],[15,18,47.427],[19,23,47.636],[24,33,47.88]]],["Ein Spiegel, keine Beratung, nichts wird gespeichert.",49.134,52.57,[[0,3,49.134],[4,12,49.343],[13,18,50.121],[19,28,50.457],[29,35,51.282],[36,40,51.618],[41,53,51.827]]],["Drei Sätze zum Mitnehmen",53.267,54.765,[[0,4,53.267],[5,10,53.662],[11,14,54.045],[15,24,54.254]]],["Anlageberatung lebt von der Wissens-Lücke, das Problem ist das Modell, nicht die Person.",55.577,60.906,[[0,14,55.577],[15,19,56.564],[20,23,56.843],[24,27,56.994],[28,42,57.133],[43,46,58.282],[47,54,58.515],[55,58,58.991],[59,62,59.13],[63,70,59.339],[71,76,59.966],[77,80,60.21],[81,88,60.326]]],["Bildung will sich selbst überflüssig machen; Beratung hält die Abhängigkeit.",61.858,65.887,[[0,7,61.858],[8,12,62.346],[13,17,62.52],[18,24,62.671],[25,36,63.008],[37,44,63.553],[45,53,64.157],[54,58,64.726],[59,62,64.912],[63,76,65.039]]],["Der erste Akt der Selbstbestimmung ist, die eigene Abhängigkeit zu erkennen, der Notgroschen ist der erste praktische Schritt.",66.7,74.118,[[0,3,66.7],[4,9,66.897],[10,13,67.268],[14,17,67.501],[18,34,67.698],[35,39,68.511],[40,43,69.068],[44,50,69.265],[51,63,69.718],[64,66,70.368],[67,76,70.508],[77,80,71.39],[81,92,71.553],[93,96,72.191],[97,100,72.33],[101,106,72.586],[107,117,73.015],[118,126,73.526]]]]}