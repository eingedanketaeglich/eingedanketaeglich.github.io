{"s":[["Verzinste Einlagen.",0.0,1.231,[[0,9,0.0],[10,19,0.615]]],["Geld, das ruht, soll nicht schlafen",1.254,3.135,[[0,5,1.254],[6,9,1.474],[10,15,1.66],[16,20,2.229],[21,26,2.415],[27,35,2.624]]],["Dein Notgroschen liegt „sicher“, aber verdient er auch etwas, oder verliert er still an Kaufkraft?",3.46,9.009,[[0,4,3.46],[5,16,3.657],[17,22,4.214],[23,32,4.528],[33,37,5.457],[38,46,5.7],[47,49,6.026],[50,54,6.118],[55,61,6.316],[62,66,7.001],[67,75,7.187],[76,78,7.535],[79,84,7.709],[85,87,8.081],[88,98,8.231]]],["Deine Konten haben jetzt Aufgaben.",9.218,10.809,[[0,5,9.218],[6,12,9.462],[13,18,9.776],[19,24,9.938],[25,34,10.17]]],["Eines trägt den Notgroschen.",11.018,12.516,[[0,5,11.018],[6,11,11.343],[12,15,11.598],[16,28,11.749]]],["Drei Etappen: die drei Wege, ruhendes Geld zu verzinsen (Tagesgeld, Festgeld, Geldmarkt-ETF) samt Lockzins-Falle, dann der Realzins-Test (Zins minus Inflation), zuletzt die Grenze zwischen „sicher parken“ und „investieren“.",12.725,29.165,[[0,4,12.725],[5,13,13.085],[14,17,13.851],[18,22,14.002],[23,28,14.269],[29,37,14.884],[38,42,15.418],[43,45,15.778],[46,55,15.941],[56,67,16.777],[68,77,17.578],[78,92,18.1],[93,97,19.679],[98,113,20.004],[114,118,21.374],[119,122,21.572],[123,136,21.711],[137,142,22.942],[143,148,23.766],[149,160,24.161],[161,168,25.182],[169,172,25.542],[173,179,25.658],[180,188,26.018],[189,196,26.517],[197,204,27.121],[205,208,27.632],[209,223,28.05]]],["Sieh den Zins deines Tagesgeld-/Sparkontos nach, eine einzige Zahl.",29.339,33.994,[[0,4,29.339],[5,8,29.628],[9,13,29.872],[14,20,30.232],[21,42,30.546],[43,48,32.171],[49,53,32.705],[54,61,33.007],[62,67,33.541]]],["Ruf dir die letzte Inflationszahl in Erinnerung, die du gehört hast.",34.203,37.477,[[0,3,34.203],[4,7,34.47],[8,11,34.574],[12,18,34.714],[19,33,35.062],[34,36,35.944],[37,48,36.06],[49,52,36.502],[53,55,36.618],[56,62,36.745],[63,68,37.07]]],["Größer oder kleiner?",37.651,38.951,[[0,6,37.651],[7,11,38.185],[12,20,38.44]]],["Nur vergleichen, nicht handeln.",39.195,41.053,[[0,3,39.195],[4,16,39.52],[17,22,40.252],[23,31,40.542]]],["In Lektion 3.1 hast du den stillen Gegner deiner Kaufkraft kennengelernt: die Inflation.",41.262,47.229,[[0,2,41.262],[3,10,41.401],[11,14,41.749],[15,19,42.446],[20,22,42.62],[23,26,42.724],[27,34,42.91],[35,41,43.305],[42,48,43.781],[49,58,44.037],[59,73,44.664],[74,77,45.848],[78,88,46.103]]],["Dieselbe Menge Geld kauft mit der Zeit weniger, und liegt die Inflation über deinem Sparzins, verlierst du real an Wert, auch wenn die Zahl auf dem Konto gleich bleibt.",47.404,56.993,[[0,8,47.404],[9,14,47.88],[15,19,48.135],[20,25,48.53],[26,29,48.774],[30,33,48.901],[34,38,49.017],[39,47,49.25],[48,51,49.83],[52,57,50.236],[58,61,50.469],[62,71,50.608],[72,76,51.223],[77,83,51.374],[84,93,51.653],[94,103,53.0],[104,106,53.371],[107,111,53.58],[112,114,54.021],[115,120,54.137],[121,125,54.776],[126,130,54.927],[131,134,55.066],[135,139,55.194],[140,143,55.484],[144,147,55.612],[148,153,55.763],[154,160,56.111],[161,168,56.448]]],["Genau daraus stammt der Merksatz Nominalzins minus Inflation gleich Realzins.",57.144,63.043,[[0,5,57.144],[6,12,57.435],[13,19,57.865],[20,23,58.143],[24,32,58.271],[33,44,58.968],[45,50,60.372],[51,60,60.767],[61,67,61.452],[68,77,62.033]]],["„Die ehrliche Frage an jedes geparkte Geld ist nicht ‚wie viel Zins?', sondern ‚wie viel Zins minus Inflation?'“",63.159,69.985,[[0,4,63.159],[5,13,63.461],[14,19,63.797],[20,22,64.192],[23,28,64.343],[29,37,64.61],[38,42,65.063],[43,46,65.341],[47,52,65.469],[53,57,65.852],[58,62,66.166],[63,70,66.444],[71,78,67.315],[79,83,67.698],[84,88,67.896],[89,93,68.163],[94,99,68.557],[100,112,69.022]]]]}