{"s":[["Fonds und ETF, der gemeinsame Korb",0.0,2.276,[[0,5,0.0],[6,9,0.569],[10,14,0.72],[15,18,1.37],[19,29,1.486],[30,34,1.997]]],["Fünfhundert Aktien einzeln kaufen?",2.392,4.447,[[0,11,2.392],[12,18,3.019],[19,26,3.483],[27,34,3.889]]],["Ein Albtraum.",4.725,5.851,[[0,3,4.725],[4,13,4.992]]],["Eleganter: alles in einen Korb, mit einer Order gekauft.",6.026,9.485,[[0,10,6.026],[11,16,6.885],[17,19,7.245],[20,25,7.349],[26,31,7.593],[32,35,8.069],[36,41,8.301],[42,47,8.557],[48,56,8.858]]],["Dieser Korb heißt Fonds; seine günstigste Bauform heißt ETF.",9.694,13.99,[[0,6,9.694],[7,11,9.996],[12,17,10.286],[18,24,10.635],[25,30,11.424],[31,41,11.656],[42,49,12.167],[50,55,12.725],[56,60,13.131]]],["Die wichtigste Gabelung, zwei Arten, den Korb zu füllen:",14.199,17.044,[[0,3,14.199],[4,14,14.362],[15,24,14.861],[25,29,15.43],[30,36,15.72],[37,40,16.01],[41,45,16.185],[46,48,16.452],[49,56,16.579]]],["Wer füllt den Korb? ein Manager-Team wählt aus",17.218,20.144,[[0,3,17.218],[4,9,17.496],[10,13,17.752],[14,19,17.938],[20,23,18.623],[24,36,18.762],[37,42,19.54],[43,46,19.911]]],["Laufende Kosten / Jahr: oft rund 1,5 bis 2 %",20.26,24.393,[[0,8,20.26],[9,15,20.712],[16,17,21.339],[18,23,21.572],[24,27,22.291],[28,32,22.558],[33,36,22.837],[37,40,23.58],[41,42,23.789],[43,44,24.114]]],["Wer füllt den Korb? ein Index-Rezept",24.904,27.075,[[0,3,24.904],[4,9,25.089],[10,13,25.31],[14,19,25.461],[20,23,26.018],[24,36,26.216]]],["Laufende Kosten / Jahr: oft nur 0,05 bis 0,50 %",27.4,32.148,[[0,8,27.4],[9,15,27.864],[16,17,28.433],[18,23,28.596],[24,27,29.037],[28,31,29.292],[32,36,29.466],[37,40,30.511],[41,45,30.836],[46,47,31.87]]],["Das Geld im Fonds ist Sondervermögen, rechtlich getrennt vom Anbieter, es gehört weiter dir.",32.589,37.512,[[0,3,32.589],[4,8,32.822],[9,11,33.065],[12,17,33.193],[18,21,33.529],[22,37,33.727],[38,47,34.54],[48,56,34.957],[57,60,35.375],[61,70,35.561],[71,73,36.246],[74,80,36.455],[81,87,36.722],[88,92,37.094]]],["Aber ehrlich:",37.895,38.