{"s":[["Der Realzins-Test, ruht dein Geld oder schrumpft es?",0.0,4.18,[[0,3,0.0],[4,18,0.395],[19,23,1.985],[24,28,2.345],[29,33,2.566],[34,38,3.1],[39,48,3.46],[49,52,3.878]]],["Die wichtigste Rechnung dieser Lektion ist eine simple Subtraktion.",5.294,8.858,[[0,3,5.294],[4,14,5.468],[15,23,6.037],[24,30,6.42],[31,38,6.664],[39,42,7.21],[43,47,7.372],[48,54,7.593],[55,67,7.964]]],["Ein Zins allein sagt wenig, was zählt, ist der Realzins.",9.462,13.514,[[0,3,9.462],[4,8,9.729],[9,15,10.019],[16,20,10.495],[21,27,10.832],[28,31,11.285],[32,38,11.587],[39,42,12.318],[43,46,12.527],[47,56,12.678]]],["Ist der Realzins positiv, wächst deine Kaufkraft wirklich.",14.327,18.066,[[0,3,14.327],[4,7,14.559],[8,16,14.721],[17,25,15.372],[26,32,16.37],[33,38,16.672],[39,48,16.904],[49,58,17.485]]],["Ist er negativ, der Zins also kleiner als die Inflation, dann ruht dein Geld nicht, sondern schrumpft still, auch wenn die Zahl auf dem Konto gleich bleibt.",18.878,27.47,[[0,3,18.878],[4,6,19.157],[7,15,19.273],[16,19,20.202],[20,24,20.364],[25,29,20.666],[30,37,20.922],[38,41,21.282],[42,45,21.456],[46,56,21.572],[57,61,22.721],[62,66,22.965],[67,71,23.244],[72,76,23.418],[77,83,23.673],[84,91,23.905],[92,101,24.172],[102,108,24.602],[109,113,25.345],[114,118,25.624],[119,122,25.775],[123,127,25.902],[128,131,26.169],[132,135,26.297],[136,141,26.46],[142,148,26.773],[149,156,27.04]]],["Hinschauen statt parken: bei jedem ruhenden Geld einmal „Zins − Inflation“ rechnen.",28.166,33.786,[[0,10,28.166],[11,16,28.816],[17,24,29.107],[25,28,29.977],[29,34,30.175],[35,43,30.5],[44,48,30.918],[49,55,31.22],[56,61,31.673],[62,63,32.323],[64,74,32.381],[75,83,33.263]]],["Konditionen vergleichen statt verharren:",34.483,36.793,[[0,11,34.483],[12,23,35.26],[24,29,35.829],[30,40,36.12]]],["Hausbank-Zins und aktiv gewählte Einlageform liegen oft weit auseinander.",37.176,41.774,[[0,13,37.176],[14,17,38.14],[18,23,38.36],[24,32,38.767],[33,44,39.173],[45,51,40.148],[52,55,40.497],[56,60,40.764],[61,73,41.019]]],["Die Aufgabe trennen:",42.377,43.515,[[0,3,42.377],[4,11,42.563],[12,20,43.027]]],["Notgroschen bleibt sicher; was lange frei ist, gehört auf den Vermögens-Weg (Baustein 4 ff.), nicht ins nächste Festgeld.",43.794,51.677,[[0,11,43.794],[12,18,44.456],[19,26,44.734],[27,30,45.431],[31,36,45.663],[37,41,45.93],[42,46,46.22],[47,53,46.708],[54,57,47.045],[58,61,47.184],[62,75,47.323],[76,85,48.287],[86,87,48.972],[88,93,49.657],[94,99,50.063],[100,103,50.412],[104,111,50.621],[112,121,50.957]]],["Ein Zins von null fühlt sich harmlos an.",52.629,54.928,[[0,3,52.629],[4,8,52.885],[9,12,53.21],[13,17,53.465],[18,23,53.767],[24,28,53.999],[29,36,54.197],[37,40,54.626]]],["Aber bei spürbarer Inflation ist „null Zins“ in Wahrheit ein Minus an Kaufkraft.",55.439,60.663,[[0,4,55.439],[5,8,55.717],[9,18,55.868],[19,28,56.472],[29,32,57.064],[33,38,57.308],[39,44,57.947],[45,47,58.632],[48,56,58.806],[57,60,59.247],[61,66,59.421],[67,69,59.804],[70,80,59.943]]],["Die einzige ehrliche Frage lautet:",61.36,63.334,[[0,3,61.36],[4,11,61.546],[12,20,62.022],[21,26,62.44],[27,34,62.8]]],["„wie viel Zins minus Inflation?“",63.577,66.039,[[0,4,63.577],[5,9,63.961],[10,14,64.228],[15,20,64.622],[21,32,65.005]]]]}