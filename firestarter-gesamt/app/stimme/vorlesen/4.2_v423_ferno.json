{"s":[["Fonds und ETF, der gemeinsame Korb",0.0,2.368,[[0,5,0.0],[6,9,0.43],[10,14,0.604],[15,18,1.393],[19,29,1.544],[30,34,2.159]]],["Fünfhundert Aktien einzeln kaufen?",2.45,4.272,[[0,11,2.45],[12,18,3.007],[19,26,3.402],[27,34,3.773]]],["Ein Albtraum.",4.598,5.468,[[0,3,4.598],[4,13,4.83]]],["Eleganter: alles in einen Korb, mit einer Order gekauft.",6.072,9.996,[[0,10,6.072],[11,16,7.349],[17,19,7.709],[20,25,7.895],[26,31,8.197],[32,35,8.626],[36,41,8.835],[42,47,9.114],[48,56,9.416]]],["Dieser Korb heißt Fonds; seine günstigste Bauform heißt ETF.",10.321,14.501,[[0,6,10.321],[7,11,10.658],[12,17,10.971],[18,24,11.343],[25,30,12.225],[31,41,12.539],[42,49,13.108],[50,55,13.595],[56,60,13.862]]],["Die wichtigste Gabelung, zwei Arten, den Korb zu füllen:",14.779,18.053,[[0,3,14.779],[4,14,14.954],[15,24,15.453],[25,29,16.265],[30,36,16.613],[37,40,16.95],[41,45,17.147],[46,48,17.426],[49,56,17.6]]],["Wer füllt den Korb? ein Manager-Team wählt aus",18.378,21.269,[[0,3,18.378],[4,9,18.703],[10,13,18.935],[14,19,19.11],[20,23,20.143],[24,36,20.329],[37,42,20.932],[43,46,21.164]]],["Laufende Kosten / Jahr: oft rund 1,5 bis 2 %",21.35,25.391,[[0,8,21.35],[9,15,21.757],[16,17,22.302],[18,23,22.546],[24,27,23.37],[28,32,23.591],[33,36,23.916],[37,40,24.636],[41,42,24.833],[43,44,25.147]]],["Wer füllt den Korb? ein Index-Rezept",26.134,29.094,[[0,3,26.134],[4,9,26.435],[10,13,26.668],[14,19,26.853],[20,23,27.991],[24,36,28.223]]],["Laufende Kosten / Jahr: oft nur 0,05 bis 0,50 %",29.721,34.504,[[0,8,29.721],[9,15,30.174],[16,17,30.673],[18,23,30.859],[24,27,31.625],[28,31,31.869],[32,36,32.055],[37,40,33.065],[41,45,33.285],[46,47,34.284]]],["Das Geld im Fonds ist Sondervermögen, rechtlich getrennt vom Anbieter, es gehört weiter dir.",35.247,40.588,[[0,3,35.247],[4,8,35.503],[9,11,35.747],[12,17,35.898],[18,21,36.42],[22,37,36.641],[38,47,37.605],[48,56,37.999],[57,60,38.371],[61,70,38.545],[71,73,39.335],[74,80,39.52],[81,87,39.857],[88,92,40.194]]],["Aber ehrlich:",41.