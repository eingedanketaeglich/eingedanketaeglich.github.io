{"s":[["Warum ein Brief?",0.0,1.103,[[0,5,0.0],[6,9,0.441],[10,16,0.58]]],["Der Nordstern und das Versprechen",1.8,3.796,[[0,3,1.8],[4,13,2.09],[14,17,2.844],[18,21,3.03],[22,33,3.216]]],["Eine Richtung trägt weiter als eine Zahl.",5.097,7.442,[[0,4,5.097],[5,13,5.399],[14,19,5.759],[20,26,6.026],[27,30,6.409],[31,35,6.618],[36,41,6.896]]],["Ein Zahlenziel ist „500.000 € bis 60“; ein Nordstern ist „in Ruhe selbst entscheiden können“.",7.953,15.36,[[0,3,7.953],[4,14,8.162],[15,18,8.847],[19,27,9.172],[28,29,10.391],[30,33,10.751],[34,38,10.925],[39,42,12.109],[43,52,12.283],[53,56,12.934],[57,60,13.282],[61,65,13.851],[66,72,14.176],[73,84,14.512],[85,93,14.954]]],["Zahlen ändern sich, die Richtung trägt.",15.685,17.717,[[0,6,15.685],[7,13,16.149],[14,19,16.486],[20,23,16.742],[24,32,16.893],[33,39,17.252]]],["Und warum aufschreiben?",18.414,19.714,[[0,3,18.414],[4,9,18.634],[10,23,18.959]]],["Weil das geschriebene Wort stärker verpflichtet als ein Vorsatz im Kopf.",20.039,23.812,[[0,4,20.039],[5,8,20.248],[9,21,20.411],[22,26,20.956],[27,34,21.223],[35,47,21.641],[48,51,22.257],[52,55,22.489],[56,63,22.686],[64,66,23.243],[67,72,23.394]]],["Ein Brief mit Datum und Unterschrift ist ein Versprechen, dem du später wieder begegnest.",24.509,29.408,[[0,3,24.509],[4,9,24.788],[10,13,25.124],[14,19,25.298],[20,23,25.763],[24,36,25.949],[37,40,26.819],[41,44,27.063],[45,57,27.214],[58,61,27.795],[62,64,27.969],[65,71,28.108],[72,78,28.491],[79,89,28.7]]],["Brief und Zinseszins liegen auf derselben Zeitachse.",30.012,32.926,[[0,5,30.012],[6,9,30.395],[10,20,30.535],[21,27,31.289],[28,31,31.556],[32,41,31.719],[42,52,32.183]]],["Während dein Kapital im Stillen wächst, wächst auch dein Wofür.",33.53,37.385,[[0,7,33.53],[8,12,33.902],[13,20,34.099],[21,23,34.633],[24,31,34.749],[32,39,35.144],[40,46,35.91],[47,51,36.235],[52,56,36.398],[57,63,36.63]]]]}