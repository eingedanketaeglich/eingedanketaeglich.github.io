{"s":[["Die Grenze.",0.0,1.231,[[0,3,0.0],[4,11,0.43]]],["Notgroschen ist Sicherheit, nicht Renditequelle",1.614,4.865,[[0,11,1.614],[12,15,2.438],[16,27,2.717],[28,33,3.669],[34,47,3.971]]],["Verzinste Einlagen haben eine klare Aufgabe:",5.468,8.545,[[0,9,5.468],[10,18,6.153],[19,24,6.78],[25,29,7.082],[30,35,7.291],[36,44,7.686]]],["Sicherheit und Verfügbarkeit, vor allem für den Notgroschen.",8.824,12.643,[[0,10,8.824],[11,14,9.462],[15,29,9.625],[30,33,10.797],[34,39,11.006],[40,43,11.366],[44,47,11.552],[48,60,11.749]]],["Sie sind nicht der Ort, an dem Vermögen wächst.",12.968,15.673,[[0,3,12.968],[4,8,13.189],[9,14,13.433],[15,18,13.7],[19,23,13.909],[24,26,14.211],[27,30,14.35],[31,39,14.582],[40,47,15.128]]],["Wer mit Zins-Hopping (ständig dem nächsten Aktionszins hinterher) Vermögen aufbauen will, verwechselt die Aufgaben.",15.999,23.371,[[0,3,15.999],[4,7,16.219],[8,20,16.393],[21,29,17.322],[30,33,18.019],[34,42,18.228],[43,54,18.623],[55,65,19.435],[66,74,20.48],[75,83,21.014],[84,89,21.513],[90,101,21.839],[102,105,22.407],[106,115,22.558]]],["Die klare Linie:",23.696,24.845,[[0,3,23.696],[4,9,23.882],[10,16,24.265]]],["Der Notgroschen bleibt sicher und verfügbar, niemals in Schwankung.",24.996,29.71,[[0,3,24.996],[4,15,25.252],[16,22,25.983],[23,29,26.366],[30,33,26.866],[34,44,27.109],[45,52,28.212],[53,55,28.781],[56,67,28.897]]],["Was darüber hinaus lange frei ist, gehört in den Vermögensaufbau (Baustein 4 ff.), nicht ins nächste Festgeld.",30.035,38.058,[[0,3,30.035],[4,11,30.302],[12,18,30.639],[19,24,31.068],[25,29,31.324],[30,34,31.649],[35,41,32.032],[42,44,32.439],[45,48,32.567],[49,64,32.81],[65,74,34.18],[75,76,35.051],[77,82,35.841],[83,88,36.421],[89,92,36.735],[93,100,36.932],[101,110,37.315]]],["Verzinste Einlagen und Vermögensaufbau sind zwei verschiedene Werkzeuge.",38.337,43.016,[[0,9,38.337],[10,18,38.964],[19,22,39.602],[23,38,39.788],[39,43,40.891],[44,48,41.146],[49,61,41.529],[62,72,42.122]]],["Das eine hält den Notgroschen sicher, das andere lässt Vermögen über Jahrzehnte wachsen.",43.259,48.925,[[0,3,43.259],[4,8,43.515],[9,13,43.956],[14,17,44.2],[18,29,44.374],[30,37,45.024],[38,41,45.686],[42,48,45.941],[49,54,46.51],[55,63,46.812],[64,68,47.346],[69,79,47.59],[80,88,48.205]]],["Sie zu verwechseln kostet auf beiden Seiten, entweder Sicherheit oder Wachstum.",49.308,54.614,[[0,3,49.308],[4,6,49.575],[7,18,49.761],[19,25,50.458],[26,29,50.934],[30,36,51.108],[37,44,51.514],[45,53,52.234],[54,64,52.849],[65,69,53.558],[70,79,53.871]]],["Drei Sätze zum Mitnehmen",54.939,56.634,[[0,4,54.939],[5,10,55.276],[11,14,55.74],[15,24,55.973]]],["Tagesgeld, Festgeld, Geldmarkt-ETF verzinsen ruhendes Geld; der Tausch ist immer Verfügbarkeit gegen Zins.",57.017,65.783,[[0,10,57.017],[11,20,58.004],[21,34,59.084],[35,44,60.535],[45,53,61.278],[54,59,61.882],[60,63,62.625],[64,70,62.822],[71,74,63.217],[75,80,63.449],[81,94,63.879],[95,100,64.866],[101,106,65.214]]],["Vorsicht vor der Lockzins-Falle.",66.108,68.477,[[0,8,66.108],[9,12,66.782],[13,16,66.967],[17,32,67.176]]],["Realzins = Einlagenzins − Inflation:",68.918,72.865,[[0,8,68.918],[9,10,69.847],[11,23,70.427],[24,25,71.588],[26,36,71.82]]],["Ist er negativ, schrumpft dein Geld still, auch wenn die Zahl gleich bleibt.",73.19,77.556,[[0,3,73.19],[4,6,73.434],[7,15,73.527],[16,25,74.212],[26,30,74.618],[31,35,74.851],[36,42,75.152],[43,47,75.64],[48,52,75.849],[53,56,76.023],[57,61,76.197],[62,68,76.58],[69,76,76.94]]],["Verzinste Einlagen sind Sicherheit, keine Renditequelle.",77.881,81.341,[[0,9,77.881],[10,18,78.473],[19,23,79.019],[24,35,79.262],[36,41,79.947],[42,56,80.307]]],["Zins-Hopping ersetzt den Zinseszins nicht.",81.666,84.754,[[0,12,81.666],[13,20,82.478],[21,24,82.873],[25,35,83.105],[36,42,84.08]]]]}