{"s":[["Deine drei Nordsterne als Zielkoordinaten",0.0,2.508,[[0,5,0.0],[6,10,0.348],[11,21,0.65],[22,25,1.3],[26,41,1.567]]],["Je eine Aussage, die in 12 Monaten wahr sein soll.",3.32,6.351,[[0,2,3.32],[3,7,3.611],[8,16,3.831],[17,20,4.54],[21,23,4.69],[24,26,4.807],[27,34,5.132],[35,39,5.515],[40,44,5.724],[45,50,5.956]]],["„Ich verstehe meine Geldentscheidungen und kann gute von schlechten Ratschlägen unterscheiden.“",6.734,11.761,[[0,4,6.734],[5,13,7.14],[14,19,7.581],[20,38,7.837],[39,42,8.986],[43,47,9.183],[48,52,9.404],[53,56,9.752],[57,67,9.961],[68,79,10.379],[80,95,10.937]]],["„Ich baue ununterbrochen auf.",12.365,14.466,[[0,4,12.365],[5,9,12.806],[10,24,13.201],[25,29,13.978]]],["Der Lauf wird nicht unterbrochen - ich handle bewusst, egal was der Markt macht.“",14.745,19.157,[[0,3,14.745],[4,8,14.942],[9,13,15.174],[14,19,15.337],[20,32,15.523],[33,34,16.301],[35,38,16.544],[39,45,16.73],[46,54,16.986],[55,59,17.752],[60,63,18.158],[64,67,18.321],[68,73,18.448],[74,81,18.739]]],["„Ich bin nicht beratungsresistent, kann aber meine Entscheidungen selbst treffen und begründen.“",19.482,24.695,[[0,4,19.482],[5,8,19.865],[9,14,20.027],[15,34,20.271],[35,39,21.769],[40,44,22.048],[45,50,22.257],[51,65,22.477],[66,72,23.092],[73,80,23.441],[81,84,23.836],[85,96,23.952]]],["Die meisten kennen ihren Kontostand, aber nicht ihr Wofür.",25.205,28.607,[[0,3,25.205],[4,11,25.403],[12,18,25.89],[19,24,26.227],[25,36,26.471],[37,41,27.295],[42,47,27.574],[48,51,27.841],[52,58,27.945]]],["Der Brief dreht das um: erst die Richtung, dann die Zahl.",29.211,33.065,[[0,3,29.211],[4,9,29.408],[10,15,29.733],[16,19,29.989],[20,23,30.233],[24,28,30.964],[29,32,31.243],[33,42,31.37],[43,47,32.021],[48,51,32.218],[52,57,32.38]]]]}