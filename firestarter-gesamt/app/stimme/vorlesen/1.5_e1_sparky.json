{"s":[["Der Zukunftsbrief",0.0,1.149,[[0,3,0.0],[4,17,0.244]]],["Ein Seemann steuert nicht nach dem Wasser vor dem Bug, sondern nach einem Stern.",1.846,6.432,[[0,3,1.846],[4,11,2.206],[12,19,2.647],[20,25,3.077],[26,30,3.297],[31,34,3.483],[35,41,3.646],[42,45,3.971],[46,49,4.122],[50,54,4.272],[55,62,4.969],[63,67,5.341],[68,73,5.538],[74,80,5.782]]],["Dein Nordstern ist kein Geldbetrag, er ist die Richtung, die auch dann gilt, wenn die See rau wird.",7.129,12.574,[[0,4,7.129],[5,14,7.349],[15,18,7.848],[19,23,8.022],[24,35,8.231],[36,38,9.416],[39,42,9.613],[43,46,9.752],[47,56,9.892],[57,60,10.368],[61,65,10.53],[66,70,10.716],[71,76,10.937],[77,81,11.308],[82,85,11.505],[86,89,11.633],[90,93,11.865],[94,99,12.109]]],["Diese Lektion schließt Baustein 1 ab: mit einem Brief an dein zukünftiges Ich.",13.177,18.1,[[0,5,13.177],[6,13,13.526],[14,22,14.048],[23,31,14.42],[32,33,14.896],[34,37,15.174],[38,41,15.952],[42,47,16.126],[48,53,16.335],[54,56,16.695],[57,61,16.811],[62,73,16.985],[74,78,17.729]]],["Warum schlägt ein geschriebener Brief den bloßen Vorsatz?",18.797,21.78,[[0,5,18.797],[6,13,19.226],[14,17,19.586],[18,31,19.702],[32,37,20.248],[38,41,20.527],[42,48,20.701],[49,57,21.107]]],["Was ist dein Wofür jenseits des Kontostands?",22.164,24.95,[[0,3,22.164],[4,7,22.396],[8,12,22.547],[13,18,22.767],[19,27,23.441],[28,31,23.94],[32,44,24.126]]],["Was macht eine Selbstverpflichtung überprüfbar?",25.391,27.829,[[0,3,25.391],[4,9,25.647],[10,14,25.867],[15,34,26.064],[35,47,26.935]]],["In Lektion 1.4 hast du eine ehrliche Standortbestimmung gemacht und für jeden der drei Leitbegriffe zwei Marken gesetzt, wo du heute stehst und wo du hinwillst.",28.526,38.452,[[0,2,28.526],[3,10,28.7],[11,14,29.141],[15,19,30.325],[20,22,30.534],[23,27,30.65],[28,36,30.848],[37,55,31.254],[56,63,32.16],[64,67,32.879],[68,71,33.065],[72,77,33.228],[78,81,33.518],[82,86,33.646],[87,99,33.924],[100,104,34.702],[105,111,35.074],[112,120,35.399],[121,123,36.188],[124,126,36.362],[127,132,36.49],[133,139,36.769],[140,143,37.314],[144,146,37.477],[147,149,37.616],[150,160,37.732]]],["Eine niedrige Zahl galt dabei als Startkapital, nicht als Urteil; genau diese Zielwerte werden jetzt zur Rohform deiner Nordsterne.",39.056,47.229,[[0,4,39.056],[5,13,39.335],[14,18,39.799],[19,23,40.17],[24,29,40.368],[30,33,40.647],[34,47,40.797],[48,53,41.889],[54,57,42.156],[58,65,42.353],[66,71,43.421],[72,77,43.816],[78,87,44.083],[88,94,44.838],[95,100,45.163],[101,104,45.5],[105,112,45.674],[113,119,46.196],[120,131,46.475]]],["„Die meisten kennen ihren Kontostand, aber nicht ihr Wofür.“",47.613,51.27,[[0,4,47.613],[5,12,47.938],[13,19,48.379],[20,25,48.716],[26,37,48.948],[38,42,49.807],[43,48,50.062],[49,52,50.271],[53,60,50.387]]]]}