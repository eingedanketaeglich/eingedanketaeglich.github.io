{"s":[["Was du mitnimmst",0.0,0.894,[[0,3,0.0],[4,6,0.232],[7,16,0.348]]],["Drei Sätze, und die Fragen, die jetzt oft kommen.",1.219,3.866,[[0,4,1.219],[5,11,1.556],[12,15,1.974],[16,19,2.09],[20,27,2.241],[28,31,2.589],[32,37,2.81],[38,41,3.158],[42,49,3.425]]],["Drei Sätze zum Mitnehmen",4.191,5.619,[[0,4,4.191],[5,10,4.516],[11,14,4.946],[15,24,5.132]]],["Kontinuität schlägt Höhe, der Motor ist das „hoch n“, nicht der Zinssatz.",6.13,11.401,[[0,11,6.13],[12,19,6.954],[20,25,7.326],[26,29,7.918],[30,35,8.057],[36,39,8.417],[40,43,8.58],[44,49,8.777],[50,53,9.3],[54,59,9.985],[60,63,10.414],[64,73,10.6]]],["37.000 € sind der entgangene Lauf, nie entstanden, nicht entnommen.",11.575,16.649,[[0,6,11.575],[7,8,12.608],[9,13,13.363],[14,17,13.56],[18,28,13.688],[29,34,14.234],[35,38,14.93],[39,50,15.232],[51,56,15.836],[57,67,16.092]]],["Langes Verharren im Tal kostet jedes Jahr plus dessen Zinseszins, teurer als ein erholter Sturz.",16.858,23.371,[[0,6,16.858],[7,16,17.218],[17,19,17.659],[20,23,17.799],[24,30,18.182],[31,36,18.6],[37,41,18.913],[42,46,19.238],[47,53,19.784],[54,65,20.248],[66,72,21.595],[73,76,22.048],[77,80,22.199],[81,89,22.326],[90,96,22.744]]],["Häufige Fragen, kurz & klar",23.487,25.299,[[0,7,23.487],[8,15,23.905],[16,20,24.347],[21,22,24.753],[23,27,24.892]]],["Sind die 7 % ein Renditeversprechen?",25.682,28.375,[[0,4,25.682],[5,8,25.937],[9,10,26.146],[11,12,26.494],[13,16,26.982],[17,36,27.272]]],["Wurden die 37.000 € in einem Crash „verloren“?",28.584,32.729,[[0,6,28.584],[7,10,28.886],[11,17,29.141],[18,19,30.419],[20,22,30.848],[23,28,30.953],[29,34,31.173],[35,46,31.823]]],["Soll ich bei jedem Tal verkaufen oder aktiv handeln?",32.973,35.55,[[0,4,32.973],[5,8,33.17],[9,12,33.274],[13,18,33.402],[19,22,33.669],[23,32,33.878],[33,37,34.4],[38,43,34.586],[44,52,34.992]]],["Ist „kaufen und liegen lassen“ also schlecht?",35.794,39.277,[[0,3,35.794],[4,11,36.188],[12,15,37.059],[16,22,37.512],[23,30,37.872],[31,35,38.499],[36,45,38.708]]],["Die